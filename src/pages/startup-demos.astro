---
import Layout from "../layouts/Layout.astro";
import { getAllStartups } from "../data/startups.js";
import { getSpeaker } from "../data/speakers.js";

const startups = getAllStartups();

// Demo format information
const demoFormat = [
    "Quick 10-minute presentations",
    "Live product demonstrations",
    "Q&A with the audience",
    "Networking opportunities afterwards",
];

// Past success stories
const successStories = [
    {
        company: "DataRuby",
        year: "2023",
        outcome:
            "Raised $3.2M seed round after presenting at SF Ruby Conference",
        quote: '"Our demo at the conference directly led to conversations with three investors who joined our seed round."',
        founder: "Michael Chen, CEO",
    },
    {
        company: "RailsMonitor",
        year: "2022",
        outcome: "Acquired by New Relic 6 months after conference demo",
        quote: '"The visibility and connections we gained at SF Ruby Conf were instrumental in our growth and eventual acquisition."',
        founder: "Sophia Liu, Founder",
    },
];
---

<Layout
    title="Startup Demos - San Francisco Ruby Conference 2025"
    description="Discover the next big thing in the Ruby ecosystem. Watch startup demos from innovative Ruby companies at SF Ruby Conference 2025."
    ogImage="/sfruby_og.jpg"
    ogUrl="https://sfruby.com/startup-demos"
>
    <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Startup Demos
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Discover the next big thing in the Ruby ecosystem
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Intro section -->
        <div class="mb-16 max-w-3xl mx-auto text-center">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-4">
                Showcasing Ruby Innovation
            </h2>
            <p class="text-lg text-dark-600">
                The Startup Demo showcase features exciting new companies
                building with Ruby. Each startup presents a 10-minute demo of
                their product, highlighting how they're using Ruby to solve
                real-world problems.
            </p>
        </div>

        <!-- Video reel of past demos -->
        <div class="mb-16 bg-dark-50 rounded-lg overflow-hidden">
            <div
                class="aspect-w-16 aspect-h-9 flex items-center justify-center bg-dark-800"
            >
                <!-- Video placeholder -->
                <div class="text-center p-8">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-16 h-16 mx-auto text-dark-400 mb-4"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
                        ></path>
                    </svg>
                    <h3 class="text-xl font-bold text-dark-900 mb-2">
                        Watch highlights from previous SF Ruby Conference
                        Startup Demos
                    </h3>
                    <p class="text-dark-600 mb-4">
                        See the most exciting demos from our past events
                    </p>
                    <a
                        href="https://www.youtube.com/@sfruby"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block px-6 py-2 bg-ruby-500 text-white rounded-md hover:bg-ruby-600 transition-colors duration-200"
                    >
                        Watch Videos
                    </a>
                </div>
            </div>
        </div>

        <!-- Demo format -->
        <div class="mb-16 bg-white rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Demo Format
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <ul class="space-y-4">
                        {
                            demoFormat.map((item) => (
                                <li class="flex items-start">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="w-6 h-6 text-ruby-500 mr-2 flex-shrink-0"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                        />
                                    </svg>
                                    <span class="text-dark-700">{item}</span>
                                </li>
                            ))
                        }
                    </ul>

                    <div class="mt-8">
                        <a
                            href="/apply-for-demo"
                            class="inline-flex items-center px-6 py-3 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200"
                        >
                            Apply for a Demo Slot
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="w-5 h-5 ml-2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <div>
                    <div class="bg-dark-50 p-6 rounded-lg">
                        <h3 class="font-bold text-dark-900 mb-2">
                            Eligibility Requirements
                        </h3>
                        <ul class="space-y-2 text-dark-700">
                            <li>
                                • Your product must be built with Ruby/Rails
                            </li>
                            <li>• Company must be less than 5 years old</li>
                            <li>
                                • Must have a working product or advanced
                                prototype
                            </li>
                            <li>
                                • Demos should focus on technical innovation
                            </li>
                        </ul>

                        <div class="mt-4 text-dark-600 text-sm">
                            <p>Application deadline: September 30, 2025</p>
                            <p>
                                Selected startups will be notified by October
                                15, 2025
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Featured startups -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Featured Startups
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    startups.map((startup) => {
                        const speaker = getSpeaker(startup.speakerId);
                        return (
                            <div class="bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg">
                                <div class="h-40 bg-dark-100 flex items-center justify-center p-4">
                                    <img
                                        src={startup.logo}
                                        alt={`${startup.name} logo`}
                                        class="max-h-full max-w-full object-contain"
                                        loading="lazy"
                                    />
                                </div>

                                <div class="p-6">
                                    <div class="flex justify-between items-start mb-2">
                                        <h3 class="font-bold text-xl text-dark-900">
                                            {startup.name}
                                        </h3>
                                        <div class="text-right">
                                            <span class="block text-xs font-medium text-dark-500 bg-dark-100 px-2 py-1 rounded mb-1">
                                                {startup.demoTime}
                                            </span>
                                            <span class="block text-xs text-ruby-500 bg-ruby-50 px-2 py-1 rounded">
                                                {(startup as any).category ||
                                                    "Demo"}
                                            </span>
                                        </div>
                                    </div>

                                    <p class="text-dark-600 mb-4">
                                        {startup.description}
                                    </p>

                                    {speaker && (
                                        <div class="mb-4 p-3 bg-dark-50 rounded-lg">
                                            <div class="text-xs text-dark-500 mb-1">
                                                Founded by
                                            </div>
                                            <div class="font-medium text-dark-900">
                                                {speaker.name}
                                            </div>
                                            <div class="text-sm text-dark-600">
                                                {speaker.role} at{" "}
                                                {speaker.company}
                                            </div>
                                        </div>
                                    )}

                                    <a
                                        href={startup.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-ruby-500 hover:text-ruby-600 font-medium inline-flex items-center"
                                    >
                                        Visit Website
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="w-4 h-4 ml-1"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <!-- Success stories -->
        <div class="bg-dark-50 rounded-lg p-8">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Success Stories
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    successStories.map((story) => (
                        <div class="bg-white p-6 rounded-lg shadow-sm">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold text-lg text-dark-900">
                                    {story.company}
                                </h3>
                                <span class="text-dark-500 text-sm">
                                    {story.year}
                                </span>
                            </div>

                            <p class="text-ruby-500 font-medium mb-4">
                                {story.outcome}
                            </p>

                            <blockquote class="border-l-4 border-dark-200 pl-4 italic text-dark-600 mb-4">
                                {story.quote}
                            </blockquote>

                            <p class="text-right text-dark-500 text-sm">
                                — {story.founder}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</Layout>
