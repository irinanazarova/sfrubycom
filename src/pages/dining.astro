---
import Layout from "../layouts/Layout.astro";
import FoodVenue from "../components/FoodVenue.astro";
import DistanceBadge from "../components/DistanceBadge.astro";
---

<Layout
    title="Dining Guide - San Francisco Ruby Conference 2025"
    description="Complete dining guide for SF Ruby Conference 2025 attendees, featuring restaurants, cafes, and bars near Fort Mason and throughout San Francisco."
>
    <!-- Hero Section -->
    <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center mb-4">
                Dining Guide
            </h1>
            <p class="text-xl text-center max-w-3xl mx-auto">
                Discover the best food and drinks near Fort Mason and around San Francisco
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
        <!-- At the Venue -->
        <section>
            <div class="flex items-center gap-3 mb-6">
                <h2 class="text-2xl font-display font-bold text-dark-900">
                    🏢 At the Venue
                </h2>
                <DistanceBadge distance="0 min" type="walk" color="green" />
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <FoodVenue
                    name="Equator Coffee"
                    type="☕"
                    hours="Daily 7:00 AM - 4:00 PM"
                    pricing="Espresso $3, Latte $5, Pastries $4-6"
                    mapQuery="Equator Coffee Fort Mason San Francisco"
                />
                <FoodVenue
                    name="Radhaus"
                    type="🍽️"
                    hours="Breakfast, Lunch, Dinner"
                    pricing="Sandwiches $12-16, Salads $14-18"
                    mapQuery="Radhaus Fort Mason San Francisco"
                />
                <FoodVenue
                    name="The Interval"
                    type="🍸"
                    hours="Bar & Café"
                    pricing="Cocktails $12-16, Wine $8-14"
                    mapQuery="The Interval Fort Mason San Francisco"
                />
            </div>
        </section>

        <!-- Close By -->
        <section>
            <div class="flex items-center gap-3 mb-6">
                <h2 class="text-2xl font-display font-bold text-dark-900">
                    🚶 Close By
                </h2>
                <DistanceBadge distance="5-20 min walk" type="walk" color="blue" />
            </div>

            <div class="space-y-8">
                <!-- Breakfast -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🥞 Breakfast & Coffee</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Reveille Coffee"
                            type=""
                            description="Artisan coffee & pastries"
                            pricing="Coffee $4-6, Pastries $3-5"
                            mapQuery="Reveille Coffee San Francisco"
                        />
                        <FoodVenue
                            name="Cracked & Buttered"
                            type=""
                            description="Gourmet breakfast sandwiches"
                            pricing="Sandwiches $8-12"
                            mapQuery="Cracked Buttered San Francisco"
                        />
                        <FoodVenue
                            name="The Donut Farm"
                            type=""
                            description="Artisanal donuts & coffee"
                            pricing="Donuts $3-5, Coffee $4-6"
                            mapQuery="The Donut Farm San Francisco"
                        />
                    </div>
                </div>

                <!-- Lunch -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🍜 Lunch</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Komeya no Bento"
                            type=""
                            description="Authentic Japanese bento boxes"
                            pricing="Bento boxes $12-18"
                            mapQuery="Komeya no Bento San Francisco"
                        />
                        <FoodVenue
                            name="Hinodeya Ramen"
                            type=""
                            description="Traditional tonkotsu ramen"
                            pricing="Ramen $14-18"
                            mapQuery="Hinodeya Ramen San Francisco"
                        />
                        <FoodVenue
                            name="Marufuku Ramen"
                            type=""
                            description="Hakata-style ramen specialist"
                            pricing="Ramen $15-20"
                            mapQuery="Marufuku Ramen San Francisco"
                        />
                        <FoodVenue
                            name="Greens Restaurant"
                            type=""
                            description="Upscale vegetarian with bay views"
                            pricing="Lunch $25-35"
                            mapQuery="Greens Restaurant San Francisco"
                        />
                        <FoodVenue
                            name="Fisherman's Wharf Crab Stands"
                            type=""
                            description="Fresh Dungeness crab & seafood"
                            pricing="Crab $15-25"
                            mapQuery="Fisherman's Wharf Crab San Francisco"
                        />
                    </div>
                </div>

                <!-- Bars -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🍷 Bars & Evening</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Bar Darling"
                            type=""
                            description="Craft cocktails & natural wines"
                            pricing="Cocktails $12-16, Wine $8-14"
                            mapQuery="Bar Darling San Francisco"
                        />
                        <FoodVenue
                            name="Buena Vista Cafe"
                            type=""
                            description="Famous Irish coffee since 1952"
                            pricing="Irish Coffee $8, Food $12-18"
                            mapQuery="Buena Vista Cafe San Francisco"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- In the Area -->
        <section>
            <div class="flex items-center gap-3 mb-6">
                <h2 class="text-2xl font-display font-bold text-dark-900">
                    🌆 In the Area
                </h2>
                <DistanceBadge distance="20-40 min walk" type="walk" color="amber" />
                <DistanceBadge distance="10-15 min" type="transit" color="purple" />
            </div>

            <div class="space-y-8">
                <!-- Coffee -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">☕ Specialty Coffee</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Coffee Movement"
                            type=""
                            description="Third-wave specialty coffee"
                            pricing="Coffee $4-7, Light bites $5-10"
                            mapQuery="Coffee Movement San Francisco"
                        />
                        <FoodVenue
                            name="Blue Bottle Coffee"
                            type=""
                            description="Famous for their hot waffle!"
                            pricing="Coffee $4-6, Waffle $8"
                            mapQuery="Blue Bottle Coffee San Francisco"
                        />
                        <FoodVenue
                            name="Saint Frank Coffee"
                            type=""
                            description="Local roaster with multiple locations"
                            pricing="Coffee $4-6, Pastries $4-7"
                            mapQuery="Saint Frank Coffee San Francisco"
                        />
                    </div>
                </div>

                <!-- Breakfast & Brunch -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🥞 Breakfast & Brunch</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Camino Alto"
                            type=""
                            description="Elevated brunch experience"
                            pricing="Brunch $18-28"
                            mapQuery="Camino Alto San Francisco"
                        />
                        <FoodVenue
                            name="Mama's on Washington"
                            type=""
                            description="Famous French toast"
                            pricing="Breakfast $12-20"
                            mapQuery="Mama's Washington Square San Francisco"
                        />
                        <FoodVenue
                            name="Zazie"
                            type=""
                            description="French bistro brunch favorite"
                            pricing="Brunch $15-25"
                            mapQuery="Zazie San Francisco"
                        />
                    </div>
                </div>

                <!-- Lunch & Dinner -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🍽️ Lunch & Dinner</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Swan Oyster Depot"
                            type=""
                            description="Historic seafood counter"
                            pricing="Seafood $15-30"
                            mapQuery="Swan Oyster Depot San Francisco"
                        />
                        <FoodVenue
                            name="Tony's Little Star"
                            type=""
                            description="Deep-dish pizza legend"
                            pricing="Pizza $18-35"
                            mapQuery="Tony's Little Star Pizza San Francisco"
                        />
                        <FoodVenue
                            name="State Bird Provisions"
                            type=""
                            description="Michelin-starred dim sum"
                            pricing="Dinner $60-80"
                            mapQuery="State Bird Provisions San Francisco"
                        />
                        <FoodVenue
                            name="Tartine Bakery"
                            type=""
                            description="Legendary bakery & cafe"
                            pricing="Pastries $4-8, Sandwiches $12-16"
                            mapQuery="Tartine Bakery San Francisco"
                        />
                        <FoodVenue
                            name="Zuni Cafe"
                            type=""
                            description="SF institution, famous roast chicken"
                            pricing="Dinner $25-45"
                            mapQuery="Zuni Cafe San Francisco"
                        />
                        <FoodVenue
                            name="Mission Chinese Food"
                            type=""
                            description="Creative Chinese-American cuisine"
                            pricing="Dinner $20-35"
                            mapQuery="Mission Chinese Food San Francisco"
                        />
                    </div>
                </div>

                <!-- Bars & Nightlife -->
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">🍸 Bars & Nightlife</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <FoodVenue
                            name="Trick Dog"
                            type=""
                            description="Creative cocktails with rotating menus"
                            pricing="Cocktails $12-16"
                            mapQuery="Trick Dog San Francisco"
                        />
                        <FoodVenue
                            name="The Progress"
                            type=""
                            description="Upscale cocktails & small plates"
                            pricing="Cocktails $14-18, Food $15-25"
                            mapQuery="The Progress San Francisco"
                        />
                        <FoodVenue
                            name="Bourbon & Branch"
                            type=""
                            description="Speakeasy with password entry"
                            pricing="Cocktails $12-16"
                            mapQuery="Bourbon & Branch San Francisco"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Food Neighborhoods -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                🗺️ Food Neighborhoods Worth Exploring
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">Mission District</h3>
                        <DistanceBadge distance="25 min" type="transit" color="purple" />
                    </div>
                    <p class="text-dark-600 text-sm mb-3">
                        Best burritos in the city, trendy restaurants, and vibrant street art. Don't miss Dolores Park!
                    </p>
                    <p class="text-dark-500 text-xs">
                        <strong>Must-try:</strong> La Taqueria, Tartine, Bi-Rite Creamery
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">North Beach (Little Italy)</h3>
                        <DistanceBadge distance="15 min" type="walk" color="blue" />
                    </div>
                    <p class="text-dark-600 text-sm mb-3">
                        Historic Italian neighborhood with authentic restaurants, cafes, and the famous City Lights Bookstore.
                    </p>
                    <p class="text-dark-500 text-xs">
                        <strong>Must-try:</strong> Tony's Little Star, Mama's, Caffe Trieste
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">Chinatown</h3>
                        <DistanceBadge distance="20 min" type="transit" color="purple" />
                    </div>
                    <p class="text-dark-600 text-sm mb-3">
                        Authentic dim sum, tea shops, and the oldest Chinatown in North America.
                    </p>
                    <p class="text-dark-500 text-xs">
                        <strong>Must-try:</strong> Z&Y Restaurant, Golden Dragon, Red Blossom Tea
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">Ferry Building</h3>
                        <DistanceBadge distance="15 min" type="transit" color="purple" />
                    </div>
                    <p class="text-dark-600 text-sm mb-3">
                        Gourmet food hall with local vendors, farmers market (Tues/Thu/Sat), and bay views.
                    </p>
                    <p class="text-dark-500 text-xs">
                        <strong>Must-try:</strong> Blue Bottle Coffee, Acme Bread, Cowgirl Creamery
                    </p>
                </div>
            </div>
        </section>

        <!-- Dietary Restrictions -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                🌱 Dietary Restrictions & Special Diets
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <h3 class="font-bold text-green-800 mb-3">🌱 Vegetarian/Vegan</h3>
                    <ul class="space-y-1 text-green-700 text-sm">
                        <li>• Greens Restaurant (vegetarian fine dining)</li>
                        <li>• Loving Hut (vegan Asian cuisine)</li>
                        <li>• The Plant Café Organic</li>
                        <li>• Shizen (vegan sushi)</li>
                    </ul>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h3 class="font-bold text-blue-800 mb-3">🚫 Gluten-Free</h3>
                    <ul class="space-y-1 text-blue-700 text-sm">
                        <li>• Mariposa Baking Co. (dedicated GF bakery)</li>
                        <li>• Pena Pachamama (Bolivian, many GF options)</li>
                        <li>• Most sushi restaurants</li>
                        <li>• Many Vietnamese pho places</li>
                    </ul>
                </div>

                <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                    <h3 class="font-bold text-purple-800 mb-3">🥩 Halal/Kosher</h3>
                    <ul class="space-y-1 text-purple-700 text-sm">
                        <li>• Sunrise Deli (Middle Eastern halal)</li>
                        <li>• Aslam's Rasoi (Pakistani halal)</li>
                        <li>• Wise Sons Jewish Delicatessen</li>
                        <li>• Many Mediterranean restaurants</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Tips -->
        <section class="bg-dark-50 rounded-lg p-8">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                💡 Dining Tips for Conference Attendees
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="font-bold text-dark-900 mb-3">🕐 Timing</h3>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>• Lunch rush: 12-1:30 PM (plan accordingly)</li>
                        <li>• Many cafes close early (3-4 PM)</li>
                        <li>• Dinner reservations recommended for popular spots</li>
                        <li>• Happy hour: typically 4-6 PM</li>
                    </ul>
                </div>
                
                <div>
                    <h3 class="font-bold text-dark-900 mb-3">💳 Payment & Tipping</h3>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>• Most places accept cards, some cash-only</li>
                        <li>• Standard tip: 18-20% for table service</li>
                        <li>• Counter service: $1-2 or 10-15%</li>
                        <li>• Many places add automatic service charges</li>
                    </ul>
                </div>
            </div>
        </section>
    </div>
</Layout>