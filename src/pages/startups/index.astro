---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StartupCard from "../../components/StartupCard.astro";
import StartupModal from "../../components/StartupModal.astro";
import {
    getAllStartups,
    startups as startupsData,
} from "../../data/startups.js";
import { talks, getTalk } from "../../data/talks.js";
import {
    jobs as jobsData,
    getJobsBySponsor,
    getJobsByStartup,
} from "../../data/jobs.js";
import { getSpeaker } from "../../data/speakers.js";

const allStartups = getAllStartups();

// Filter out hidden startups (CorePilot cancelled)
const visibleStartups = allStartups.filter((s) => s.id !== "corepilot");

// Sort startups: those with demo videos first
const startups = visibleStartups.sort((a, b) => {
    const aDemoTalk = getTalk(`${a.id}-demo`);
    const bDemoTalk = getTalk(`${b.id}-demo`);
    const aHasVideo = a.youtubeId || aDemoTalk?.youtubeId;
    const bHasVideo = b.youtubeId || bDemoTalk?.youtubeId;

    if (aHasVideo && !bHasVideo) return -1;
    if (!aHasVideo && bHasVideo) return 1;
    return 0;
});

// Map startup IDs to sponsor IDs for job lookup
const startupToSponsorMap: Record<string, string> = {
    bolt_new: "bolt-new",
    finta: "finta",
    thatch: "thatch",
    // Add more mappings as needed
};

// Calculate stats
const totalFunding = startups.filter((s) => s.funding).length;
const ycBacked = startups.filter((s) => s.isYC).length;
const unicorns = startups.filter(
    (s) => s.valuation && s.valuation.includes("B"),
).length;

// Build enhanced startups data with jobs info and source URLs
const enhancedStartupsData: Record<string, any> = {};
for (const [id, startup] of Object.entries(startupsData)) {
    const sponsorId = startupToSponsorMap[id];
    // Get jobs from both sponsor ID (if exists) and startup ID
    const sponsorJobs = sponsorId ? getJobsBySponsor(sponsorId) : [];
    const directStartupJobs = getJobsByStartup(id);
    const startupJobs = [...sponsorJobs, ...directStartupJobs];
    const demoTalk = getTalk(`${id}-demo`);
    enhancedStartupsData[id] = {
        ...startup,
        jobs: startupJobs,
        youtubeId: startup.youtubeId || demoTalk?.youtubeId || null,
        fundingUrl: startup.fundingUrl || null,
        valuationUrl: startup.valuationUrl || null,
        newsUrl: startup.newsUrl || null,
    };
}
---

<BaseLayout
    darkHero={false}
    title="Ruby Startups - SF Ruby"
    description="From seed-stage to unicorns, discover the startups building the future with Ruby and Rails."
>
    <!-- Hero Section -->
    <section
        class="relative pt-32 pb-16 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden"
    >
        <!-- Background pattern -->
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute inset-0"
                style="background-image: url('data:image/svg+xml,%3Csvg width=\"
                60\"
                height='\"60\"'
                viewBox='\"0'
                0
                60
                60\"
                xmlns='\"http://www.w3.org/2000/svg\"%3E%3Cg'
                fill='\"none\"'
                fill-rule='\"evenodd\"%3E%3Cg'
                fill='\"%23ffffff\"'
                fill-opacity='\"0.4\"%3E%3Cpath'
                d='\"M36'
                34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6
                34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6
                4V0H4v4H0v2h4v4h2V6h4V4H6z\"%3E%3C
                path%3E%3C
                g%3E%3C
                g%3E%3C
                svg%3E')"
            >
            </div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6"
                >
                    Ruby Startups
                    <span class="block text-ruby-400">new generation</span>
                </h1>
                <p class="text-lg md:text-xl text-gray-300 mb-8">
                    From seed-stage to unicorns, discover the startups building
                    the future with Ruby and Rails.
                </p>

                <!-- Stats -->
                <div class="flex flex-wrap gap-8">
                    <div>
                        <div class="text-3xl font-bold text-white">
                            {startups.length}
                        </div>
                        <div class="text-sm text-gray-400">Startups</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-amber-400">
                            {ycBacked}
                        </div>
                        <div class="text-sm text-gray-400">YC Backed</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-emerald-400">
                            {unicorns}
                        </div>
                        <div class="text-sm text-gray-400">Unicorns</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Startups Grid -->
    <section class="py-12 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div
                class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
                id="startups-grid"
            >
                {
                    startups.map((startup) => {
                        const sponsorId = startupToSponsorMap[startup.id];
                        const hasJobs = sponsorId
                            ? getJobsBySponsor(sponsorId).length > 0
                            : false;
                        return (
                            <div
                                data-filterable
                                data-search={`${startup.name} ${startup.description || ""}`}
                            >
                                <StartupCard
                                    startup={startup}
                                    hasJobs={hasJobs}
                                />
                            </div>
                        );
                    })
                }
            </div>

            <div id="no-results" class="hidden text-center py-12">
                <div
                    class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center"
                >
                    <svg
                        class="w-8 h-8 text-gray-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">
                    No startups found
                </h3>
                <p class="text-gray-500">
                    Try adjusting your filters or search terms.
                </p>
            </div>
        </div>
    </section>

    <!-- How to Get Featured Section -->
    <section class="py-16 bg-white border-t border-gray-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
                    How to add your startup here
                </h2>
                <p class="text-lg text-gray-600">
                    Two ways to get featured in our directory and connect with
                    the Ruby community.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Option 1: Interview -->
                <div
                    class="bg-gradient-to-br from-ruby-50 to-pink-50 rounded-2xl p-8 border border-ruby-100"
                >
                    <div
                        class="w-12 h-12 bg-ruby-500 rounded-xl flex items-center justify-center mb-4"
                    >
                        <svg
                            class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">
                        "Startups on Rails" Interview
                    </h3>
                    <p class="text-gray-600 mb-6">
                        Give a 30-minute remote interview with Irina Nazarova
                        and be featured in her "Startups on Rails" talks at Ruby
                        conferences around the world.
                    </p>
                    <a
                        href="https://cal.com/inazarova/feedback"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-ruby-500 to-pink-500 text-white font-semibold rounded-lg shadow-sm hover:shadow-md hover:from-ruby-400 hover:to-pink-400 transition-all"
                    >
                        Book a call
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            ></path>
                        </svg>
                    </a>
                </div>

                <!-- Option 2: Demo at Meetup -->
                <div
                    class="bg-gradient-to-br from-sky-50 to-indigo-50 rounded-2xl p-8 border border-sky-100"
                >
                    <div
                        class="w-12 h-12 bg-sky-500 rounded-xl flex items-center justify-center mb-4"
                    >
                        <svg
                            class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">
                        Demo at SF Ruby Meetup
                    </h3>
                    <p class="text-gray-600 mb-6">
                        Present your startup in person at our monthly SF Ruby
                        Meetup. Demo your product, share your story, and connect
                        with the local Ruby community.
                    </p>
                    <a
                        href="https://forms.gle/EZLqENWd5VjiLduq8"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-sky-500 text-white font-semibold rounded-lg hover:bg-sky-600 transition-colors"
                    >
                        Submit to speak
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Startup Modal -->
    <StartupModal />
</BaseLayout>

<script define:vars={{ enhancedStartupsData }}>
    // Make startup data available to the modal
    window.startupsData = enhancedStartupsData;
</script>

<script>
    import { getSpeaker } from "../../data/speakers.js";

    // Wait for DOM and modal to be ready
    function initStartupCards() {
        const cards = document.querySelectorAll(".startup-card");

        cards.forEach((card) => {
            card.addEventListener("click", (e) => {
                e.preventDefault();
                const startupId = card.getAttribute("data-startup-id");
                if (!startupId) return;

                const startup = (window as any).startupsData[startupId];
                if (!startup) return;

                // Build modal content
                const modalHtml = buildModalContent(startup);

                // Show modal
                if (
                    typeof (window as any).setStartupModalContent === "function"
                ) {
                    (window as any).setStartupModalContent(modalHtml);
                    (window as any).showStartupModal();
                }
            });
        });
    }

    function buildModalContent(startup: any): string {
        // Get speaker info if available - now with full bio
        let speakerHtml = "";
        if (startup.speakerId) {
            const speaker = getSpeaker(startup.speakerId);
            if (speaker) {
                // Build social links
                let socialLinks = "";
                if (speaker.twitter || speaker.github || speaker.linkedin) {
                    const links = [];
                    if (speaker.twitter) {
                        links.push(
                            `<a href="https://twitter.com/${speaker.twitter}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 transition-colors"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>`,
                        );
                    }
                    if (speaker.github) {
                        links.push(
                            `<a href="https://github.com/${speaker.github}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 transition-colors"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>`,
                        );
                    }
                    if (speaker.linkedin) {
                        links.push(
                            `<a href="${speaker.linkedin}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 transition-colors"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>`,
                        );
                    }
                    socialLinks = `<div class="flex gap-3 mt-3">${links.join("")}</div>`;
                }

                speakerHtml = `
                    <div class="p-5 bg-gradient-to-br from-gray-50 to-slate-50 rounded-xl border border-gray-100">
                        <div class="flex items-start gap-4">
                            ${
                                speaker.image
                                    ? `
                                <img
                                    src="${speaker.image}"
                                    alt="${speaker.name}"
                                    class="w-20 h-20 rounded-xl object-cover shadow-md flex-shrink-0"
                                />
                            `
                                    : ""
                            }
                            <div class="flex-1 min-w-0">
                                <p class="font-bold text-lg text-gray-900">${speaker.name}</p>
                                <p class="text-sm text-gray-600">${speaker.role || speaker.title || ""}</p>
                                ${speaker.company ? `<p class="text-sm text-gray-500">${speaker.company}</p>` : ""}
                                ${socialLinks}
                            </div>
                        </div>
                        ${
                            speaker.bio
                                ? `
                            <p class="mt-4 text-sm text-gray-600 leading-relaxed">${speaker.bio}</p>
                        `
                                : ""
                        }
                    </div>
                `;
            }
        }

        // Build stats section
        let statsHtml = "";
        const stats = [];
        if (startup.founded)
            stats.push(
                `<div class="text-center"><div class="text-lg font-bold text-gray-900">${startup.founded}</div><div class="text-xs text-gray-500">Founded</div></div>`,
            );
        if (startup.funding) {
            const fundingContent = startup.fundingUrl
                ? `<a href="${startup.fundingUrl}" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-emerald-600 hover:text-emerald-700 hover:underline">${startup.funding}</a>`
                : `<div class="text-lg font-bold text-emerald-600">${startup.funding}</div>`;
            stats.push(
                `<div class="text-center">${fundingContent}<div class="text-xs text-gray-500">Funding</div></div>`,
            );
        }
        if (startup.valuation) {
            const valuationContent = startup.valuationUrl
                ? `<a href="${startup.valuationUrl}" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-amber-600 hover:text-amber-700 hover:underline">${startup.valuation}</a>`
                : `<div class="text-lg font-bold text-amber-600">${startup.valuation}</div>`;
            stats.push(
                `<div class="text-center">${valuationContent}<div class="text-xs text-gray-500">Valuation</div></div>`,
            );
        }

        if (stats.length > 0) {
            statsHtml = `
                <div class="flex justify-around py-4 border-y border-gray-100">
                    ${stats.join("")}
                </div>
            `;
        }

        // Build YouTube video section
        let videoHtml = "";
        if (startup.youtubeId) {
            videoHtml = `
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Demo Video</h3>
                    <div class="relative aspect-video rounded-xl overflow-hidden bg-black shadow-lg">
                        <iframe
                            src="https://www.youtube.com/embed/${startup.youtubeId}"
                            title="${startup.name} Demo"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            class="absolute inset-0 w-full h-full"
                        ></iframe>
                    </div>
                </div>
            `;
        }

        // Build news section
        let newsHtml = "";
        if (startup.news) {
            const newsContent = startup.newsUrl
                ? `<a href="${startup.newsUrl}" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-800 hover:text-blue-900 hover:underline">${startup.news}</a>`
                : `<p class="text-sm text-blue-800">${startup.news}</p>`;
            newsHtml = `
                <div class="p-4 bg-blue-50 rounded-xl mb-6">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        ${newsContent}
                    </div>
                </div>
            `;
        }

        // Build jobs section
        let jobsHtml = "";
        if (startup.jobs && startup.jobs.length > 0) {
            const jobsList = startup.jobs
                .map(
                    (job: any) => `
                <a
                    href="${job.url}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block p-4 bg-emerald-50 rounded-xl hover:bg-emerald-100 transition-colors"
                >
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1">
                            <p class="font-semibold text-gray-900">${job.title}</p>
                            <p class="text-sm text-gray-600 mt-1">${job.location} · ${job.type}</p>
                        </div>
                        <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </div>
                </a>
            `,
                )
                .join("");

            jobsHtml = `
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Open Positions (${startup.jobs.length})
                    </h3>
                    <div class="space-y-3">
                        ${jobsList}
                    </div>
                </div>
            `;
        }

        // Build hiring badge
        const hiringBadge =
            startup.jobs && startup.jobs.length > 0
                ? '<span class="px-2 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full">Hiring</span>'
                : "";

        return `
            <div class="p-6 sm:p-8">
                <!-- Close button -->
                <button
                    id="startupModalCloseBtn"
                    class="absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors"
                    aria-label="Close modal"
                >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Header -->
                <div class="flex items-start gap-5 mb-6">
                    ${
                        startup.logo
                            ? `
                        <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-gray-50 border border-gray-100 flex items-center justify-center overflow-hidden">
                            <img src="${startup.logo}" alt="${startup.name}" class="w-full h-full object-contain p-3" />
                        </div>
                    `
                            : ""
                    }
                    <div class="flex-1 pt-1">
                        <div class="flex items-center gap-2 flex-wrap mb-2">
                            <h2 class="text-2xl font-bold text-gray-900">${startup.name}</h2>
                            ${startup.isYC ? '<span class="px-2 py-0.5 text-xs font-semibold bg-orange-100 text-orange-700 rounded-full">YC</span>' : ""}
                            ${startup.valuation ? `<span class="px-2 py-0.5 text-xs font-semibold bg-amber-100 text-amber-700 rounded-full">${startup.valuation}</span>` : ""}
                            ${hiringBadge}
                        </div>
                        <a
                            href="${startup.url}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center text-sm text-ruby-500 hover:text-ruby-600 font-medium"
                        >
                            ${startup.url?.replace("https://", "").replace("http://", "").replace(/\/$/, "")}
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Stats -->
                ${statsHtml}

                <!-- Description -->
                <div class="py-5">
                    <p class="text-gray-700 leading-relaxed">${startup.description || ""}</p>
                </div>

                <!-- Video Demo -->
                ${videoHtml}

                <!-- News -->
                ${newsHtml}

                <!-- Jobs -->
                ${jobsHtml}

                <!-- Speaker -->
                ${
                    speakerHtml
                        ? `
                    <div class="mt-6">
                        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Presented by</h3>
                        ${speakerHtml}
                    </div>
                `
                        : ""
                }
            </div>
        `;
    }

    // Initialize when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initStartupCards);
    } else {
        initStartupCards();
    }
</script>
