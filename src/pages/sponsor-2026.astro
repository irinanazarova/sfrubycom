---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import HashScroll from "../components/HashScroll.astro";
import EmailModal from "../components/EmailModal.astro";
import { palette } from "../design/tokens.mjs";
import "../styles/global.css";

// 2026 sponsorship tiers (hardcoded here on purpose — data/sponsors.js holds the
// historical 2025 tiers that the /sponsors-2025 archive page still renders).
const tiers2026 = [
    {
        name: "Pickaxe ⛏️",
        price: "$20,000",
        paymentLink: "https://buy.stripe.com/5kQ6oH8bi25Tacg4Ude7m07",
        description: "Premier sponsorship with maximum visibility and branding.",
        featured: true,
        benefits: [
            "Prominent logo placement on all conference materials",
            "Featured acknowledgment during opening and closing remarks",
            "Dedicated sponsor spotlight on social media",
            "Premium exhibition space",
            "Unlimited job postings on the SF Ruby job board for 12 months",
            "Bring up to 10 of your team to the conference",
        ],
    },
    {
        name: "Ruby",
        price: "$10,000",
        paymentLink: "https://buy.stripe.com/6oU5kD4Z68uhfwA5Yhe7m06",
        description:
            "High-visibility sponsorship with excellent branding opportunities.",
        benefits: [
            "Logo on conference website and printed materials",
            "Sponsor acknowledgment during opening remarks",
            "Social media recognition",
            "Exhibition space or branded gifts for attendees",
            "3 job postings on the SF Ruby job board",
            "Bring up to 5 of your team to the conference",
        ],
    },
    {
        name: "Emerald",
        price: "$4,000",
        paymentLink: "https://buy.stripe.com/cNi9AT3V24e10BG2M5e7m05",
        description: "Strong presence with quality branding and networking.",
        benefits: [
            "Logo on conference website and printed materials",
            "Sponsor acknowledgment during opening remarks",
            "Social media recognition",
            "1 job posting on the SF Ruby job board",
            "Bring up to 2 of your team to the conference",
        ],
    },
    {
        name: "Afterparty",
        price: null,
        description: "Exclusive sponsorship of the conference afterparty.",
        benefits: [
            "Exclusive branding at the afterparty",
            "Logo on conference website and printed materials",
            "Special acknowledgment during the afterparty",
            "Social media recognition",
            "Bring up to 10 of your team to the conference",
        ],
    },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Sponsor the SF Ruby Conference 2026 and connect with 450+ Ruby developers, founders, and engineers in San Francisco."
        />
        <meta name="theme-color" content={palette.ruby[600]} />
        <title>Sponsor SF Ruby 2026 - SF Ruby</title>

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta property="og:title" content="Sponsor SF Ruby 2026 - SF Ruby" />
        <meta
            property="og:description"
            content="Sponsor the SF Ruby Conference 2026 and connect with 450+ Ruby developers, founders, and engineers in San Francisco."
        />
        <meta property="og:image" content="https://sfruby.com/og/sponsor.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content="https://sfruby.com/og/sponsor.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Hero -->
            <section
                class="relative pt-32 pb-28 px-sky-grad-day text-white overflow-hidden"
            >
                <!-- blocky retro clouds -->
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-24 left-[14%] w-32 md:w-40 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-40 right-[10%] w-24 md:w-28 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />

                <div
                    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"
                >
                    <div class="text-center">
                        <h1
                            class="px-font px-shadow-ink text-xl md:text-3xl text-white mb-6"
                        >
                            Sponsor SF Ruby 2026
                        </h1>
                        <p class="text-xl text-white">
                            Connect with the Ruby community at our annual
                            conference and monthly meetups.
                        </p>
                    </div>
                </div>

                <!-- crenellated step into the white content below -->
                <div
                    class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:var(--white)]"
                    aria-hidden="true"
                >
                </div>
            </section>

            <!-- Content Section -->
            <section class="py-16 bg-white">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- 2025 Stats -->
                    <div
                        class="px-card bg-white p-8 mb-12"
                    >
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-6 text-center"
                        >
                            2026 in Numbers
                        </h2>
                        <div
                            class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center"
                        >
                            <div>
                                <div
                                    class="px-font text-xl md:text-2xl text-ruby-600"
                                >
                                    450+
                                </div>
                                <div class="text-gray-600 text-sm mt-1">
                                    Conference Attendees
                                </div>
                            </div>
                            <div>
                                <div
                                    class="px-font text-xl md:text-2xl text-ruby-600"
                                >
                                    18+
                                </div>
                                <div class="text-gray-600 text-sm mt-1">
                                    Speakers
                                </div>
                            </div>
                            <div>
                                <div
                                    class="px-font text-xl md:text-2xl text-ruby-600"
                                >
                                    2,400+
                                </div>
                                <div class="text-gray-600 text-sm mt-1">
                                    Subscribers
                                </div>
                            </div>
                            <div>
                                <div
                                    class="px-font text-xl md:text-2xl text-ruby-600"
                                >
                                    650+
                                </div>
                                <div class="text-gray-600 text-sm mt-1">
                                    Slack Members
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Why Sponsor -->
                    <div
                        class="px-card bg-white p-8 mb-12"
                    >
                        <h2 class="text-xl font-bold text-gray-900 mb-6">
                            Why Sponsor?
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                                >
                                    <svg
                                        class="w-5 h-5 text-ruby-600"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Targeted Audience
                                    </h3>
                                    <p class="text-gray-600 text-sm">
                                        Reach senior engineers and founders
                                        actively building with Ruby.
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                                >
                                    <svg
                                        class="w-5 h-5 text-ruby-600"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Hiring Pipeline
                                    </h3>
                                    <p class="text-gray-600 text-sm">
                                        Connect with Ruby talent at the
                                        conference and job board.
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                                >
                                    <svg
                                        class="w-5 h-5 text-ruby-600"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Community Support
                                    </h3>
                                    <p class="text-gray-600 text-sm">
                                        Support the Ruby ecosystem and show your
                                        commitment to the community.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2026 Sponsorship Tiers -->
                    <div class="mb-12">
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-6 text-center"
                        >
                            2026 Sponsorship Tiers
                        </h2>
                        <div class="grid sm:grid-cols-2 gap-6">
                            {
                                tiers2026.map((tier) => (
                                    <div
                                        class={`relative flex flex-col px-card p-8 ${tier.featured ? "bg-ruby-50" : "bg-white"}`}
                                    >
                                        {tier.featured && (
                                            <span class="absolute top-5 right-5 text-[11px] font-semibold uppercase tracking-wider text-ruby-600 bg-ruby-100 rounded-full px-2.5 py-1">
                                                Most visibility
                                            </span>
                                        )}
                                        <h3 class="text-lg font-bold text-gray-900">
                                            {tier.name}
                                        </h3>
                                        {tier.price && (
                                            <div class="px-font mt-2 text-lg md:text-xl text-ruby-600">
                                                {tier.price}
                                            </div>
                                        )}
                                        <p class="mt-3 text-sm text-gray-600">
                                            {tier.description}
                                        </p>
                                        <ul class="mt-5 space-y-2.5 flex-1">
                                            {tier.benefits.map((benefit) => (
                                                <li class="flex items-start gap-2.5 text-sm text-gray-700">
                                                    <svg
                                                        class="w-4 h-4 text-ruby-500 mt-0.5 flex-shrink-0"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M5 13l4 4L19 7"
                                                        />
                                                    </svg>
                                                    <span>{benefit}</span>
                                                </li>
                                            ))}
                                        </ul>
                                        <div class="mt-6 flex flex-wrap gap-3">
                                            <button
                                                data-email-modal="sponsor-2026"
                                                class="flex-1 px-btn px-btn--white px-font text-px9 gap-2 px-5 py-3 justify-center"
                                            >
                                                Contact
                                            </button>
                                            {tier.paymentLink && (
                                                <a
                                                    href={tier.paymentLink}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex-1 px-btn px-font text-px9 gap-2 px-5 py-3 bg-ruby-500 text-white hover:bg-ruby-400 text-center justify-center"
                                                >
                                                    Pay (Stripe)
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 2025 Sponsors -->
                    <div
                        class="px-card bg-white p-8 mb-12"
                    >
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-6 text-center"
                        >
                            2025 Sponsors
                        </h2>
                        <div
                            class="flex flex-wrap justify-center items-center gap-8 opacity-75"
                        >
                            <!-- Pickaxe tier -->
                            <img
                                src="/sponsor_chime.png"
                                alt="Chime"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_boltnew.png"
                                alt="Bolt.new"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_cisco.png"
                                alt="Cisco"
                                class="h-8 object-contain"
                            />
                            <!-- Ruby tier -->
                            <img
                                src="/sponsor_gusto.png"
                                alt="Gusto"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_temporal.png"
                                alt="Temporal"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_intercom.png"
                                alt="Intercom"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_omada.png"
                                alt="Omada"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_avo.png"
                                alt="Avo"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_thatch.png"
                                alt="Thatch"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_finta.png"
                                alt="Finta"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_angellist.png"
                                alt="AngelList"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_planetscale.png"
                                alt="PlanetScale"
                                class="h-8 object-contain"
                            />
                            <!-- Reception -->
                            <img
                                src="/sponsor_gitbutler.png"
                                alt="GitButler"
                                class="h-8 object-contain"
                            />
                            <!-- Travel -->
                            <img
                                src="/sponsor_tidewave.png"
                                alt="Tidewave AI"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_hackclub.png"
                                alt="Hack Club"
                                class="h-8 object-contain"
                            />
                            <img
                                src="/sponsor_ezcater.png"
                                alt="ezCater"
                                class="h-8 object-contain"
                            />
                        </div>
                        <p class="text-center text-gray-500 mt-6">and more</p>
                    </div>

                    <!-- Contact -->
                    <div
                        class="px-card bg-ruby-50 p-8 text-center"
                    >
                        <h2 class="text-xl font-bold text-gray-900 mb-4">
                            Questions, or want a custom package?
                        </h2>
                        <p class="text-gray-600 mb-6">
                            Tell us what you have in mind and we'll tailor a
                            sponsorship for 2026.
                        </p>
                        <button
                            data-email-modal="sponsor-2026"
                            class="px-btn px-font text-px10 md:text-xs gap-2 px-8 py-4 bg-gold-500 text-ink hover:bg-gold-400"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                            Get in touch
                        </button>
                    </div>
                </div>
            </section>
        </main>

        <EmailModal
            id="sponsor-2026"
            email="vicamelnikova@evilmartians.com"
            subject="SF Ruby 2026 Sponsorship"
            title="Sponsor SF Ruby 2026"
        />

        <Footer />
        <BottomNav />
        <HashScroll />
    </body>
</html>
