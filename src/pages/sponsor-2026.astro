---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import HashScroll from "../components/HashScroll.astro";
import EmailModal from "../components/EmailModal.astro";
import SponsorTiers from "../components/SponsorTiers.astro";
import { sponsors as sponsors2025 } from "../data/sponsors.js";
import { sponsorTiers2026, sponsorStats2026, whySponsor2026, SPONSOR_CONTACT } from "../data/sponsor-tiers-2026.js";
import { companies as attending, displayName } from "../data/attending.js";
import { markdownTwinFor } from "../lib/markdown-twins.js";
import { palette } from "../design/tokens.mjs";
import "../styles/global.css";

// Who has signed lives in data/sponsors.js: SponsorTiers reads the 2026 roster
// from it, and sponsors2025Count below counts the 2025 one. What a sponsorship
// costs is in data/sponsor-tiers-2026.js.
const sponsors2025Count = Object.keys(sponsors2025).length;

// Who has already bought tickets, from the same snapshot the homepage renders
// (companies with two or more ticket holders). For a sponsor deciding whether
// their hiring managers will meet anyone, this is the list that answers it.
const attendingCompanies = attending.map((c) => displayName(c.name));

---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Sponsor the San Francisco Ruby Conference 2026: two days of talks and a community day with 450 Ruby engineers from small teams and big companies, Nov 10-12 at SFJAZZ."
        />
        <meta name="theme-color" content={palette.ruby[600]} />
        <title>Sponsor the San Francisco Ruby Conference 2026 - SF Ruby</title>
        <link rel="alternate" type="text/markdown" href={markdownTwinFor(Astro.url.pathname)} />

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta property="og:title" content="Sponsor the San Francisco Ruby Conference 2026 - SF Ruby" />
        <meta
            property="og:description"
            content="Sponsor the San Francisco Ruby Conference 2026: two days of talks and a community day with 450 Ruby engineers from small teams and big companies, Nov 10-12 at SFJAZZ."
        />
        <meta property="og:image" content="https://sfruby.com/og/sponsor.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content="https://sfruby.com/og/sponsor.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Hero -->
            <section
                class="relative pt-32 pb-28 px-sky-grad-day text-white overflow-hidden"
            >
                <!-- blocky retro clouds -->
                <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-24 left-[10%] w-44 md:w-64 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-40 right-[10%] w-28 md:w-40 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />

                <div
                    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"
                >
                    <div class="text-center">
                        <h1
                            class="px-font px-shadow-ink text-xl md:text-3xl text-white mb-6"
                        >
                            Sponsor SF Ruby 2026
                        </h1>
                        <p class="text-xl text-white">
                            Three days in a room of engineers who read and write
                            Ruby, from the startups building on it and the
                            household names running it at scale, plus a monthly
                            meetup the rest of the year.
                        </p>
                    </div>
                </div>

                <!-- crenellated step into the white content below -->
                <div
                    class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:var(--white)]"
                    aria-hidden="true"
                >
                </div>
            </section>

            <!-- Content Section -->
            <section class="py-16 bg-white">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- 2026 in numbers -->
                    <div
                        class="px-card bg-white p-8 mb-12"
                    >
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-6 text-center"
                        >
                            2026 in Numbers
                        </h2>
                        <div
                            class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center"
                        >
                            {sponsorStats2026.map((s) => (
                                <div>
                                    <div class="px-font text-xl md:text-2xl text-ruby-600">
                                        {s.value}
                                    </div>
                                    <div class="text-gray-600 text-sm mt-1">
                                        {s.label}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {attendingCompanies.length > 0 && (
                        <div class="px-card bg-white p-8 mb-12">
                            <h2 class="px-font text-sm md:text-base text-gray-900 mb-3 text-center">
                                Who is in the room
                            </h2>
                            <p class="text-sm text-gray-600 text-center mb-6">
                                Companies with two or more ticket holders so far,
                                organizers and volunteers included.
                            </p>
                            <ul class="flex flex-wrap justify-center gap-2 list-none p-0">
                                {attendingCompanies.map((name) => (
                                    <li class="px-plate px-font text-px8 px-2.5 py-1.5">{name}</li>
                                ))}
                            </ul>
                        </div>
                    )}

                    <!-- Why Sponsor -->
                    <div
                        class="px-card bg-white p-8 mb-12"
                    >
                        <h2 class="text-xl font-bold text-gray-900 mb-6">
                            Why Sponsor?
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {whySponsor2026.map((r) => (
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                                    >
                                        <svg
                                            class="w-5 h-5 text-ruby-600"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d={r.icon}
                                            />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-gray-900">
                                            {r.title}
                                        </h3>
                                        <p class="text-gray-600 text-sm">
                                            {r.text}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- 2026 Sponsorship Tiers -->
                    <div class="mb-12">
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-6 text-center"
                        >
                            2026 Sponsorship Tiers
                        </h2>
                        <div class="grid sm:grid-cols-2 gap-6">
                            {
                                sponsorTiers2026.map((tier) => (
                                    <div
                                        class={`relative flex flex-col px-card p-8 ${tier.featured ? "bg-ruby-50" : "bg-white"}`}
                                    >
                                        {tier.featured && (
                                            <span class="absolute top-5 right-5 text-[11px] font-semibold uppercase tracking-wider text-ruby-600 bg-ruby-100 rounded-full px-2.5 py-1">
                                                Most visibility
                                            </span>
                                        )}
                                        <h3 class="text-lg font-bold text-gray-900">
                                            {tier.name}{tier.emoji && ` ${tier.emoji}`}
                                        </h3>
                                        {tier.price && (
                                            <div class="px-font mt-2 text-lg md:text-xl text-ruby-600">
                                                {tier.price}
                                            </div>
                                        )}
                                        <p class="mt-3 text-sm text-gray-600">
                                            {tier.description}
                                        </p>
                                        <ul class="mt-5 space-y-2.5 flex-1">
                                            {tier.benefits.map((benefit) => (
                                                <li class="flex items-start gap-2.5 text-sm text-gray-700">
                                                    <svg
                                                        class="w-4 h-4 text-ruby-500 mt-0.5 flex-shrink-0"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M5 13l4 4L19 7"
                                                        />
                                                    </svg>
                                                    <span>{benefit}</span>
                                                </li>
                                            ))}
                                        </ul>
                                        <div class="mt-6 flex flex-wrap gap-3">
                                            <button
                                                data-email-modal="sponsor-2026"
                                                class="flex-1 px-btn px-btn--white px-font text-px9 gap-2 px-5 py-3 justify-center"
                                            >
                                                Contact
                                            </button>
                                            {tier.paymentLink && (
                                                <a
                                                    href={tier.paymentLink}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex-1 px-btn px-font text-px9 gap-2 px-5 py-3 bg-ruby-500 text-white hover:bg-ruby-400 text-center justify-center"
                                                >
                                                    Pay (Stripe)
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                </div>

                <!-- The sponsor wall gets a wider column than the reading
                     copy above it, so a tier's logos stay on one row. -->
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- 2026 Sponsors -->
                    <!-- p-4 on phones: p-8 costs enough width that the Emerald
                         row drops to one card per screen. -->
                    <div class="px-card bg-white p-4 sm:p-8 mb-12">
                        <h2
                            class="px-font text-sm md:text-base text-gray-900 mb-2 text-center"
                        >
                            2026 Sponsors
                        </h2>
                        <p class="text-sm text-gray-500 mb-8 text-center">
                            The companies backing year two so far.
                        </p>
                        <SponsorTiers />
                        <p class="text-center text-sm text-gray-500 mt-8">
                            Year one had {sponsors2025Count} sponsors, Chime,
                            Bolt.new, Cisco, Gusto and Temporal among them: <a
                                href="/sponsors-2025"
                                class="text-ruby-600 underline underline-offset-2 hover:text-ruby-500"
                                >see the 2025 sponsors</a
                            >.
                        </p>
                    </div>

                </div>

                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- Contact -->
                    <div
                        class="px-card bg-ruby-50 p-8 text-center"
                    >
                        <h2 class="text-xl font-bold text-gray-900 mb-4">
                            Questions, or want a custom package?
                        </h2>
                        <p class="text-gray-600 mb-6">
                            Tell us what you have in mind and we'll tailor a
                            sponsorship for 2026.
                        </p>
                        <button
                            data-email-modal="sponsor-2026"
                            class="px-btn px-font text-px10 md:text-xs gap-2 px-8 py-4 bg-gold-500 text-ink hover:bg-gold-400"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                            Get in touch
                        </button>
                    </div>
                </div>
            </section>
        </main>

        <EmailModal
            id="sponsor-2026"
            email={SPONSOR_CONTACT.email}
            subject={SPONSOR_CONTACT.subject}
            title="Sponsor SF Ruby 2026"
        />

        <Footer />
        <BottomNav />
        <HashScroll />
    </body>
</html>
