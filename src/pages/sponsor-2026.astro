---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import HashScroll from "../components/HashScroll.astro";
import EmailModal from "../components/EmailModal.astro";
import SponsorTiers from "../components/SponsorTiers.astro";
import CompaniesAttending from "../components/CompaniesAttending.astro";
import { sponsors as sponsors2025 } from "../data/sponsors.js";
import { sponsorTiers2026, whySponsor2026, SPONSOR_CONTACT } from "../data/sponsor-tiers-2026.js";
import { markdownTwinFor } from "../lib/markdown-twins.js";
import { palette } from "../design/tokens.mjs";
import "../styles/global.css";

// Who has signed lives in data/sponsors.js: SponsorTiers reads the 2026 roster
// from it, and sponsors2025Count below counts the 2025 one. What a sponsorship
// costs is in data/sponsor-tiers-2026.js.
const sponsors2025Count = Object.keys(sponsors2025).length;

---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Sponsor the San Francisco Ruby Conference 2026: two days of talks and a community day with 450 Ruby engineers from small teams and big companies, Nov 10-12 at SFJAZZ."
        />
        <meta name="theme-color" content={palette.ruby[600]} />
        <title>Sponsor the San Francisco Ruby Conference 2026 - SF Ruby</title>
        <link rel="alternate" type="text/markdown" href={markdownTwinFor(Astro.url.pathname)} />

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta property="og:title" content="Sponsor the San Francisco Ruby Conference 2026 - SF Ruby" />
        <meta
            property="og:description"
            content="Sponsor the San Francisco Ruby Conference 2026: two days of talks and a community day with 450 Ruby engineers from small teams and big companies, Nov 10-12 at SFJAZZ."
        />
        <meta property="og:image" content="https://sfruby.com/og/sponsor.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content="https://sfruby.com/og/sponsor.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Hero -->
            <section
                class="relative pt-32 pb-28 px-sky-grad-day text-white overflow-hidden"
            >
                <!-- blocky retro clouds -->
                <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-20 -left-6 sm:left-0 w-28 sm:w-36 md:w-48 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute bottom-16 -right-6 sm:right-0 w-20 sm:w-24 md:w-32 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />

                <div
                    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10"
                >
                    <div class="text-center">
                        <h1
                            class="px-font px-shadow-ink text-xl md:text-3xl text-white mb-6"
                        >
                            Sponsor SF Ruby 2026
                        </h1>
                        <p class="max-w-2xl mx-auto text-xl text-white">
                            Get in front of 450 Ruby engineers and founders
                            at SFJAZZ on Nov 10-11
                        </p>
                        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
                            <a
                                href="#tiers"
                                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
                            >
                                Become a sponsor
                            </a>
                            <button
                                data-email-modal="sponsor-2026"
                                class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
                            >
                                Get in touch
                            </button>
                        </div>
                    </div>
                </div>

                <!-- crenellated step into the white content below -->
                <div
                    class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:var(--white)]"
                    aria-hidden="true"
                >
                </div>
            </section>

            <!-- Content Section -->
            <section class="py-16 bg-white">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- 2026 Sponsorship Tiers -->
                    <div id="tiers" class="mb-12 scroll-mt-24">
                        <div class="grid sm:grid-cols-2 gap-6">
                            {
                                sponsorTiers2026.map((tier) => (
                                    <div
                                        class={`relative flex flex-col px-card p-8 ${tier.featured ? "bg-ruby-50" : "bg-white"}`}
                                    >
                                        {tier.label && (
                                            <span class="absolute top-5 right-5 text-[11px] font-semibold uppercase tracking-wider text-ruby-600 bg-ruby-100 rounded-full px-2.5 py-1">
                                                {tier.label}
                                            </span>
                                        )}
                                        <h3 class="text-lg font-bold text-gray-900">
                                            {tier.name}{tier.emoji && ` ${tier.emoji}`}
                                        </h3>
                                        {tier.price && (
                                            <div class="px-font mt-2 text-lg md:text-xl text-ruby-600">
                                                {tier.price}
                                            </div>
                                        )}
                                        <p class="mt-3 text-sm text-gray-600">
                                            {tier.description}
                                        </p>
                                        <ul class="mt-5 space-y-2.5 flex-1">
                                            {tier.benefits.map((benefit) => (
                                                <li class="flex items-start gap-2.5 text-sm text-gray-700">
                                                    <svg
                                                        class="w-4 h-4 text-ruby-500 mt-0.5 flex-shrink-0"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M5 13l4 4L19 7"
                                                        />
                                                    </svg>
                                                    <span>{benefit}</span>
                                                </li>
                                            ))}
                                        </ul>
                                        <div class="mt-6 flex flex-wrap gap-3">
                                            <button
                                                data-email-modal="sponsor-2026"
                                                class="flex-1 px-btn px-btn--white px-font text-px9 gap-2 px-5 py-3 justify-center"
                                            >
                                                Contact
                                            </button>
                                            {tier.paymentLink && (
                                                <a
                                                    href={tier.paymentLink}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex-1 px-btn px-font text-px9 gap-2 px-5 py-3 bg-ruby-500 text-white hover:bg-ruby-400 text-center justify-center"
                                                >
                                                    Pay (Stripe)
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Why Sponsor -->
                    <div
                        id="why-sponsor"
                        class="px-card bg-white p-8 mb-12 scroll-mt-24"
                    >
                        <h2 class="text-xl font-bold text-gray-900 mb-6">
                            Why Sponsor?
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {whySponsor2026.map((r) => (
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                                    >
                                        <svg
                                            class="w-5 h-5 text-ruby-600"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d={r.icon}
                                            />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-gray-900">
                                            {r.title}
                                        </h3>
                                        <p class="text-gray-600 text-sm">
                                            {r.text}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                </div>

                <!-- The sponsor wall gets a wider column than the reading
                     copy above it, so a tier's logos stay on one row. -->
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- 2026 Sponsors -->
                    <!-- p-4 on phones: p-8 costs enough width that the Emerald
                         row drops to one card per screen. -->
                    <div class="px-card bg-white p-4 sm:p-8 mb-12">
                        <h2 class="text-xl font-bold text-gray-900 mb-8 text-center">
                            SF Ruby 2026 is possible thanks to
                        </h2>
                        <SponsorTiers />
                        <p class="text-center text-sm text-gray-500 mt-8">
                            SF Ruby 2025 was sold out.<br /> <a
                                href="/sponsors-2025"
                                class="text-ruby-600 underline underline-offset-2 hover:text-ruby-500"
                                >{sponsors2025Count} sponsors</a
                            > including Chime, bolt.new, Cisco, Gusto and
                            Temporal made it possible.
                        </p>
                    </div>

                </div>

                <!-- Closing ask: the tiers above are the menu, this is for
                     anything that is not on it. -->
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 flex justify-center">
                    <button
                        data-email-modal="sponsor-2026"
                        class="px-btn px-btn--gold px-font text-px8 sm:text-px10 md:text-xs px-6 py-5 sm:px-10 tap-press text-center leading-relaxed [text-wrap:balance] max-w-full"
                    >
                        Have a sponsorship idea? Get in touch
                    </button>

            </section>

            <CompaniesAttending
                eyebrow={null}
                cta={false}
                subtitle={null}
            />
        </main>

        <EmailModal
            id="sponsor-2026"
            email={SPONSOR_CONTACT.email}
            subject={SPONSOR_CONTACT.subject}
            title="Email us about sponsoring"
            lede={null}
            showSubject={false}
        />

        <Footer />
        <BottomNav />
        <HashScroll />
    </body>
</html>
