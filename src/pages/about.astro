            { 
                name: "Stanford University", 
                description: "Indoor museums (Cantor Arts, Anderson Collection) and covered walkways",
                image: "https://images.pexels.com/photos/207692/pexels-photo-207692.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Stanford University campus with historic architecture and palm trees"
            },
            { 
                name: "Computer History Museum", 
                description: "Indoor tech museum in Mountain View, accessible via covered Caltrain",
                image: "https://images.pexels.com/photos/2582937/pexels-photo-2582937.jpeg?auto=compress&cs=tinysrgb&w=800",
