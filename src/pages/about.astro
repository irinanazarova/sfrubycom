---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About - San Francisco Ruby Conference 2025" description="Everything you need to know about attending the San Francisco Ruby Conference 2025, including venue info, accommodations, dining, and things to do in SF.">
    <!-- Hero Section -->
    <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center mb-4">
                Welcome to the San Francisco Ruby Conference
            </h1>
            <p class="text-xl text-center max-w-3xl mx-auto">
                Join us in the city where Ruby startups are born and thrive
            </p>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
        
        <!-- 1. Mark Your Calendars -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">1) Mark Your Calendars</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white border border-ruby-200 rounded-lg p-6">
                    <h3 class="font-bold text-ruby-600 text-lg mb-2">Official Conference Days</h3>
                    <p class="text-dark-900 font-medium mb-2">November 19-20, 2025</p>
                    <p class="text-dark-600 text-sm mb-3">9:00 AM - 6:00 PM each day</p>
                    <p class="text-dark-600 text-sm">Plus evening after-party events and networking opportunities</p>
                </div>
                <div class="bg-white border border-sky-200 rounded-lg p-6">
                    <h3 class="font-bold text-sky-600 text-lg mb-2">Community Day</h3>
                    <p class="text-dark-900 font-medium mb-2">November 21, 2025</p>
                    <p class="text-dark-600 text-sm mb-3">Unofficial community activities</p>
                    <p class="text-dark-600 text-sm">Indoor meetups, museum visits, cozy gatherings, and more</p>
                </div>
            </div>
        </section>

        <!-- 2. Plan Your Local Commute -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">2) Plan Your Local Commute</h2>
            <div class="bg-dark-50 rounded-lg p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">🚌 Public Transit</h3>
                        <ul class="space-y-2 text-dark-600">
                            <li><strong>Muni:</strong> Lines 28, 30, 43 to Lombard St</li>
                            <li><strong>Cable Car:</strong> Hyde-Powell line to Aquatic Park</li>
                            <li><strong>From BART:</strong> Embarcadero → Muni 30</li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">🚗 Rideshare & Parking</h3>
                        <ul class="space-y-2 text-dark-600">
                            <li><strong>Waymo:</strong> Driverless rides available</li>
                            <li><strong>Uber/Lyft:</strong> Drop-off at Marina Blvd entrance</li>
                            <li><strong>Parking:</strong> On-site lots available ($15-20/day)</li>
                        </ul>
                    </div>
                </div>
                <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h4 class="font-medium text-blue-800 mb-2">💳 Clipper Card</h4>
                    <p class="text-blue-700 text-sm">
                        Get a Clipper card for easy payment on all Bay Area transit. Available at stations or use your phone with Apple/Google Pay.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Plan Deliciousness -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">3) Plan Deliciousness</h2>
            
            <!-- At the Venue -->
            <div class="mb-8">
                <h3 class="font-bold text-lg text-dark-900 mb-4">🏢 At the Venue</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white border rounded-lg p-4">
                        <h4 class="font-medium text-dark-900 mb-2">☕ Equator Coffee</h4>
                        <p class="text-dark-600 text-sm mb-2">Daily 7:00 AM - 4:00 PM</p>
                        <p class="text-dark-600 text-sm mb-3">Espresso $3, Latte $5, Pastries $4-6</p>
                        <a href="https://maps.google.com/?q=Equator+Coffee+Fort+Mason+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600 text-sm">📍 View on Map</a>
                    </div>
                    <div class="bg-white border rounded-lg p-4">
                        <h4 class="font-medium text-dark-900 mb-2">🍽️ Radhaus</h4>
                        <p class="text-dark-600 text-sm mb-2">Breakfast, Lunch, Dinner</p>
                        <p class="text-dark-600 text-sm mb-3">Sandwiches $12-16, Salads $14-18</p>
                        <a href="https://maps.google.com/?q=Radhaus+Fort+Mason+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600 text-sm">📍 View on Map</a>
                    </div>
                    <div class="bg-white border rounded-lg p-4">
                        <h4 class="font-medium text-dark-900 mb-2">🍸 The Interval</h4>
                        <p class="text-dark-600 text-sm mb-2">Bar & Café</p>
                        <p class="text-dark-600 text-sm mb-3">Cocktails $12-16, Wine $8-14</p>
                        <a href="https://maps.google.com/?q=The+Interval+Fort+Mason+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600 text-sm">📍 View on Map</a>
                    </div>
                </div>
            </div>

            <!-- Close By (20 min walk) -->
            <div class="mb-8">
                <h3 class="font-bold text-lg text-dark-900 mb-4">🚶 Close By (20-minute walk)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-medium text-dark-900 mb-3">🥞 Breakfast</h4>
                        <div class="space-y-3">
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Reveille Coffee</p>
                                        <p class="text-dark-600 text-sm">Artisan coffee & pastries</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Reveille+Coffee+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Cracked & Buttered</p>
                                        <p class="text-dark-600 text-sm">Gourmet breakfast sandwiches</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Cracked+Buttered+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-medium text-dark-900 mb-3">🍜 Lunch</h4>
                        <div class="space-y-3">
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Komeya no Bento</p>
                                        <p class="text-dark-600 text-sm">Authentic Japanese bento boxes</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Komeya+no+Bento+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Hinodeya Ramen</p>
                                        <p class="text-dark-600 text-sm">Traditional tonkotsu ramen</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Hinodeya+Ramen+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Marufuku Ramen</p>
                                        <p class="text-dark-600 text-sm">Hakata-style ramen specialist</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Marufuku+Ramen+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <h4 class="font-medium text-dark-900 mb-3">🍷 Bar</h4>
                    <div class="bg-white border rounded-lg p-3 max-w-md">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="font-medium text-dark-900">Bar Darling</p>
                                <p class="text-dark-600 text-sm">Craft cocktails & natural wines</p>
                            </div>
                            <a href="https://maps.google.com/?q=Bar+Darling+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- In the Area (up to 40 min walk) -->
            <div>
                <h3 class="font-bold text-lg text-dark-900 mb-4">🌆 In the Area (up to 40-minute walk)</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <h4 class="font-medium text-dark-900 mb-3">☕ Coffee</h4>
                        <div class="space-y-3">
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Coffee Movement</p>
                                        <p class="text-dark-600 text-sm">Third-wave specialty coffee</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Coffee+Movement+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Blue Bottle Coffee</p>
                                        <p class="text-dark-600 text-sm">Famous for their hot waffle!</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Blue+Bottle+Coffee+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-medium text-dark-900 mb-3">🥞 Breakfast</h4>
                        <div class="space-y-3">
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Camino Alto</p>
                                        <p class="text-dark-600 text-sm">Elevated brunch experience</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Camino+Alto+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Mama's on Washington</p>
                                        <p class="text-dark-600 text-sm">Famous French toast</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Mama's+Washington+Square+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-medium text-dark-900 mb-3">🍽️ Lunch & Dinner</h4>
                        <div class="space-y-3">
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Swan Oyster Depot</p>
                                        <p class="text-dark-600 text-sm">Historic seafood counter</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Swan+Oyster+Depot+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">Tony's Little Star</p>
                                        <p class="text-dark-600 text-sm">Deep-dish pizza legend</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=Tony's+Little+Star+Pizza+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                            <div class="bg-white border rounded-lg p-3">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-medium text-dark-900">State Bird Provisions</p>
                                        <p class="text-dark-600 text-sm">Michelin-starred dim sum</p>
                                    </div>
                                    <a href="https://maps.google.com/?q=State+Bird+Provisions+San+Francisco" target="_blank" class="text-ruby-500 hover:text-ruby-600">📍</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. Plan Your Trip to SF -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">4) Plan Your Trip to SF</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">📅 Suggested Dates</h3>
                    <div class="bg-white border rounded-lg p-4 mb-6">
                        <p class="font-medium text-dark-900 mb-2">November 18-22, 2025</p>
                        <p class="text-dark-600 text-sm">Arrive Monday, depart Saturday for the full experience including Community Day activities</p>
                    </div>

                    <h3 class="font-bold text-lg text-dark-900 mb-4">🏨 Book Your Stay</h3>
                    <div class="space-y-3">
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">Near Venue (Marina/Fisherman's Wharf)</p>
                            <p class="text-dark-600 text-sm">Hotel Zoe ($121/night), Argonaut Hotel ($238/night)</p>
                        </div>
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">Downtown (Union Square)</p>
                            <p class="text-dark-600 text-sm">Chancellor Hotel ($99/night), The Marker ($114/night)</p>
                        </div>
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">Budget Options</p>
                            <p class="text-dark-600 text-sm">Golden Gate Hotel ($84/night), Airbnb apartments</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">✈️ Book Your Flights</h3>
                    <div class="space-y-3 mb-6">
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">San Francisco (SFO)</p>
                            <p class="text-dark-600 text-sm">Main airport, BART connection to city ($11.15)</p>
                        </div>
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">Oakland (OAK)</p>
                            <p class="text-dark-600 text-sm">Often cheaper, BART connection available</p>
                        </div>
                    </div>

                    <h3 class="font-bold text-lg text-dark-900 mb-4">🚗 From the Airport</h3>
                    <div class="space-y-2">
                        <div class="flex justify-between items-center bg-white border rounded-lg p-3">
                            <span class="text-dark-900">BART (Public Transit)</span>
                            <span class="text-green-600 font-medium">$11.15</span>
                        </div>
                        <div class="flex justify-between items-center bg-white border rounded-lg p-3">
                            <span class="text-dark-900">Uber/Lyft</span>
                            <span class="text-amber-600 font-medium">$60-80</span>
                        </div>
                        <div class="flex justify-between items-center bg-white border rounded-lg p-3">
                            <span class="text-dark-900">Waymo (Driverless)</span>
                            <span class="text-blue-600 font-medium">~$65</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h4 class="font-medium text-blue-800 mb-2">🎫 Getting a Local Transport Card</h4>
                    <p class="text-blue-700 text-sm">Download the Clipper app or add to Apple/Google Wallet. Works on all Bay Area transit systems.</p>
                </div>
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <h4 class="font-medium text-amber-800 mb-2">👕 Plan Your Wardrobe</h4>
                    <p class="text-amber-700 text-sm mb-2"><strong>Weather:</strong> 60°F/15°C highs, possible light rain</p>
                    <p class="text-amber-700 text-sm"><strong>Pack:</strong> Layers (tee + hoodie + rain jacket), comfortable shoes, hiking boots for weekend adventures!</p>
                </div>
            </div>
        </section>

        <!-- 5. Plan Routes Around SF -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">5) Plan Routes Around SF</h2>
            
            <div class="space-y-6">
                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <h3 class="font-bold text-dark-900 mb-3">🌉 Fort Mason to Crissy Field Walk</h3>
                    <p class="text-dark-600 text-sm mb-3">
                        Walk from the venue to Crissy Field for Golden Gate Bridge views. Grab a bite from food trucks, 
                        then find the hidden Yoda statue in the Presidio. Perfect for conference breaks!
                    </p>
                    <div class="flex items-center text-dark-500 text-sm">
                        <span class="mr-4">⏱️ 30-45 minutes</span>
                        <span>🚶 Easy walk</span>
                    </div>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <h3 class="font-bold text-dark-900 mb-3">🌳 Golden Gate Park to Ocean Beach</h3>
                    <p class="text-dark-600 text-sm mb-3">
                        Explore Golden Gate Park (museums, bison paddock, boat rentals at Stow Lake), 
                        then walk to Ocean Beach and Sunset Dunes Park. Indoor museum options if weather turns.
                    </p>
                    <div class="flex items-center text-dark-500 text-sm">
                        <span class="mr-4">⏱️ Half day</span>
                        <span>🚌 Muni accessible</span>
                    </div>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <h3 class="font-bold text-dark-900 mb-3">🌲 Muir Woods Adventure</h3>
                    <p class="text-dark-600 text-sm mb-3">
                        Uber to Muir Woods ($40-50), hike among the redwoods, then walk down to Mill Valley for lunch. 
                        Take the Golden Gate Transit bus back to SF. Covered trails perfect for light rain!
                    </p>
                    <div class="flex items-center text-dark-500 text-sm">
                        <span class="mr-4">⏱️ Full day</span>
                        <span>🥾 Moderate hiking</span>
                    </div>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <h3 class="font-bold text-dark-900 mb-3">🎓 Stanford University Day Trip</h3>
                    <p class="text-dark-600 text-sm mb-3">
                        Take Caltrain to Stanford. Visit two free art museums (Cantor Arts Center, Anderson Collection), 
                        lunch at Treehouse, then hike the Dish Trail. Dinner in Palo Alto before returning.
                    </p>
                    <div class="flex items-center text-dark-500 text-sm">
                        <span class="mr-4">⏱️ Full day</span>
                        <span>🚂 Caltrain $7-15</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. Get Involved -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">6) Get Involved</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-purple-50 border border-purple-200 rounded-lg p-6 text-center">
                    <div class="text-4xl mb-4">🎉</div>
                    <h3 class="font-bold text-dark-900 mb-3">Host a Community Day Event</h3>
                    <p class="text-dark-600 text-sm mb-4">
                        Organize a walk, indoor meetup, museum tour, or cozy gathering for November 21. 
                        We'll help promote it!
                    </p>
                    <a href="/contact" class="inline-block px-4 py-2 bg-purple-500 text-white rounded-md text-sm font-medium hover:bg-purple-600 transition-colors">
                        Propose an Event
                    </a>
                </div>

                <div class="bg-green-50 border border-green-200 rounded-lg p-6 text-center">
                    <div class="text-4xl mb-4">🙋‍♀️</div>
                    <h3 class="font-bold text-dark-900 mb-3">Volunteer to Help</h3>
                    <p class="text-dark-600 text-sm mb-4">
                        Help with registration, speaker support, logistics, or community activities. 
                        Great way to meet people!
                    </p>
                    <a href="/contact" class="inline-block px-4 py-2 bg-green-500 text-white rounded-md text-sm font-medium hover:bg-green-600 transition-colors">
                        Volunteer
                    </a>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 text-center">
                    <div class="text-4xl mb-4">🏢</div>
                    <h3 class="font-bold text-dark-900 mb-3">Bring Your Company</h3>
                    <p class="text-dark-600 text-sm mb-4">
                        Help your company sponsor the conference and connect with the Ruby community. 
                        Multiple sponsorship tiers available.
                    </p>
                    <a href="/sponsors" class="inline-block px-4 py-2 bg-blue-500 text-white rounded-md text-sm font-medium hover:bg-blue-600 transition-colors">
                        Learn About Sponsoring
                    </a>
                </div>
            </div>

            <div class="mt-8 bg-gradient-to-r from-ruby-50 to-sky-50 border border-ruby-200 rounded-lg p-6">
                <h4 class="font-bold text-dark-900 mb-3">💡 November-Friendly Community Day Ideas</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <ul class="space-y-1 text-dark-600">
                        <li>• Indoor coding workshops or hackathons</li>
                        <li>• Coffee shop meetups and tech talks</li>
                        <li>• Museum visits (Exploratorium, Computer History Museum)</li>
                        <li>• Food tours with indoor stops</li>
                    </ul>
                    <ul class="space-y-1 text-dark-600">
                        <li>• Wine tasting in heated venues</li>
                        <li>• Tech company office tours</li>
                        <li>• Covered market visits (Ferry Building)</li>
                        <li>• Board game cafes and indoor activities</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="text-center bg-gradient-to-r from-ruby-500 to-ruby-700 text-white rounded-lg p-8">
            <h2 class="text-2xl font-display font-bold mb-4">Ready to Join Us in San Francisco?</h2>
            <p class="text-lg mb-6 max-w-2xl mx-auto">
                We can't wait to welcome you to the city where Ruby startups are born and thrive. 
                See you at Fort Mason this November!
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a 
                    href="https://lu.ma/sfrubyconf2025"
                    target="_blank"
                    class="inline-flex items-center justify-center px-8 py-3 bg-white text-ruby-600 rounded-md font-medium shadow-md transition-all duration-300 transform hover:scale-105"
                >
                    Get Your Tickets
                </a>
                <a 
                    href="#newsletter"
                    class="inline-flex items-center justify-center px-8 py-3 bg-transparent border border-white text-white rounded-md font-medium transition-all duration-300 transform hover:scale-105"
                >
                    Stay Updated
                </a>
            </div>
