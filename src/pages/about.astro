---
import Layout from '../layouts/Layout.astro';

---

<Layout title="About - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">About</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        San Francisco Ruby Conference 2025
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="bg-dark-50 rounded-lg p-8">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-6"></h2>
      
      <div class="space-y-4">
        Join us this November at San Francisco's historic Fort Mason. The conference runs November 19-20, with unofficial community events—like hiking and picnics—on Friday, November 21. Mark your calendars and be part of something special!


      </div>
    </div>

    <div class="mt-16 text-center">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-4"></h2>
      <p class="text-dark-600 mb-2">smth</p>
      <p class="text-dark-600"></p>
    </div>
  </div>
</Layout>