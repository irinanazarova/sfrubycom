---
import Layout from "../layouts/Layout.astro";
import DistanceBadge from "../components/DistanceBadge.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
---

<Layout
    title="About - San Francisco Ruby Conference 2025"
    description="Everything you need to know about attending the San Francisco Ruby Conference 2025, including venue info, accommodations, and things to do in SF."
>
    <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Welcome
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Join us in the city where Ruby startups are born and thrive
            </p>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
        <!-- 1. Mark Your Calendars -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Mark Your Calendars
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="bg-white border border-ruby-200 rounded-lg p-6">
                    <h3 class="font-bold text-ruby-600 text-lg mb-2">
                        Official Conference Days
                    </h3>
                    <p class="text-dark-900 font-medium mb-2">
                        November 19-20, 2025
                    </p>
                    <p class="text-dark-600 text-sm mb-3">
                        9:00 AM - 6:00 PM each day
                    </p>
                    <p class="text-dark-600 text-sm">Plus evening events</p>
                </div>
                <div class="bg-white border border-sky-200 rounded-lg p-6">
                    <h3 class="font-bold text-sky-600 text-lg mb-2">
                        Community Day
                    </h3>
                    <p class="text-dark-900 font-medium mb-2">
                        November 21, 2025
                    </p>
                    <p class="text-dark-600 text-sm mb-3">
                        Community activities
                    </p>
                    <p class="text-dark-600 text-sm">
                        Indoor meetups, museum visits, cozy gatherings, and more
                    </p>
                </div>
            </div>

            <!-- Venue Information -->
            <div
                class="bg-white border border-dark-200 rounded-lg overflow-hidden"
            >
                <div class="grid grid-cols-1 md:grid-cols-2">
                    <!-- Venue Photo -->
                    <div class="h-48 md:h-auto">
                        <img
                            src="/about_venue.jpg"
                            alt="Photo of Fort Mason Center waterfront view"
                            class="w-full h-full object-cover"
                            loading="lazy"
                        />
                    </div>

                    <!-- Venue Details -->
                    <div class="p-6">
                        <h3 class="font-bold text-dark-900 text-lg mb-3">
                            📍 Venue: Fort Mason Center for Arts & Culture
                        </h3>
                        <p class="text-dark-900 font-medium mb-2">
                            2 Marina Blvd, San Francisco, CA 94123
                        </p>
                        <p class="text-dark-600 text-sm mb-4">
                            Historic waterfront venue in the Golden Gate
                            National Recreation Area.
                        </p>
                        <a
                            href="https://maps.google.com/?q=Fort+Mason+Center+San+Francisco"
                            target="_blank"
                            class="inline-flex items-center px-4 py-2 bg-sky-500 text-white rounded-md font-medium hover:bg-sky-600 transition-colors"
                        >
                            📍 View on Map
                        </a>
                    </div>
                </div>
            </div>

            <!-- Venue Map -->
            <div class="mt-6 border border-dark-200 rounded-lg overflow-hidden">
                <img
                    src="/venue-map.png"
                    alt="Venue map: Fort Mason Center for Arts & Culture"
                    class="w-full h-auto"
                    loading="lazy"
                />
            </div>
        </section>

        <!-- 2. Plan Your Local Commute -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Plan Your Local Commute
            </h2>

            <div class="bg-dark-50 rounded-lg p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">
                            🚌 Public Transit
                        </h3>
                        <ul class="space-y-2 text-dark-600">
                            <li>
                                <strong>Muni:</strong> Lines 28, 30, 43 to Lombard
                                St
                            </li>
                            <li>
                                <strong>Cable Car:</strong> Hyde-Powell line to Aquatic
                                Park
                            </li>
                            <li>
                                <strong>From BART:</strong> Embarcadero → Muni 30
                            </li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">
                            🚗 Rideshare & Parking
                        </h3>
                        <ul class="space-y-2 text-dark-600">
                            <li>
                                <strong>Waymo:</strong> Driverless rides available.
                                Install Waymo app. Only US app store
                            </li>
                            <li>
                                <strong>Uber/Lyft:</strong> Drop-off at Marina Blvd
                                entrance
                            </li>
                            <li>
                                <strong>Parking:</strong> On-site lots available
                                ($15-20/day)
                            </li>
                        </ul>
                    </div>
                </div>
                <div
                    class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4"
                >
                    <h4 class="font-medium text-blue-800 mb-2">
                        💳 Clipper Card
                    </h4>
                    <p class="text-blue-700 text-sm">
                        Use Clipper card to pay for all Bay Area public transit,
                        including BART, Muni, Caltrain. Available <a
                            href="https://www.clippercard.com/ClipperWeb/pay-with-phone"
                            target="_blank"
                            class="underline">on your phone</a
                        >
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Dining Options -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-display font-bold text-dark-900">
                    Dining Options
                </h2>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 bg-gray-50 border border-dark-200 rounded-lg gap-6 mb-6"
            >
                <div class="flex items-center gap-2 md:col-span-3 p-6 pb-0">
                    <h3 class="font-bold text-dark-900">Food Trucks Onsite</h3>
                    <DistanceBadge distance="0 min" type="walk" color="green" />
                </div>

                <div class="px-6">
                    <p class="text-dark-600 text-sm mb-3">
                        <strong>Cielito Lindo</strong>
                    </p>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>• Taco Plate $13.99</li>
                        <li>• Burrito Bowl $15.99</li>
                        <li>• Baja Fish Tacos $15.99</li>
                    </ul>
                </div>

                <div class="px-6">
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>• Dim Sum Platter $16.00</li>
                        <li>• Vegetable Chow Mein $14.00</li>
                        <li>• General Chicken Rice $14.00</li>
                    </ul>
                </div>

                <div class="px-6">
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>• Power Rice Bowl $18.00</li>
                        <li>• Power Wrap $17.00</li>
                        <li>• Mediterranean Salad $17.00</li>
                    </ul>
                </div>

                <div class="flex items-center gap-2 md:col-span-3 p-6 pt-0">
                    <a
                        href="/food-truck-menu.pdf"
                        target="_blank"
                        rel="noopener"
                        class="underline">See the menu</a
                    >
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">
                            Next to the Venue
                        </h3>
                        <DistanceBadge
                            distance="2-5 min"
                            type="walk"
                            color="purple"
                        />
                    </div>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>
                            • <strong>Equator Coffee:</strong> Latte $4.75, Breakfast
                            sandwich $9.75
                        </li>
                        <li>
                            • <strong>Radhaus:</strong> Bratwurst $23, potato pancakes
                            $15.
                        </li>
                        <li>
                            • <strong>The Interval:</strong> Cocktails, wine
                        </li>
                    </ul>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">Close By</h3>
                        <DistanceBadge
                            distance="5-20 min"
                            type="walk"
                            color="blue"
                        />
                    </div>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>
                            • <strong>Cracked & Buttered:</strong> Zesty Ricotta
                            Pancakes $15
                        </li>
                        <li>
                            • <strong>Komeya no Bento:</strong> Duck breast bento
                            $16.95
                        </li>
                        <li>
                            • <strong>Marufuku Ramen:</strong> Vegetable ramen $17
                        </li>
                    </ul>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">In the Area</h3>
                        <DistanceBadge
                            distance="20-40 min"
                            type="walk"
                            color="amber"
                        />
                    </div>
                    <ul class="space-y-2 text-dark-600 text-sm">
                        <li>
                            • <strong>Blue Bottle:</strong> Famous hot waffle
                        </li>
                        <li>
                            • <strong>Flores San Francisco:</strong> traditional
                            Mexican cuisine
                        </li>
                        <li>
                            • <strong>little shucker:</strong> oysters, raw bar and
                            wine
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 4. Plan Your Trip to SF -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Plan Your Trip to SF
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">
                        📅 Suggested Dates
                    </h3>
                    <div class="bg-white border rounded-lg p-4 mb-6">
                        <p class="font-medium text-dark-900 mb-2">
                            November 18-22, 2025
                        </p>
                        <p class="text-dark-600 text-sm">
                            Arrive Monday, depart Saturday for the full
                            experience including Community Day activities
                        </p>
                    </div>

                    <h3 class="font-bold text-lg text-dark-900 mb-4">
                        🏨 Book Your Stay
                    </h3>
                    <div class="space-y-3">
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">
                                What to book
                            </p>
                            <p class="text-dark-600 text-sm">
                                We recommend booking an Airbnb or hotel in one
                                of the following areas: Nob Hill, North Beach,
                                Lombard Street or Downtown. Places like Inner
                                Sunset work great as well.
                            </p>
                        </div>
                    </div>

                    <!-- Safety Note -->
                    <div
                        class="mt-6 bg-amber-50 border border-amber-200 rounded-lg p-4"
                    >
                        <h4 class="font-medium text-amber-800 mb-2">
                            🛡️ Accommodation Safety Note
                        </h4>
                        <p class="text-amber-700 text-sm">
                            For your safety, strictly avoid accommodations in
                            the Tenderloin. For your comfort please also avoid
                            Civic Center, and SOMA.
                        </p>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-lg text-dark-900 mb-4">
                        ✈️ Book Your Flights
                    </h3>
                    <div class="space-y-3 mb-6">
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">
                                San Francisco (SFO)
                            </p>
                            <p class="text-dark-600 text-sm">
                                Main airport, BART connection to city ($11.15)
                            </p>
                        </div>
                        <div class="bg-white border rounded-lg p-3">
                            <p class="font-medium text-dark-900">
                                Oakland (OAK)
                            </p>
                            <p class="text-dark-600 text-sm">
                                Often cheaper, BART connection available
                            </p>
                        </div>
                    </div>

                    <h3 class="font-bold text-lg text-dark-900 mb-4">
                        🚗 From the Airport
                    </h3>
                    <div class="space-y-2 mb-6">
                        <div
                            class="flex justify-between items-center bg-white border rounded-lg p-3"
                        >
                            <span class="text-dark-900"
                                >BART (Public Transit)</span
                            >
                            <span class="text-green-600 font-medium"
                                >$11.15</span
                            >
                        </div>
                        <div
                            class="flex justify-between items-center bg-white border rounded-lg p-3"
                        >
                            <span class="text-dark-900">Uber/Lyft</span>
                            <span class="text-amber-600 font-medium"
                                >$60-80</span
                            >
                        </div>
                        <!--<div
                            class="flex justify-between items-center bg-white border rounded-lg p-3">
                            <span class="text-dark-900">Waymo (Driverless)</span
                            >
                            <span class="text-blue-600 font-medium">~$65</span>
                        </div>-->
                    </div>

                    <!-- Weather Widget -->
                    <WeatherWidget />
                </div>
            </div>
        </section>

        <!-- 5. Plan Routes Around SF -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Plan Your Stay in SF
            </h2>

            <div class="space-y-6">
                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">
                            🌉 Fort Mason to Crissy Field Walk
                        </h3>
                        <DistanceBadge
                            distance="30-45 min"
                            type="time"
                            color="green"
                        />
                        <DistanceBadge
                            distance="Easy walk"
                            type="walk"
                            color="blue"
                        />
                    </div>
                    <p class="text-dark-600 text-sm">
                        Walk from the venue to Crissy Field for Golden Gate
                        Bridge views. Grab a bite from food trucks, then find
                        the hidden Yoda statue in the Presidio. Perfect for
                        conference breaks!
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">
                            🌳 Golden Gate Park to Ocean Beach
                        </h3>
                        <DistanceBadge
                            distance="Half day"
                            type="time"
                            color="amber"
                        />
                        <DistanceBadge
                            distance="Muni accessible"
                            type="transit"
                            color="purple"
                        />
                    </div>
                    <p class="text-dark-600 text-sm">
                        Explore Golden Gate Park (museums, bison paddock, boat
                        rentals at Blue Heron Lake), then walk to Ocean Beach
                        and Sunset Dunes Park. Check De Young museum and Academy
                        of Sciences in the Golden Gate Park if weather turns.
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">
                            🌲 Muir Woods Adventure
                        </h3>
                        <DistanceBadge
                            distance="Full day"
                            type="time"
                            color="amber"
                        />
                        <DistanceBadge
                            distance="Moderate hiking"
                            type="walk"
                            color="green"
                        />
                    </div>
                    <p class="text-dark-600 text-sm">
                        Uber to Muir Woods ($40-50), hike among the redwoods,
                        then walk down to Mill Valley for lunch. Take the Golden
                        Gate Transit bus back to SF. Covered trails perfect for
                        light rain!
                    </p>
                </div>

                <div class="bg-white border border-dark-200 rounded-lg p-6">
                    <div class="flex items-center gap-2 mb-3">
                        <h3 class="font-bold text-dark-900">
                            🎓 Stanford University Day Trip
                        </h3>
                        <DistanceBadge
                            distance="Full day"
                            type="time"
                            color="amber"
                        />
                        <DistanceBadge
                            distance="Caltrain $7-15"
                            type="transit"
                            color="purple"
                        />
                    </div>
                    <p class="text-dark-600 text-sm">
                        Take Caltrain to Stanford. Visit two free art museums
                        (Cantor Arts Center, Anderson Collection), lunch at
                        Treehouse, then hike the Dish Trail. Dinner in Palo Alto
                        before returning.
                    </p>
                </div>
            </div>
        </section>

        <!-- 6. Get Involved -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                Get Involved
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div
                    class="bg-purple-50 border border-purple-200 rounded-lg p-6 text-center"
                >
                    <div class="text-4xl mb-4">🎉</div>
                    <h3 class="font-bold text-dark-900 mb-3">
                        Host a Community Day Event
                    </h3>
                    <p class="text-dark-600 text-sm mb-4">
                        Organize a walk, museum tour, or cozy gathering on
                        November 21. We'll add it to Schedule!
                    </p>
                    <a
                        href="https://forms.gle/7BBYK28BRkgXZdZF8"
                        target="_blank"
                        class="inline-block px-4 py-2 bg-purple-500 text-white rounded-md text-sm font-medium hover:bg-purple-600 transition-colors"
                    >
                        Submit an Event
                    </a>
                </div>

                <div
                    class="bg-blue-50 border border-blue-200 rounded-lg p-6 text-center"
                >
                    <div class="text-4xl mb-4">🏢</div>
                    <h3 class="font-bold text-dark-900 mb-3">
                        Bring Your Company
                    </h3>
                    <p class="text-dark-600 text-sm mb-4">
                        Help your company sponsor the conference and connect
                        with the Ruby community. Multiple sponsorship tiers
                        available.
                    </p>
                    <a
                        href="/sponsors"
                        class="inline-block px-4 py-2 bg-blue-500 text-white rounded-md text-sm font-medium hover:bg-blue-600 transition-colors"
                    >
                        Learn About Sponsoring
                    </a>
                </div>
            </div>
        </section>

        <!-- Bring your film camera -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                📸 Let's Make Memories!
            </h2>

            <div class="bg-dark-50 rounded-lg p-6">
                <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">
                            Bring your film camera:
                        </h3>
                        <ul class="space-y-2 text-dark-600">
                            <li>Bring your 35 mm camera</li>
                            <li>Get a roll of film in the Film Corner</li>
                            <li>Take photos of people at the event</li>
                            <li>Bring us the film back</li>
                            <li>
                                We develop and publish scans on the conference
                                website
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
        <!-- Org team -->
        <section>
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">
                🙋‍♀️ Meet the org team
            </h2>

            <div class="bg-dark-50 rounded-lg p-6">
                <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
                    <div>
                        <h3 class="font-bold text-dark-900 mb-4">
                            Here're the main organizers and responsibilities:
                        </h3>
                        <ul class="space-y-2 text-dark-600">
                            <li>
                                Maple Ong, Cameron Dutro, Noel Rappin, Vladimir
                                Dementyev: Program Committee
                            </li>
                            <li>Aurelie Verrot: Speakers</li>
                            <li>Steven Ancheta: Volunteers</li>
                            <li>Gary Tou: Scholarship Program</li>
                            <li>Aleksander Berdiugin: Vendors</li>
                            <li>Amanda Kinney: Vendors</li>
                            <li>Anton Lovchikov, Yaroslav Lozhkin: Design</li>
                            <li>Vladimir Dementyev: Software</li>
                            <li>Irina Nazarova: Host</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section
            class="text-center bg-gradient-to-r from-ruby-500 to-ruby-700 text-white rounded-lg p-8"
        >
            <h2 class="text-2xl font-display font-bold mb-4">
                Ready to Join Us in San Francisco?
            </h2>
            <p class="text-lg mb-6 max-w-2xl mx-auto">
                We can't wait to welcome you to the city where Ruby startups are
                born and thrive. See you at Fort Mason this November!
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="https://lu.ma/sfrubyconf2025"
                    target="_blank"
                    class="inline-flex items-center justify-center px-8 py-3 bg-white text-ruby-600 rounded-md font-medium shadow-md transition-all duration-300 transform hover:scale-105"
                >
                    Get Tickets
                </a>
                <a
                    href="/#newsletter"
                    class="inline-flex items-center justify-center px-8 py-3 bg-transparent border border-white text-white rounded-md font-medium transition-all duration-300 transform hover:scale-105"
                >
                    Sign up for updates
                </a>
            </div>
        </section>
    </div>
</Layout>
