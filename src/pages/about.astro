                imageAlt: "Historic ferry building with clock tower and bustling marketplace inside"
            },
        ],
    },
    {
        category: "Light Outdoor Activities",
        items: [
            { 
                name: "Crissy Field Walk", 
                description: "Covered walkways and Golden Gate Bridge views, manageable in light rain",
                image: "https://images.pexels.com/photos/208745/pexels-photo-208745.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Golden Gate Bridge view from Crissy Field with green grass and walking paths"
            },
            { 
                name: "Fisherman's Wharf", 
                description: "Covered piers, indoor attractions, and sea lions at Pier 39",
                image: "https://images.pexels.com/photos/1006965/pexels-photo-1006965.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Fisherman's Wharf with boats, covered walkways, and tourist attractions"
            },
            { 
                name: "Union Square Shopping", 
                description: "Indoor shopping district with department stores and covered areas",
                image: "https://images.pexels.com/photos/1797428/pexels-photo-1797428.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Union Square with palm trees, shops, and urban plaza"
            },
        ],
    },
    {
        category: "Weekend Day Trips",
        items: [
            { 
                name: "Muir Woods & Sausalito", 
                description: "Covered forest trails, then warm up in Sausalito cafes and shops",
                image: "https://images.pexels.com/photos/1496373/pexels-photo-1496373.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Towering redwood trees in Muir Woods with hiking trail"
