            { name: "Pacific Catch", description: "Fresh seafood and poke bowls" },
            { name: "Delarosa", description: "Roman-style pizza and Italian dishes" },
            { name: "Little Original Joe's", description: "Classic SF Italian-American comfort food" },
        ],
    },
