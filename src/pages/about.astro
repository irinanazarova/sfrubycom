                imageAlt: "Interactive science exhibits and displays in a modern museum setting"
            },
            { 
                name: "California Academy of Sciences", 
                description: "Natural history museum with planetarium and aquarium in Golden Gate Park",
                image: "https://images.pexels.com/photos/2280568/pexels-photo-2280568.jpeg?auto=compress&cs=tinysrgb&w=800",
                imageAlt: "Modern museum building with glass dome and natural history exhibits"
            },
            { 
                name: "Ferry Building Marketplace", 
                description: "Gourmet food hall with local vendors and covered shopping",
