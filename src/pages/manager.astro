---
// The approval page. The page is the email: the engineer pastes it, fills the
// brackets, and sends it. The cost itemization and the "what you bring back"
// cards were taken off in September 2026, since the email carries the costs
// and the reasons itself.
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ticketLink, ticketEventClass } from "../data/conference-2026.js";
import { emailSubject, emailBody } from "../data/manager-email-2026.js";
---

<BaseLayout
    darkHero={false}
    title="Convince your manager - SF Ruby Conference 2026"
    description="An email to send your manager, what the San Francisco Ruby Conference costs a Bay Area engineer (the ticket and one day off), and what they bring back."
>
    <section class="pt-28 pb-14 bg-sky-50 border-b-4 border-ink">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Nov 10-12, SFJAZZ</span>
            <h1 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                Convince your manager
            </h1>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-5">
                Advance your company to the cusp of what's possible with Ruby
                today. Copy, paste, fill in the gaps and send it to your boss.
            </p>
            <!-- Same pair as the /team hero, so the two pages offer the same
                 next step. -->
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a
                    href={ticketLink("manager")}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press ${ticketEventClass("manager")}`}
                >
                    <img
                        src="/px-ticket.png"
                        alt=""
                        width="64"
                        height="64"
                        class="px-pixelated h-5 w-auto"
                    />
                    Register on Luma
                </a>
                <a
                    href="/team"
                    class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
                >
                    Bring your team
                </a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="px-dialog bg-white p-5 md:p-6">
                <!-- Subject and body copy separately, each from the icon next
                     to its own label, so each goes straight into its field. -->
                <div class="flex items-center gap-1">
                    <p class="px-font text-px8 text-gray-500 m-0">Email subject</p>
                    <button
                        type="button"
                        data-copy="manager-subject"
                        aria-label="Copy the email subject"
                        title="Copy the email subject"
                        class="shrink-0 inline-flex items-center justify-center w-11 h-11 -my-3 -ml-2 text-gray-400 hover:text-ruby-600 transition-colors tap-press"
                    >
                        <Icon name="ph:copy-light" class="w-6 h-6" data-copy-idle />
                        <Icon name="ph:check-bold" class="w-6 h-6 hidden text-ruby-600" data-copy-done />
                    </button>
                </div>
                <pre
                    id="manager-subject"
                    class="whitespace-pre-wrap font-mono text-xs md:text-sm text-gray-800 leading-relaxed m-0 mt-2"
                >{emailSubject}</pre>

                <div class="flex items-center gap-1 mt-8">
                    <p class="px-font text-px8 text-gray-500 m-0">Email body</p>
                    <button
                        type="button"
                        data-copy="manager-email"
                        aria-label="Copy the email body"
                        title="Copy the email body"
                        class="shrink-0 inline-flex items-center justify-center w-11 h-11 -my-3 -ml-2 text-gray-400 hover:text-ruby-600 transition-colors tap-press"
                    >
                        <Icon name="ph:copy-light" class="w-6 h-6" data-copy-idle />
                        <Icon name="ph:check-bold" class="w-6 h-6 hidden text-ruby-600" data-copy-done />
                    </button>
                </div>
                <pre
                    id="manager-email"
                    class="whitespace-pre-wrap font-mono text-xs md:text-sm text-gray-800 leading-relaxed m-0 mt-2"
                >{emailBody}</pre>
            </div>

            <p class="text-sm text-gray-500 leading-relaxed mt-10 text-center">
                Every talk, with its abstract, is on
                <a href="/#schedule" class="text-ruby-600 underline underline-offset-2">the schedule</a>.
            </p>

            <p class="text-sm text-gray-500 leading-relaxed mt-4 text-center">
                <a href="/team" class="text-ruby-600 underline underline-offset-2">Teams of five get a 10% and a segment on stage</a>.
            </p>
        </div>
    </section>

    <script>
        // Each button copies its own block as plain text, named by data-copy,
        // so the subject and the body go to the clipboard separately. The
        // button confirms inline and then reverts, so the page never needs a
        // toast. Falls back to selecting the text where the clipboard API is
        // unavailable.
        document.querySelectorAll("[data-copy]").forEach((button) => {
            const block = document.getElementById(
                button.getAttribute("data-copy") || "",
            );
            if (!block) return;
            // An icon button confirms by swapping its two icons; a text button
            // by swapping its label, which would wipe an icon out of the DOM.
            const idle = button.querySelector("[data-copy-idle]");
            const done = button.querySelector("[data-copy-done]");
            const label = button.textContent;
            const confirm = (text) => {
                if (idle && done) {
                    idle.classList.add("hidden");
                    done.classList.remove("hidden");
                } else {
                    button.textContent = text;
                }
            };
            const revert = () => {
                if (idle && done) {
                    done.classList.add("hidden");
                    idle.classList.remove("hidden");
                } else {
                    button.textContent = label;
                }
            };
            button.addEventListener("click", async () => {
                const text = block.textContent || "";
                try {
                    await navigator.clipboard.writeText(text);
                    confirm("Copied");
                } catch {
                    const range = document.createRange();
                    range.selectNodeContents(block);
                    const sel = window.getSelection();
                    sel?.removeAllRanges();
                    sel?.addRange(range);
                    confirm("Select and copy");
                }
                setTimeout(revert, 1800);
            });
        });
    </script>
</BaseLayout>
