---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getAllStartups } from "../../data/startups.js";
import { getSortedJobs } from "../../data/jobs.js";
import { talks } from "../../data/talks.js";

// Get actual counts from data files
const allStartups = getAllStartups().filter((s) => s.id !== "corepilot");
const startupCount = allStartups.length;
const jobCount = getSortedJobs().length;
const allTalks = Object.values(talks);
const talkCount = allTalks.filter((t: any) => t.youtubeId).length;
const slackMembers = 550; // Approximate
---

<BaseLayout
    title="About SF Ruby - SF Ruby"
    description="Learn about SF Ruby, the community for Ruby developers, founders, and enthusiasts in San Francisco."
>
    <!-- Hero: dusk sky with HUD stats -->
    <section class="relative pt-32 pb-16 px-sky-grad-dusk overflow-hidden">
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h1 class="px-font px-shadow-ink text-xl md:text-3xl text-white mb-6">
                    About SF Ruby
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    The community for Ruby developers and founders in
                    San&nbsp;Francisco.
                </p>

                <!-- Stats: HUD counters -->
                <div class="flex flex-wrap gap-x-10 gap-y-6">
                    <div>
                        <div class="px-font text-base md:text-lg text-white">
                            {startupCount}
                        </div>
                        <div class="text-sm text-white/60 mt-1.5">Ruby Startups</div>
                    </div>
                    <div>
                        <div class="px-font text-base md:text-lg text-ruby-400">
                            {talkCount}+
                        </div>
                        <div class="text-sm text-white/60 mt-1.5">Recorded Talks</div>
                    </div>
                    <div>
                        <div class="px-font text-base md:text-lg text-gold-400">
                            {jobCount}
                        </div>
                        <div class="text-sm text-white/60 mt-1.5">Open Jobs</div>
                    </div>
                    <div>
                        <div class="px-font text-base md:text-lg text-sky-300">
                            {slackMembers}+
                        </div>
                        <div class="text-sm text-white/60 mt-1.5">Slack Members</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-12 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Mission -->
            <div class="prose prose-lg max-w-none mb-12">
                <h2 class="px-font text-base md:text-lg text-gray-900 mb-5">
                    Our Mission
                </h2>
                <p class="text-gray-600 leading-relaxed">
                    SF Ruby exists to promote Ruby as the language of choice for
                    new startups, showcase real Ruby companies (especially
                    conference demos), and support founders and engineers with
                    content, meetups, jobs, and resources.
                </p>
                <p class="text-gray-600 leading-relaxed">
                    We believe Ruby is the best language for building web
                    applications, and San Francisco is where the most ambitious
                    Ruby startups are born. Our goal is to connect the Ruby
                    community and help it thrive.
                </p>
            </div>

            <!-- What We Do -->
            <div class="px-card bg-white p-8 mb-12">
                <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">What We Do</h2>
                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <img src="/px-heart.png" alt="" width="14" height="13" class="px-pixelated h-8 w-auto flex-shrink-0 mt-1" />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Monthly Meetups
                            </h3>
                            <p class="text-gray-600 text-sm">
                                We host monthly meetups with talks, demos, and
                                networking. Join us on <a
                                    href="https://lu.ma/sfruby"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-ruby-500 hover:text-ruby-600"
                                    >Luma</a
                                >.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <img src="/px-ticket.png" alt="" width="26" height="12" class="px-pixelated h-7 w-auto flex-shrink-0 mt-1" />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Annual Conference
                            </h3>
                            <p class="text-gray-600 text-sm">
                                The SF Ruby Conference brings together 450+
                                Rubyists for two days of talks, workshops, and
                                startup demos.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <img src="/px-quest.png" alt="" width="64" height="296" class="px-pixelated h-9 w-auto flex-shrink-0" />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Startup Directory
                            </h3>
                            <p class="text-gray-600 text-sm">
                                We maintain a directory of Ruby startups in the
                                Bay Area, from pre-seed to public companies.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <img src="/px-briefcase.png" alt="" width="18" height="11" class="px-pixelated h-7 w-auto flex-shrink-0 mt-1" />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Job Board
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Companies can post Ruby jobs to reach our
                                community of senior engineers and founders.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Organized By -->
            <div class="px-card bg-white p-8 mb-12">
                <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                    Organized By
                </h2>
                <div class="flex flex-col md:flex-row items-center gap-6">
                    <a
                        href="https://evilmartians.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-shrink-0"
                    >
                        <img
                            src="/evilmartians.png"
                            alt="Evil Martians"
                            class="h-16 w-auto"
                        />
                    </a>
                    <div>
                        <p class="text-gray-600">
                            SF Ruby is organized by <a
                                href="https://evilmartians.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-ruby-500 hover:text-ruby-600 font-medium"
                                >Evil Martians</a
                            >, a product development consultancy and open source
                            powerhouse. We build and maintain popular Ruby gems
                            and contribute to Rails core.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact -->
            <div class="px-card bg-ruby-500 p-8 text-center text-white">
                <h2 class="px-font px-shadow-ink text-sm md:text-base mb-5">Get in Touch</h2>
                <p class="text-white/90 mb-6">
                    Have questions, want to sponsor, or just want to say hi?
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href="mailto:conference@sfruby.com"
                        class="px-btn px-font text-[0.5625rem] md:text-[0.625rem] gap-2 px-5 py-3.5 bg-white text-ruby-600 hover:bg-gray-50 normal-case"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        conference@sfruby.com
                    </a>
                    <a
                        href="https://x.com/inazarova"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-btn px-font text-[0.5625rem] md:text-[0.625rem] gap-2 px-5 py-3.5 bg-gold-500 text-ink hover:bg-gold-400 normal-case"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path>
                        </svg>
                        @sf_ruby
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
