---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getAllStartups } from "../../data/startups.js";
import { getSortedJobs } from "../../data/jobs.js";
import { talks } from "../../data/talks.js";

// Get actual counts from data files
const allStartups = getAllStartups().filter((s) => s.id !== "corepilot");
const startupCount = allStartups.length;
const jobCount = getSortedJobs().length;
const allTalks = Object.values(talks);
const talkCount = allTalks.filter((t: any) => t.youtubeId).length;
const slackMembers = 600; // Approximate
---

<BaseLayout
    title="About SF Ruby - SF Ruby"
    description="Learn about SF Ruby, the community for Ruby developers, founders, and enthusiasts in San Francisco."
>
    <!-- Hero Section with dark background for nav visibility -->
    <section
        class="relative pt-32 pb-16 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden"
    >
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute inset-0"
                style="background-image: url('data:image/svg+xml,%3Csvg width=\"
                60\"
                height='\"60\"'
                viewBox='\"0'
                0
                60
                60\"
                xmlns='\"http://www.w3.org/2000/svg\"%3E%3Cg'
                fill='\"none\"'
                fill-rule='\"evenodd\"%3E%3Cg'
                fill='\"%23ffffff\"'
                fill-opacity='\"0.4\"%3E%3Cpath'
                d='\"M36'
                34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6
                34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6
                4V0H4v4H0v2h4v4h2V6h4V4H6z\"
                %3E%3C
                g%3E%3C
                g%3E%3C
                svg%3E')"
            >
            </div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6"
                >
                    About SF Ruby
                </h1>
                <p class="text-lg md:text-xl text-gray-300 mb-8">
                    The community for Ruby developers and founders in
                    San&nbsp;Francisco.
                </p>

                <!-- Stats -->
                <div class="flex flex-wrap gap-8">
                    <div>
                        <div class="text-3xl font-bold text-white">
                            {startupCount}
                        </div>
                        <div class="text-sm text-gray-400">Ruby Startups</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-ruby-400">
                            {talkCount}+
                        </div>
                        <div class="text-sm text-gray-400">Recorded Talks</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-emerald-400">
                            {jobCount}
                        </div>
                        <div class="text-sm text-gray-400">Open Jobs</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-sky-400">
                            {slackMembers}+
                        </div>
                        <div class="text-sm text-gray-400">Slack Members</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-12 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Mission -->
            <div class="prose prose-lg max-w-none mb-12">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                    Our Mission
                </h2>
                <p class="text-gray-600 leading-relaxed">
                    SF Ruby exists to promote Ruby as the language of choice for
                    new startups, showcase real Ruby companies (especially
                    conference demos), and support founders and engineers with
                    content, meetups, jobs, and resources.
                </p>
                <p class="text-gray-600 leading-relaxed">
                    We believe Ruby is the best language for building web
                    applications, and San Francisco is where the most ambitious
                    Ruby startups are born. Our goal is to connect the Ruby
                    community and help it thrive.
                </p>
            </div>

            <!-- What We Do -->
            <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-12">
                <h2 class="text-xl font-bold text-gray-900 mb-6">What We Do</h2>
                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-ruby-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Monthly Meetups
                            </h3>
                            <p class="text-gray-600 text-sm">
                                We host monthly meetups with talks, demos, and
                                networking. Join us on <a
                                    href="https://lu.ma/sfruby"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-ruby-500 hover:text-ruby-600"
                                    >Luma</a
                                >.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-ruby-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Annual Conference
                            </h3>
                            <p class="text-gray-600 text-sm">
                                The SF Ruby Conference brings together 450+
                                Rubyists for two days of talks, workshops, and
                                startup demos.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-ruby-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Startup Directory
                            </h3>
                            <p class="text-gray-600 text-sm">
                                We maintain a directory of Ruby startups in the
                                Bay Area, from pre-seed to public companies.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-ruby-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Job Board
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Companies can post Ruby jobs to reach our
                                community of senior engineers and founders.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Organized By -->
            <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-12">
                <h2 class="text-xl font-bold text-gray-900 mb-6">
                    Organized By
                </h2>
                <div class="flex flex-col md:flex-row items-center gap-6">
                    <a
                        href="https://evilmartians.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-shrink-0"
                    >
                        <img
                            src="/evilmartians.png"
                            alt="Evil Martians"
                            class="h-16 w-auto"
                        />
                    </a>
                    <div>
                        <p class="text-gray-600">
                            SF Ruby is organized by <a
                                href="https://evilmartians.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-ruby-500 hover:text-ruby-600 font-medium"
                                >Evil Martians</a
                            >, a product development consultancy and open source
                            powerhouse. We build and maintain popular Ruby gems
                            and contribute to Rails core.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact -->
            <div
                class="bg-gradient-to-r from-ruby-500 to-pink-500 rounded-2xl p-8 text-center text-white"
            >
                <h2 class="text-2xl font-bold mb-4">Get in Touch</h2>
                <p class="text-ruby-100 mb-6">
                    Have questions, want to sponsor, or just want to say hi?
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href="mailto:conference@sfruby.com"
                        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-ruby-500 font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        conference@sfruby.com
                    </a>
                    <a
                        href="https://x.com/sf_ruby"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-all duration-300"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path>
                        </svg>
                        @sf_ruby
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
