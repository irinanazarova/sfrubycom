---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpcomingMeetups from "../components/UpcomingMeetups.astro";
import HostCard from "../components/HostCard.astro";
import HostModal from "../components/HostModal.astro";

import { getLatestMeetupRecordings, formatTimestamp } from "../data/meetup-recordings.js";
import { getAllHosts, hosts as hostsData } from "../data/hosts.js";
import { getJobsBySponsor } from "../data/jobs.js";

const latestMeetupRecordings = getLatestMeetupRecordings(2);

// Open roles per host (by sponsorId), passed to the host modal so it can link
// each role to our job board. Only the fields the modal needs.
const hostJobs: Record<string, { id: string; title: string; location?: string }[]> = {};
for (const h of getAllHosts()) {
    if (!h.sponsorId) continue;
    const roles = getJobsBySponsor(h.sponsorId);
    if (roles.length) {
        hostJobs[h.id] = roles.map((j) => ({ id: j.id, title: j.title, location: j.location }));
    }
}
---

<BaseLayout
    title="SF Ruby Meetup - Monthly Ruby Meetups in San Francisco"
    description="The monthly SF Ruby meetup: talks, startup demos, and networking with founders and engineers building with Ruby. Free, every month, in San Francisco."
>
    <!-- Meetup hero: day sky, same overworld as the rest of the site -->
    <section class="relative text-white overflow-hidden px-sky-grad-day">
        <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-16 left-[6%] w-24 md:w-40 md:top-24 animate-float pointer-events-none" aria-hidden="true" />
        <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-32 right-[8%] w-32 animate-float [animation-delay:-3s] pointer-events-none hidden md:block" aria-hidden="true" />

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-32 pb-16 sm:pt-36 sm:pb-20 text-center">
            <span class="px-plate px-font text-px8 md:text-px10 px-3 py-2">
                Monthly Meetup
            </span>
            <h1 class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6 mb-4">
                Join the Next SF Ruby Meetup
            </h1>
            <p class="text-lg text-white/90 max-w-2xl mx-auto mb-10">
                Connect with founders and engineers building with Ruby.
                Learn, share, and make friends for life!
            </p>

            <!-- Next meetup, synced from Luma at build time -->
            <div class="text-left">
                <UpcomingMeetups />
            </div>

            <!-- CTAs -->
            <div class="flex flex-wrap justify-center gap-3">
                <a
                    href="https://lu.ma/sfruby"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px10 gap-2.5 px-6 py-3.5 bg-white text-gray-900 hover:bg-gray-50"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    See all events
                </a>
                <a
                    href="https://forms.gle/EZLqENWd5VjiLduq8"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px10 gap-2.5 px-6 py-3.5 bg-ink text-white hover:bg-gray-800"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Submit a talk
                </a>
                <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSdTg1VZIMOyWqffBZgsQxxWbSWYOKmp_kFVnQhtJvlgvdabyw/viewform?usp=send_form"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px10 gap-2.5 px-6 py-3.5 bg-white text-gray-900 hover:bg-gray-50"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Demo your startup
                </a>
            </div>
        </div>

        <!-- crenellated step into the recordings section -->
        <div class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:var(--dark-50)]" aria-hidden="true"></div>
    </section>

    <!-- Latest recordings -->
    <section id="recordings" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="px-font text-lg md:text-2xl text-gray-900 mb-4">
                    Latest Recordings
                </h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    Missed a meetup? Every talk is on YouTube.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
                {
                    latestMeetupRecordings.map((recording: any) => (
                        <div class="group bg-white border-2 border-ink shadow-md overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col">
                            <a
                                href={`https://www.youtube.com/watch?v=${recording.youtubeId}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block"
                            >
                                <div class="aspect-video bg-gray-900 relative overflow-hidden">
                                    <img
                                        src={`https://img.youtube.com/vi/${recording.youtubeId}/mqdefault.jpg`}
                                        alt={recording.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                        <div class="w-12 h-12 bg-white/90 rounded-full flex items-center justify-center">
                                            <svg class="w-5 h-5 text-sky-500 ml-1" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-4 pb-2">
                                    <h3 class="font-semibold text-gray-900 group-hover:text-sky-500 transition-colors">
                                        {recording.title.replace("SF Bay Area Ruby Meetup - ", "").replace("SF Ruby & Elixir Special - ", "Elixir Special - ")}
                                    </h3>
                                    <p class="text-sm text-gray-500 mt-1">
                                        {recording.talks.length} talks · {recording.venue}
                                    </p>
                                </div>
                            </a>
                            <div class="px-4 pb-4">
                                <details class="meetup-details">
                                    <summary class="text-xs text-sky-500 hover:text-sky-600 cursor-pointer font-medium select-none">
                                        Show talks
                                    </summary>
                                    <ul class="mt-2 space-y-1.5">
                                        {recording.talks.map((talk: any) => (
                                            <li class="text-xs">
                                                <a
                                                    href={`https://www.youtube.com/watch?v=${recording.youtubeId}${talk.timestamp ? `&t=${talk.timestamp}` : ""}`}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex items-start gap-2 text-gray-600 hover:text-sky-600 transition-colors"
                                                >
                                                    <span class="text-gray-400 font-mono whitespace-nowrap mt-px">{formatTimestamp(talk.timestamp)}</span>
                                                    <span>
                                                        <span class="font-medium">{talk.speaker}</span>
                                                        {talk.company && <span class="text-gray-400"> ({talk.company})</span>}
                                                        <span class="text-gray-400"> — </span>
                                                        {talk.title}
                                                    </span>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </details>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="mt-10 text-center">
                <a
                    href="/videos"
                    class="px-btn px-font text-px10 gap-2 px-6 py-3.5 bg-white text-gray-900 hover:bg-gray-50 border-2 border-ink"
                >
                    View all videos
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Our Hosts -->
    <section id="hosts" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="px-font text-lg md:text-2xl text-gray-900 mb-4">
                    Our Hosts
                </h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    These companies open their doors to the Ruby community every month.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-12">
                {getAllHosts().map((host) => (
                    <HostCard host={host} />
                ))}
            </div>

            <div class="text-center">
                <a
                    href="/host"
                    class="px-btn px-font text-px10 gap-2 px-6 py-3.5 bg-ink text-white hover:bg-gray-800"
                >
                    Host the meetup
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Join the community -->
    <section id="community" class="py-16 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="px-font text-base md:text-lg text-gray-900 mb-4">
                Between Meetups
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto mb-8">
                The conversation continues on Slack and in the monthly newsletter.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <a
                    href="https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px10 gap-2 px-6 py-3.5 bg-ink text-white hover:bg-gray-800"
                >
                    Join SF Ruby Slack
                </a>
                <a
                    href="https://sfruby.substack.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px10 gap-2 px-6 py-3.5 bg-white text-gray-900 hover:bg-gray-50 border-2 border-ink"
                >
                    Newsletter
                </a>
                <a
                    href="/photos"
                    class="px-btn px-font text-px10 gap-2 px-6 py-3.5 bg-white text-gray-900 hover:bg-gray-50 border-2 border-ink"
                >
                    Photos
                </a>
            </div>
        </div>
    </section>

    <HostModal />
</BaseLayout>

<script define:vars={{ hostsData, hostJobs }}>
    function buildHostModalContent(host) {
        // Open roles on our job board for this host, linked high in the modal.
        const jobs = hostJobs[host.id] || [];
        let jobsHtml = "";
        if (jobs.length > 0) {
            const roleLinks = jobs.map(job =>
                `<a href="/jobs#${job.id}" class="flex items-center justify-between gap-3 py-1.5 text-sm text-emerald-800 hover:text-emerald-900 hover:underline">
                    <span class="font-medium">${job.title}</span>
                    <svg class="w-4 h-4 flex-shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>`
            ).join("");
            jobsHtml = `
                <div class="mb-5 p-4 bg-emerald-50 rounded-xl border border-emerald-100">
                    <h4 class="text-xs font-semibold text-emerald-700 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        Now hiring · ${jobs.length} open ${jobs.length === 1 ? "role" : "roles"} on our board
                    </h4>
                    <div class="divide-y divide-emerald-100">${roleLinks}</div>
                </div>
            `;
        }

        // Tag color
        let tagClass = "bg-red-50 text-red-700";
        if (host.tag === "Ruby SDK") tagClass = "bg-purple-50 text-purple-700";

        let leadershipHtml = "";
        if (host.leadership) {
            leadershipHtml = `
                <div class="flex items-center gap-2 mt-2">
                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="text-sm text-gray-600">${host.leadership}</span>
                </div>
            `;
        }

        let foundersHtml = "";
        if (host.founders) {
            foundersHtml = `
                <div class="flex items-start gap-2 mt-2">
                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="text-sm text-gray-600">Founded ${host.founded || ""} by ${host.founders}</span>
                </div>
            `;
        }

        let productHtml = "";
        if (host.product) {
            productHtml = `
                <div class="mb-5">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">The Product</h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.product}</p>
                </div>
            `;
        }

        let historyHtml = "";
        if (host.history) {
            historyHtml = `
                <div class="mb-5">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">The Story</h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.history}</p>
                </div>
            `;
        }

        let ecosystemHtml = "";
        if (host.rubyEcosystem) {
            let openSourceHtml = "";
            if (host.openSource && host.openSource.length > 0) {
                const repoLinks = host.openSource.map(repo =>
                    `<a href="${repo.url}" target="_blank" rel="noopener noreferrer" class="flex items-start gap-2 p-2 -mx-2 rounded-lg hover:bg-red-100/50 transition-colors group">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        <div class="min-w-0">
                            <span class="text-sm font-medium text-gray-900 group-hover:text-red-700">${repo.name}</span>
                            <span class="text-xs text-gray-500 ml-1">${repo.desc}</span>
                        </div>
                    </a>`
                ).join("");
                openSourceHtml = `
                    <div class="mt-3 pt-3 border-t border-red-100">
                        <p class="text-xs font-semibold text-red-700 uppercase tracking-wider mb-1">Open Source</p>
                        ${repoLinks}
                    </div>
                `;
            }
            let sourceHtml = "";
            if (host.rubySource) {
                sourceHtml = `
                    <a href="${host.rubySource.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-xs font-medium text-red-700 hover:text-red-900 hover:underline">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.247m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.247" />
                        </svg>
                        Read more: ${host.rubySource.label}
                    </a>
                `;
            }
            ecosystemHtml = `
                <div class="mb-5 p-4 bg-gradient-to-br from-red-50 to-rose-50 rounded-xl border border-red-100">
                    <h4 class="text-xs font-semibold text-red-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z"/>
                        </svg>
                        Ruby & Rails Ecosystem
                    </h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.rubyEcosystem}</p>
                    ${sourceHtml}
                    ${openSourceHtml}
                </div>
            `;
        }

        return `
            <div class="p-6">
                <button id="hostModalCloseBtn" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 transition-colors z-10">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Header -->
                <div class="flex items-start gap-4 mb-5">
                    <div class="w-16 h-16 bg-gray-50 rounded-xl flex items-center justify-center p-2 flex-shrink-0 border border-gray-100">
                        <img src="${host.logo}" alt="${host.name}" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-xl font-bold text-gray-900">${host.name}</h3>
                            <span class="px-2 py-0.5 text-xs font-bold rounded-md ${tagClass}">${host.tag}</span>
                        </div>
                        <p class="text-gray-600 mt-1">${host.summary}</p>
                        ${foundersHtml}
                        ${leadershipHtml}
                    </div>
                </div>

                ${host.rubyConnection ? `
                <div class="flex items-start gap-2 mb-5">
                    <svg class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z"/></svg>
                    <p class="text-sm font-semibold text-gray-900 leading-snug">${host.rubyConnection}</p>
                </div>` : ""}

                ${jobsHtml}
                ${productHtml}
                ${historyHtml}
                ${ecosystemHtml}

                <a href="${host.url}" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-medium text-sm">
                    Visit ${host.name}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        `;
    }

    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-host-id]").forEach((card) => {
            card.addEventListener("click", (e) => {
                e.preventDefault();
                const hostId = card.getAttribute("data-host-id");
                const host = hostsData[hostId];
                if (
                    host &&
                    window.setHostModalContent &&
                    window.showHostModal
                ) {
                    window.setHostModalContent(buildHostModalContent(host));
                    window.showHostModal();
                }
            });
        });
    });
</script>
