---
import PresentationLayout from "../../layouts/PresentationLayout.astro";
import Slide from "../../components/Slide.astro";
import QuoteSlide from "../../components/QuoteSlide.astro";
import "../../styles/neon-rpg.css";
import { startups } from "../../data/startups.js";
import { speakers } from "../../data/speakers.js";

// Demo founders with photos - dynamically generated from startups/speakers data
const demoFounders = Object.values(startups)
    .filter((s) => s.speakerId && speakers[s.speakerId])
    .map((startup) => ({
        name: speakers[startup.speakerId].name,
        company: startup.name,
        image: speakers[startup.speakerId].image,
        logo: startup.logo,
    }));

// Startup data
const aiStartups = [
    { name: "Bolt.new", metric: "$40M ARR in 8 weeks", founder: "Albert Pai" },
    {
        name: "Cora Computer",
        metric: "Solo founder vs Google",
        founder: "Kieran Klaassen",
    },
    {
        name: "Simple AI",
        metric: "Sub-700ms voice agents",
        founder: "YC-backed",
    },
    { name: "Sixfold", metric: "Insurance AI", founder: "Brian Moseley" },
    {
        name: "RubyLLM",
        metric: "3,452 GitHub stars",
        founder: "Carmine Paolino",
    },
    { name: "Cactus", metric: "AI call center", founder: "YC X25" },
];

const scaleProof = [
    { company: "Intercom", metric: "2M req/sec", detail: "14 years on Rails" },
    { company: "Shopify", metric: "80M req/min", detail: "Black Friday 2024" },
    { company: "AngelList", metric: "$100B+ managed", detail: "~30 engineers" },
    { company: "NexHealth", metric: "$1B unicorn", detail: "85% Rails" },
];

const openSourceImpact = [
    {
        founder: "Kieran Klaassen",
        project: "compound-engineering-plugin",
        stars: "6,240",
    },
    { founder: "Carmine Paolino", project: "RubyLLM", stars: "3,452" },
    {
        founder: "Jeremy Evans",
        project: "Sequel + Roda + Rodauth",
        stars: "8,800+",
    },
    { founder: "André Arko", project: "Bundler", stars: "#1 contributor" },
];

// Southeast Asian Ruby/Rails success stories
const seaFounders = [
    {
        name: "Jun Hasegawa",
        company: "Opn",
        country: "🇯🇵",
        origin: "Japan",
        metric: "$1B",
        detail: "Thailand's fintech unicorn",
    },
    {
        name: "Ezra Don Harinsut",
        company: "Opn",
        country: "🇹🇭",
        origin: "Thailand",
        metric: "$1B",
        detail: "Started in a Bangkok Starbucks",
    },
    {
        name: "Nadiem Makarim",
        company: "Gojek",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$28B",
        detail: "Decacorn → Education Minister",
    },
    {
        name: "Tessa Wijaya",
        company: "Xendit",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$1B",
        detail: "First female founder to unicorn in ID",
    },
    {
        name: "Suwandi Soh",
        company: "Mekari",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$97M ARR",
        detail: "Indonesia's #1 SaaS, Rails 7",
    },
    {
        name: "Bobby Ong",
        company: "CoinGecko",
        country: "🇲🇾",
        origin: "Malaysia",
        metric: "#2 crypto",
        detail: "Bootstrapped from KL, no VC",
    },
];
---

<PresentationLayout title="Startups on Rails 2026 - RubyConfTH Bangkok">
    <!-- Progress Bar -->
    <div class="progress-bar" id="progress"></div>

    <!-- ========================================
       OPENING: Slides 1-3
       ======================================== -->

    <!-- Slide 1: Title -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="Hey everyone! Sawadee krap! How's everyone doing? So excited to be here in Bangkok. First time in Thailand, and I already love it. Let me tell you what I've been up to for the last two years."
    >
        <div>
            <p class="reveal-item section-label mb-6">
                RubyConfTH Bangkok 2026
            </p>
            <h1
                class="reveal-item text-5xl md:text-7xl lg:text-8xl font-black mb-8"
            >
                <span class="gradient-text">Startups on Rails</span>
            </h1>
            <p
                class="reveal-item text-xl md:text-2xl text-gray-400 mb-6 max-w-2xl mx-auto"
            >
                What I learned from 50+ founders.
            </p>
            <p class="reveal-item text-2xl text-gray-500">Irina Nazarova</p>
            <div
                class="reveal-item mt-10 animate-pulse-slow text-gray-600 text-2xl"
            >
                ↓ Press arrow keys to navigate
            </div>
        </div>
    </Slide>

    <!-- Slide 1b: About Me -->
    <Slide
        layout="two-column"
        background="dark"
        notes="A bit about me. I run Evil Martians — we help startups scale with Ruby and Rails. I also co-created AnyCable for real-time apps. And I organize SF Ruby meetup and conference in San Francisco. But honestly? I've spent the last two years doing something a bit unusual..."
    >
        <div class="grid md:grid-cols-5 gap-6 items-center relative z-10">
            <div class="md:col-span-2 flex justify-center">
                <div
                    class="reveal-item w-56 h-56 md:w-72 md:h-72 rounded-full overflow-hidden border-4 border-[rgba(255,45,149,0.3)] shadow-[0_0_40px_rgba(255,45,149,0.2)]"
                >
                    <img
                        src="/speaker_irina.jpg"
                        alt="Irina Nazarova"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
            <div class="md:col-span-3">
                <h2
                    class="reveal-item text-3xl md:text-4xl font-bold text-white mb-6"
                >
                    Irina Nazarova
                </h2>
                <div class="reveal-item space-y-4 text-2xl text-gray-300">
                    <p>
                        <span class="text-neon-magenta">CEO</span> at Evil Martians
                    </p>
                    <p>
                        Co-founder of <span class="text-white">AnyCable</span>
                    </p>
                    <p>
                        Organizer of <span class="text-white">SF Ruby</span> meetup
                        & conference
                    </p>
                </div>
                <p class="reveal-item mt-4 text-2xl text-gray-400">
                    I've spent two years asking founders: why Ruby?
                </p>
            </div>
        </div>
    </Slide>

    <!-- Slide 2: The Question -->
    <Slide
        layout="centered"
        background="dark"
        notes="You know this question, right? 'Are you STILL using Ruby?' That pause. That tone. Like you're driving a vintage car. I got tired of hearing it. So I decided to actually investigate what's happening."
    >
        <!-- Matrix Rain Background -->
        <div
            class="matrix-column"
            style="left: 5%; animation-duration: 8s; animation-delay: 0s;"
        >
            01Ruby10
        </div>
        <div
            class="matrix-column"
            style="left: 12%; animation-duration: 10s; animation-delay: 2s;"
        >
            死廃Legacy
        </div>
        <div
            class="matrix-column"
            style="left: 20%; animation-duration: 7s; animation-delay: 1s;"
        >
            Python>>>
        </div>
        <div
            class="matrix-column"
            style="left: 28%; animation-duration: 9s; animation-delay: 3s;"
        >
            AITakeOver
        </div>
        <div
            class="matrix-column"
            style="left: 35%; animation-duration: 11s; animation-delay: 0.5s;"
        >
            Still???????
        </div>
        <div
            class="matrix-column"
            style="left: 65%; animation-duration: 8s; animation-delay: 1.5s;"
        >
            TypeScript
        </div>
        <div
            class="matrix-column"
            style="left: 72%; animation-duration: 10s; animation-delay: 2.5s;"
        >
            01100110
        </div>
        <div
            class="matrix-column"
            style="left: 80%; animation-duration: 7s; animation-delay: 0.8s;"
        >
            Dead???!!!
        </div>
        <div
            class="matrix-column"
            style="left: 88%; animation-duration: 9s; animation-delay: 3.5s;"
        >
            恐怖Fear
        </div>
        <div
            class="matrix-column"
            style="left: 95%; animation-duration: 12s; animation-delay: 1.2s;"
        >
            00110101
        </div>
        <div class="matrix-glow-line" style="right: 5%; animation-delay: 0s;">
        </div>
        <div class="matrix-glow-line" style="right: 15%; animation-delay: 1s;">
        </div>
        <div class="relative z-10">
            <p class="reveal-item section-label mb-8">The Question</p>
            <h2
                class="reveal-item text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-8"
            >
                "Are you <span class="fear-text">still</span> using Ruby?"
            </h2>
            <p class="reveal-item text-2xl text-gray-400 max-w-2xl mx-auto">
                You've heard it. At conferences. From recruiters. From that
                friend who switched to Go.
            </p>
        </div>
    </Slide>

    <!-- Slide 3: My Journey -->
    <Slide
        layout="stacked"
        background="gradient-purple"
        notes="So I hit the phones. Literally. 50+ founders. I gave three keynotes on this topic. And I organized SF Ruby Conference — first Ruby conference in San Francisco in TEN YEARS. What I found... it surprised me. This talk is that journey."
    >
        <div>
            <p class="reveal-item section-label mb-4">Context</p>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                I've spent two years talking to Ruby startups.
            </h2>
            <div class="reveal-item grid md:grid-cols-3 gap-6 mb-8">
                <div class="metric-card">
                    <div class="text-3xl font-bold text-white mb-1">50+</div>
                    <div class="text-gray-400 text-2xl">
                        Founders interviewed
                    </div>
                </div>
                <div class="metric-card">
                    <div class="text-3xl font-bold text-white mb-1">3</div>
                    <div class="text-gray-400 text-2xl">Keynotes given</div>
                </div>
                <div class="metric-card">
                    <div class="text-3xl font-bold text-white mb-1">1</div>
                    <div class="text-gray-400 text-2xl">
                        Conference organized
                    </div>
                </div>
            </div>
            <p class="reveal-item text-2xl text-gray-300">
                This talk is what I learned. Not just about startups.<br />
                About <span class="text-white font-semibold">us</span>. About
                our fears. And our choices.
            </p>
        </div>
    </Slide>

    <!-- ========================================
       THE FEAR: Slides 4-10
       ======================================== -->

    <!-- Slide 4: Section Title - Fear -->
    <Slide
        layout="centered"
        background="dark"
        notes="But first, let's talk about something we don't usually discuss openly. The fear."
    >
        <div>
            <p class="reveal-item section-label mb-4">Part One</p>
            <h2 class="reveal-item text-5xl md:text-7xl font-black text-white">
                The Fear
            </h2>
        </div>
    </Slide>

    <!-- Slide 5: The Hero -->
    <Slide
        layout="stacked"
        background="gradient-pink"
        notes="Let me tell you about our hero. It's you. You're a Ruby engineer who loves Ruby. You've built things. You've shipped. Ruby feels RIGHT. But lately..."
    >
        <div>
            <p class="reveal-item section-label mb-4">Our Hero</p>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                A Ruby engineer who loves Ruby.
            </h2>
            <div class="space-y-4 text-2xl text-gray-300">
                <p class="reveal-item">
                    You've built things. You've shipped products. You're
                    productive.
                </p>
                <p class="reveal-item">
                    Ruby feels <span class="text-white">right</span>.
                </p>
                <p class="reveal-item text-2xl text-gray-500 mt-4">
                    But lately...
                </p>
            </div>
        </div>
    </Slide>

    <!-- Slide 6: The Anxiety -->
    <Slide
        layout="stacked"
        background="dark"
        notes="The anxiety creeps in. AI is taking our jobs — every headline. Python owns machine learning — every tutorial. JavaScript owns the web. And Ruby? Ruby is big in Japan. But Japan is... different? Right?"
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The anxiety creeps in.
            </h2>
            <div class="space-y-5">
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-red font-mono text-2xl">[!]</span>
                    <p class="text-2xl text-gray-300">
                        AI is "taking our jobs." Every headline says so.
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-yellow font-mono text-2xl">[~]</span>
                    <p class="text-2xl text-gray-300">
                        Python owns machine learning. Every tutorial is Python.
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-yellow font-mono text-2xl">[~]</span>
                    <p class="text-2xl text-gray-300">
                        JavaScript owns the web. TypeScript is "the future."
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-cyan font-mono text-2xl">[?]</span>
                    <p class="text-2xl text-gray-300">
                        Ruby is big in Japan. But Japan is... "different"?
                    </p>
                </div>
            </div>
        </div>
    </Slide>

    <!-- Slide 7: The Real Question -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="But here's what's really going on. The question you're actually asking yourself: What should I do to ensure the future for me and my family for at least a decade? Should I learn Python? ML? Drop Ruby entirely?"
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The real question you're asking:
            </h2>
            <p
                class="reveal-item text-2xl md:text-3xl text-gray-300 leading-relaxed"
            >
                "What should I do to ensure the future<br />
                for me and my family<br />
                <span class="text-white font-semibold"
                    >for at least a decade?</span
                >"
            </p>
            <div
                class="reveal-item mt-6 flex flex-wrap justify-center gap-4 text-2xl"
            >
                <span class="rpg-list-item px-4 py-2">Learn Python?</span>
                <span class="rpg-list-item px-4 py-2">Learn ML?</span>
                <span class="rpg-list-item px-4 py-2">Drop Ruby?</span>
            </div>
        </div>
    </Slide>

    <!-- Slide 8: The Shame -->
    <Slide
        layout="stacked"
        background="dark"
        notes="And then something interesting happens. Ruby Shame. Founders don't mention Ruby to investors anymore. Engineers hedge: 'We use Rails, but we're considering...' Job posts hide the word Ruby. It's like we're embarrassed."
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The "Ruby Shame" phenomenon.
            </h2>
            <div class="space-y-4 text-2xl text-gray-300">
                <p class="reveal-item anim-glitch">
                    Founders don't mention Ruby to investors.
                </p>
                <p class="reveal-item anim-glitch">
                    Engineers hedge: "We use Rails, <span class="text-gray-500"
                        >but we're considering...</span
                    >"
                </p>
                <p class="reveal-item anim-glitch">
                    Job posts avoid saying "Ruby" in the title.
                </p>
            </div>
        </div>
    </Slide>

    <!-- Slide 8b: Daniel Quote -->
    <QuoteSlide
        quote="I felt almost lonely, even though I knew dozens of companies building with Rails in the Bay Area. We just weren't connecting."
        author="Daniel"
        context="Startup founder, San Francisco"
        label="Isolation"
        background="gradient-purple"
        color="magenta"
        notes="Daniel, a startup founder in San Francisco, told me this. Dozens of Rails companies in the Bay Area — but nobody was talking about it. That loneliness? It's real. I felt it too."
    />

    <!-- Slide 9: Fear Responses -->
    <Slide
        layout="fullscreen"
        background="gradient-pink"
        notes="So how do we respond to this fear? Denial — Ruby is fine, nothing's changing. Shame — I don't mention Ruby anymore. Flight — learning Rust on weekends, just in case. Defensiveness — Ruby has ALWAYS been underrated! Sound familiar?"
    >
        <div class="w-full h-full flex flex-col justify-center px-8">
            <h2
                class="reveal-item text-3xl md:text-5xl font-bold text-white mb-8 text-center"
            >
                How we respond to fear:
            </h2>
            <div class="grid md:grid-cols-2 gap-6 flex-1 max-h-[70vh]">
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h3 class="text-neon-magenta font-bold text-2xl mb-2">
                            Denial
                        </h3>
                        <p class="text-gray-400 text-xl md:text-2xl">
                            "Ruby is fine. Nothing's changing. Those people
                            don't know what they're talking about."
                        </p>
                    </div>
                    <img
                        src="/images/fear1.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h3 class="text-neon-magenta font-bold text-2xl mb-2">
                            Shame
                        </h3>
                        <p class="text-gray-400 text-xl md:text-2xl">
                            "I don't mention Ruby anymore. I say 'backend' and
                            hope they don't ask."
                        </p>
                    </div>
                    <img
                        src="/images/fear2.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h3 class="text-neon-magenta font-bold text-2xl mb-2">
                            Flight
                        </h3>
                        <p class="text-gray-400 text-xl md:text-2xl">
                            "I'm learning Rust on weekends. Just in case."
                        </p>
                    </div>
                    <img
                        src="/images/fear3.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h3 class="text-neon-magenta font-bold text-2xl mb-2">
                            Defensiveness
                        </h3>
                        <p class="text-gray-400 text-xl md:text-2xl">
                            "Ruby has ALWAYS been underrated! You just don't
                            understand!"
                        </p>
                    </div>
                    <img
                        src="/images/fear4.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
            </div>
        </div>
    </Slide>

    <!-- ========================================
       THE MENTOR: Slides 11-14
       ======================================== -->

    <!-- Slide 11: Section Title - Mentor -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="We seek guidance. A mentor. Someone who's seen this before."
    >
        <!-- Constellation Background - Wisdom -->
        <div class="constellation-container">
            <div
                class="star large"
                style="top: 15%; left: 20%; animation-delay: 0s;"
            >
            </div>
            <div
                class="star"
                style="top: 25%; left: 30%; animation-delay: 0.5s;"
            >
            </div>
            <div class="star" style="top: 10%; left: 45%; animation-delay: 1s;">
            </div>
            <div
                class="star large"
                style="top: 20%; right: 25%; animation-delay: 0.3s;"
            >
            </div>
            <div
                class="star"
                style="top: 30%; right: 15%; animation-delay: 0.8s;"
            >
            </div>
            <div
                class="star"
                style="top: 70%; left: 15%; animation-delay: 1.2s;"
            >
            </div>
            <div
                class="star large"
                style="top: 80%; left: 35%; animation-delay: 0.6s;"
            >
            </div>
            <div
                class="star"
                style="top: 75%; right: 20%; animation-delay: 1.5s;"
            >
            </div>
            <div
                class="star"
                style="top: 85%; right: 35%; animation-delay: 0.2s;"
            >
            </div>
            <div
                class="star-line"
                style="top: 17%; left: 22%; width: 80px; transform: rotate(20deg);"
            >
            </div>
            <div
                class="star-line"
                style="top: 22%; left: 32%; width: 100px; transform: rotate(-35deg);"
            >
            </div>
            <div
                class="star-line"
                style="top: 78%; left: 17%; width: 120px; transform: rotate(15deg);"
            >
            </div>
        </div>
        <div class="relative z-10">
            <p class="reveal-item section-label mb-4">Part Two</p>
            <h2 class="reveal-item text-5xl md:text-7xl font-black text-white">
                The Mentor
            </h2>
        </div>
    </Slide>

    <!-- Slide 12: Sarah Mei -->
    <QuoteSlide
        quote="Operating from a place of fear is not helpful to us as individuals, as an industry, as a society."
        author="Sarah Mei"
        authorImage="/speaker_sarah.jpg"
        context="SF Ruby Conference 2025"
        label="Wisdom"
        bio="Sarah has been in Ruby since 2006. She founded RailsBridge. She's seen every shift."
        color="cyan"
        notes="Sarah Mei gave a fantastic talk at our SF Ruby Conference. She's been in Ruby since 2006. She founded RailsBridge. And she said something that really stuck with me: Operating from fear is not helpful. Not to us. Not to anyone."
    />

    <!-- Slide 13: Historical Parallels -->
    <Slide
        layout="stacked"
        background="gradient-purple"
        notes="Just think about this. Every major technology shift FELT like the end. Virtual machines in the 90s — you can't run a VM in production! Cloud in the 2000s — you need your own hardware! And now AI — you'll always need to write code yourself!"
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                Every major shift felt like the end.
            </h2>
            <div class="space-y-4">
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">
                            Virtual Machines (Late 90s)
                        </h3>
                        <span class="text-gray-500 text-2xl">Java</span>
                    </div>
                    <p class="text-2xl text-gray-400">
                        "You'll never run a VM in production. You need
                        hand-tuned memory."
                    </p>
                </div>
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">
                            Cloud (Mid 2000s)
                        </h3>
                        <span class="text-gray-500 text-2xl">AWS</span>
                    </div>
                    <p class="text-2xl text-gray-400">
                        "You need to control your own hardware. Cloud will never
                        work for serious apps."
                    </p>
                </div>
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">AI (Now)</h3>
                        <span class="text-gray-500 text-2xl">LLMs</span>
                    </div>
                    <p class="text-2xl text-gray-400">
                        "You'll always need to write code yourself. AI can't
                        replace developers."
