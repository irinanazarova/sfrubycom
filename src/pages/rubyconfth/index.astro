---
import PresentationLayout from "../../layouts/PresentationLayout.astro";
import Slide from "../../components/Slide.astro";
import QuoteSlide from "../../components/QuoteSlide.astro";
import "../../styles/neon-rpg.css";
import { startups } from "../../data/startups.js";
import { speakers } from "../../data/speakers.js";

// Demo founders with photos - dynamically generated from startups/speakers data
const demoFounders = Object.values(startups)
    .filter((s) => s.speakerId && speakers[s.speakerId])
    .map((startup) => ({
        name: speakers[startup.speakerId].name,
        company: startup.name,
        image: speakers[startup.speakerId].image,
        logo: startup.logo,
    }));

// Startup data
const aiStartups = [
    {
        name: "Simple AI",
        description: "Enterprise voice agents",
        logo: "/startup_simpleai.png",
    },
    {
        name: "Sixfold",
        description: "AI insurance underwriting",
        logo: "/startup_sixfold.png",
    },
    {
        name: "Cactus",
        description: "AI lead qualification 24/7",
        logo: "/startup_cactus.png",
    },
    {
        name: "Superconductor",
        description: "Parallel coding agents",
        logo: "/startup_superconductor.png",
    },
    {
        name: "Bemi AI",
        description: "AI customer support agents",
        logo: "/startup_bemi.png",
    },
    {
        name: "Cleary",
        description: "AI HR platform",
        logo: "/startup_cleary.png",
    },
    {
        name: "LlamaPress",
        description: "AI content platform on Rails",
        logo: "/startup_llamapress.png",
    },
    {
        name: "CorePilot",
        description: "AI-powered ERP for aviation",
        logo: "/startup_corepilot.png",
    },
];


// Southeast Asian Ruby/Rails success stories
const seaCompanies = [
    { company: "Opn", country: "🇹🇭", detail: "Fintech unicorn" },
    { company: "Mekari", country: "🇮🇩", detail: "Indonesia's #1 SaaS" },
    { company: "CoinGecko", country: "🇲🇾", detail: "Crypto data platform" },
    { company: "Crypto.com", country: "🇸🇬", detail: "150M+ users exchange" },
    { company: "Nimble", country: "🇹🇭", detail: "Rails dev agency" },
    { company: "Mindvalley", country: "🇲🇾", detail: "Ed-tech platform" },
    { company: "Grain", country: "🇸🇬", detail: "Catering & food tech" },
    { company: "Quincus", country: "🇸🇬", detail: "Logistics SaaS" },
    { company: "Emeritus", country: "🇸🇬", detail: "Online education" },
    {
        company: "Funding Societies",
        country: "🇸🇬",
        detail: "SME lending platform",
    },
];
---

<PresentationLayout title="Startups on Rails 2026 - RubyConfTH Bangkok">
    <!-- Progress Bar -->
    <div class="progress-bar" id="progress"></div>

    <!-- ========================================
       OPENING: Slides 1-3
       ======================================== -->

    <!-- Slide 1: Title -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="Sawasdee ka! So excited to be here in Bangkok. And super grateful to be opening the two days of learning and sharing about Ruby here in Thailand"
    >
        <div>
            <p class="section-label mb-6">RubyConfTH Bangkok 2026</p>
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-8">
                <span class="gradient-text">Startups on Rails</span>
            </h1>
            <p
                class="text-[26px] md:text-3xl text-gray-400 mb-6 max-w-4xl mx-auto"
            >
                What I learned from 50+ founders.
            </p>
            <p class="text-[26px] text-gray-500">Irina Nazarova</p>
            <div
                class="reveal-item mt-10 animate-pulse-slow text-gray-600 text-[26px]"
            >
                ↓ Press arrow keys to navigate
            </div>
        </div>
    </Slide>

    <!-- Slide 1a: Thailand Photo -->
    <Slide
        layout="fullscreen"
        background="dark"
        notes=""
    >
        <img
            src="/thailand.jpg"
            alt="Thailand"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <p class="absolute inset-0 flex items-center justify-center text-black text-5xl font-bold z-10">PAGA Microroastery</p>
    </Slide>

    <!-- Slide 1b: About Me -->
    <Slide
        layout="two-column"
        background="dark"
        notes="A bit about me. CLICK — I run Evil Martians — we help startups scale with Ruby and Rails. CLICK — I co-created AnyCable for real-time apps. CLICK — And I organize SF Ruby meetup and conference in San Francisco. But two years ago, something started bothering me..."
    >
        <div class="grid md:grid-cols-5 items-center relative z-10">
            <div class="md:col-span-2 flex justify-center">
                <div
                    class="reveal-item w-44 h-44 md:w-56 md:h-56 rounded-full overflow-hidden border-4 border-[rgba(255,45,149,0.3)] shadow-[0_0_40px_rgba(255,45,149,0.2)]"
                >
                    <img
                        src="/speaker_irina.jpg"
                        alt="Irina Nazarova"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
            <div
                class="md:col-span-3 flex flex-col items-center justify-center"
            >
                <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">
                    Irina Nazarova
                </h2>
                <div class="flex items-center gap-8">
                    <img
                        src="/images/evilmartians.png"
                        alt="Evil Martians"
                        class="reveal-item h-36 md:h-44 object-contain"
                    />
                    <img
                        src="/images/anycable.png"
                        alt="AnyCable"
                        class="reveal-item h-36 md:h-44 object-contain"
                    />
                    <img
                        src="/images/sfruby.png"
                        alt="SF Ruby"
                        class="reveal-item h-36 md:h-44 object-contain"
                    />
                </div>
            </div>
        </div>
    </Slide>

    <!-- Slide 2: The Question -->
    <Slide
        layout="centered"
        background="dark"
        notes="CLICK — 'Are you STILL using Ruby?' That pause. That tone. CLICK — You've heard it. At conferences. From recruiters. From that friend who switched to Rust. I got tired of hearing it. So I decided to investigate."
    >
        <!-- Matrix Rain Background -->
        <div
            class="matrix-column"
            style="left: 5%; animation-duration: 8s; animation-delay: 0s;"
        >
            01Ruby10
        </div>
        <div
            class="matrix-column"
            style="left: 12%; animation-duration: 10s; animation-delay: 2s;"
        >
            死廃Legacy
        </div>
        <div
            class="matrix-column"
            style="left: 20%; animation-duration: 7s; animation-delay: 1s;"
        >
            Python
        </div>
        <div
            class="matrix-column"
            style="left: 28%; animation-duration: 9s; animation-delay: 3s;"
        >
            AITakeOver
        </div>
        <div
            class="matrix-column"
            style="left: 35%; animation-duration: 11s; animation-delay: 0.5s;"
        >
            Still???????
        </div>
        <div
            class="matrix-column"
            style="left: 65%; animation-duration: 8s; animation-delay: 1.5s;"
        >
            TypeScript
        </div>
        <div
            class="matrix-column"
            style="left: 72%; animation-duration: 10s; animation-delay: 2.5s;"
        >
            01100110
        </div>
        <div
            class="matrix-column"
            style="left: 80%; animation-duration: 7s; animation-delay: 0.8s;"
        >
            Dead???!!!
        </div>
        <div
            class="matrix-column"
            style="left: 88%; animation-duration: 9s; animation-delay: 3.5s;"
        >
            恐怖Fear
        </div>
        <div
            class="matrix-column"
            style="left: 95%; animation-duration: 12s; animation-delay: 1.2s;"
        >
            00110101
        </div>
        <div class="matrix-glow-line" style="right: 5%; animation-delay: 0s;">
        </div>
        <div class="matrix-glow-line" style="right: 15%; animation-delay: 1s;">
        </div>
        <div class="relative z-10">
            <p class="reveal-item section-label mb-8">The Question</p>
            <h2
                class="reveal-item text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-8"
            >
                "Are you <span class="fear-text">still</span> using Ruby?"
            </h2>
            <p class="reveal-item text-[26px] text-gray-400 max-w-4xl mx-auto">
                You've heard it. At conferences. From recruiters. From that
                friend who switched to Rust.
            </p>
        </div>
    </Slide>

    <!-- Slide 3: My Journey -->
    <Slide
        layout="stacked"
        background="gradient-purple"
        notes="CLICK — 50+ founders interviewed. CLICK — Six talks given. CLICK — One conference organized — first Ruby conference in San Francisco in ten years. CLICK — 25 Rails startups we serve at Evil Martians. What I found surprised me. Let me take you through it."
    >
        <div>
            <p class="reveal-item section-label mb-6">Context</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="reveal-item text-center">
                    <div
                        class="text-6xl md:text-7xl font-black gradient-text mb-3"
                    >
                        50+
                    </div>
                    <div class="text-[26px] text-gray-300">
                        founders interviewed
                    </div>
                </div>
                <div class="reveal-item text-center">
                    <div
                        class="text-6xl md:text-7xl font-black text-neon-cyan mb-3"
                        style="text-shadow: 0 0 30px rgba(0,255,255,0.4);"
                    >
                        6
                    </div>
                    <div class="text-[26px] text-gray-300">talks given</div>
                </div>
                <div class="reveal-item text-center">
                    <div
                        class="text-6xl md:text-7xl font-black text-neon-magenta mb-3"
                        style="text-shadow: 0 0 30px rgba(255,45,149,0.4);"
                    >
                        1
                    </div>
                    <div class="text-[26px] text-gray-300">
                        conference organized
                    </div>
                </div>
                <div class="reveal-item text-center">
                    <div
                        class="text-6xl md:text-7xl font-black text-neon-green mb-3"
                        style="text-shadow: 0 0 30px rgba(0,204,102,0.4);"
                    >
                        25
                    </div>
                    <div class="text-[26px] text-gray-300">
                        Rails startups services at Evil Martians
                    </div>
                </div>
            </div>
        </div>
    </Slide>

    <!-- ========================================
       THE FEAR: Slides 4-10
       ======================================== -->

    <!-- Slide 4: Section Title - Fear -->
    <Slide
        layout="centered"
        background="dark"
        notes="Here's what I found first. CLICK — The Fear."
    >
        <div>
            <p class="reveal-item section-label mb-4">Part One</p>
            <h2 class="reveal-item text-5xl md:text-7xl font-black text-white">
                The Fear
            </h2>
        </div>
    </Slide>

    <!-- Slide 5: The Hero -->
    <Slide
        layout="stacked"
        background="gradient-pink"
        notes="Let me tell you about our hero. CLICK — A Ruby engineer who loves Ruby. CLICK — You've built things. You've shipped. CLICK — Ruby feels right. CLICK — But lately..."
    >
        <div>
            <p class="reveal-item section-label mb-4">Our Hero</p>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                A Ruby engineer who loves Ruby.
            </h2>
            <div class="space-y-4 text-[26px] text-gray-300">
                <p class="reveal-item">
                    You've built things. You've shipped products. You're
                    productive.
                </p>
                <p class="reveal-item">
                    Ruby feels <span class="text-white">right</span>.
                </p>
                <p class="reveal-item text-[26px] text-gray-500 mt-4">
                    But lately...
                </p>
            </div>
        </div>
    </Slide>

    <!-- Slide 6: The Anxiety -->
    <Slide
        layout="stacked"
        background="dark"
        notes="The anxiety creeps in. CLICK — AI is taking our jobs — every headline. CLICK — Python owns machine learning. CLICK — JavaScript owns the web. CLICK — Ruby is big in Japan. But is that enough? Here's what's really going on underneath."
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The anxiety creeps in.
            </h2>
            <div class="space-y-5">
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-red font-mono text-[26px]">[!]</span>
                    <p class="text-[26px] text-gray-300">
                        AI is "taking our jobs." Every headline says so.
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-yellow font-mono text-[26px]"
                        >[~]</span
                    >
                    <p class="text-[26px] text-gray-300">
                        Python owns machine learning. Every tutorial is Python.
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-yellow font-mono text-[26px]"
                        >[~]</span
                    >
                    <p class="text-[26px] text-gray-300">
                        JavaScript owns the web. TypeScript is "the future."
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-cyan font-mono text-[26px]">[?]</span
                    >
                    <p class="text-[26px] text-gray-300">
                        Ruby is big in Japan. But Japan is... "different"?
                    </p>
                </div>
            </div>
        </div>
    </Slide>

    <!-- Slide 7: The Real Question -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="The real question. CLICK — How do I secure my career for the next ten years? CLICK — Should I learn Python? ML? Drop Ruby? And that fear does something to us."
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The real question you're asking:
            </h2>
            <p
                class="reveal-item text-[26px] md:text-3xl text-gray-300 leading-relaxed"
            >
                "How do I secure my career and my family's future<br />
                <span class="text-white font-semibold"
                    >for the next ten years?</span
                >"
            </p>
            <div
                class="reveal-item mt-6 flex flex-wrap justify-center gap-4 text-[26px]"
            >
                <span class="rpg-list-item px-4 py-2">Learn Python?</span>
                <span class="rpg-list-item px-4 py-2">Learn ML?</span>
                <span class="rpg-list-item px-4 py-2">Drop Ruby?</span>
            </div>
        </div>
    </Slide>

    <!-- Slide 8: The Shame -->
    <Slide
        layout="stacked"
        background="dark"
        notes="The Shame. CLICK — Founders don't mention Ruby to investors. CLICK — Engineers hedge: 'We use Rails, but we're considering...' CLICK — Job posts hide the word Ruby. So how do we deal with this?"
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                The Shame
            </h2>

            <div class="space-y-5">
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-red font-mono text-[26px]">[$]</span>
                    <p class="text-[26px] text-gray-300">
                        Founders don't mention Ruby to investors.
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-yellow font-mono text-[26px]"
                        >[#]</span
                    >
                    <p class="text-[26px] text-gray-300">
                        Engineers hedge: "We use Rails, <span
                            class="text-gray-500">but we're considering...</span
                        >"
                    </p>
                </div>
                <div class="reveal-item anim-glitch flex items-start gap-4">
                    <span class="text-neon-pink font-mono text-[26px]">[~]</span
                    >
                    <p class="text-[26px] text-gray-300">
                        Job posts avoid saying "Ruby" in the title.
                    </p>
                </div>
            </div>
        </div>
    </Slide>

    <!-- Slide 9: Fear Responses -->
    <Slide
        layout="fullscreen"
        background="gradient-pink"
        notes="How we respond to fear. CLICK — Denial: 'Ruby is fine.' CLICK — Shame: 'I don't mention Ruby anymore.' CLICK — Flight: 'Learning Rust on weekends.' CLICK — Defensiveness: 'Ruby has ALWAYS been underrated!' Sound familiar? We need a different way."
    >
        <div class="w-full h-full flex flex-col justify-center px-8">
            <h2
                class="reveal-item text-3xl md:text-5xl font-bold text-white mb-8 text-center"
            >
                How we respond to fear:
            </h2>
            <div class="grid md:grid-cols-2 gap-6 flex-1 max-h-[70vh]">
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h2 class="text-neon-magenta font-bold mb-2">Denial</h2>
                        <p class="text-gray-400 text-[26px] md:text-3xl">
                            "Ruby is fine. Nothing's changing. Those people
                            don't know what they're talking about."s
                        </p>
                    </div>
                    <img
                        src="/images/fear1.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h2 class="text-neon-magenta font-bold mb-2">Shame</h2>
                        <p class="text-gray-400 text-[26px] md:text-3xl">
                            "I don't mention Ruby anymore. I say 'backend' and
                            hope they don't ask."
                        </p>
                    </div>
                    <img
                        src="/images/fear2.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h2 class="text-neon-magenta font-bold mb-2">Flight</h2>
                        <p class="text-gray-400 text-[26px] md:text-3xl">
                            "I'm learning Rust on weekends. Just in case."
                        </p>
                    </div>
                    <img
                        src="/images/fear3.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
                <div
                    class="reveal-item anim-neon-flicker rpg-card flex items-center gap-6 p-6"
                >
                    <div class="flex-1">
                        <h2 class="text-neon-magenta font-bold mb-2">
                            Defensiveness
                        </h2>
                        <p class="text-gray-400 text-[26px] md:text-3xl">
                            "Ruby has ALWAYS been underrated! You just don't
                            understand!"
                        </p>
                    </div>
                    <img
                        src="/images/fear4.png"
                        alt=""
                        class="w-32 h-32 md:w-40 md:h-40 object-contain flex-shrink-0"
                    />
                </div>
            </div>
        </div>
    </Slide>

    <!-- ========================================
       THE MENTOR: Slides 11-14
       ======================================== -->

    <!-- Slide 11: Section Title - Mentor -->
    <Slide
        layout="centered"
        background="gradient-purple"
        notes="We seek guidance. Someone who's seen this before. CLICK — The Mentor."
    >
        <!-- Constellation Background - Wisdom -->
        <div class="constellation-container">
            <div
                class="star large"
                style="top: 15%; left: 20%; animation-delay: 0s;"
            >
            </div>
            <div
                class="star"
                style="top: 25%; left: 30%; animation-delay: 0.5s;"
            >
            </div>
            <div class="star" style="top: 10%; left: 45%; animation-delay: 1s;">
            </div>
            <div
                class="star large"
                style="top: 20%; right: 25%; animation-delay: 0.3s;"
            >
            </div>
            <div
                class="star"
                style="top: 30%; right: 15%; animation-delay: 0.8s;"
            >
            </div>
            <div
                class="star"
                style="top: 70%; left: 15%; animation-delay: 1.2s;"
            >
            </div>
            <div
                class="star large"
                style="top: 80%; left: 35%; animation-delay: 0.6s;"
            >
            </div>
            <div
                class="star"
                style="top: 75%; right: 20%; animation-delay: 1.5s;"
            >
            </div>
            <div
                class="star"
                style="top: 85%; right: 35%; animation-delay: 0.2s;"
            >
            </div>
            <div
                class="star-line"
                style="top: 17%; left: 22%; width: 80px; transform: rotate(20deg);"
            >
            </div>
            <div
                class="star-line"
                style="top: 22%; left: 32%; width: 100px; transform: rotate(-35deg);"
            >
            </div>
            <div
                class="star-line"
                style="top: 78%; left: 17%; width: 120px; transform: rotate(15deg);"
            >
            </div>
        </div>
        <div class="relative z-10">
            <p class="reveal-item section-label mb-4">Part Two</p>
            <h2 class="reveal-item text-5xl md:text-7xl font-black text-white">
                The Mentor
            </h2>
        </div>
    </Slide>

    <!-- Slide 12: Sarah Mei -->
    <QuoteSlide
        quote="Operating from a place of fear is not helpful to us as individuals, as an industry, as a society."
        author="Sarah Mei"
        authorImage="/speaker_sarah.jpg"
        context="SF Ruby Conference 2025"
        label="Wisdom"
        bio="Sarah has been in Ruby since 2006. She founded RailsBridge. She's seen every shift."
        color="cyan"
        notes="Sarah Mei — in Ruby since 2006, founded RailsBridge. At our SF Ruby Conference she said: operating from fear is not helpful. Not to us. Not to anyone. And she's right. Because look at history."
    />

    <!-- Slide 13: Historical Parallels -->
    <Slide
        layout="stacked"
        background="gradient-purple"
        notes="Every major shift felt like the end. CLICK — VMs in the 90s: 'You can't run a VM in production!' CLICK — Cloud in the 2000s: 'You need your own hardware!' CLICK — AI now: 'You'll always need to write code yourself!' But what actually happened?"
    >
        <div>
            <h2
                class="reveal-item text-3xl md:text-4xl font-bold text-white mb-8"
            >
                Every major shift felt like the end.
            </h2>
            <div class="space-y-4">
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">
                            Virtual Machines (Late 90s)
                        </h3>
                        <span class="text-gray-500 text-[26px]">Java</span>
                    </div>
                    <p class="text-[26px] text-gray-400">
                        "You'll never run a VM in production. You need
                        hand-tuned memory."
                    </p>
                </div>
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">
                            Cloud (Mid 2000s)
                        </h3>
                        <span class="text-gray-500 text-[26px]">AWS</span>
                    </div>
                    <p class="text-[26px] text-gray-400">
                        "You need to control your own hardware. Cloud will never
                        work for serious apps."
                    </p>
                </div>
                <div
                    class="reveal-item bg-[var(--dark-surface)] p-4 rounded-xl"
                >
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-neon-cyan font-bold">AI (Now)</h3>
                        <span class="text-gray-500 text-[26px]">LLMs</span>
                    </div>
                    <p class="text-[26px] text-gray-400">
                        "You'll always need to write code yourself. AI can't
