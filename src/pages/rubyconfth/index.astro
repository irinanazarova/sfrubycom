    <script>
        // ========================================
        // PREVIEW MODE DETECTION
        // ========================================
        // When loaded in iframe with ?preview=1, disable all interactivity
        const isPreviewMode = new URLSearchParams(window.location.search).has(
            "preview",
        );
        const isInIframe = window.self !== window.top;

        // In preview mode: hide UI, disable scroll, show single slide, disable animations
        if (isPreviewMode) {
            document.documentElement.style.overflow = "hidden";
            document.body.style.overflow = "hidden";
            document.body.classList.add("preview-mode");
        }

        const slides = document.querySelectorAll(".slide");
        const totalSlides = slides.length;
        const progressBar = document.getElementById("progress");
        const currentSlideEl = document.getElementById("current-slide");
        const totalSlidesEl = document.getElementById("total-slides");

        // Update total slides count
        if (totalSlidesEl) totalSlidesEl.textContent = totalSlides;

        // Track current slide
        let currentSlideIndex = 0;

        // Get all reveal items for a slide
        function getRevealItems(slide) {
            return slide.querySelectorAll(".reveal-item");
        }

        // Get unrevealed items for a slide
        function getUnrevealedItems(slide) {
            return slide.querySelectorAll(".reveal-item:not(.revealed)");
        }

        // Check if slide has reveal items
        function hasRevealItems(slide) {
            return getRevealItems(slide).length > 0;
        }

        // Reveal next item on current slide
        function revealNextItem() {
            const currentSlide = slides[currentSlideIndex];
            const unrevealed = getUnrevealedItems(currentSlide);

            if (unrevealed.length > 0) {
                unrevealed[0].classList.add("revealed");
                return true; // Item was revealed
            }
            return false; // No items to reveal
        }

        // Reveal first item only (for entering a slide)
        function revealFirstItem(slide) {
            const items = getRevealItems(slide);
            if (items.length > 0) {
                items[0].classList.add("revealed");
            }
        }

        // Reveal all items on a slide
        function revealAllItems(slide) {
            const items = getRevealItems(slide);
            items.forEach((item) => item.classList.add("revealed"));
        }

        // Hide all items on a slide
        function hideAllItems(slide) {
            const items = getRevealItems(slide);
            items.forEach((item) => item.classList.remove("revealed"));
        }

        // Update slide number display
        function updateSlideNumber() {
            currentSlideEl.textContent = currentSlideIndex + 1;
        }

        // Update progress bar
        function updateProgress() {
            const progress = currentSlideIndex / (totalSlides - 1);
            progressBar.style.transform = `scaleX(${progress})`;
        }

        // Update URL hash without triggering scroll
        function updateHash(index) {
            const slideNum = index + 1;
            history.replaceState(null, "", `#${slideNum}`);
        }

        // Go to specific slide
        function goToSlide(index, revealAll = false) {
            if (index < 0 || index >= totalSlides) return;

            currentSlideIndex = index;
            window.scrollTo({
                top: slides[index].offsetTop,
                behavior: "smooth",
            });

            // Reveal items based on navigation direction
            if (revealAll) {
                revealAllItems(slides[index]);
            } else {
                // For forward navigation, reveal first item only
                revealFirstItem(slides[index]);
            }

            updateSlideNumber();
            updateProgress();
            updateHash(index);
        }

        // Keyboard navigation with progressive reveal
        // Skip in preview mode (iframe previews)
        if (!isPreviewMode)
            document.addEventListener("keydown", (e) => {
                if (
                    e.key === "ArrowDown" ||
                    e.key === " " ||
                    e.key === "PageDown" ||
                    e.key === "ArrowRight"
                ) {
                    e.preventDefault();

                    const currentSlide = slides[currentSlideIndex];

                    // If slide has reveal items, try to reveal next one
                    if (hasRevealItems(currentSlide)) {
                        const revealed = revealNextItem();

                        // If no more items to reveal, go to next slide
                        if (!revealed && currentSlideIndex < totalSlides - 1) {
                            currentSlideIndex++;
                            goToSlide(currentSlideIndex);
                        }
                    } else {
                        // No reveal items, just go to next slide
                        if (currentSlideIndex < totalSlides - 1) {
                            currentSlideIndex++;
                            goToSlide(currentSlideIndex);
                        }
                    }
                    // Sync presenter view
                    if (typeof broadcastState === "function") broadcastState();
                } else if (
                    e.key === "ArrowUp" ||
                    e.key === "PageUp" ||
                    e.key === "ArrowLeft"
                ) {
                    e.preventDefault();

                    // Go to previous slide - reset its state for fresh reveal
                    if (currentSlideIndex > 0) {
                        currentSlideIndex--;
                        hideAllItems(slides[currentSlideIndex]);
                        goToSlide(currentSlideIndex, false);
                    }
                    // Sync presenter view
                    if (typeof broadcastState === "function") broadcastState();
                } else if (e.key === "Home") {
                    e.preventDefault();
                    hideAllItems(slides[0]);
                    goToSlide(0);
                    if (typeof broadcastState === "function") broadcastState();
                } else if (e.key === "End") {
                    e.preventDefault();
                    goToSlide(totalSlides - 1, true);
                    if (typeof broadcastState === "function") broadcastState();
                }
            });

        // Sync slide number on scroll (for mouse/trackpad scrolling)
        // Skip in preview mode
        if (!isPreviewMode) {
            const slideObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (
                            entry.isIntersecting &&
                            entry.intersectionRatio > 0.5
                        ) {
                            const slideIndex = Array.from(slides).indexOf(
                                entry.target,
                            );
                            if (slideIndex !== currentSlideIndex) {
                                const previousIndex = currentSlideIndex;
                                currentSlideIndex = slideIndex;
                                updateSlideNumber();
                                updateProgress();
                                updateHash(slideIndex);

                                // Going BACKWARDS (scrolling up)? Reset the slide we're entering
                                if (slideIndex < previousIndex) {
                                    hideAllItems(entry.target);
                                    revealFirstItem(entry.target);
                                } else {
                                    // Going forward - reveal all items
                                    revealAllItems(entry.target);
                                }
                                // Sync presenter view
                                if (typeof broadcastState === "function")
                                    broadcastState();
                            }
                        }
                    });
                },
                { threshold: 0.5 },
            );

            slides.forEach((slide) => slideObserver.observe(slide));
        }

        // Parse slide number from hash or query param
        function getSlideFromHash() {
            // In preview mode, use ?slide=X query param
            const params = new URLSearchParams(window.location.search);
            const slideParam = params.get("slide");
            if (slideParam) {
                const slideNum = parseInt(slideParam, 10);
                if (
                    !isNaN(slideNum) &&
                    slideNum >= 1 &&
                    slideNum <= totalSlides
                ) {
                    return slideNum - 1; // Convert to 0-indexed
                }
            }

            // Otherwise use hash #X
            const hash = window.location.hash;
            if (hash) {
                const slideNum = parseInt(hash.replace("#", ""), 10);
                if (
                    !isNaN(slideNum) &&
                    slideNum >= 1 &&
                    slideNum <= totalSlides
                ) {
                    return slideNum - 1; // Convert to 0-indexed
                }
            }
            return 0;
        }

        // Initialize - check for hash/query or start at first slide
        const initialSlide = getSlideFromHash();

        if (isPreviewMode) {
            // PREVIEW MODE: Show only the target slide, hide everything else
            const footer = document.querySelector(".fixed-footer");
            const progressEl = document.getElementById("progress");
            if (footer) footer.style.display = "none";
            if (progressEl) progressEl.style.display = "none";

            // Get revealed count from query param
            const params = new URLSearchParams(window.location.search);
            const revealedParam = params.get("revealed");
            const revealCount =
                revealedParam === "all"
                    ? Infinity
                    : parseInt(revealedParam, 10) || 0;

            // Hide all slides except target
            slides.forEach((slide, i) => {
                if (i === initialSlide) {
                    slide.style.display = "flex";
                    // Reveal only up to revealCount items
                    const items = slide.querySelectorAll(".reveal-item");
                    items.forEach((item, idx) => {
                        if (idx < revealCount) {
                            item.classList.add("revealed");
                        }
                    });
                } else {
                    slide.style.display = "none";
                }
            });
        } else if (initialSlide > 0) {
            // Jump to slide from hash, reveal all items
            currentSlideIndex = initialSlide;
            revealAllItems(slides[initialSlide]);
            slides[initialSlide].scrollIntoView();
            updateSlideNumber();
            updateProgress();
            updateHash(initialSlide);
        } else {
            // Start at first slide
            revealFirstItem(slides[0]);
            updateSlideNumber();
            updateProgress();
            updateHash(0);
        }

        // Handle browser back/forward buttons (skip in preview mode)
        if (!isPreviewMode)
            window.addEventListener("popstate", () => {
                const slideIndex = getSlideFromHash();
                if (slideIndex !== currentSlideIndex) {
                    currentSlideIndex = slideIndex;
                    revealAllItems(slides[slideIndex]);
                    slides[slideIndex].scrollIntoView({ behavior: "smooth" });
                    updateSlideNumber();
                    updateProgress();
                    // Sync presenter view
                    if (typeof broadcastState === "function") broadcastState();
                }
            });

        // ========================================
        // COUNTER ANIMATION - Numbers count up
        // ========================================
        // Usage: <span class="counter" data-target="40" data-suffix="M">0</span>
        // Will count from 0 to 40 when revealed

        function animateCounter(el) {
            const target = parseInt(el.dataset.target) || 0;
            const duration = parseInt(el.dataset.duration) || 1500;
            const suffix = el.dataset.suffix || "";
            const prefix = el.dataset.prefix || "";
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                // Ease out cubic
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(eased * target);

                el.textContent = prefix + current + suffix;

                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }

            requestAnimationFrame(update);
        }

        // Observe counters and trigger when they become visible
        const counterObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting && !entry.target.dataset.counted) {
                        entry.target.dataset.counted = "true";
                        animateCounter(entry.target);
                    }
                });
            },
            { threshold: 0.5 },
        );

        document.querySelectorAll(".counter").forEach((counter) => {
            counterObserver.observe(counter);
        });

        // ========================================
        // GLITCH ANIMATION TRIGGER
        // ========================================
        // Add .anim-glitch or .anim-jitter to elements that should glitch when revealed
        // They'll animate once when the .revealed class is added

        // ========================================
        // PRESENTER MODE - BroadcastChannel Sync
        // ========================================
        // Press 'P' to open presenter view
        // Both windows stay in sync via BroadcastChannel
        // IMPORTANT: Skip all this if we're in preview mode or inside an iframe

        // No-op function for preview/iframe - prevents errors from keyboard handler calls
        function broadcastState() {
            // Only broadcast if not in preview mode or iframe
            if (isPreviewMode || isInIframe) return;

            const currentSlide = slides[currentSlideIndex];
            const revealedCount = currentSlide.querySelectorAll(
                ".reveal-item.revealed",
            ).length;
            const totalReveals =
                currentSlide.querySelectorAll(".reveal-item").length;
            const notes = currentSlide.dataset.notes || "";

            window._presenterChannel?.postMessage({
                type: "slide-update",
                slideIndex: currentSlideIndex,
                revealedCount: revealedCount,
                totalReveals: totalReveals,
                notes: notes,
                timestamp: Date.now(),
            });
        }

        // Only set up BroadcastChannel if NOT in preview mode or iframe
        if (!isPreviewMode && !isInIframe) {
            window._presenterChannel = new BroadcastChannel(
                "presentation-sync",
            );

            // Listen for control messages from presenter view
            window._presenterChannel.onmessage = (event) => {
                const data = event.data;

                if (data.type === "goto-slide") {
                    if (data.slideIndex !== currentSlideIndex) {
                        currentSlideIndex = data.slideIndex;
                        if (data.revealAll) {
                            revealAllItems(slides[currentSlideIndex]);
                        } else {
                            hideAllItems(slides[currentSlideIndex]);
                            revealFirstItem(slides[currentSlideIndex]);
                        }
                        slides[currentSlideIndex].scrollIntoView({
                            behavior: "smooth",
                        });
                        updateSlideNumber();
                        updateProgress();
                        updateHash(currentSlideIndex);
                        broadcastState();
                    }
                } else if (data.type === "next-step") {
                    // Trigger next reveal/slide
                    const currentSlide = slides[currentSlideIndex];
                    if (hasRevealItems(currentSlide)) {
                        const revealed = revealNextItem();
                        if (!revealed && currentSlideIndex < totalSlides - 1) {
                            currentSlideIndex++;
                            goToSlide(currentSlideIndex);
                        }
                    } else if (currentSlideIndex < totalSlides - 1) {
                        currentSlideIndex++;
                        goToSlide(currentSlideIndex);
                    }
                    broadcastState();
                } else if (data.type === "prev-step") {
                    if (currentSlideIndex > 0) {
                        currentSlideIndex--;
                        hideAllItems(slides[currentSlideIndex]);
                        goToSlide(currentSlideIndex, false);
                    }
                    broadcastState();
                } else if (data.type === "request-state") {
                    broadcastState();
                }
            };

            // Keyboard shortcuts only for main window
            document.addEventListener("keydown", (e) => {
                // Open presenter view with 'P' key
                if (
                    (e.key === "p" || e.key === "P") &&
                    !e.ctrlKey &&
                    !e.metaKey
                ) {
                    e.preventDefault();
                    window.open(
                        "/rubyconfth/presenter",
                        "presenter-view",
                        "width=1400,height=900,menubar=no,toolbar=no",
                    );
                    return;
                }
                // Black screen with 'B' key
                if (
                    (e.key === "b" || e.key === "B") &&
                    !e.ctrlKey &&
                    !e.metaKey
                ) {
                    document.body.classList.toggle("blackout");
                    return;
                }
            });

            // Broadcast initial state
            setTimeout(broadcastState, 500);
        }
    </script>
</PresentationLayout>
