// Southeast Asian Ruby/Rails success stories
const seaFounders = [
    {
        name: "Jun Hasegawa",
        company: "Opn",
        country: "🇯🇵",
        origin: "Japan",
        metric: "$1B",
        detail: "Thailand's fintech unicorn",
    },
    {
        name: "Ezra Don Harinsut",
        company: "Opn",
        country: "🇹🇭",
        origin: "Thailand",
        metric: "$1B",
        detail: "Started in a Bangkok Starbucks",
    },
    {
        name: "Nadiem Makarim",
        company: "Gojek",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$28B",
        detail: "Decacorn → Education Minister",
    },
    {
        name: "Tessa Wijaya",
        company: "Xendit",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$1B",
        detail: "First female founder to unicorn in ID",
    },
    {
        name: "Suwandi Soh",
        company: "Mekari",
        country: "🇮🇩",
        origin: "Indonesia",
        metric: "$97M ARR",
        detail: "Indonesia's #1 SaaS, Rails 7",
    },
    {
        name: "Bobby Ong",
