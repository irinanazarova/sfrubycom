    <script>
        const slides = document.querySelectorAll(".slide");
        const totalSlides = slides.length;
        const progressBar = document.getElementById("progress");
        const currentSlideEl = document.getElementById("current-slide");
        const totalSlidesEl = document.getElementById("total-slides");

        // Update total slides count
        totalSlidesEl.textContent = totalSlides;

        // Track current slide
        let currentSlideIndex = 0;

        // Get all reveal items for a slide
        function getRevealItems(slide) {
            return slide.querySelectorAll(".reveal-item");
        }

        // Get unrevealed items for a slide
        function getUnrevealedItems(slide) {
            return slide.querySelectorAll(".reveal-item:not(.revealed)");
        }

        // Check if slide has reveal items
        function hasRevealItems(slide) {
            return getRevealItems(slide).length > 0;
        }

        // Reveal next item on current slide
        function revealNextItem() {
            const currentSlide = slides[currentSlideIndex];
            const unrevealed = getUnrevealedItems(currentSlide);

            if (unrevealed.length > 0) {
                unrevealed[0].classList.add("revealed");
                return true; // Item was revealed
            }
            return false; // No items to reveal
        }

        // Reveal first item only (for entering a slide)
        function revealFirstItem(slide) {
            const items = getRevealItems(slide);
            if (items.length > 0) {
                items[0].classList.add("revealed");
            }
        }

        // Reveal all items on a slide
        function revealAllItems(slide) {
            const items = getRevealItems(slide);
            items.forEach((item) => item.classList.add("revealed"));
        }

        // Hide all items on a slide
        function hideAllItems(slide) {
            const items = getRevealItems(slide);
            items.forEach((item) => item.classList.remove("revealed"));
        }

        // Update slide number display
        function updateSlideNumber() {
            currentSlideEl.textContent = currentSlideIndex + 1;
        }

        // Update progress bar
        function updateProgress() {
            const progress = currentSlideIndex / (totalSlides - 1);
            progressBar.style.transform = `scaleX(${progress})`;
        }

        // Update URL hash without triggering scroll
        function updateHash(index) {
            const slideNum = index + 1;
            history.replaceState(null, '', `#${slideNum}`);
        }

        // Go to specific slide
        function goToSlide(index, revealAll = false) {
            if (index < 0 || index >= totalSlides) return;

            currentSlideIndex = index;
            window.scrollTo({
                top: slides[index].offsetTop,
                behavior: "smooth",
            });

            // Reveal items based on navigation direction
            if (revealAll) {
                revealAllItems(slides[index]);
            } else {
                // For forward navigation, reveal first item only
                revealFirstItem(slides[index]);
            }

            updateSlideNumber();
            updateProgress();
            updateHash(index);
        }

        // Keyboard navigation with progressive reveal
        document.addEventListener("keydown", (e) => {
            if (
                e.key === "ArrowDown" ||
                e.key === " " ||
                e.key === "PageDown" ||
                e.key === "ArrowRight"
            ) {
                e.preventDefault();

                const currentSlide = slides[currentSlideIndex];

                // If slide has reveal items, try to reveal next one
                if (hasRevealItems(currentSlide)) {
                    const revealed = revealNextItem();

                    // If no more items to reveal, go to next slide
                    if (!revealed && currentSlideIndex < totalSlides - 1) {
                        currentSlideIndex++;
                        goToSlide(currentSlideIndex);
                    }
                } else {
                    // No reveal items, just go to next slide
                    if (currentSlideIndex < totalSlides - 1) {
                        currentSlideIndex++;
                        goToSlide(currentSlideIndex);
                    }
                }
            } else if (
                e.key === "ArrowUp" ||
                e.key === "PageUp" ||
                e.key === "ArrowLeft"
            ) {
                e.preventDefault();

                // Go to previous slide - reset its state for fresh reveal
                if (currentSlideIndex > 0) {
                    currentSlideIndex--;
                    hideAllItems(slides[currentSlideIndex]);
                    goToSlide(currentSlideIndex, false);
                }
            } else if (e.key === "Home") {
                e.preventDefault();
                hideAllItems(slides[0]);
                goToSlide(0);
            } else if (e.key === "End") {
                e.preventDefault();
                goToSlide(totalSlides - 1, true);
            }
        });

        // Sync slide number on scroll (for mouse/trackpad scrolling)
        const slideObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
                        const slideIndex = Array.from(slides).indexOf(
                            entry.target,
                        );
                        if (slideIndex !== currentSlideIndex) {
                            const previousIndex = currentSlideIndex;
                            currentSlideIndex = slideIndex;
                            updateSlideNumber();
                            updateProgress();
                            updateHash(slideIndex);

                            // Going BACKWARDS (scrolling up)? Reset the slide we're entering
                            if (slideIndex < previousIndex) {
                                hideAllItems(entry.target);
                                revealFirstItem(entry.target);
                            } else {
                                // Going forward - reveal all items
                                revealAllItems(entry.target);
                            }
                        }
                    }
                });
            },
            { threshold: 0.5 },
        );

        slides.forEach((slide) => slideObserver.observe(slide));

        // Parse initial hash and go to slide
        function getSlideFromHash() {
            const hash = window.location.hash;
            if (hash) {
                const slideNum = parseInt(hash.replace('#', ''), 10);
                if (!isNaN(slideNum) && slideNum >= 1 && slideNum <= totalSlides) {
                    return slideNum - 1; // Convert to 0-indexed
                }
            }
            return 0;
        }

        // Initialize - check for hash or start at first slide
        const initialSlide = getSlideFromHash();
        if (initialSlide > 0) {
            // Jump to slide from hash, reveal all items
            currentSlideIndex = initialSlide;
            revealAllItems(slides[initialSlide]);
            slides[initialSlide].scrollIntoView();
            updateSlideNumber();
            updateProgress();
            updateHash(initialSlide);
        } else {
            // Start at first slide
            revealFirstItem(slides[0]);
            updateSlideNumber();
            updateProgress();
            updateHash(0);
        }

        // Handle browser back/forward buttons
        window.addEventListener('popstate', () => {
            const slideIndex = getSlideFromHash();
            if (slideIndex !== currentSlideIndex) {
                currentSlideIndex = slideIndex;
                revealAllItems(slides[slideIndex]);
                slides[slideIndex].scrollIntoView({ behavior: 'smooth' });
                updateSlideNumber();
                updateProgress();
            }
        });

        // ========================================
        // COUNTER ANIMATION - Numbers count up
        // ========================================
        // Usage: <span class="counter" data-target="40" data-suffix="M">0</span>
        // Will count from 0 to 40 when revealed

        function animateCounter(el) {
            const target = parseInt(el.dataset.target) || 0;
            const duration = parseInt(el.dataset.duration) || 1500;
            const suffix = el.dataset.suffix || "";
            const prefix = el.dataset.prefix || "";
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                // Ease out cubic
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(eased * target);

                el.textContent = prefix + current + suffix;

                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }

            requestAnimationFrame(update);
        }

        // Observe counters and trigger when they become visible
        const counterObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting && !entry.target.dataset.counted) {
                        entry.target.dataset.counted = "true";
                        animateCounter(entry.target);
                    }
                });
            },
            { threshold: 0.5 },
        );

        document.querySelectorAll(".counter").forEach((counter) => {
            counterObserver.observe(counter);
        });

        // ========================================
        // GLITCH ANIMATION TRIGGER
        // ========================================
        // Add .anim-glitch or .anim-jitter to elements that should glitch when revealed
        // They'll animate once when the .revealed class is added
    </script>

