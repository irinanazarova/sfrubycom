    },
    { name: "Sixfold", metric: "Insurance AI", founder: "Brian Moseley" },
    {
        name: "RubyLLM",
        metric: "3,452 GitHub stars",
        founder: "Carmine Paolino",
    },
    { name: "Cactus", metric: "AI call center", founder: "YC X25" },
];

const scaleProof = [
    { company: "Intercom", metric: "2M req/sec", detail: "14 years on Rails" },
    { company: "Shopify", metric: "80M req/min", detail: "Black Friday 2024" },
    { company: "AngelList", metric: "$100B+ managed", detail: "~30 engineers" },
