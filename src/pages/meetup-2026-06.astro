---
import "../styles/global.css";

// SF Ruby Meetup @ PlanetScale — June 18, 2026
// Single standby slide shown before and between the talks.
// Fixed 1920x1080 canvas, scaled to fit the viewport (no overflow).
// PDF export: see memory/pdf-export.md.

const agenda = [
    { time: "5:00 PM", title: "Doors open", detail: "Food, drinks, mingling" },
    { time: "5:30 PM", title: "Welcome + community announcements" },
    { time: "5:40 PM", title: "Discoverability of Ruby & Rails Resources for LLMs", who: "Irina Nazarova · Evil Martians" },
    { time: "5:50 PM", title: "Local-first Rails with pglite and Electric: A Demo", who: "Irina Nazarova · Evil Martians" },
    { time: "6:00 PM", title: "Implementing Core Set", who: "Jeremy Evans · Ubicloud" },
    { time: "6:30 PM", title: "ActiveJob: Call Me Maybe", who: "Hal Spitz" },
    { time: "7:00 PM", title: "Break" },
    { time: "7:20 PM", title: "Networking", detail: "30 seconds each on stage, no slides — then connect" },
    { time: "8:30 PM", title: "Wrap" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="description" content="SF Ruby Meetup at PlanetScale — June 18, 2026" />
        <meta name="theme-color" content="#1e3a8a" />
        <title>SF Ruby Meetup @ PlanetScale — June 18, 2026</title>
        <link rel="preload" href="/fonts/MartianGrotesk.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/MartianMono.woff2" as="font" type="font/woff2" crossorigin />
    </head>
    <body class="deck">
        <div class="stage" id="stage">

            <!-- Header -->
            <header class="hdr">
                <div class="hdr-left">
                    <img src="/sfruby_letters_white.png" alt="SF Ruby" class="logo" />
                    <span class="hdr-divider"></span>
                    <span class="hdr-eyebrow">Monthly Meetup · June 18</span>
                </div>
                <div class="host-chip">
                    <span>Hosted by</span>
                    <img src="/sponsor_planetscale.png" alt="PlanetScale" />
                </div>
            </header>

            <!-- Main: illustration + agenda -->
            <main class="main">
                <div class="art">
                    <img src="/meetup-planetscale-illustration.jpg" alt="SF Ruby Meetup at PlanetScale HQ" />
                </div>

                <section class="card agenda-card">
                    <h1 class="agenda-h">Tonight's Agenda</h1>
                    <ul class="agenda">
                        {agenda.map((row) => (
                            <li class="row">
                                <span class="time">{row.time}</span>
                                <span class="body">
                                    <span class="title">{row.title}</span>
                                    {row.who && <span class="meta">{row.who}</span>}
                                    {row.detail && !row.who && <span class="meta">{row.detail}</span>}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            </main>

            <!-- Conference announcement band -->
            <footer class="card conf">
                <div class="conf-left">
                    <span class="pill">
                        <span class="pill-tag">Year Two</span>
                        <span class="pill-when">Nov 10–12, 2026 · SF Jazz</span>
                    </span>
                    <p class="conf-name">San Francisco Ruby Startup Conference</p>
                </div>
                <div class="conf-mid">
                    <img src="/speaker_garry_tan.jpg" alt="Garry Tan" class="garry" />
                    <p class="conf-keynote">
                        Keynote: <strong>Garry Tan</strong><br />
                        President &amp; CEO of <strong>Y Combinator</strong>
                    </p>
                </div>
                <div class="conf-right">
                    <span class="conf-cta">Tickets &amp; info</span>
                    <span class="conf-url">sfruby.com</span>
                </div>
            </footer>

        </div>

        <style is:global>
            * { box-sizing: border-box; }
            html, body { margin: 0; padding: 0; }
            .deck {
                height: 100vh;
                width: 100vw;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                background-image:
                    radial-gradient(900px 520px at 80% -5%, rgba(255,255,255,0.22), transparent 60%),
                    linear-gradient(165deg in oklch, oklch(0.76 0.145 232) 0%, oklch(0.59 0.155 245) 45%, oklch(0.45 0.21 277) 100%);
            }

            /* Fixed canvas, scaled to fit by JS */
            .stage {
                position: absolute;
                top: 50%;
                left: 50%;
                width: 1920px;
                height: 1080px;
                transform-origin: center center;
                padding: 56px 64px;
                display: flex;
                flex-direction: column;
                gap: 28px;
                color: #fff;
                font-family: "Martian Mono", ui-monospace, monospace;
                background-image:
                    radial-gradient(900px 520px at 80% -5%, rgba(255,255,255,0.22), transparent 60%),
                    linear-gradient(165deg in oklch, oklch(0.76 0.145 232) 0%, oklch(0.59 0.155 245) 45%, oklch(0.45 0.21 277) 100%);
            }

            /* ---- Header ---- */
            .hdr { display: flex; align-items: center; justify-content: space-between; }
            .hdr-left { display: flex; align-items: center; gap: 22px; }
            .logo { height: 58px; width: auto; }
            .hdr-divider { width: 1px; height: 34px; background: rgba(255,255,255,0.35); }
            .hdr-eyebrow {
                text-transform: uppercase;
                letter-spacing: 0.22em;
                font-size: 16px;
                font-weight: 600;
                color: rgba(255,255,255,0.85);
            }
            .host-chip {
                display: inline-flex;
                align-items: center;
                gap: 14px;
                background: #fff;
                border-radius: 9999px;
                padding: 10px 22px;
            }
            .host-chip span {
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: 0.14em;
                color: #6b7280;
            }
            .host-chip img { height: 22px; width: auto; }

            /* ---- Main ---- */
            .main {
                flex: 1;
                min-height: 0;
                display: grid;
                grid-template-columns: 600px 1fr;
                gap: 36px;
            }
            .art {
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 30px 60px rgba(0,0,0,0.30);
                border: 1px solid rgba(255,255,255,0.2);
            }
            .art img { width: 100%; height: 100%; object-fit: cover; display: block; }

            .card {
                background: rgba(255,255,255,0.12);
                border: 1px solid rgba(255,255,255,0.22);
                border-radius: 24px;
                backdrop-filter: blur(6px);
            }
            .agenda-card { padding: 30px 40px; display: flex; flex-direction: column; }
            .agenda-h {
                font-family: "Martian Grotesk", sans-serif;
                font-weight: 700;
                font-size: 46px;
                line-height: 1;
                margin: 0 0 18px;
                letter-spacing: -0.01em;
            }
            .agenda { list-style: none; margin: 0; padding: 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
            .row {
                display: flex;
                align-items: baseline;
                gap: 26px;
                padding: 9px 0;
                border-bottom: 1px solid rgba(255,255,255,0.14);
            }
            .row:last-child { border-bottom: 0; }
            .time {
                flex: 0 0 118px;
                font-weight: 700;
                font-size: 21px;
                color: #fff;
                white-space: nowrap;
            }
            .body { display: flex; flex-direction: column; gap: 2px; }
            .title {
                font-family: "Martian Grotesk", sans-serif;
                font-weight: 700;
                font-size: 23px;
                line-height: 1.12;
                color: #fff;
            }
            .meta { font-size: 14px; color: rgba(255,255,255,0.72); letter-spacing: 0.01em; }

            /* ---- Conference band ---- */
            .conf {
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 32px;
                padding: 22px 40px;
            }
            .conf-left { display: flex; flex-direction: column; gap: 12px; }
            .pill {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                width: fit-content;
                border-radius: 9999px;
                background: rgba(255,255,255,0.14);
                border: 1px solid rgba(255,255,255,0.3);
                padding: 5px 16px 5px 5px;
            }
            .pill-tag {
                border-radius: 9999px;
                background: linear-gradient(90deg, #dc2626, #ec4899);
                padding: 5px 12px;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.18em;
            }
            .pill-when { font-size: 14px; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.92); }
            .conf-name {
                margin: 0;
                font-family: "Martian Grotesk", sans-serif;
                font-weight: 700;
                font-size: 26px;
                line-height: 1.05;
                max-width: 16ch;
            }
            .conf-mid { display: flex; align-items: center; gap: 18px; }
            .garry { width: 76px; height: 76px; border-radius: 9999px; object-fit: cover; object-position: top; border: 2px solid rgba(255,255,255,0.4); }
            .conf-keynote { margin: 0; font-size: 16px; line-height: 1.45; color: rgba(255,255,255,0.9); }
            .conf-keynote strong { color: #fff; font-weight: 700; }
            .conf-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; text-align: right; }
            .conf-cta { font-size: 13px; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.7); }
            .conf-url {
                font-family: "Martian Grotesk", sans-serif;
                font-weight: 700;
                font-size: 22px;
                color: #fff;
            }
        </style>

        <script is:inline>
            (function () {
                const stage = document.getElementById("stage");
                function fit() {
                    const s = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
                    stage.style.transform = "translate(-50%, -50%) scale(" + s + ")";
                }
                window.addEventListener("resize", fit);
                fit();
            })();
        </script>
    </body>
</html>
