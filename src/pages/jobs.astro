---
import Layout from '../layouts/Layout.astro';
import { getAllJobs, getSortedJobs } from '../data/jobs.js';
import { sponsors } from '../data/sponsors.js';

const jobs = getSortedJobs();
---

<Layout>
    <main class="min-h-screen bg-gradient-to-b from-white to-cloud-50">
        <!-- Hero Section -->
        <section class="py-20 bg-gradient-to-r from-ruby-500 to-pink-500">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-6 tracking-tight">
                        Ruby Jobs
                    </h1>
                    <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto leading-relaxed mb-8">
                        Find your next opportunity with our amazing sponsors
                    </p>
                    <a
                        href="https://forms.gle/H9nTdVYaGkR8XSkY6"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center px-8 py-4 bg-white text-ruby-600 rounded-lg font-bold shadow-xl hover:shadow-2xl hover:bg-gray-50 transition-all duration-300 transform hover:scale-105"
                    >
                        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Submit a Ruby Job
                    </a>
                </div>
            </div>
        </section>

        <!-- Jobs Listing Section -->
        <section class="py-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                {jobs.length > 0 ? (
                    <div class="grid grid-cols-1 gap-8 max-w-4xl mx-auto">
                        {jobs.map((job) => {
                            const sponsor = sponsors[job.sponsorId];
                            return (
                                <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
                                    <div class="p-8">
                                        <!-- Sponsor Logo -->
                                        {sponsor && sponsor.logo && (
                                            <div class="mb-6">
                                                <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="inline-block">
                                                    <img
                                                        src={sponsor.logo}
                                                        alt={sponsor.name}
                                                        class="h-12 w-auto object-contain hover:opacity-80 transition-opacity"
                                                    />
                                                </a>
                                            </div>
                                        )}

                                        <!-- Job Details -->
                                        <div>
                                            <div class="mb-4">
                                                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                                                    {job.title}
                                                </h2>
                                                <div class="flex flex-wrap gap-3 text-sm text-gray-600">
                                                    {job.location && (
                                                        <span class="flex items-center gap-1">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                            </svg>
                                                            {job.location}
                                                        </span>
                                                    )}
                                                    {job.type && (
                                                        <span class="flex items-center gap-1">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                                            </svg>
                                                            {job.type}
                                                        </span>
                                                    )}
                                                </div>
                                            </div>

                                            <div class="prose prose-lg max-w-none text-gray-700 mb-6">
                                                <p>{job.description}</p>
                                            </div>

                                            <a
                                                href={job.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-ruby-500 to-pink-500 text-white rounded-lg font-semibold shadow-lg hover:shadow-xl hover:from-ruby-600 hover:to-pink-600 transition-all duration-300 transform hover:scale-105"
                                            >
                                                View Job Details
                                                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                ) : (
                    <!-- Empty State -->
                    <div class="text-center py-20">
                        <div class="inline-block p-12 bg-white rounded-xl shadow-lg border-2 border-gray-100">
                            <svg class="w-20 h-20 text-ruby-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <h3 class="text-3xl font-bold text-gray-900 mb-4">Job Board Coming Soon!</h3>
                            <p class="text-lg text-gray-600 max-w-md mx-auto mb-8">
                                Our sponsors will be posting exciting Ruby opportunities here. Be the first to know!
                            </p>
                            <a
                                href="https://forms.gle/H9nTdVYaGkR8XSkY6"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-ruby-500 to-pink-500 text-white rounded-lg font-semibold shadow-lg hover:shadow-xl hover:from-ruby-600 hover:to-pink-600 transition-all duration-300 transform hover:scale-105"
                            >
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Submit Your Ruby Job
                            </a>
                        </div>
                    </div>
                )}
            </div>
        </section>
    </main>
</Layout>
