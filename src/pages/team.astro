---
// The team page: everything a manager or founder needs to register five
// people, on one URL they can forward. Nothing here is a new promise. The
// longer stage slot, group registration on Luma and invoicing all exist; this
// page puts them in one place instead of a paragraph under the price ladder.
import BaseLayout from "../layouts/BaseLayout.astro";
import { ticketLink, ticketEventClass, ticketTiers, regularTier } from "../data/conference-2026.js";
import { getAllJobs, jobCompanyId } from "../data/jobs.js";

const CONTACT_EMAIL = "conference@sfruby.com";
const regular = ticketTiers.find((t) => t.name === "Regular");
const company = ticketTiers.find((t) => t.name === "Company-sponsored");
const regularCloses = new Date(regularTier.closesOn).toLocaleDateString(
    "en-US",
    { month: "short", day: "numeric", timeZone: "America/Los_Angeles" },
);

const openRoles = getAllJobs();
const hiringCompanies = new Set(openRoles.map(jobCompanyId).filter(Boolean))
    .size;

const steps = [
    {
        title: "Register everyone in one order",
        body: `Luma takes several tickets in one checkout. ${company.name} ($${company.price}, no deadline) if the company pays, Regular ($${regular.price} until ${regularCloses}) if people expense it.`,
    },
    {
        title: "Ask for one invoice",
        body: `Write to ${CONTACT_EMAIL} with the names and we send one invoice.`,
    },
    {
        title: "Tell us who is on stage",
        body: "Teams of five or more get a slot with slides in the networking session. Send the presenter's name and we put them on the run sheet.",
    },
];

const included = [
    "All talks on Nov 10 (AI-heavy) and Nov 11 (AI-light), and the community day on Nov 12",
    "Two networking groups for every person, with a minute on the mic",
    "Teams of five or more: a slot with slides to introduce the company",
    "A character for everyone on the Pier, so the team shows up on the map together",
];
---

<BaseLayout
    darkHero={false}
    title="Bring your team - SF Ruby Conference 2026"
    description="Register a team for the San Francisco Ruby Conference, Nov 10-12 at SFJAZZ: one order, one invoice, and a stage slot for teams of five or more."
>
    <section class="pt-28 pb-14 bg-sky-50 border-b-4 border-ink">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Nov 10-12, SFJAZZ</span>
            <h1 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                Bring your team
            </h1>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-5">
                Two days in San Francisco, one invoice. Teams of five or more
                get the stage to introduce the company.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a
                    href={ticketLink("team")}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press ${ticketEventClass("team")}`}
                >
                    <img
                        src="/px-ticket.png"
                        alt=""
                        width="64"
                        height="64"
                        class="px-pixelated h-5 w-auto"
                    />
                    Register on Luma
                </a>
                <a
                    href={`mailto:${CONTACT_EMAIL}?subject=Team%20tickets%20for%20SF%20Ruby%202026`}
                    class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
                >
                    Ask for an invoice
                </a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-px10 md:text-xs text-ruby-600">
                What a team ticket includes
            </h2>
            <ul class="mt-6 grid gap-3 list-none p-0">
                {
                    included.map((item) => (
                        <li class="px-card bg-sky-50 p-4 md:p-5 text-sm md:text-base text-gray-700 leading-relaxed">
                            {item}
                        </li>
                    ))
                }
            </ul>

            <h2 class="px-font text-px10 md:text-xs text-ruby-600 mt-14">
                How to register a team
            </h2>
            <ol class="mt-6 grid gap-4 list-none p-0">
                {
                    steps.map((s, i) => (
                        <li class="px-card bg-white p-5 md:p-6 flex gap-4">
                            <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start shrink-0">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <div class="min-w-0">
                                <h3 class="px-font text-px9 md:text-px10 text-gray-900 leading-relaxed">
                                    {s.title}
                                </h3>
                                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-3">
                                    {s.body}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ol>

            <div class="px-dialog bg-white p-6 md:p-8 mt-14">
                <h2 class="px-font text-px10 md:text-xs text-gray-900">
                    Founding teams
                </h2>
                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-4">
                    Founders get their own conversation groups, with the
                    startup-minded engineers you want to hire in the room.
                    Bring your co-founder and first engineers: the small-teams
                    talks are built for a team of three.
                </p>
            </div>

            <div class="px-dialog bg-white p-6 md:p-8 mt-6">
                <h2 class="px-font text-px10 md:text-xs text-gray-900">
                    Teams from big companies
                </h2>
                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-4">
                    Gusto, Persona, Shopify and 37signals are on stage, and the
                    big-teams conversation groups compare notes on agentic
                    coding and on Sidekiq, Solid Queue and GoodJob. Your hiring
                    managers sit in those groups, and the slot puts the team in
                    front of the whole room. See
                    <a href="/#schedule" class="text-ruby-600 underline underline-offset-2">the schedule</a>.
                </p>
            </div>

            <div class="px-card bg-sky-50 p-6 md:p-7 mt-8 text-center">
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    <span class="font-display font-semibold text-gray-900">
                        {openRoles.length} open Ruby roles from {hiringCompanies} companies
                    </span>{" "}
                    are on the jobs board. Hiring? Post yours before the conference.
                </p>
                <a
                    href="/jobs/post"
                    class="px-btn px-btn--sky px-font text-px8 md:text-px10 px-5 py-3 tap-press mt-5"
                >
                    Post a job
                </a>
            </div>

            <p class="text-sm text-gray-500 leading-relaxed mt-10 text-center">
                Someone needs sign-off? Send them
                <a href="/manager" class="text-ruby-600 underline underline-offset-2">the manager page</a>.
            </p>
        </div>
    </section>
</BaseLayout>
