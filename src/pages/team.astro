---
// The team page: everything a manager or founder needs to register five
// people, on one URL they can forward. Nothing here is a new promise. The
// longer stage slot, group registration on Luma and invoicing all exist; this
// page puts them in one place instead of a paragraph under the price ladder.
import BaseLayout from "../layouts/BaseLayout.astro";
import { LUMA_URL, ticketTiers, regularTier } from "../data/conference-2026.js";
import { getAllJobs, jobCompanyId } from "../data/jobs.js";

const CONTACT_EMAIL = "conference@sfruby.com";
const regular = ticketTiers.find((t) => t.name === "Regular");
const company = ticketTiers.find((t) => t.name === "Company-sponsored");
const regularCloses = new Date(regularTier.closesOn).toLocaleDateString(
    "en-US",
    { month: "short", day: "numeric", timeZone: "America/Los_Angeles" },
);

const openRoles = getAllJobs();
const hiringCompanies = new Set(openRoles.map(jobCompanyId).filter(Boolean))
    .size;

const steps = [
    {
        title: "Register everyone in one order",
        body: `Luma takes several tickets in a single checkout. Pick the ${company.name} ticket ($${company.price}, no deadline) if the company pays, or Regular ($${regular.price} until ${regularCloses}) if people expense it individually.`,
    },
    {
        title: "Ask for one invoice",
        body: `Write to ${CONTACT_EMAIL} with the names and we send a single invoice for the group.`,
    },
    {
        title: "Tell us who is on stage",
        body: "Teams of five or more get extended time, and slides, to introduce the company in the networking session. Send the name of the person presenting and we put them on the run sheet.",
    },
];

const included = [
    "All talks on both tracks, Nov 10 and 11, and the community day on Nov 12",
    "A seat in at least two organized networking groups for every person, with 60 seconds on the mic each",
    "For teams of five or more: an extended slot, with slides, to introduce the company to the room",
    "A Cloud Card for everyone in the Pier, the pre-conference game, so the team shows up on the map together",
];
---

<BaseLayout
    darkHero={false}
    title="Bring your team - SF Ruby Startup Conference 2026"
    description="Register a team for the San Francisco Ruby Startup Conference, Nov 10-12 at SFJAZZ: one order, one invoice, and an extended stage slot for teams of five or more."
>
    <section class="pt-28 pb-14 bg-sky-50 border-b-4 border-ink">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Nov 10-12, SFJAZZ</span>
            <h1 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                Bring your team
            </h1>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-5">
                Two days in San Francisco, no flights, one invoice. Your
                engineers hear from the people who wrote the gems they run,
                and the room hears from you.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a
                    href={LUMA_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
                >
                    <img
                        src="/px-ticket.png"
                        alt=""
                        width="64"
                        height="64"
                        class="px-pixelated h-5 w-auto"
                    />
                    Register on Luma
                </a>
                <a
                    href={`mailto:${CONTACT_EMAIL}?subject=Team%20tickets%20for%20SF%20Ruby%202026`}
                    class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
                >
                    Ask for an invoice
                </a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-px10 md:text-xs text-ruby-600">
                What a team ticket includes
            </h2>
            <ul class="mt-6 grid gap-3 list-none p-0">
                {
                    included.map((item) => (
                        <li class="px-card bg-sky-50 p-4 md:p-5 text-sm md:text-base text-gray-700 leading-relaxed">
                            {item}
                        </li>
                    ))
                }
            </ul>

            <h2 class="px-font text-px10 md:text-xs text-ruby-600 mt-14">
                How to register a team
            </h2>
            <ol class="mt-6 grid gap-4 list-none p-0">
                {
                    steps.map((s, i) => (
                        <li class="px-card bg-white p-5 md:p-6 flex gap-4">
                            <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start shrink-0">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <div class="min-w-0">
                                <h3 class="px-font text-px9 md:text-px10 text-gray-900 leading-relaxed">
                                    {s.title}
                                </h3>
                                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-3">
                                    {s.body}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ol>

            <div class="px-dialog bg-white p-6 md:p-8 mt-14">
                <h2 class="px-font text-px10 md:text-xs text-gray-900">
                    Founding teams
                </h2>
                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-4">
                    Founders and founding teams get their own networking round,
                    hosted together with Y Combinator. Bring your co-founder and
                    your first engineers: the round is built for the questions
                    a team of three has, and the engineers you want to hire are
                    in the next room.
                </p>
            </div>

            <div class="px-card bg-sky-50 p-6 md:p-7 mt-8 text-center">
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    <span class="font-display font-semibold text-gray-900">
                        {openRoles.length} open Ruby and Rails roles from {hiringCompanies} companies
                    </span>{" "}
                    are on the SF Ruby jobs board today. Hiring? Put your role
                    in front of the room before the conference.
                </p>
                <a
                    href="/jobs/post"
                    class="px-btn px-btn--sky px-font text-px8 md:text-px10 px-5 py-3 tap-press mt-5"
                >
                    Post a job
                </a>
            </div>

            <p class="text-sm text-gray-500 leading-relaxed mt-10 text-center">
                Someone on the team needs sign-off first? Send them
                <a href="/manager" class="text-ruby-600 underline underline-offset-2">the manager page</a>.
            </p>
        </div>
    </section>
</BaseLayout>
