---
// The team page: everything a manager or founder needs to register five
// people, on one URL they can forward. Nothing here is a new promise. The
// longer stage segment, group registration on Luma and invoicing all exist; this
// page puts them in one place instead of a paragraph under the price ladder.
import BaseLayout from "../layouts/BaseLayout.astro";
import { ticketLink, ticketEventClass, ticketTiers } from "../data/conference-2026.js";

const CONTACT_EMAIL = "conference@sfruby.com";
const PIER_URL = "https://clouds.sfruby.com/";
const PIER_MAP_URL = "https://clouds.sfruby.com/e/2026-bits/pier";
const company = ticketTiers.find((t) => t.name === "Company-sponsored");

// `note` is a second paragraph under a step, for the condition that would
// otherwise crowd the step itself.
const steps = [
    {
        title: "Create a single order on Luma",
        body: `Register several tickets in one checkout. Each ticket is $${company.price}. Teams of five and more receive 10% off.`,
        link: {
            text: "one checkout",
            href: ticketLink("team"),
            external: true,
            // Same Plausible goal as every other ticket link on the site.
            class: ticketEventClass("team"),
        },
    },
    {
        title: "Email us for the invoice",
        body: `Send us an email at ${CONTACT_EMAIL} listing your teammates.`,
        // `link` turns that phrase of `body` into a link, so the copy stays one
        // string. `text` must appear in `body` verbatim.
        link: {
            text: CONTACT_EMAIL,
            href: `mailto:${CONTACT_EMAIL}?subject=Team%20tickets%20for%20SF%20Ruby%202026`,
        },
        note: "Teams of five and more get to speak on stage. Mark who from your team is going to present on stage.",
    },
    {
        title: "Activate your chibis",
        body: "Activate your chibi character and post on socials. Let's spread the word and make the conference even more fun!",
        link: { text: "your chibi character", href: PIER_URL, external: true },
    },
    {
        title: "Join the Pier",
        body: "Mine some coins at the Pier to exchange them for fun goodies at the conference!",
        link: { text: "the Pier", href: PIER_MAP_URL, external: true },
    },
    {
        title: "Post a job",
        body: "Hiring? Put your open Ruby roles on the jobs board before the conference.",
        link: { text: "the jobs board", href: "/jobs/post" },
    },
    {
        title: "Have fun and learn at SF Ruby",
        body: "Small and big teams will have two intertwining tracks that include technical talks and networking. Day 1 is AI-heavy, Day 2 is AI-light, and Day 3 is all about community fun.",
        link: { text: "two intertwining tracks", href: "/#schedule" },
    },
    {
        title: "Present on stage",
        body: "Every attendee gets a minute on the mic. Teams of five and more get a whole segment on the stage.",
    },
];

---

<BaseLayout
    darkHero={false}
    title="Bring your team - SF Ruby Conference 2026"
    description="Register a team for the San Francisco Ruby Conference, Nov 10-12 at SFJAZZ: one order, one invoice, 10% off, and a stage segment for teams of five or more."
>
    <section class="pt-28 pb-14 bg-sky-50 border-b-4 border-ink">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Nov 10-12, SFJAZZ</span>
            <h1 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                Bring your team
            </h1>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-5">
                Teams of five get a 10% and a segment on stage.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a
                    href={ticketLink("team")}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press ${ticketEventClass("team")}`}
                >
                    <img
                        src="/px-ticket.png"
                        alt=""
                        width="64"
                        height="64"
                        class="px-pixelated h-5 w-auto"
                    />
                    Register on Luma
                </a>
                <a
                    href="/manager"
                    class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
                >
                    Get approval
                </a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <ol class="grid gap-4 list-none p-0">
                {
                    steps.map((s, i) => (
                        <li class="px-card bg-white p-5 md:p-6 flex gap-4">
                            <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start shrink-0">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <div class="min-w-0">
                                <h3 class="px-font text-px9 md:text-px10 text-gray-900 leading-relaxed">
                                    {s.title}
                                </h3>
                                <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-3">
                                    {s.link ? (
                                        <Fragment>{s.body.split(s.link.text)[0]}<a href={s.link.href} class={`text-ruby-600 underline underline-offset-2 ${s.link.class ?? ""}`} {...(s.link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{s.link.text}</a>{s.body.split(s.link.text)[1]}</Fragment>
                                    ) : (
                                        s.body
                                    )}
                                </p>
                                {s.note && (
                                    <p class="text-sm md:text-base text-gray-600 leading-relaxed mt-3">
                                        {s.note}
                                    </p>
                                )}
                            </div>
                        </li>
                    ))
                }
            </ol>

            <p class="text-sm text-gray-500 leading-relaxed mt-14 text-center">
                Every talk, with its abstract, is on
                <a href="/#schedule" class="text-ruby-600 underline underline-offset-2">the schedule</a>.
            </p>

            <p class="text-sm text-gray-500 leading-relaxed mt-4 text-center">
                Use
                <a href="/manager" class="text-ruby-600 underline underline-offset-2">our handy template</a>
                to get approval from your boss.
            </p>
        </div>
    </section>
</BaseLayout>
