---
// Where to eat during the conference's lunch breaks and where to go after the
// talks: the map, then every lunch place side by side, then the evening list.
// Data lives in src/data/lunch-2026.js (shared with the Markdown twin). The map,
// its pin positions and the item sprites are generated by scripts/px-lunch.mjs.
// Lunch times come from the schedule, so they cannot drift.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { days, formatTime } from "../data/schedule-2026.js";
import {
    places,
    afterTalks,
    SEATS_MAX,
    SLACK_CHANNEL,
    SLACK_URL,
    SOURCE_NOTE,
    MAP_CREDIT,
} from "../data/lunch-2026.js";
import map from "../data/lunch-map-2026.json";

const breaks = days.slice(0, 2).map((d) => {
    const b = d.blocks.find((x) => x.kind === "lunch");
    return `${d.weekday} ${formatTime(b.start)} to ${formatTime(b.end)}`;
});
const coins = (dollars) => Math.max(1, Math.round(dollars / 5));
const pole = (id, set) => ({ ...map.pins[id], id, set });
const poles = [
    ...places.map((p) => pole(p.id, "lunch")),
    ...afterTalks.map((p) => pole(p.id, "after")),
];
---

<BaseLayout
    title="Lunch plans - San Francisco Ruby Conference 2026"
    ogImage="/og/lunch.png"
    description="Make lunch plans with other attendees on Slack. A map and a side-by-side of places near SFJAZZ: walk, seats, Yelp rating, price, signature, vegetarian and fish dishes, plus where to go after the talks."
>
    <PageHero label="Nov 10-11, SFJAZZ" title="Lunch plans" width="wide">
        <p slot="lede">
            Make plans in <strong class="whitespace-nowrap">{SLACK_CHANNEL}</strong> on Slack.
            <span class="block mt-1">{breaks.join(", ")}.</span>
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href={SLACK_URL} target="_blank" rel="noopener noreferrer" class="px-btn px-btn--gold px-font text-px9 md:text-px10 px-5 py-3.5 tap-press">Open Slack</a>
        </div>
        <div id="map-switch" class="invisible flex items-center justify-center gap-2 mt-4" role="group" aria-label="Places on the map">
            <button type="button" data-set="lunch" aria-pressed="true" class="lunch-sort px-font">Lunch</button>
            <button type="button" data-set="after" aria-pressed="false" class="lunch-sort px-font">After the talks</button>
        </div>
        <div id="lunch-map" class="lunch-map relative -mx-2 sm:mx-0 lg:-mx-20 mt-1" data-show="lunch">
            <img
                src="/px-lunch-map.png"
                width={map.width}
                height={map.height}
                alt="Map of Hayes Valley around SFJAZZ."
                class="px-pixelated block w-full h-auto"
            />
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true">
                {poles.map((p) => (
                    <g data-set={p.set}>
                        <line x1={p.bx} y1={p.by} x2={p.fx} y2={p.fy} class="lunch-pole" />
                    </g>
                ))}
            </svg>
            {map.streets.map((s) => (
                <span
                    class="lunch-street"
                    style={`left:${s.x}%;top:${s.y}%;--turn:${s.along === "e" ? "26.57deg" : "-26.57deg"}`}
                    aria-hidden="true"
                >
                    {s.text}
                </span>
            ))}
            <span
                class="lunch-pin lunch-pin--venue px-plate px-plate--gold px-font"
                style={`left:${map.pins.venue.x}%;top:${map.pins.venue.y}%`}
            >
                SFJAZZ
            </span>
            {places.map((p) => (
                <a
                    href={`#${p.id}`}
                    data-set="lunch"
                    class="lunch-pin px-plate px-plate--ruby px-font tap-press"
                    style={`left:${map.pins[p.id].x}%;top:${map.pins[p.id].y}%`}
                    aria-label={p.name}
                    title={p.name}
                >
                    {p.n}
                </a>
            ))}
            {afterTalks.map((p) => (
                <a
                    href={`#${p.id}`}
                    data-set="after"
                    class="lunch-pin px-plate px-font tap-press"
                    style={`left:${map.pins[p.id].x}%;top:${map.pins[p.id].y}%`}
                    aria-label={p.name}
                    title={p.name}
                >
                    {p.n}
                </a>
            ))}
        </div>
    </PageHero>

    <section class="bg-white pt-8 pb-12 md:pt-12 md:pb-16">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
                <h2 class="px-font text-sm md:text-lg text-gray-900 leading-normal">Compare</h2>
                <div id="lunch-sort" class="invisible flex flex-wrap gap-2" role="group" aria-label="Sort places">
                    <button type="button" data-key="walk" data-dir="1" aria-pressed="true" class="lunch-sort px-font">Closest</button>
                    <button type="button" data-key="seats" data-dir="-1" aria-pressed="false" class="lunch-sort px-font">Seats</button>
                    <button type="button" data-key="yelp" data-dir="-1" aria-pressed="false" class="lunch-sort px-font">Rating</button>
                    <button type="button" data-key="lunch" data-dir="1" aria-pressed="false" class="lunch-sort px-font">Price</button>
                </div>
            </div>

            <div class="lunch-table">
            <div class="lunch-row lunch-head mt-8 px-5 pb-2 px-font text-px8 text-gray-500" aria-hidden="true">
                <span>Place</span>
                <span>Seats, est.</span>
                <span>Yelp</span>
                <span>Lunch</span>
                <span>On the menu</span>
                <span></span>
            </div>

            <ol id="lunch-list" class="flex flex-col gap-5 list-none p-0 mt-6 lg:mt-1">
                {places.map((p) => (
                    <li
                        id={p.id}
                        class="lunch-row px-card bg-white p-4 lg:px-5"
                        data-walk={p.walk}
                        data-seats={p.seats}
                        data-yelp={p.yelp}
                        data-lunch={p.lunch}
                        data-n={p.n}
                    >
                        <div class="lunch-place flex gap-3 min-w-0">
                            <img src={`/lunch/${p.sprite}.png`} alt="" width="12" height="12" class="px-pixelated w-10 h-10 shrink-0" />
                            <div class="min-w-0">
                                <h3 class="font-display font-semibold text-base text-gray-900 leading-snug">
                                    <span class="px-font text-px8 text-ruby-600 mr-1">{p.n}</span>
                                    {p.name}
                                </h3>
                                {p.days && <span class="px-plate px-plate--gold px-font text-px8 px-1.5 py-1 mt-1.5">{p.days}</span>}
                                <p class="text-sm text-gray-600 leading-snug mt-1">{p.kitchen}</p>
                                <p class="text-xs text-gray-500 leading-snug mt-1">
                                    {p.walk} min walk, {p.address}. {p.hours}.
                                </p>
                            </div>
                        </div>

                        <div class="lunch-stat">
                            <span class="lunch-stat__label px-font lg:sr-only">Seats, est.</span>
                            <span class="font-mono text-sm text-gray-900">{p.seats}</span>
                            <span class="lunch-meter" aria-hidden="true">
                                <span style={`width:${(p.seats / SEATS_MAX) * 100}%`}></span>
                            </span>
                        </div>

                        <div class="lunch-stat">
                            <span class="lunch-stat__label px-font lg:sr-only">Yelp</span>
                            <span class="font-mono text-sm text-gray-900">
                                {p.yelp.toFixed(1)} <span class="text-gray-500 text-xs">({p.reviews})</span>
                            </span>
                            <span class="lunch-stars" aria-hidden="true">
                                <span style={`width:${(p.yelp / 5) * 100}%`}></span>
                            </span>
                        </div>

                        <div class="lunch-stat">
                            <span class="lunch-stat__label px-font lg:sr-only">Lunch</span>
                            <span class="font-mono text-sm text-gray-900">${p.lunch}</span>
                            <span class="flex gap-0.5" aria-hidden="true">
                                {Array.from({ length: coins(p.lunch) }).map(() => (
                                    <img src="/px-coin.png" alt="" width="64" height="64" class="px-pixelated w-3.5 h-3.5" />
                                ))}
                            </span>
                            {p.lunchNote && <span class="text-[11px] text-gray-500 leading-tight">{p.lunchNote}</span>}
                        </div>

                        <dl class="lunch-food m-0 flex flex-col gap-1.5 text-sm leading-snug min-w-0">
                            <div class="lunch-diet">
                                <img src="/lunch/drumstick.png" alt="" width="12" height="12" class="px-pixelated w-5 h-5 shrink-0" />
                                <div><dt>Signature</dt> <dd class="text-gray-900">{p.signature}</dd></div>
                            </div>
                            <div class="lunch-diet">
                                <img src="/lunch/leaf.png" alt="" width="12" height="12" class="px-pixelated w-5 h-5 shrink-0" />
                                <div><dt>Vegetarian</dt> <dd class="text-gray-700">{p.veg}</dd></div>
                            </div>
                            <div class="lunch-diet">
                                <img src="/lunch/fish.png" alt="" width="12" height="12" class:list={["px-pixelated w-5 h-5 shrink-0", !p.fish && "opacity-30 grayscale"]} />
                                <div><dt>Fish</dt> <dd class={p.fish ? "text-gray-700" : "text-gray-500"}>{p.fish ?? "None on the menu"}</dd></div>
                            </div>
                        </dl>

                        <div class="lunch-actions flex lg:flex-col gap-2">
                            <a href={p.menu} target="_blank" rel="noopener noreferrer" class="lunch-link px-font tap-press">Menu</a>
                            <a href={p.directions} target="_blank" rel="noopener noreferrer" class="lunch-link px-font tap-press">Route</a>
                        </div>
                    </li>
                ))}
            </ol>
            </div>

            <h2 id="after-the-talks" class="px-font text-sm md:text-lg text-gray-900 leading-normal mt-12">After the talks</h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 mt-6">
                {afterTalks.map((p) => (
                    <li id={p.id} class="lunch-evening px-card bg-white p-4 flex flex-col gap-3">
                        <div class="flex gap-3 min-w-0 grow">
                            <img src={`/lunch/${p.sprite}.png`} alt="" width="12" height="12" class="px-pixelated w-10 h-10 shrink-0" />
                            <div class="min-w-0">
                                <h3 class="font-display font-semibold text-base text-gray-900 leading-snug">
                                    <span class="px-font text-px8 text-indigo-500 mr-1">{p.n}</span>
                                    {p.name}
                                </h3>
                                <p class="text-sm text-gray-600 leading-snug mt-1">{p.kitchen}</p>
                                <p class="text-xs text-gray-500 leading-snug mt-1">
                                    {p.walk} min walk, {p.address}. {p.hours}. {p.note}
                                </p>
                                {p.yelp && (
                                    <p class="font-mono text-xs text-gray-700 mt-1.5">
                                        Yelp {p.yelp.toFixed(1)} <span class="text-gray-500">({p.reviews})</span>
                                    </p>
                                )}
                                {p.capacity && <p class="font-mono text-xs text-gray-700 mt-1.5">{p.capacity}</p>}
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <a href={p.link} target="_blank" rel="noopener noreferrer" class="lunch-link grow px-font tap-press">{p.linkLabel}</a>
                            <a href={p.directions} target="_blank" rel="noopener noreferrer" class="lunch-link grow px-font tap-press">Route</a>
                        </div>
                    </li>
                ))}
            </ul>

            <p class="text-xs text-gray-500 mt-10 max-w-3xl">{SOURCE_NOTE} {MAP_CREDIT}.</p>
        </div>
    </section>
</BaseLayout>

<style>
    .lunch-pin {
        position: absolute;
        transform: translate(-50%, -100%);
        z-index: 2;
        min-width: 1.5rem;
        padding: 0.3rem 0.35rem;
        border-width: 2px;
        box-shadow: 2px 2px 0 0 var(--px-ink);
        font-size: 8px;
        line-height: 1;
        text-align: center;
        text-decoration: none;
    }
    .lunch-pin:hover,
    .lunch-pin:focus-visible {
        z-index: 3;
        filter: brightness(1.15);
    }
    .lunch-pin--venue {
        z-index: 1;
    }
    .lunch-pole {
        stroke: var(--px-ink);
        stroke-width: 1.5;
        shape-rendering: crispEdges;
    }
    .lunch-map[data-show="lunch"] [data-set="after"],
    .lunch-map[data-show="after"] [data-set="lunch"] {
        display: none;
    }
    .lunch-street {
        position: absolute;
        transform: translate(-50%, -50%) rotate(var(--turn));
        color: var(--white);
        font-size: clamp(7px, 1.25vw, 11px);
        line-height: 1;
        white-space: nowrap;
        pointer-events: none;
    }
    @media (min-width: 640px) {
        .lunch-pin {
            min-width: 1.875rem;
            padding: 0.4rem 0.45rem;
            border-width: 3px;
            box-shadow: 3px 3px 0 0 var(--px-ink);
            font-size: 10px;
        }
    }

    .lunch-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.875rem 0.75rem;
        scroll-margin-top: 6rem;
    }
    .lunch-place,
    .lunch-food,
    .lunch-actions {
        grid-column: 1 / -1;
    }
    .lunch-head {
        display: none;
    }
    .lunch-row:target,
    .lunch-evening:target {
        outline: 4px solid var(--px-gold);
        outline-offset: 2px;
    }
    .lunch-evening {
        scroll-margin-top: 6rem;
    }
    @media (min-width: 1024px) {
        .lunch-row {
            grid-template-columns:
                minmax(0, 2.3fr) minmax(0, 0.8fr) minmax(0, 0.95fr) minmax(0, 0.8fr)
                minmax(0, 2.6fr) 5rem;
            gap: 1.25rem;
            align-items: center;
        }
        .lunch-place,
        .lunch-food,
        .lunch-actions {
            grid-column: auto;
        }
        .lunch-head {
            display: grid;
            align-items: end;
            /* The cards' 4px border plus their 20px padding. */
            padding-inline: 1.5rem;
            position: sticky;
            top: 5.25rem;
            z-index: 20;
            padding-top: 0.5rem;
            background: var(--white);
            /* Covers the 8px card shadow that sticks out on the right. */
            box-shadow: 0.5rem 0 0 0 var(--white);
        }
        /* A linked card stops below the site header and the frozen row. */
        #lunch-list > .lunch-row {
            scroll-margin-top: 8rem;
        }
    }

    .lunch-stat {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }
    .lunch-stat__label {
        font-size: 8px;
        line-height: 1.4;
        color: var(--dark-500);
    }
    .lunch-meter {
        display: block;
        height: 0.75rem;
        border: 2px solid var(--px-ink);
        background: var(--dark-200);
    }
    .lunch-meter > span {
        display: block;
        height: 100%;
        background: repeating-linear-gradient(
            90deg,
            var(--ruby-500) 0 6px,
            var(--ruby-700) 6px 8px
        );
    }
    .lunch-stars {
        position: relative;
        display: block;
        width: 5.625rem;
        max-width: 100%;
        height: 1.125rem;
        background: url("/lunch/star.png") left center / 1.125rem 1.125rem repeat-x;
        image-rendering: pixelated;
        isolation: isolate;
    }
    .lunch-stars::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--white);
        opacity: 0.72;
    }
    .lunch-stars > span {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 1;
        background: url("/lunch/star.png") left center / 1.125rem 1.125rem repeat-x;
        image-rendering: pixelated;
    }
    .lunch-diet {
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
        min-width: 0;
    }
    .lunch-diet dt {
        display: inline;
        font-size: 0.75rem;
        color: var(--dark-500);
    }
    .lunch-diet dd {
        display: inline;
        margin: 0;
    }

    .lunch-link,
    .lunch-sort {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0 0.875rem;
        border: 3px solid var(--px-ink);
        background: var(--white);
        color: var(--px-ink);
        box-shadow: 3px 3px 0 0 var(--px-ink);
        font-size: 9px;
        line-height: 1;
        text-decoration: none;
    }
    .lunch-actions .lunch-link {
        flex: 1 1 0;
    }
    .lunch-link:hover,
    .lunch-sort:hover {
        background: var(--gold-100);
    }
    .lunch-sort[aria-pressed="true"] {
        background: var(--px-gold);
    }
    /* All four sort buttons on one row at 390. */
    @media (max-width: 639px) {
        .lunch-sort {
            padding: 0 0.5rem;
            font-size: 8px;
        }
    }
</style>

<script>
    const sort = document.getElementById("lunch-sort");
    const list = document.getElementById("lunch-list");
    if (sort && list) {
        sort.classList.remove("invisible");
        const buttons = sort.querySelectorAll("button");
        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const { key, dir } = button.dataset;
                buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
                [...list.children]
                    .sort((a, b) =>
                        (Number(a.dataset[key]) - Number(b.dataset[key])) * Number(dir) ||
                        Number(a.dataset.n) - Number(b.dataset.n),
                    )
                    .forEach((row) => list.append(row));
            });
        });
    }

    // The map shows one set of pins at a time.
    const mapSwitch = document.getElementById("map-switch");
    const lunchMap = document.getElementById("lunch-map");
    if (mapSwitch && lunchMap) {
        mapSwitch.classList.remove("invisible");
        const toggles = mapSwitch.querySelectorAll("button");
        const show = (set) => {
            lunchMap.dataset.show = set;
            toggles.forEach((t) => t.setAttribute("aria-pressed", String(t.dataset.set === set)));
        };
        toggles.forEach((t) => t.addEventListener("click", () => show(t.dataset.set)));
        // A shared link to an evening place opens the map on that set.
        if (lunchMap.querySelector(`a[data-set="after"][href="${CSS.escape(location.hash)}"]`)) show("after");
    }
</script>
