---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import StartupCard from "../components/StartupCard.astro";
import StartupModal from "../components/StartupModal.astro";
import ResourceCard from "../components/ResourceCard.astro";
import Button from "../components/Button.astro";
import SocialLink from "../components/SocialLink.astro";

import { getAllStartups, getStartup, startups as startupsData } from "../data/startups.js";
import { getTalk, talks } from "../data/talks.js";
import { getLatestMeetupRecordings, formatTimestamp } from "../data/meetup-recordings.js";
import { getJobsBySponsor, getSortedJobs } from "../data/jobs.js";
import { getAllPhotoAlbums, GCS_PHOTO_BASE } from "../data/events.js";
import { getSponsor, getSponsorsGroupedByTier } from "../data/sponsors.js";
import { getSpeaker } from "../data/speakers.js";
import { getAllHosts, hosts as hostsData } from "../data/hosts.js";
import HostCard from "../components/HostCard.astro";
import HostModal from "../components/HostModal.astro";

const allStartups = getAllStartups();

// Filter out hidden startups (CorePilot cancelled)
const visibleStartups = allStartups.filter((s) => s.id !== "corepilot");

// Sort startups: those with demo videos first (same as /startups page)
const startups = visibleStartups.sort((a, b) => {
    const aDemoTalk = getTalk(`${a.id}-demo`);
    const bDemoTalk = getTalk(`${b.id}-demo`);
    const aHasVideo = a.youtubeId || aDemoTalk?.youtubeId;
    const bHasVideo = b.youtubeId || bDemoTalk?.youtubeId;

    if (aHasVideo && !bHasVideo) return -1;
    if (!aHasVideo && bHasVideo) return 1;
    return 0;
});

// Get featured startups (first 8)
const featuredStartups = startups.slice(0, 8);

const startupCount = startups.length;

// Map startup IDs to sponsor IDs for job lookup
const startupToSponsorMap: Record<string, string> = {
    bolt_new: "bolt-new",
    finta: "finta",
    thatch: "thatch",
};

// Build enhanced startups data with jobs info, speaker info, and source URLs for modal
const enhancedStartupsData: Record<string, any> = {};
for (const [id, startup] of Object.entries(startupsData)) {
    const sponsorId = startupToSponsorMap[id];
    const startupJobs = sponsorId ? getJobsBySponsor(sponsorId) : [];
    const demoTalk = getTalk(`${id}-demo`);
    const speaker = startup.speakerId ? getSpeaker(startup.speakerId) : null;
    enhancedStartupsData[id] = {
        ...startup,
        jobs: startupJobs,
        youtubeId: startup.youtubeId || demoTalk?.youtubeId || null,
        fundingUrl: startup.fundingUrl || null,
        valuationUrl: startup.valuationUrl || null,
        newsUrl: startup.newsUrl || null,
        speaker: speaker,
    };
}

// Get featured jobs (1 per company, newest first)
const allJobs = getSortedJobs();
const seenCompanies = new Set();
const featuredJobs = allJobs.filter((job) => {
    const companyKey = job.sponsorId || job.startupId;
    if (seenCompanies.has(companyKey)) return false;
    seenCompanies.add(companyKey);
    return true;
}).slice(0, 6).map((job) => {
    const sponsor = getSponsor(job.sponsorId);
    const startup = job.startupId ? getStartup(job.startupId) : null;
    return {
        ...job,
        sponsor: sponsor || (startup ? { name: startup.name, logo: startup.logo } : null),
    };
});
const jobCount = allJobs.length;

// Get latest 2 meetup recordings + 2 conference keynotes for homepage
const latestMeetupRecordings = getLatestMeetupRecordings(2);
const featuredKeynotes = [getTalk("rails-x-keynote"), getTalk("rails-ai-ruby-llm")]
    .filter(Boolean)
    .map((talk: any) => ({
        ...talk,
        speaker: talk.speakerId ? getSpeaker(talk.speakerId) : null,
    }));

// Get photo albums
const photoAlbums = getAllPhotoAlbums();
const featuredPhotos = photoAlbums.slice(0, 4);
const totalPhotoCount = photoAlbums.reduce(
    (sum, album) => sum + album.photoCount,
    0,
);

// Get sponsors grouped by tier - order: Pickaxe, Ruby, Post Production, Reception, Emerald, Travel
const tierOrder = [
    "Pickaxe ⛏️",
    "Ruby",
    "Post Production",
    "Reception",
    "Emerald",
    "Travel",
];
const sponsorsByTier = getSponsorsGroupedByTier().sort((a, b) => {
    return tierOrder.indexOf(a.name) - tierOrder.indexOf(b.name);
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Join the SF Ruby community: monthly meetups, talks, jobs, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta name="theme-color" content="#dc2626" />
        <title>SF Ruby - Where Ruby Startups Grow</title>

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="SF Ruby - Where Ruby Startups Grow"
        />
        <meta
            property="og:description"
            content="Let's build the new generation of Ruby success stories. Join the SF Ruby community: monthly meetups, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta property="og:image" content="https://iqtfijxk.ogplus.net/" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content="https://iqtfijxk.ogplus.net/" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col"
    >
        <Header />

        <main class="flex-grow">
            <!-- Conference Announcement -->
            <!-- TODO before publish: replace href="#" with the real conference-page URL -->
            <!-- Gradient runs the full height sky -> navy, ending on the news color so the join is seamless -->
            <section id="conf-announcement" class="relative min-h-[92vh] flex items-center text-white overflow-hidden" style="background-image: radial-gradient(900px 520px at 80% -5%, rgba(255,255,255,0.22), transparent 60%), linear-gradient(165deg in oklch, oklch(0.76 0.145 232) 0%, oklch(0.59 0.155 245) 45%, oklch(0.45 0.21 277) 100%);">
                <!-- soft clouds -->
                <div class="absolute top-24 left-1/5 w-80 h-36 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute top-44 right-12 w-64 h-28 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute top-[30%] left-1/2 w-72 h-32 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 py-32 text-center">
                    <div class="mb-6">
                        <span class="inline-flex items-center gap-3 rounded-full bg-white/10 border border-white/30 py-1.5 pl-1.5 pr-4 align-middle">
                            <span class="shrink-0 whitespace-nowrap rounded-full bg-gradient-to-r from-ruby-500 to-pink-500 px-2.5 py-1 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-white">Year Two</span>
                            <span class="text-xs md:text-sm tracking-[0.06em] uppercase text-white/90">Nov 10–12, 2026 · SF Jazz, San Francisco</span>
                        </span>
                    </div>
                    <img src="/sfruby-startup-2026.png" alt="San Francisco Ruby Startup Conference" width="2048" height="1550" class="w-full max-w-lg lg:max-w-xl h-auto mb-8 mx-auto" />
                    <!-- Photo: Seb Daly / Web Summit / Sportsfile, CC BY 2.0 (Wikimedia Commons) -->
                    <div class="flex items-center justify-center gap-5">
                        <img src="/speaker_garry_tan.jpg" alt="Garry Tan" width="500" height="667" loading="lazy" class="w-24 h-24 md:w-28 md:h-28 rounded-full object-cover object-top ring-2 ring-white/40 shrink-0" />
                        <div class="text-left">
                            <p class="text-xl md:text-2xl lg:text-3xl text-white/90 leading-snug">
                                Keynote: <strong class="text-white">Garry Tan</strong>, President &amp; CEO of <strong class="text-white">Y Combinator</strong>
                            </p>
                            <p class="text-base md:text-lg text-white/70 mt-2">
                                Rubyist, Creator of <a href="https://github.com/garrytan/gstack" target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors">GStack</a>
                            </p>
                        </div>
                    </div>
                    <div class="mt-8">
                        <a href="/conference-2026" class="inline-flex items-center gap-2 text-base md:text-lg text-white/90 hover:text-white transition-colors">
                            Learn more<span class="sr-only"> about the San Francisco Ruby Startup Conference</span>
                            <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </a>
                    </div>
                </div>
            </section>

            <!-- SF Ruby News Hero -->
            <section id="news" class="relative text-white overflow-hidden" style="background-image: linear-gradient(to bottom in oklch, oklch(0.45 0.21 277) 0%, oklch(0.26 0.06 274) 22%, #020617 55%, #020617 100%);">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-8 pb-16">

                    <!-- Masthead -->
                    <div class="text-center mb-12 relative">
                        <div class="flex items-center gap-4 justify-center mb-3">
                            <div class="flex-1 max-w-[120px] h-px bg-white/20"></div>
                            <h1 class="font-display text-2xl md:text-3xl tracking-wider uppercase text-white font-bold">SF Ruby News</h1>
                            <div class="flex-1 max-w-[120px] h-px bg-white/20"></div>
                        </div>
                        <p class="text-sm text-white/50 tracking-widest uppercase">June 2026</p>
                        <!-- Past Issues -->
                        <div class="mt-4 flex justify-center sm:mt-0 sm:absolute sm:top-0 sm:right-0">
                            <div class="flex items-center gap-3 text-xs text-white/40">
                                <a href="/news/2026-02/" class="hover:text-white/70 transition-colors">Feb</a>
                                <span class="text-white/20">·</span>
                                <a href="/news/2026-03/" class="hover:text-white/70 transition-colors">Mar</a>
                                <span class="text-white/20">·</span>
                                <a href="/news/2026-04/" class="hover:text-white/70 transition-colors">Apr</a>
                                <span class="text-white/20">·</span>
                                <a href="/news/2026-05/" class="hover:text-white/70 transition-colors">May</a>
                            </div>
                        </div>
                    </div>

                    <!-- News Carousel -->
                    <div class="relative" id="news-carousel">

                        <!-- Page 1 -->
                        <div class="news-page" data-page="0">
                            <!-- Headline Story: Factorial Series D -->
                            <div class="mb-10">
                                <span class="inline-block px-2.5 py-1 bg-ruby-500/20 text-ruby-400 text-xs font-bold uppercase tracking-wider rounded mb-4">Funding</span>
                                <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">Factorial Raises $150M at a $2.5B Valuation</h2>
                                <div class="border-l-2 border-ruby-500/60 pl-6">
                                    <p class="text-lg md:text-xl text-white/80 leading-relaxed">
                                        Barcelona's <strong class="text-white">Factorial</strong>, the HR platform running a Rails backend with 200+ product engineers, closes a $150M Series D led by <strong class="text-white">General Catalyst</strong> and becomes one of Europe's most valuable AI scale-ups.
                                    </p>
                                    <p class="text-sm text-white/60 leading-relaxed mt-4">
                                        General Catalyst commits up to an additional $540M through its Customer Value Fund: more than $700M in total. 16,000 businesses across 90 countries, ~2,600 employees, hiring up to 50 people a week. The money funds the shift from HR SaaS to an AI-powered workforce operations platform, plus a new Munich office. <a href="https://tech.eu/2026/06/03/factorial-raises-150m-series-d-at-25b-valuation-to-expand-across-europe/" class="underline hover:text-white/80">Tech.eu has the round details</a>.
                                    </p>
                                    <div class="mt-4">
                                        <p class="text-xs text-white/50">June 3, 2026 · PR Newswire</p>
                                    </div>
                                    <a href="https://www.prnewswire.com/news-releases/factorial-raises-150m-series-d-reaches-2-5-billion-valuation-to-become-one-of-the-most-valuable-ai-scale-ups-in-europe-302789074.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-xs text-ruby-400 hover:text-ruby-300 transition-colors">
                                        Read the announcement<span class="sr-only"> about Factorial's Series D</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                    </a>
                                </div>
                            </div>

                            <!-- Divider -->
                            <div class="h-px bg-white/10 mb-10"></div>

                            <!-- Three Column Stories: Row 1 -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 mb-10">
                                <!-- Press: Intercom becomes Fin -->
                                <div class="md:pr-8">
                                    <span class="inline-block px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded mb-3">Press</span>
                                    <h3 class="font-display text-xl font-bold text-white mb-2">Intercom Renames the Company Fin</h3>
                                    <p class="text-xs text-white/40 mb-2">May 12, 2026</p>
                                    <p class="text-sm text-white/60 leading-relaxed mb-3">The 15-year-old company takes its AI agent's name: the corporate entity is now <strong class="text-white/80">Fin</strong>, with Intercom continuing as the help-desk product. Fin crossed $100M ARR, growing 3.5x, inside a $400M+ ARR business, all on the 2M-line Rails monolith. Two days later it shipped <strong class="text-white/80">Fin Operator</strong>: an AI agent that manages the AI agent.</p>
                                    <a href="https://www.intercom.com/blog/today-intercom-becomes-fin/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                        Read more<span class="sr-only"> about Intercom becoming Fin</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                    </a>
                                </div>
                                <!-- Press: Clio $500M ARR -->
                                <div class="md:border-l md:border-white/10 md:pl-8 md:pr-8">
                                    <span class="inline-block px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded mb-3">Press</span>
                                    <h3 class="font-display text-xl font-bold text-white mb-2">Clio Crosses $500M ARR</h3>
                                    <p class="text-xs text-white/40 mb-2">May 12, 2026</p>
                                    <p class="text-sm text-white/60 leading-relaxed mb-3">The legal practice platform and longtime Rails shop hits $500M in annual recurring revenue, up from $400M six months prior, serving legal professionals in 130+ countries. CEO Jack Newton frames it as joining "a rare class of profitable, accelerating AI platforms." Follows the $1B vLex acquisition and a $5B valuation.</p>
                                    <a href="https://www.clio.com/about/press/clio-500-million-arr/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                        Read more<span class="sr-only"> about Clio's $500M ARR</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                    </a>
                                </div>
                                <!-- Earnings: GitLab Q1 FY27 -->
                                <div class="md:border-l md:border-white/10 md:pl-8">
                                    <span class="inline-block px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded mb-3">Earnings</span>
                                    <h3 class="font-display text-xl font-bold text-white mb-2">GitLab: $264M Quarter, Agentic Tailwinds</h3>
                                    <p class="text-xs text-white/40 mb-2">June 2, 2026</p>
                                    <p class="text-sm text-white/60 leading-relaxed mb-3">Rails Foundation Core member reports Q1 FY2027 revenue of $264.2M (+23%), 14% non-GAAP operating margin, $149M operating cash flow, and 117% net retention. CEO Bill Staples: <strong class="text-white/80">"The agentic era is creating structural tailwinds for GitLab."</strong></p>
                                    <a href="https://www.businesswire.com/news/home/20260602438182/en/GitLab-Reports-First-Quarter-Fiscal-Year-2027-Financial-Results" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                        Read more<span class="sr-only"> about GitLab Q1 FY2027</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                    </a>
                                </div>
                            </div>

                            <!-- Three Column Stories: Row 2 -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 mb-6">
                                <div class="md:pr-8">
                                    <div class="flex flex-col gap-3">
                                        <span class="inline-block px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded w-fit">Earnings</span>
                                        <h3 class="font-display text-xl font-bold text-white">Doximity: $645M Year, 800K Prescribers</h3>
                                        <p class="text-sm text-white/60 leading-relaxed">SF-based Rails Foundation Core member closes FY2026 with $644.9M revenue (+13%) and $317.5M free cash flow (+19%). A record 800K+ active prescribers use its workflow tools; nearly half already use its clinical AI, with prompts per user nearly doubling from January to April.</p>
                                        <a href="https://press.doximity.com/articles/doximity-announces-fourth-quarter-and-fiscal-year-2026-financial-results" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors">
                                            Read more<span class="sr-only"> about Doximity FY2026 results</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="md:border-l md:border-white/10 md:pl-8 md:pr-8">
                                    <div class="flex flex-col gap-3">
                                        <span class="inline-block px-2.5 py-1 bg-violet-500/20 text-violet-400 text-xs font-bold uppercase tracking-wider rounded w-fit">Release</span>
                                        <h3 class="font-display text-xl font-bold text-white">Checkr Launches Profiles: Identity That Travels</h3>
                                        <p class="text-sm text-white/60 leading-relaxed">SF background-check platform ($2.2B valuation, Rails) ships portable verified identity: identity verification, background checks, and credential validation in a shareable profile that individuals own. Built against AI-era fraud; per Checkr's research, 62% of managers believe people now fake identity better than organizations detect it.</p>
                                        <a href="https://www.prnewswire.com/news-releases/checkr-launches-profiles-giving-people-a-verified-identity-that-travels-with-them-302756790.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-violet-400 hover:text-violet-300 transition-colors">
                                            Read more<span class="sr-only"> about Checkr Profiles</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="md:border-l md:border-white/10 md:pl-8">
                                    <div class="flex flex-col gap-3">
                                        <span class="inline-block px-2.5 py-1 bg-ruby-500/20 text-ruby-400 text-xs font-bold uppercase tracking-wider rounded w-fit">Event</span>
                                        <h3 class="font-display text-xl font-bold text-white">SF Ruby Meetup, June @ PlanetScale</h3>
                                        <p class="text-sm text-white/60 leading-relaxed">Thursday June 18, 5pm, 108 Natoma St. Jeremy Evans on "Implementing Core Set," Alan Ridlehoover's "Indispensable: What Human Computers Can Teach Human Programmers," plus a PlanetScale talk and interest circles. Hosted with Sam Lambert. 108+ RSVPs.</p>
                                        <a href="https://lu.ma/ltipgvuh" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-ruby-400 hover:text-ruby-300 transition-colors">
                                            RSVP on Luma<span class="sr-only"> - SF Ruby June meetup at PlanetScale</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Hiring strip -->
                            <div class="mt-4 mb-6 border border-white/10 rounded-lg px-6 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
                                <span class="inline-block px-2.5 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider rounded w-fit shrink-0">Hiring</span>
                                <p class="text-sm text-white/60 leading-relaxed flex-1">Fresh Ruby roles on the board, every listing re-verified this week: <strong class="text-white/80">Gusto</strong> (Staff, Payments/Risk), <strong class="text-white/80">Superconductor</strong> (Principal Rails), <strong class="text-white/80">Koah Labs</strong> (Backend, Product, Platform), <strong class="text-white/80">Omada Health</strong>, <strong class="text-white/80">CompanyCam</strong>, plus open roles at Thatch, Persona, Chime, Patch, Reset, and Finta.</p>
                                <a href="/jobs" class="inline-flex items-center gap-1.5 text-xs text-amber-400 hover:text-amber-300 transition-colors shrink-0">
                                    Browse all jobs<span class="sr-only"> on the SF Ruby jobs board</span>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                </a>
                            </div>
                        </div>

                        <!-- Page 2 -->
                        <div class="news-page hidden" data-page="1">
                            <!-- Headline Story: RubyConf Austria -->
                            <div class="mb-10">
                                <span class="inline-block px-2.5 py-1 bg-ruby-500/20 text-ruby-400 text-xs font-bold uppercase tracking-wider rounded mb-4">Event</span>
                                <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">RubyConf Austria Draws the Legends to Vienna</h2>
                                <div class="border-l-2 border-ruby-500/60 pl-6">
                                    <p class="text-lg md:text-xl text-white/80 leading-relaxed">
