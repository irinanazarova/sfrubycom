---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import SpeakersHighlight from "../components/SpeakersHighlight.astro";
import StartupDemos from "../components/StartupDemos.astro";
import Sponsors from "../components/Sponsors.astro";
import Newsletter from "../components/Newsletter.astro";
import Testimonials from "../components/Testimonials.astro";
---

<Layout>
    <main class="scroll-smooth">
        <Hero />

        <!-- Key Topics: Ruby and Startups section -->
        <section
            id="themes"
            class="py-32 bg-gray-50"
            style="padding: 8rem 0; background-color: #f9fafb; display: block; visibility: visible;"
        >
            <div
                class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
                style="max-width: 80rem; margin: 0 auto; padding: 0 1rem;"
            >
                <div class="text-center mb-20">
                    <p
                        class="mb-12 text-2xl md:text-3xl font-light text-dark-700 max-w-4xl mx-auto leading-relaxed"
                    >
                        SF Ruby is excited to invite you to our premier event:
                        the
                        <span
                            class="bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent font-semibold"
                        >
                            San Francisco Ruby Conference
                        </span>
                    </p>
                    <div class="space-y-8 mb-20">
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            We're gathering <span
                                class="font-semibold text-dark-800"
                                >~600 Rubyists</span
                            > in San Francisco: where new Ruby dreams are born every
                            day. The two unforgettable days await—where you’ll forge
                            connections with ambitious founders, engineers scaling
                            the largest Ruby-powered products, and open source authors
                            shaping what’s next for Ruby and Rails.
                        </p>
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            Demos from the fast-paced Ruby startups, hands-on
                            workshops on hot topics, and deep conversations in
                            the hallway track. Join a creative, generous, and
                            unapologetically mischievous Ruby community. This is
                            where you belong!
                        </p>
                    </div>
                    <div class="inline-block">
                        <a href="#themes" class="group">
                            <h2
                                class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-dark-900 mb-4 tracking-tight transition-colors duration-300 group-hover:text-ruby-600"
                            >
                                Key Topics: Ruby and Startups
                            </h2>
                        </a>
                        <div
                            class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
                        >
                        </div>
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;"
                >
                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                        style="background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; padding: 1.5rem; display: block; visibility: visible;"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                            style="width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;"
                        >
                            <img
                                src="/oss.png"
                                alt="New Open Source & AI Tooling icon"
                                class="w-full h-full object-contain"
                                style="width: 100%; height: 100%; object-fit: contain; display: block;"
                            />
                        </div>
                        <h3
                            class="text-xl font-bold text-gray-900 mb-2"
                            style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;"
                        >
                            New Open Source & AI Tooling
                        </h3>
                        <p class="text-gray-600" style="color: #4b5563;">
                            New open source and tools built for the most
                            ambitious Ruby and Rails apps, including Ruby&AI.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                        style="background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; padding: 1.5rem; display: block; visibility: visible;"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                            style="width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;"
                        >
                            <img
                                src="/scaleups.png"
                                alt="Ruby at Scale icon"
                                class="w-full h-full object-contain"
                                style="width: 100%; height: 100%; object-fit: contain; display: block;"
                            />
                        </div>
                        <h3
                            class="text-xl font-bold text-gray-900 mb-2"
                            style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;"
                        >
                            Ruby at Scale
                        </h3>
                        <p class="text-gray-600" style="color: #4b5563;">
                            Stories from Ruby startups that grew huge: how they
                            scaled their product and teams.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                        style="background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; padding: 1.5rem; display: block; visibility: visible;"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                            style="width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;"
                        >
                            <img
                                src="/cto.png"
                                alt="CTO Panel icon"
                                class="w-full h-full object-contain"
                                style="width: 100%; height: 100%; object-fit: contain; display: block;"
                            />
                        </div>
                        <h3
                            class="text-xl font-bold text-gray-900 mb-2"
                            style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;"
                        >
                            CTO Panel
                        </h3>
                        <p class="text-gray-600" style="color: #4b5563;">
                            Let's learn from the CTOs of multi-billion dollar
                            Ruby companies: Gusto, Chime, Clio, and more.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                        style="background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; padding: 1.5rem; display: block; visibility: visible;"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                            style="width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;"
                        >
                            <img
                                src="/startups.png"
                                alt="Ruby Startup Demos icon"
                                class="w-full h-full object-contain"
                                style="width: 100%; height: 100%; object-fit: contain; display: block;"
                            />
                        </div>
                        <h3
                            class="text-xl font-bold text-gray-900 mb-2"
                            style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;"
                        >
                            Ruby Startup Demos
                        </h3>
                        <p class="text-gray-600" style="color: #4b5563;">
                            Get inspired by the hottest products built with Ruby
                            and Rails today.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <SpeakersHighlight />

        <StartupDemos />

        <Testimonials />

        <Sponsors />

        <Newsletter />
    </main>
</Layout>

<style>
    /* Smooth scroll behavior */
    html {
        scroll-behavior: smooth;
    }
</style>

<script>
    // Smooth scroll for anchor links only
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener("click", function (e) {
                e.preventDefault();
                const href = (
                    e.currentTarget as HTMLAnchorElement
                ).getAttribute("href");
                if (href) {
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({
                            behavior: "smooth",
                            block: "start",
                        });
                    }
                }
            });
        });
    });
</script>
