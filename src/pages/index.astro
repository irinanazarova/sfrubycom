                                <!-- Release: JRuby 10 -->
                                <div class="md:border-l md:border-white/10 md:pl-8">
                                    <span class="inline-block px-2.5 py-1 bg-violet-500/20 text-violet-400 text-xs font-bold uppercase tracking-wider rounded mb-3">Release</span>
                                    <h3 class="font-display text-xl font-bold text-white mb-2">JRuby 10: Java 26 + RISC-V</h3>
                                    <p class="text-xs text-white/40 mb-2">Apr 6, 2026</p>
                                    <p class="text-sm text-white/60 leading-relaxed mb-3">Ruby 3.4 compatibility with Java 26 and RISC-V 64 support. 43 fixes including memory leaks and JIT compiler issues.</p>
                                    <a href="https://www.jruby.org/2026/04/06/jruby-10-0-5-0.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-violet-400 hover:text-violet-300 transition-colors">
                                        Read more<span class="sr-only"> about JRuby 10</span>
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                    </a>
                                </div>
                            </div>

                            <!-- Three Column Stories: Row 2 -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 mb-6">
                                <div class="md:pr-8">
                                    <div class="flex flex-col gap-3">
                                        <span class="inline-block px-2.5 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider rounded w-fit">Security</span>
