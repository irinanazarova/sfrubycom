---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import SpeakersHighlight from "../components/SpeakersHighlight.astro";
import StartupDemos from "../components/StartupDemos.astro";
import Sponsors from "../components/Sponsors.astro";
import Newsletter from "../components/Newsletter.astro";
import Testimonials from "../components/Testimonials.astro";
---

<Layout>
    <main class="scroll-smooth">
        <Hero />

        <!-- Key Topics: Ruby and Startups section -->
        <section id="themes" class="py-32 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-20">
                    <p
                        class="mb-12 text-2xl md:text-3xl font-light text-dark-700 max-w-4xl mx-auto leading-relaxed"
                    >
                        SF Ruby is excited to invite you to our premier event:
                        the
                        <span
                            class="bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent font-semibold"
                        >
                            San Francisco Ruby Conference
                        </span>
                    </p>
                    <div class="space-y-8 mb-20">
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            We're gathering <span
                                class="font-semibold text-dark-800"
                                >~600 Rubyists</span
                            > in San Francisco: where new Ruby dreams are born every
                            day. Two unforgettable days await—where you'll forge
                            connections with ambitious founders, engineers scaling
                            the largest Ruby-powered products, and open source authors
                            shaping what’s next for Ruby and Rails.
                        </p>
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            Demos from the fast-paced Ruby startups, hands-on
                            workshops on hot topics, and deep conversations in
                            the hallway track. Join a creative, generous, and
                            unapologetically mischievous Ruby community. This is
                            where you belong!
                        </p>
                    </div>
                    <div class="inline-block">
                        <h2
                            class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-dark-900 mb-4 tracking-tight"
                        >
                            Key Topics: Ruby and Startups
                        </h2>
                        <div
                            class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
                        >
                        </div>
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                        >
                            <img
                                src="/oss.png"
                                alt="New Open Source & AI Tooling icon"
                                class="w-full h-full object-contain"
                            />
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            New Open Source & AI Tooling
                        </h3>
                        <p class="text-gray-600">
                            New open source and tools built for the most
                            ambitious Ruby and Rails apps, including Ruby & AI.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                        >
                            <img
                                src="/scaleups.png"
                                alt="Ruby at Scale icon"
                                class="w-full h-full object-contain"
                            />
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Ruby at Scale
                        </h3>
                        <p class="text-gray-600">
                            Stories from Ruby startups that grew huge: how they
                            scaled their product and teams.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                        >
                            <img
                                src="/cto.png"
                                alt="CTO Panel icon"
                                class="w-full h-full object-contain"
                            />
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            CTO Panel
                        </h3>
                        <p class="text-gray-600">
                            Let's learn from the CTOs of multi-billion dollar
                            Ruby companies: Gusto, Chime, Clio, and more.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-lg shadow-md border border-gray-200 p-6"
                    >
                        <div
                            class="w-28 h-28 flex items-center justify-center mb-4"
                        >
                            <img
                                src="/startups.png"
                                alt="Ruby Startup Demos icon"
                                class="w-full h-full object-contain"
                            />
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Ruby Startup Demos
                        </h3>
                        <p class="text-gray-600">
                            Get inspired by the hottest products built with Ruby
                            and Rails today.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <SpeakersHighlight />

        <StartupDemos />

        <Testimonials />

        <Sponsors />

        <Newsletter />
    </main>
</Layout>
