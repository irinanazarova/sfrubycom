---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import IslandNav from "../components/IslandNav.astro";
import NewsRunner from "../components/NewsRunner.astro";
import "../styles/global.css";
import StartupCard from "../components/StartupCard.astro";
import StartupModal from "../components/StartupModal.astro";
import ResourceCard from "../components/ResourceCard.astro";
import Button from "../components/Button.astro";
import SocialLink from "../components/SocialLink.astro";

import { getAllStartups, getStartup, startups as startupsData } from "../data/startups.js";
import { getTalk, talks } from "../data/talks.js";
import { getLatestMeetupRecordings, formatTimestamp } from "../data/meetup-recordings.js";
import { getJobsBySponsor, getSortedJobs } from "../data/jobs.js";
import { getAllPhotoAlbums, GCS_PHOTO_BASE } from "../data/events.js";
import { getSponsor } from "../data/sponsors.js";
import { getSpeaker } from "../data/speakers.js";
import { getAllHosts, hosts as hostsData } from "../data/hosts.js";
import HostCard from "../components/HostCard.astro";
import HostModal from "../components/HostModal.astro";

const allStartups = getAllStartups();

// Filter out hidden startups (CorePilot cancelled)
const visibleStartups = allStartups.filter((s) => s.id !== "corepilot");

// Sort startups: those with demo videos first (same as /startups page)
const startups = visibleStartups.sort((a, b) => {
    const aDemoTalk = getTalk(`${a.id}-demo`);
    const bDemoTalk = getTalk(`${b.id}-demo`);
    const aHasVideo = a.youtubeId || aDemoTalk?.youtubeId;
    const bHasVideo = b.youtubeId || bDemoTalk?.youtubeId;

    if (aHasVideo && !bHasVideo) return -1;
    if (!aHasVideo && bHasVideo) return 1;
    return 0;
});

// Get featured startups (first 8)
const featuredStartups = startups.slice(0, 8);

const startupCount = startups.length;

// Map startup IDs to sponsor IDs for job lookup
const startupToSponsorMap: Record<string, string> = {
    bolt_new: "bolt-new",
    finta: "finta",
    thatch: "thatch",
};

// Build enhanced startups data with jobs info, speaker info, and source URLs for modal
const enhancedStartupsData: Record<string, any> = {};
for (const [id, startup] of Object.entries(startupsData)) {
    const sponsorId = startupToSponsorMap[id];
    const startupJobs = sponsorId ? getJobsBySponsor(sponsorId) : [];
    const demoTalk = getTalk(`${id}-demo`);
    const speaker = startup.speakerId ? getSpeaker(startup.speakerId) : null;
    enhancedStartupsData[id] = {
        ...startup,
        jobs: startupJobs,
        youtubeId: startup.youtubeId || demoTalk?.youtubeId || null,
        fundingUrl: startup.fundingUrl || null,
        valuationUrl: startup.valuationUrl || null,
        newsUrl: startup.newsUrl || null,
        speaker: speaker,
    };
}

// Get featured jobs (1 per company, newest first)
const allJobs = getSortedJobs();
const seenCompanies = new Set();
const featuredJobs = allJobs.filter((job) => {
    const companyKey = job.sponsorId || job.startupId || job.companyId;
    if (seenCompanies.has(companyKey)) return false;
    seenCompanies.add(companyKey);
    return true;
}).slice(0, 6).map((job) => {
    const sponsor = getSponsor(job.sponsorId);
    const startup = job.startupId ? getStartup(job.startupId) : null;
    const inline = job.companyName ? { name: job.companyName, logo: job.companyLogo } : null;
    return {
        ...job,
        sponsor: sponsor || (startup ? { name: startup.name, logo: startup.logo } : inline),
    };
});
const jobCount = allJobs.length;

// Get latest 2 meetup recordings + 2 conference keynotes for homepage
const latestMeetupRecordings = getLatestMeetupRecordings(2);
const featuredKeynotes = [getTalk("rails-x-keynote"), getTalk("rails-ai-ruby-llm")]
    .filter(Boolean)
    .map((talk: any) => ({
        ...talk,
        speaker: talk.speakerId ? getSpeaker(talk.speakerId) : null,
    }));

// Get photo albums
const photoAlbums = getAllPhotoAlbums();
const featuredPhotos = photoAlbums.slice(0, 4);
const totalPhotoCount = photoAlbums.reduce(
    (sum, album) => sum + album.photoCount,
    0,
);

// First confirmed 2026 conference sponsors (Ruby tier)
const conference2026Sponsors = [
    { name: "Typesense", logo: "/sponsor_typesense.png", url: "https://typesense.org/" },
    { name: "WorkOS", logo: "/sponsor_workos.svg", url: "https://workos.com/" },
];

// July 2026 news, one uniform card each (chip: ruby = story, gold = release/hiring)
const newsItems = [
    { cat: "Press", gold: false, title: "Anthropic Picks Persona to Verify Claude Users", meta: "Jun 22 · TechCrunch", blurb: "Starting July 8, Anthropic will verify the identity of flagged Claude accounts with a government ID and a selfie check, and it chose Persona, the SF identity platform that calls itself a Rails-first company, to run the verification. For Persona ($418M raised, $2B valuation), it lands a month after FedRAMP Moderate authorization.", href: "https://techcrunch.com/2026/06/22/anthropic-says-claude-may-want-to-see-your-id/", link: "Read the coverage", external: true },
    { cat: "Conference", gold: false, title: "SF Ruby Conf: CFP July 6, Tickets July 15", meta: "Nov 10-12 · SFJAZZ", blurb: "Our first conference: three days at SFJAZZ in San Francisco, keynoted by Garry Tan, President & CEO of Y Combinator. The CFP opens July 6, early bird tickets go on sale for one day on July 15, and sponsorships are open now.", href: "/conference-2026", link: "Conference details", external: false },
    { cat: "Event", gold: false, title: "RubyConf 2026: Matz Keynotes Vegas", meta: "Jul 14-16 · Red Rock Resort", blurb: "Ruby Central's flagship lands in Las Vegas with keynotes from Matz, Dave Thomas, Jessica Kerr, and Obie Fernandez, plus the first class of Ruby Fellows. SF meetup regulars fill the program: Cameron Dutro, Jeremy Evans, Alexander Baygeldin, Marco Roth.", href: "https://rubyconf.org/", link: "Register", external: true },
    { cat: "Event", gold: false, title: "SF Ruby Meetup, July @ Sentry", meta: "Jul 22 · 45 Fremont St.", blurb: "A new format: fewer talks, more connecting, with a full round of stage intros. Cameron Dutro presents Garnet.js, his JavaScript implementation of the YARV virtual machine, joined by Alexander Baygeldin (Evil Martians) and Marco Roth. 83+ RSVPs already.", href: "https://lu.ma/qeg0w8on", link: "RSVP on Luma", external: true },
    { cat: "AI + Ruby", gold: false, title: "RubyLLM Hits the Hacker News Front Page", meta: "Jun 24 · Hacker News", blurb: "RubyLLM spent June 24 on the Hacker News front page with 446 points and 82 comments, the loudest mainstream moment yet for Carmine Paolino's library. v1.16 shipped days earlier with concurrent AI tool execution, observability instrumentation, and proxy support for every provider.", href: "https://news.ycombinator.com/item?id=48660711", link: "Read the thread", external: true },
    { cat: "AI + Ruby", gold: false, title: "Matz's AI-Built Compiler Runs Rails in 13MB of RAM", meta: "Jun 19", blurb: "Sam Ruby compiled a Rails blog app through Roundhouse into Spinel, the ahead-of-time Ruby compiler Matz is building with Claude's help, producing a native binary that runs in 13MB of RAM. Spinel covers a deliberate Ruby subset, and it points at Ruby on the edge and in embedded devices.", href: "https://intertwingly.net/blog/2026/06/19/Spinel-on-Rails.html", link: "Read the writeup", external: true },
    { cat: "Press", gold: false, title: "Rails at 41 Million Requests an Hour", meta: "Jun 16", blurb: "Andrew Atkinson documents how Aura Frames survived Christmas Day: 41M API requests an hour and 226K database transactions a second across eight sharded Postgres primaries, on Rails' built-in Multiple Databases support with disable_joins, keyset pagination, and Memcached.", href: "https://andyatkinson.com/how-aura-frames-scales-for-peak-load-ruby-on-rails", link: "Read the case study", external: true },
    { cat: "Release", gold: true, title: "Instacart Is Gemini's First Grocery Partner", meta: "May 19", blurb: "Gemini users can now connect Instacart and build a real, shoppable cart in conversation, then check out for delivery or pickup. Gemini joins Claude and ChatGPT among the major assistants with agentic Instacart shopping. In June the Rails-built platform shipped Immersive Feed, a shoppable video ad format.", href: "https://company.instacart.com/updates/instacart-brings-agentic-grocery-shopping-to-gemini", link: "Read more", external: true },
    { cat: "Release", gold: true, title: "Chime Pushes Into Investing", meta: "Jun 1", blurb: "CEO Chris Britt says investment accounts arrive within months: individual stocks, ETFs, bonds, and robo-investing powered by Jade, Chime's generative-AI agent. The Rails-built neobank, 10.2M active members strong, keeps widening its lane after posting its first GAAP-profitable quarter this spring.", href: "https://finance.yahoo.com/markets/stocks/article/chime-ceo-says-hundreds-of-thousands-of-its-members-are-setting-up-trump-accounts-as-it-pushes-into-investing-161148607.html", link: "Read more", external: true },
    { cat: "Event", gold: false, title: "Brighton Ruby Runs Its 12th Edition", meta: "Jun 25 · Brighton Dome", blurb: "Andy Croll's single-day seaside conference delivered 11 talks: Iliana Hadzhiatanasova on 15 years of upgrades in a 3-million-line monolith (Rails 3.0 to edge), Craig Norford on scaling multi-tenant Sidekiq, a performance-engineering session from Elena Tănăsoiu and Emma Gabriel, and Brian Casel on why your experience is your AI advantage.", href: "https://rubyevents.org/events/brightonruby-2026", link: "See the program", external: true },
    { cat: "Event", gold: false, title: "SF Ruby Meetup @ PlanetScale", meta: "Jun 18 · San Francisco", blurb: "Hosted with Sam Lambert. Jeremy Evans (Ubicloud) walked through implementing Core Set, Hal Spitz delivered \"ActiveJob: Call Me Maybe,\" and Irina Nazarova demoed local-first Rails with pglite and Electric, plus making Ruby resources discoverable to LLMs.", href: "https://lu.ma/ltipgvuh", link: "Event page", external: true },
    { cat: "Event", gold: false, title: "Blastoff Rails Recordings Are Live", meta: "Jun 11-12 · Albuquerque", blurb: "All 17 talks from the first-edition conference are up on rubyevents.org, including keynotes from Irina Nazarova (\"Startups on Rails\") and Kieran Klaassen (\"Building Cora Solo\"), plus Avi Flombaum's \"Don't Read the Code: Trusting AI With Your Rails Codebase.\"", href: "https://rubyevents.org/events/blastoffrails-2026", link: "Watch the talks", external: true },
    { cat: "Release", gold: true, title: "Chatwoot Tops Ruby Trending, Ships Voice Calls", meta: "Jun 16", blurb: "The Rails-built open-source support platform (YC W21) added 4,100+ GitHub stars this month, the most of any Ruby repo, and launched voice calls in beta: Twilio phone calls and WhatsApp calling alongside Captain, its AI support agent.", href: "https://www.chatwoot.com/changelog", link: "See the changelog", external: true },
    { cat: "Release", gold: true, title: "MCP Ruby SDK: Four Releases in Two Weeks", meta: "Jun", blurb: "The official mcp gem shipped v0.19 through v0.22 inside June: OAuth client-credentials support, W3C trace context propagation, ephemeral sessions, and a 5-100x speedup in tool schema validation. Ruby keeps pace as an agent-native backend language.", href: "https://github.com/modelcontextprotocol/ruby-sdk/releases", link: "Release notes", external: true },
    { cat: "Release", gold: true, title: "rv 0.6: Ruby Installs in a Blink", meta: "Jun 13", blurb: "André Arko published the plan and progress for rv, his Rust-based, uv-inspired Ruby manager: v0.6 delivers near-instant Ruby installs and project setup. Bundler's longtime lead is rebuilding Ruby onboarding for the speed developers now expect.", href: "https://andre.arko.net/2026/06/13/rv-plan-and-progress/", link: "Read the plan", external: true },
    { cat: "Hiring", gold: true, title: "Y Combinator Builds on Rails (and Is Hiring)", meta: "SF", blurb: "YC's software team, about 20 engineers behind Work at a Startup, Demo Day, GStack, and GBrain, is hiring Product Engineers in SF on a stack of Rails, React, Postgres, and LLM APIs. The accelerator whose president keynotes our conference in November ships on Ruby.", href: "https://www.ycombinator.com/software", link: "See the roles", external: true },
    { cat: "Hiring", gold: true, title: "Ruby Roles on the Board", meta: "61+ open roles", blurb: "Gusto (Staff, Payments/Risk), Superconductor (Principal Rails), Koah Labs, Omada Health, CompanyCam, plus Thatch, Persona, Chime, Patch, Reset, and Finta. New Rails teams hiring this month: Y Combinator, WindBorne (Redwood City), Opendate, and Jukebox Health.", href: "/jobs", link: "Browse all jobs", external: false },
];

---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Join the SF Ruby community: monthly meetups, talks, jobs, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta name="theme-color" content="#dc2626" />
        <title>SF Ruby - Where Ruby Startups Grow</title>

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="SF Ruby - Where Ruby Startups Grow"
        />
        <meta
            property="og:description"
            content="Let's build the new generation of Ruby success stories. Join the SF Ruby community: monthly meetups, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta property="og:image" content="https://sfruby.com/og/home.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content="https://sfruby.com/og/home.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Conference Announcement -->
            <!-- TODO before publish: replace href="#" with the real conference-page URL -->
            <!-- Gradient runs the full height sky -> navy, ending on the news color so the join is seamless -->
            <section id="conf-announcement" class="relative min-h-[92vh] flex items-center text-white overflow-hidden px-sky-grad-deep">
                <!-- blocky retro clouds -->
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-28 left-[12%] w-36 md:w-44 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-48 right-[10%] w-24 md:w-32 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
                <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-[16%] left-[5%] w-36 md:w-44 h-auto animate-float [animation-delay:-1.5s] pointer-events-none hidden sm:block" aria-hidden="true" />
                <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute top-[32%] right-[6%] w-40 h-auto animate-float [animation-delay:-4.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 py-16 sm:py-32 text-center">
                    <div class="mb-8">
                        <span class="px-plate px-font text-[0.5rem] md:text-[0.625rem] px-4 py-2">
                            <span class="text-gold-500">Year Two</span>
                            <span class="text-white"> &#183; Nov 10-12, 2026 &#183; SF Jazz</span>
                        </span>
                    </div>
                    <img src="/logo8bit-transparent.png" alt="San Francisco Ruby Startup Conference '26" width="536" height="920" class="px-pixelated w-full max-w-[15rem] md:max-w-[17rem] h-auto mb-8 mx-auto" />
                    <!-- Photo: Seb Daly / Web Summit / Sportsfile, CC BY 2.0 (Wikimedia Commons) -->
                    <div class="flex items-center justify-center gap-5">
                        <img src="/speaker_garry_tan.jpg" alt="Garry Tan" width="500" height="667" loading="lazy" class="w-24 h-24 md:w-28 md:h-28 border-4 border-ink shadow-md object-cover object-top shrink-0" />
                        <div class="text-left">
                            <p class="text-xl md:text-2xl lg:text-3xl text-white/90 leading-snug">
                                Keynote: <strong class="text-white">Garry Tan</strong>, President &amp; CEO of <strong class="text-white">Y Combinator</strong>
                            </p>
                            <p class="text-base md:text-lg text-white/70 mt-2">
                                Rubyist, Creator of <a href="https://github.com/garrytan/gstack" target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors">GStack</a>
                            </p>
                        </div>
                    </div>
                    <div class="mt-12 flex flex-wrap justify-center gap-x-8 gap-y-10 max-w-3xl mx-auto text-center">
                        <a href="https://luma.com/sfrubyconf2026" target="_blank" rel="noopener noreferrer" class="px-island-btn tap-press">
                            <img src="/px-ticket.png" alt="" width="26" height="12" class="px-island-btn__item h-8 w-auto" />
                            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-28 md:w-32 h-auto" />
                            <span class="px-plate px-font text-[0.5rem] px-3 py-1.5">Buy tickets</span>
                            <span class="text-xs text-white/85 mt-2">Early bird July 15</span>
                        </a>
                        <a href="https://cfp.sfruby.com" target="_blank" rel="noopener noreferrer" class="px-island-btn tap-press">
                            <img src="/px-quest.png" alt="" width="64" height="296" class="px-island-btn__item h-9 w-auto [animation-delay:-0.7s]" />
                            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-28 md:w-32 h-auto" />
                            <span class="px-plate px-font text-[0.5rem] px-3 py-1.5">Propose a talk</span>
                            <span class="text-xs text-white/85 mt-2">CFP opens July 6</span>
                        </a>
                        <a href="/sponsor-2026" class="px-island-btn tap-press">
                            <img src="/px-coin.png" alt="" width="134" height="134" class="px-island-btn__item h-9 w-auto [animation-delay:-1.4s]" />
                            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-28 md:w-32 h-auto" />
                            <span class="px-plate px-font text-[0.5rem] px-3 py-1.5">Sponsor</span>
                            <span class="text-xs text-white/85 mt-2">Booths and more</span>
                        </a>
                    </div>
                </div>

                <!-- crenellated step into the news masthead -->
                <div class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:#071f56]" aria-hidden="true"></div>
            </section>

            <!-- SF Ruby News Hero -->
            <section id="news" class="relative text-white overflow-hidden px-night">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-8 pb-16">

                    <!-- Masthead: game HUD -->
                    <div class="mb-12">
                        <div class="border-2 border-white/30 bg-white/5 px-4 py-3 flex flex-col sm:flex-row items-center justify-between gap-2">
                            <h1 class="px-font text-sm md:text-base text-white">SF Ruby News</h1>
                            <p class="px-font text-[0.625rem] md:text-xs text-gold-400">World 07-26 &#8226; July</p>
                        </div>
                        <!-- Past Issues -->
                        <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-end gap-x-3 gap-y-2">
                            <span class="px-font text-[0.5rem] text-white/50">Select world:</span>
                            <a href="/news/2026-02/" class="px-font text-[0.5rem] text-white/60 hover:text-gold-400 transition-colors">Feb</a>
                            <a href="/news/2026-03/" class="px-font text-[0.5rem] text-white/60 hover:text-gold-400 transition-colors">Mar</a>
                            <a href="/news/2026-04/" class="px-font text-[0.5rem] text-white/60 hover:text-gold-400 transition-colors">Apr</a>
                            <a href="/news/2026-05/" class="px-font text-[0.5rem] text-white/60 hover:text-gold-400 transition-colors">May</a>
                            <a href="/news/2026-06/" class="px-font text-[0.5rem] text-white/60 hover:text-gold-400 transition-colors">Jun</a>
                        </div>
                    </div>

                    <NewsRunner />

                    <!-- News: uniform cards on a horizontal snap scroller -->
                    <div class="relative">
                        <div
                            id="news-scroller"
                            class="px-scroll-row flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4"
                            tabindex="0"
                            aria-label="News stories"
                        >
                            {newsItems.map((item) => (
                                <article class="px-dialog relative snap-start shrink-0 w-[86%] sm:w-[24rem] p-5 md:p-6 flex flex-col text-left">
                                    <div class="flex items-center justify-between gap-3 mb-4">
                                        <span class:list={["px-font inline-block px-2 py-1.5 text-[0.5rem] border-2 border-ink", item.gold ? "bg-gold-500 text-ink" : "bg-ruby-500 text-white"]}>{item.cat}</span>
                                        <span class="text-[0.6875rem] text-white/50 shrink-0">{item.meta}</span>
                                    </div>
                                    <h3 class="font-display text-lg md:text-xl font-bold text-white leading-snug mb-3">{item.title}</h3>
                                    <p class="text-sm text-white/70 leading-relaxed flex-1">{item.blurb}</p>
                                    <a
                                        href={item.href}
                                        target={item.external ? "_blank" : undefined}
                                        rel={item.external ? "noopener noreferrer" : undefined}
                                        class:list={["mt-4 inline-flex items-center gap-1.5 text-xs transition-colors", item.gold ? "text-gold-400 hover:text-gold-300" : "text-ruby-400 hover:text-ruby-300"]}
                                    >
                                        {item.link}
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                    </a>
                                    <!-- face-down state, shown only during the news game -->
                                    <div class="news-lock hidden absolute inset-0 px-dither-royal flex items-center justify-center" aria-hidden="true">
                                        <span class="px-font text-5xl text-gold-500 px-shadow-ink">?</span>
                                    </div>
                                </article>
                            ))}
                        </div>

                        <!-- Pager -->
                        <div class="flex items-center justify-center gap-6 mt-6 mb-6">
                            <button id="news-prev" aria-label="Previous story" class="w-11 h-11 border-2 border-white/40 flex items-center justify-center text-white/60 hover:text-white hover:border-white transition-colors disabled:opacity-20 disabled:cursor-default" disabled>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                            </button>
                            <p id="news-count" class="px-font text-[0.625rem] text-gold-400" aria-live="polite">News 1 of {newsItems.length}</p>
                            <button id="news-next" aria-label="Next story" class="w-11 h-11 border-2 border-white/40 flex items-center justify-center text-white/60 hover:text-white hover:border-white transition-colors disabled:opacity-20 disabled:cursor-default">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Divider + CTA -->
                    <div class="h-[2px] bg-white/15 mb-10"></div>

                    <script>
                        (function() {
                            const scroller = document.getElementById('news-scroller');
                            const prevBtn = document.getElementById('news-prev') as HTMLButtonElement;
                            const nextBtn = document.getElementById('news-next') as HTMLButtonElement;
                            const counter = document.getElementById('news-count');
                            if (!scroller || !prevBtn || !nextBtn || !counter) return;
                            const cards = Array.from(scroller.children) as HTMLElement[];
                            const total = cards.length;
                            const step = () => (cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : scroller.clientWidth);

                            let current = 0;
                            function update() {
                                current = Math.min(total - 1, Math.max(0, Math.round(scroller.scrollLeft / step())));
                                counter.textContent = `News ${current + 1} of ${total}`;
                                prevBtn.disabled = current === 0;
                                nextBtn.disabled = current === total - 1;
                            }
                            let raf = 0;
                            scroller.addEventListener('scroll', () => {
                                cancelAnimationFrame(raf);
                                raf = requestAnimationFrame(update);
                            }, { passive: true });
                            prevBtn.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
                            nextBtn.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
                            scroller.addEventListener('keydown', (e) => {
                                if (e.key === 'ArrowRight') { e.preventDefault(); nextBtn.click(); }
                                if (e.key === 'ArrowLeft') { e.preventDefault(); prevBtn.click(); }
                            });
                            update();
                        })();
                    </script>

