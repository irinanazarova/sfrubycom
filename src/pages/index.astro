---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import StartupCard from "../components/StartupCard.astro";
import StartupModal from "../components/StartupModal.astro";
import MeetupCard from "../components/MeetupCard.astro";
import ResourceCard from "../components/ResourceCard.astro";
import Button from "../components/Button.astro";
import SocialLink from "../components/SocialLink.astro";
import EmailModal from "../components/EmailModal.astro";

import { getAllStartups, startups as startupsData } from "../data/startups.js";
import { getTalk, talks } from "../data/talks.js";
import { getJobsBySponsor, getSortedJobs } from "../data/jobs.js";
import { getAllPhotoAlbums, GCS_PHOTO_BASE } from "../data/events.js";
import { getSponsor, getSponsorsGroupedByTier } from "../data/sponsors.js";
import { getSpeaker } from "../data/speakers.js";

// Try to load meetups from content if available
let meetups = [];
try {
    const meetupsModule = await import("../content/meetups.json");
    meetups = meetupsModule.default || [];
} catch (e) {
    // No meetups data available
}

const allStartups = getAllStartups();

// Filter out hidden startups (CorePilot cancelled)
const visibleStartups = allStartups.filter((s) => s.id !== "corepilot");

// Sort startups: those with demo videos first (same as /startups page)
const startups = visibleStartups.sort((a, b) => {
    const aDemoTalk = getTalk(`${a.id}-demo`);
    const bDemoTalk = getTalk(`${b.id}-demo`);
    const aHasVideo = a.youtubeId || aDemoTalk?.youtubeId;
    const bHasVideo = b.youtubeId || bDemoTalk?.youtubeId;

    if (aHasVideo && !bHasVideo) return -1;
    if (!aHasVideo && bHasVideo) return 1;
    return 0;
});

// Get next upcoming meetup
const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingMeetups = meetups
    .filter((m) => new Date(m.date) >= today)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
const nextMeetup = upcomingMeetups[0];

// Get featured startups (first 8)
const featuredStartups = startups.slice(0, 8);

const startupCount = startups.length;

// Map startup IDs to sponsor IDs for job lookup
const startupToSponsorMap: Record<string, string> = {
    bolt_new: "bolt-new",
    finta: "finta",
    thatch: "thatch",
};

// Build enhanced startups data with jobs info, speaker info, and source URLs for modal
const enhancedStartupsData: Record<string, any> = {};
for (const [id, startup] of Object.entries(startupsData)) {
    const sponsorId = startupToSponsorMap[id];
    const startupJobs = sponsorId ? getJobsBySponsor(sponsorId) : [];
    const demoTalk = getTalk(`${id}-demo`);
    const speaker = startup.speakerId ? getSpeaker(startup.speakerId) : null;
    enhancedStartupsData[id] = {
        ...startup,
        jobs: startupJobs,
        youtubeId: startup.youtubeId || demoTalk?.youtubeId || null,
        fundingUrl: startup.fundingUrl || null,
        valuationUrl: startup.valuationUrl || null,
        newsUrl: startup.newsUrl || null,
        speaker: speaker,
    };
}

// Get featured jobs (first 4)
const allJobs = getSortedJobs();
const featuredJobs = allJobs.slice(0, 4).map((job) => ({
    ...job,
    sponsor: getSponsor(job.sponsorId),
}));
const jobCount = allJobs.length;

// Get featured talks with videos (first 4) and include speaker info
const talksWithVideos = Object.values(talks)
    .filter((talk: any) => talk.youtubeId && talk.type !== "demo")
    .slice(0, 4)
    .map((talk: any) => ({
        ...talk,
        speaker: talk.speakerId ? getSpeaker(talk.speakerId) : null,
    }));

// Get photo albums
const photoAlbums = getAllPhotoAlbums();
const featuredPhotos = photoAlbums.slice(0, 4);
const totalPhotoCount = photoAlbums.reduce(
    (sum, album) => sum + album.photoCount,
    0,
);

// Get sponsors grouped by tier - order: Pickaxe, Ruby, Post Production, Reception, Emerald, Travel
const tierOrder = [
    "Pickaxe ⛏️",
    "Ruby",
    "Post Production",
    "Reception",
    "Emerald",
    "Travel",
];
const sponsorsByTier = getSponsorsGroupedByTier().sort((a, b) => {
    return tierOrder.indexOf(a.name) - tierOrder.indexOf(b.name);
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="Join the SF Ruby community: monthly meetups, talks, jobs, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta name="theme-color" content="#dc2626" />
        <title>SF Ruby - Where Ruby Startups Grow</title>

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="SF Ruby - Where Ruby Startups Grow"
        />
        <meta
            property="og:description"
            content="Let's build the new generation of Ruby success stories. Join the SF Ruby community: monthly meetups, and the annual conference. Connect with founders and engineers building with Ruby."
        />
        <meta property="og:image" content="https://sfruby.com/og_sfruby.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col"
    >
        <Header />

        <main class="flex-grow">
            <!-- Hero Section with Blue Gradient -->
            <section
                class="relative bg-gradient-to-br from-sky-400 via-sky-600 to-indigo-700 text-white overflow-hidden min-h-[90vh] flex items-center"
            >
                <!-- Background effects -->
                <div class="absolute inset-0 overflow-hidden">
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent"
                    >
                    </div>
                    <div
                        class="absolute top-20 left-10 w-72 h-72 bg-white/10 rounded-full blur-3xl"
                    >
                    </div>
                    <div
                        class="absolute bottom-40 right-20 w-96 h-96 bg-indigo-400/20 rounded-full blur-3xl"
                    >
                    </div>
                </div>

                <div
                    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20"
                >
                    <div class="max-w-4xl mx-auto text-center">
                        <h1
                            class="text-4xl md:text-5xl lg:text-7xl font-bold text-white mb-6 leading-tight"
                        >
                            Let's build the new generation of Ruby success
                            stories!
                        </h1>

                        <div
                            class="flex flex-col sm:flex-row gap-4 justify-center"
                        >
                            <a
                                href="https://lu.ma/sfruby"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-ruby-500 to-pink-500 border-2 border-ruby-400 text-white rounded-xl font-semibold shadow-xl transition-all duration-300 transform hover:shadow-2xl hover:shadow-ruby-500/30 hover:scale-105"
                            >
                                Join next meetup
                                <svg
                                    class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                </svg>
                            </a>
                            <a
                                href="/talks"
                                class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold shadow-xl transition-all duration-300 transform hover:shadow-2xl hover:scale-105 hover:bg-white/20 hover:border-white/50"
                            >
                                Explore videos
                                <svg
                                    class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Cloud-shaped transition to next section -->
                <div
                    class="absolute bottom-0 left-0 right-0 h-20 overflow-hidden"
                >
                    <svg
                        preserveAspectRatio="none"
                        viewBox="0 0 1200 120"
                        xmlns="http://www.w3.org/2000/svg"
                        class="absolute bottom-0 w-full h-full"
                    >
                        <path
                            d="M0,120 L0,80 C120,60 240,50 360,55 C480,45 600,48 720,55 C840,45 960,48 1080,55 C1140,52 1170,53 1200,55 L1200,120 Z"
                            fill="#f8fafc"></path>
                    </svg>
                </div>
            </section>

            <!-- Next Meetup Section -->
            {
                nextMeetup && (
                    <section class="py-20 bg-slate-50">
                        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                            <div class="max-w-4xl mx-auto">
                                <!-- Section header -->
                                <div class="text-center mb-8">
                                    <span class="inline-block px-4 py-1.5 bg-ruby-100 text-ruby-700 text-sm font-semibold rounded-full mb-4">
                                        Monthly Meetup
                                    </span>
                                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                                        Join the Next SF Ruby Meetup
                                    </h2>
                                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                                        Connect with founders and engineers building with Ruby.
                                        Learn, share, and make friends for life!
                                    </p>
                                </div>

                                <!-- Meetup card - more prominent -->
                                <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden mb-8">
                                    <div class="bg-gradient-to-r from-ruby-500 to-pink-500 px-6 py-3">
                                        <span class="text-white font-semibold">Next Event</span>
                                    </div>
                                    <div class="p-6">
                                        <MeetupCard meetup={nextMeetup} />
                                    </div>
                                </div>

                                <!-- Three CTAs -->
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <!-- Sign up -->
                                    <a
                                        href="https://lu.ma/sfruby"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group flex items-center gap-4 p-5 bg-white rounded-xl border-2 border-gray-200 hover:border-ruby-400 hover:shadow-lg transition-all duration-300"
                                    >
                                        <div class="w-12 h-12 bg-ruby-100 rounded-xl flex items-center justify-center group-hover:bg-ruby-500 transition-colors">
                                            <svg class="w-6 h-6 text-ruby-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-900 group-hover:text-ruby-600 transition-colors">Sign up</h3>
                                            <p class="text-sm text-gray-500">RSVP on Luma</p>
                                        </div>
                                    </a>

                                    <!-- Submit a talk -->
                                    <a
                                        href="https://forms.gle/EZLqENWd5VjiLduq8"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group flex items-center gap-4 p-5 bg-white rounded-xl border-2 border-gray-200 hover:border-ruby-400 hover:shadow-lg transition-all duration-300"
                                    >
                                        <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center group-hover:bg-amber-500 transition-colors">
                                            <svg class="w-6 h-6 text-amber-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-900 group-hover:text-ruby-600 transition-colors">Submit a talk</h3>
                                            <p class="text-sm text-gray-500">Share your knowledge</p>
                                        </div>
                                    </a>

                                    <!-- Host the meetup -->
                                    <button
                                        data-email-modal="host-meetup"
                                        class="group flex items-center gap-4 p-5 bg-white rounded-xl border-2 border-gray-200 hover:border-ruby-400 hover:shadow-lg transition-all duration-300 text-left w-full"
                                    >
                                        <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center group-hover:bg-emerald-500 transition-colors">
                                            <svg class="w-6 h-6 text-emerald-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-900 group-hover:text-ruby-600 transition-colors">Host the meetup</h3>
                                            <p class="text-sm text-gray-500">Open your office</p>
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>
                )
            }

            <!-- Email Modal for hosting -->
            <EmailModal
                id="host-meetup"
                email="irina@evilmartians.com"
                subject="Host SF Ruby Meetup"
                title="Host an SF Ruby Meetup"
            />

            <!-- Startup Gallery Section -->
            <section class="py-20 bg-white">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                        >
                            Ruby startups shipping today
                        </h2>
                        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                            {startupCount} startups in the SF Bay Area building with
                            Ruby.
                        </p>
                    </div>

                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                    >
                        {
                            featuredStartups.map((startup) => {
                                const sponsorId =
                                    startupToSponsorMap[startup.id];
                                const hasJobs = sponsorId
                                    ? getJobsBySponsor(sponsorId).length > 0
                                    : false;
                                return (
                                    <StartupCard
                                        startup={startup}
                                        compact
                                        hasJobs={hasJobs}
                                    />
                                );
                            })
                        }
                    </div>

                    <div class="mt-10 text-center">
                        <Button href="/startups" variant="secondary">
                            View all startups
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </Button>
                    </div>
                </div>
            </section>

            <!-- Talks Section -->
            <section class="py-20 bg-gray-50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                        >
                            Watch the Talks
                        </h2>
                        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                            Conference keynotes, meetup presentations, and
                            startup demos.
                        </p>
                    </div>

                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                    >
                        {
                            talksWithVideos.map((talk: any) => (
                                <a
                                    href={`/talks?talk=${talk.id}#${talk.id}`}
                                    class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300"
                                >
                                    <div class="aspect-video bg-gray-900 relative overflow-hidden">
                                        <img
                                            src={`https://img.youtube.com/vi/${talk.youtubeId}/mqdefault.jpg`}
                                            alt={talk.title}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                        />
                                        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                            <div class="w-12 h-12 bg-white/90 rounded-full flex items-center justify-center">
                                                <svg
                                                    class="w-5 h-5 text-ruby-500 ml-1"
                                                    fill="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path d="M8 5v14l11-7z" />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-4">
                                        <h3 class="font-semibold text-gray-900 group-hover:text-ruby-500 transition-colors">
                                            {talk.title}
                                        </h3>
                                        {talk.speaker && (
                                            <p class="text-sm text-gray-500 mt-1">
                                                {talk.speaker.name}
                                            </p>
                                        )}
                                    </div>
                                </a>
                            ))
                        }
                    </div>

                    <div class="mt-10 text-center">
                        <Button href="/talks" variant="secondary">
                            View all talks
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </Button>
                    </div>
                </div>
            </section>

            <!-- Jobs Section -->
            <section class="py-20 bg-white">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                        >
                            Ruby Jobs
                        </h2>
                        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                            {jobCount} open positions at Ruby startups and companies.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {
                            featuredJobs.map((job) => (
                                <a
                                    href={job.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group flex items-center gap-4 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-all duration-300"
                                >
                                    {job.sponsor?.logo && (
                                        <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center p-2 flex-shrink-0 border border-gray-200">
                                            <img
                                                src={job.sponsor.logo}
                                                alt={job.sponsor.name}
                                                class="max-w-full max-h-full object-contain"
                                            />
                                        </div>
                                    )}
                                    <div class="flex-grow min-w-0">
                                        <h3 class="font-semibold text-gray-900 group-hover:text-ruby-500 transition-colors truncate">
                                            {job.title}
                                        </h3>
                                        <p class="text-sm text-gray-500">
                                            {job.sponsor?.name} · {job.location}
                                        </p>
                                    </div>
                                    <svg
                                        class="w-5 h-5 text-gray-400 group-hover:text-ruby-500 flex-shrink-0 transition-colors"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                        />
                                    </svg>
                                </a>
                            ))
                        }
                    </div>

                    <div class="mt-10 text-center">
                        <Button href="/jobs" variant="secondary">
                            View all jobs
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </Button>
                    </div>
                </div>
            </section>

            <!-- Photos Section -->
            <section class="py-20 bg-gray-50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2
                            class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                        >
                            Photos
                        </h2>
                        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                            {totalPhotoCount} photos from SF Ruby Conference 2025.
                        </p>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        {
                            featuredPhotos.map((album) => (
                                <a
                                    href={`/photos#${album.id}`}
                                    class="group block aspect-square rounded-xl overflow-hidden relative"
                                >
                                    <img
                                        src={album.coverPhoto}
                                        alt={album.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                                        <div class="absolute bottom-3 left-3 right-3">
                                            <p class="text-white text-sm font-medium">
                                                {album.title}
                                            </p>
                                            <p class="text-white/70 text-xs">
                                                {album.photoCount} photos
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            ))
                        }
                    </div>

                    <div class="mt-10 text-center">
                        <Button href="/photos" variant="secondary">
                            View all photos
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </Button>
                    </div>
                </div>
            </section>

            <!-- Community Links Section -->
            <section class="py-20 bg-white">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
