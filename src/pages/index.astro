---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import HashScroll from "../components/HashScroll.astro";
import SectionLinks from "../components/SectionLinks.astro";
import CompaniesAttending from "../components/CompaniesAttending.astro";
import Pier from "../components/Pier.astro";
import GettingThere from "../components/GettingThere.astro";
import Schedule from "../components/Schedule.astro";
import TicketsBlock from "../components/TicketsBlock.astro";
import Crew from "../components/Crew.astro";
import { ticketLink, ticketEventClass, regularTier, conferenceSpeakers, ticketTiers } from "../data/conference-2026.js";
import { conference2026SponsorTiers } from "../data/sponsors.js";
import SponsorTiers from "../components/SponsorTiers.astro";
import { palette } from "../design/tokens.mjs";
import "../styles/global.css";

// Fighter-select roster: confirmed speakers with sprites, minus a few kept off
// the homepage grid so the count fills it exactly, plus community cameos
// mixed in: the game is the whole community, stage slot or not. With the
// visitor's own "You" cell the grid holds 21 on desktop (7 x 3) and 20 on
// phones (5 x 4), where the last cameo sits out.
const offTheGrid = ["Alex Coomans", "Cole Robertson", "Jason Thomas"];
const fighters = conferenceSpeakers
    .filter((s) => s.pixel && !offTheGrid.includes(s.name))
    .map((s) => ({ name: s.name, org: s.orgs[0].name, pixel: s.pixel }));

// Cameos carry their real affiliation, same as the speakers: everyone on the
// roster reads as a peer, stage slot or not.
const cameos = [
    { name: "Amanda Kinney", org: "Evil Martians", pixel: "/community_amanda_kinney_pixel_256.png" },
    { name: "Andrew Ford", org: "Buttercut", pixel: "/community_andrew_ford_pixel_256.png" },
    { name: "Chris Fung", org: "Gusto", pixel: "/community_chris_fung_pixel_256.png" },
    { name: "James Kerr", org: "Tend Cash", pixel: "/community_james_kerr_pixel_256.png", desktopOnly: true },
];
// Fixed scatter positions so the cameos read as mixed in, not appended.
[4, 8, 13, 17].forEach((pos, i) =>
    fighters.splice(Math.min(pos, fighters.length), 0, cameos[i]),
);

// Flat sponsor list for the hero ticker, tier order preserved.
const tickerSponsors = conference2026SponsorTiers.flatMap((t) => t.sponsors);

// One description for the meta tag, Open Graph and Twitter, from the same
// data the page renders, so a price change never leaves a stale preview.
const fromPrice = Math.min(...ticketTiers.filter((t) => t.state === "live").map((t) => t.price));
const DESCRIPTION = `Nov 10-12, 2026 at SFJAZZ. Two days of Ruby talks for small teams and big teams, Day 1 AI-heavy and Day 2 AI-light, then a community day. Schedule is live, tickets from $${fromPrice}.`;

// Deadline text for the hero CTA.
const regularCloses = new Date(regularTier.closesOn).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "America/Los_Angeles",
});
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="description" content={DESCRIPTION} />
        <meta name="theme-color" content={palette.sky[400]} />
        <title>San Francisco Ruby Conference 2026 - SF Ruby</title>

        <link
            rel="preload"
            href="/fonts/PressStart2P.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="San Francisco Ruby Conference 2026 - SF Ruby"
        />
        <meta property="og:description" content={DESCRIPTION} />
        <meta property="og:url" content="https://sfruby.com/" />
        <meta property="og:image" content="https://sfruby.com/og/conference.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="San Francisco Ruby Conference 2026 - SF Ruby" />
        <meta name="twitter:description" content={DESCRIPTION} />
        <meta property="twitter:image" content="https://sfruby.com/og/conference.png" />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Conference hero, staged like a game title screen: title art,
                 date subtitle, one-line statement, blinking press-start CTA,
                 and the organizer/sponsor ticker scrolling along the bottom. -->
            <!-- On laptops the hero stops short of the fold on purpose: the
                 schedule's heading shows under it, so the page reads as
                 something to scroll. -->
            <section id="conf" class="relative lg:min-h-[calc(100svh-10rem)] flex items-center text-white overflow-hidden px-sky-grad-day">
                <!-- blocky retro clouds up high, floating islands down low:
                     the overworld this screen takes place in -->
                <!-- three cloud sizes at three depths: big and slow low down,
                     small and far up high -->
                <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-24 left-[6%] w-48 md:w-72 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-40 right-[8%] w-32 md:w-48 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-16 left-[44%] w-20 md:w-28 animate-float [animation-delay:-1.5s] pointer-events-none hidden md:block" aria-hidden="true" />
                <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute bottom-52 right-[2%] w-40 md:w-64 animate-float [animation-delay:-6s] pointer-events-none hidden lg:block" aria-hidden="true" />
                <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute bottom-60 left-[1%] w-28 md:w-40 animate-float [animation-delay:-4s] pointer-events-none hidden lg:block" aria-hidden="true" />
                <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-44 left-[3%] w-56 h-auto animate-float [animation-delay:-4.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
                <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute top-[30%] right-[3%] w-36 h-auto animate-float [animation-delay:-2s] pointer-events-none hidden lg:block" aria-hidden="true" />
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 pt-20 lg:pt-[5.5rem] pb-36 md:pb-40 lg:pb-[8.5rem]">
                    <h1 class="sr-only">
                        San Francisco Ruby Conference 2026
                    </h1>
                    <div class="grid lg:grid-cols-2 gap-6 lg:gap-12 items-center">
                        <!-- Fighter select: the speakers as a character-select
                             screen. A script cycles the gold highlight through
                             the roster; clicking a cell locks the choice. -->
                        <div class="order-2 lg:order-1 flex justify-center lg:justify-end">
                            <div id="fighter-select" class="px-dialog px-dialog--gold p-4 md:p-6 lg:p-5 w-full max-w-md">
                                <p class="px-font text-px10 md:text-xs text-gold-500 text-center mb-3 md:mb-4 lg:mb-3">
                                    Choose your fighter
                                </p>
                                <div class="relative flex items-end justify-center h-36 md:h-56 lg:h-40 mb-1" aria-hidden="true">
                                    <span class="px-spot"></span>
                                    <img src="/px-sparkle.png" alt="" width="7" height="7" class="px-sparkle w-3 md:w-4 top-[12%] left-[18%]" style="--px-twinkle-delay: 0s" />
                                    <img src="/px-sparkle.png" alt="" width="7" height="7" class="px-sparkle w-2.5 md:w-3 top-[30%] right-[16%]" style="--px-twinkle-delay: -0.7s" />
                                    <img src="/px-sparkle.png" alt="" width="7" height="7" class="px-sparkle w-2 md:w-3 top-[58%] left-[24%]" style="--px-twinkle-delay: -1.2s" />
                                    <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-0 left-1/2 -translate-x-1/2 w-44 md:w-60 h-auto" />
                                    <img id="fighter-portrait" src={fighters[0].pixel} alt="" width="256" height="256" class="px-pixelated h-[calc(100%-1.25rem)] md:h-[calc(100%-1.75rem)] w-auto px-fighter-bob relative mb-3 md:mb-4" />
                                    <span id="fighter-mystery" class="px-font text-5xl md:text-6xl text-white hidden self-center relative mb-6 md:mb-8">?</span>
                                </div>
                                <div class="text-center mb-3 md:mb-4 lg:mb-3 min-h-[3.5rem] lg:min-h-[3rem]">
                                    <p id="fighter-name" class="px-font text-px10 md:text-sm text-white">{fighters[0].name}</p>
                                    <p id="fighter-org" class="px-font text-px8 text-gold-500 mt-1.5 opacity-90">{fighters[0].org}</p>
                                </div>
                                <div id="fighter-grid" class="grid grid-cols-5 lg:grid-cols-7 gap-1.5" role="list" aria-label="Conference speakers">
                                    {fighters.map((f, i) => (
                                        <button
                                            type="button"
                                            role="listitem"
                                            class:list={["px-fighter-cell", { "is-active": i === 0, "max-lg:hidden": f.desktopOnly }]}
                                            data-name={f.name}
                                            data-org={f.org}
                                            data-pixel={f.pixel}
                                            aria-label={`${f.name}, ${f.org}`}
                                        >
                                            <img src={f.pixel} alt="" width="256" height="256" class="px-pixelated w-full h-auto" style={`--px-bob-delay: ${(i * -0.4).toFixed(1)}s`} loading="eager" />
                                        </button>
                                    ))}
                                    <!-- The last slot is the visitor: choosing
                                         yourself means claiming a ticket. -->
                                    <a
                                        href={ticketLink("hero-you")}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        role="listitem"
                                        class={`px-fighter-cell ${ticketEventClass("hero-you")}`}
                                        data-name="You"
                                        data-org="Claim your slot"
                                        data-pixel=""
                                        aria-label="You: claim your slot, buy a ticket"
                                    >
                                        <span class="px-font text-px8 text-white" aria-hidden="true">You</span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Title stack: art, date, statement, insert-coin CTA -->
                        <div class="order-1 lg:order-2 text-center">
                            <img src="/logo8bit-transparent.png" alt="San Francisco Ruby Conference '26" width="520" height="830" class="px-pixelated w-full max-w-[9rem] md:max-w-[13rem] lg:max-w-[10rem] h-auto mb-4 md:mb-6 lg:mb-4 mx-auto" />
                            <div class="mb-4 md:mb-5 lg:mb-4">
                                <span class="px-plate px-font text-px8 md:text-px10 px-4 py-2">
                                    <span class="text-gold-500">Year Two</span>
                                    <span class="text-white"> &#183; Nov 10-12, 2026 &#183; SFJAZZ</span>
                                </span>
                            </div>
                            <p class="font-display font-semibold text-base md:text-xl leading-snug text-gold-400 px-shadow-ink max-w-md lg:max-w-lg mx-auto mb-5 md:mb-7 lg:mb-5">
                                Let's bring programmer delight and Ruby into the future.
                            </p>
                            <!-- Insert coin: one gold block carrying the ask, the price
                                 and the deadline, the whole thing the link -->
                            <a
                                href={ticketLink("hero")}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`px-btn px-btn--gold tap-press inline-flex items-center gap-4 px-7 py-4 text-left ${ticketEventClass("hero")}`}
                            >
                                <span class="px-coinslot shrink-0" aria-hidden="true">
                                    <span class="px-coinslot__well">
                                        <img src="/px-coin.png" alt="" width="12" height="12" class="px-pixelated px-coinslot__coin" />
                                    </span>
                                    <span class="px-coinslot__slot"></span>
                                </span>
                                <span class="flex flex-col gap-1.5">
                                    <span class="px-font text-xs md:text-sm"><span class="px-blink" aria-hidden="true">&#9654;&#xFE0E; </span>Get your ticket</span>
                                    <span class="px-font text-px8 opacity-80 flex flex-wrap gap-x-2 gap-y-1">
                                        <span class="whitespace-nowrap">$450 &#183; until {regularCloses}<span id="days-left"></span></span>
                                        <span class="whitespace-nowrap">One day: $350</span>
                                    </span>
                                </span>
                            </a>
                            <!-- The herald: the early-bird dragon, its sign
                                 repainted to announce the program, linking to
                                 the schedule. In the title stack on phones; on
                                 desktop it hovers top-right of the title art,
                                 positioned against the content column. -->
                            <a
                                href="#schedule"
                                class="inline-block mt-7 lg:mt-0 lg:absolute lg:top-20 lg:right-0 xl:-right-6 tap-press"
                                aria-label="The schedule is live. Jump to the schedule"
                            >
                                <img
                                    src="/schedule_live_dragon.png"
                                    alt="A pixel dragon holding a sign that reads Schedule is live"
                                    width="1064"
                                    height="696"
                                    class="px-pixelated animate-float w-full max-w-[12rem] lg:max-w-[11rem] xl:max-w-[13rem] h-auto"
                                />
                            </a>
                        </div>
                    </div>
                    <script define:vars={{ closesOn: regularTier.closesOn }}>
                        // Countdown next to the deadline, computed on the client so
                        // the static build never goes stale. Absent if JS fails.
                        const el = document.getElementById("days-left");
                        const days = Math.ceil(
                            (new Date(closesOn).getTime() - Date.now()) / 86400000,
                        );
                        if (el && days > 0 && days < 120)
                            el.textContent = ` (${days}d)`;
                    </script>
                    <script>
                        // Character select: cycle the highlight through the
                        // roster; hover pauses, a click or the arrow keys take
                        // over (left/right anywhere, up/down while engaged with
                        // the panel so page scrolling stays intact).
                        {
                            // Cells hidden at this width (the phone grid is
                            // one short) stay out of the cycle.
                            const cells = [
                                ...document.querySelectorAll(".px-fighter-cell"),
                            ].filter((c) => c.offsetParent !== null);
                            const grid = document.getElementById("fighter-grid");
                            const cols = () =>
                                getComputedStyle(grid).gridTemplateColumns.split(" ").length;
                            const portrait = document.getElementById("fighter-portrait");
                            const mystery = document.getElementById("fighter-mystery");
                            const nameEl = document.getElementById("fighter-name");
                            const orgEl = document.getElementById("fighter-org");
                            const panel = document.getElementById("fighter-select");
                            let index = 0;
                            let timer = null;
                            let locked = false;

                            const show = (i) => {
                                index = i;
                                cells.forEach((c, j) =>
                                    c.classList.toggle("is-active", j === i),
                                );
                                const d = cells[i].dataset;
                                nameEl.textContent = d.name;
                                orgEl.textContent = d.org;
                                if (d.pixel) {
                                    portrait.src = d.pixel;
                                    portrait.classList.remove("hidden");
                                    mystery.classList.add("hidden");
                                    // retrigger the two-frame blip-in
                                    portrait.classList.remove("px-fighter-enter");
                                    void portrait.offsetWidth;
                                    portrait.classList.add("px-fighter-enter");
                                } else {
                                    portrait.classList.add("hidden");
                                    mystery.classList.remove("hidden");
                                }
                            };

                            const reduced = window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            ).matches;
                            const start = () => {
                                if (reduced || locked || timer) return;
                                timer = setInterval(
                                    () => show((index + 1) % cells.length),
                                    1600,
                                );
                            };
                            const stop = () => {
                                clearInterval(timer);
                                timer = null;
                            };

                            cells.forEach((c, i) =>
                                c.addEventListener("click", () => {
                                    locked = true;
                                    stop();
                                    show(i);
                                }),
                            );
                            let hovering = false;
                            panel.addEventListener("pointerenter", () => {
                                hovering = true;
                                stop();
                            });
                            panel.addEventListener("pointerleave", () => {
                                hovering = false;
                                start();
                            });

                            // Arrow keys grab the controls: attract mode ends,
                            // the player drives. Up/down only fire while the
                            // panel is hovered or focused, so they never steal
                            // the page's own scroll keys.
                            document.addEventListener("keydown", (e) => {
                                if (e.altKey || e.ctrlKey || e.metaKey) return;
                                const engaged =
                                    hovering ||
                                    panel.contains(document.activeElement);
                                let delta = null;
                                if (e.key === "ArrowRight") delta = 1;
                                else if (e.key === "ArrowLeft") delta = -1;
                                else if (e.key === "ArrowDown" && engaged)
                                    delta = cols();
                                else if (e.key === "ArrowUp" && engaged)
                                    delta = -cols();
                                if (delta === null) return;
                                e.preventDefault();
                                locked = true;
                                stop();
                                const n = cells.length;
                                show((((index + delta) % n) + n) % n);
                            });
                            start();
                        }
                    </script>
                </div>

                <!-- Organized by + sponsors: running ticker along the hero's bottom
                     edge. Sponsor logos are dark art, so they ride the dark strip
                     as white silhouettes (brightness-0 invert). The clone group is
                     aria-hidden and link-free so tab order sees each brand once. -->
                <!-- the ground the scene stands on, with the sponsor ticker as
                     the strip beneath it -->
                <div class="absolute bottom-0 left-0 w-full">
                <div class="px-ground h-12 md:h-16" aria-hidden="true"></div>
                <div class="px-ticker w-full border-t-4 border-ink py-3">
                    {
                        [false, true].map((clone) => (
                            <div
                                class="px-ticker__group gap-10 pr-10"
                                aria-hidden={clone ? "true" : undefined}
                            >
                                {Array.from({ length: 2 }).map(() => (
                                    <>
                                        <span class="px-font text-px8 uppercase whitespace-nowrap text-white">
                                            Organized by
                                        </span>
                                        {clone ? (
                                            <img
                                                src="/images/logo_evilmartians_horizontal.png"
                                                alt=""
                                                width="1856"
                                                height="432"
                                                class="h-8 md:h-9 w-auto shrink-0"
                                            />
                                        ) : (
                                            <a
                                                href="https://evilmartians.com"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="shrink-0 hover:opacity-80 transition-opacity"
                                            >
                                                <img
                                                    src="/images/logo_evilmartians_horizontal.png"
                                                    alt="Evil Martians"
                                                    width="1856"
                                                    height="432"
                                                    class="h-8 md:h-9 w-auto"
                                                    loading="eager"
                                                />
                                            </a>
                                        )}
                                        <span class="px-font text-px8 uppercase whitespace-nowrap text-white">
                                            Sponsored by
                                        </span>
                                        {/* Every ticker img needs intrinsic width/height and eager
                                            loading: a late-loading or 0-width image changes the
                                            group's width mid-animation, and Safari glitches when
                                            the translateX(-100%) distance is re-resolved. */}
                                        {tickerSponsors.map((sponsor) =>
                                            clone ? (
                                                <img
                                                    src={sponsor.logo}
                                                    alt=""
                                                    width={sponsor.logoWidth}
                                                    height={sponsor.logoHeight}
                                                    class="h-6 md:h-7 w-auto shrink-0 brightness-0 invert"
                                                    loading="eager"
                                                />
                                            ) : (
                                                <a
                                                    href={sponsor.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="shrink-0 hover:opacity-80 transition-opacity"
                                                >
                                                    <img
                                                        src={sponsor.logo}
                                                        alt={sponsor.name}
                                                        width={sponsor.logoWidth}
                                                        height={sponsor.logoHeight}
                                                        class="h-6 md:h-7 w-auto brightness-0 invert"
                                                        loading="eager"
                                                    />
                                                </a>
                                            ),
                                        )}
                                    </>
                                ))}
                            </div>
                        ))
                    }
                </div>
                </div>
            </section>

            <!-- The schedule, first thing after the hero: the two-audience
                 program is the claim the rest of the page has to earn, and
                 the schedule is the proof. -->
            <Schedule />

            <!-- Tickets and the manager page, right after the program -->
            <TicketsBlock />

            <!-- 2026 Conference Sponsors -->
            <!-- White, with the ink rule on top, so the sponsor wall reads as
                 its own block after the schedule's pale sky -->
            <section id="sponsors-2026" class="py-20 md:py-24 bg-white border-t-4 border-ink">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-8">
                        <span class="px-plate px-plate--gold px-font text-px8 px-3 py-1.5">Sponsors</span>
                        <h2 class="px-font text-lg md:text-2xl text-gray-900 mt-6 mb-2">
                            Backing year two
                        </h2>
                        <p class="text-base md:text-lg text-gray-600 mt-4 mb-10">Thank you to the companies behind the conference.</p>

                        <SponsorTiers />

                        <div class="mt-10">
                            <a
                                href="/sponsor-2026"
                                class="px-btn px-font text-px9 gap-2 px-5 py-3 bg-gold-500 text-ink hover:bg-gold-400"
                            >
                                Join them: Sponsor 2026
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Who is in the room, then the game everyone in it plays -->
            <CompaniesAttending />

            <Pier />

            <!-- Venue photo, framed like a cutscene still -->
            <section class="relative w-full border-y-4 border-ink">
                <img
                    src="/sfjazz.webp"
                    alt="SFJAZZ Center, San Francisco"
                    width="1600"
                    height="900"
                    loading="lazy"
                    class="w-full h-[40vh] md:h-[60vh] object-cover"
                />
                <div class="absolute bottom-0 left-0 w-full p-6 md:p-10">
                    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="px-card inline-block bg-white p-4 md:p-5">
                            <p class="px-font text-xs md:text-sm text-gray-900">
                                <a
                                    href="https://www.sfjazz.org/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="hover:underline"
                                    >The Venue: SFJAZZ Center</a
                                >
                            </p>
                            <p class="text-xs md:text-sm text-gray-600 mt-2">
                                San Francisco
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- How to reach the venue: transit lines and garage rates -->
            <GettingThere />

            <!-- The people running it, before the community strip -->
            <Crew />

            <!-- The community behind the conference -->
            <section id="community" class="py-16 bg-white">
