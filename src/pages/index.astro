</html>

<script define:vars={{ enhancedStartupsData }}>
    // Modal functionality for startup cards
    function buildModalContent(startup) {
        let videoHtml = "";
        if (startup.youtubeId) {
            videoHtml = `
                <div class="mb-6">
                    <div class="aspect-video rounded-xl overflow-hidden bg-black">
                        <iframe
                            src="https://www.youtube.com/embed/${startup.youtubeId}"
                            title="${startup.name} Demo"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            class="w-full h-full"
                        ></iframe>
                    </div>
                </div>
            `;
        }

        let factsHtml = "";
        if (startup.funding || startup.valuation || startup.news) {
            const fundingHtml = startup.funding
                ? startup.fundingUrl
                    ? `<a href="${startup.fundingUrl}" target="_blank" rel="noopener noreferrer" class="hover:text-ruby-500 underline">${startup.funding}</a>`
                    : startup.funding
                : null;
            const valuationHtml = startup.valuation
                ? startup.valuationUrl
                    ? `<a href="${startup.valuationUrl}" target="_blank" rel="noopener noreferrer" class="hover:text-ruby-500 underline">${startup.valuation}</a>`
                    : startup.valuation
                : null;
            const newsHtml = startup.news
                ? startup.newsUrl
                    ? `<a href="${startup.newsUrl}" target="_blank" rel="noopener noreferrer" class="hover:text-ruby-500 underline">${startup.news}</a>`
                    : startup.news
                : null;

            factsHtml = `
                <div class="mb-6 p-4 bg-gray-50 rounded-xl">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        ${fundingHtml ? `<div><span class="text-gray-500">Funding:</span> <span class="font-medium text-gray-900">${fundingHtml}</span></div>` : ""}
                        ${valuationHtml ? `<div><span class="text-gray-500">Valuation:</span> <span class="font-medium text-gray-900">${valuationHtml}</span></div>` : ""}
                        ${newsHtml ? `<div class="md:col-span-2"><span class="text-gray-500">Latest:</span> <span class="text-gray-700">${newsHtml}</span></div>` : ""}
                    </div>
                </div>
            `;
        }

        let jobsHtml = "";
        if (startup.jobs && startup.jobs.length > 0) {
            const jobsList = startup.jobs
                .map(
                    (job) => `
                <a href="${job.applyUrl || "#"}" target="_blank" rel="noopener noreferrer"
                   class="block p-3 bg-white border border-gray-200 rounded-lg hover:border-ruby-300 hover:shadow-sm transition-all">
                    <div class="font-medium text-gray-900">${job.title}</div>
                    <div class="text-sm text-gray-500">${job.location || "Remote"}</div>
                </a>
            `,
                )
                .join("");

            jobsHtml = `
                <div class="mb-6">
                    <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
                        Open Positions
                        <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded-full">Hiring</span>
                    </h4>
                    <div class="space-y-2">${jobsList}</div>
                </div>
            `;
        }

        let speakerHtml = "";
        if (startup.speaker) {
            const speaker = startup.speaker;
            // Build social links
            let socialLinks = "";
            if (speaker.socials && speaker.socials.length > 0) {
                const socialIcons = speaker.socials
                    .map((url) => {
                        let icon = "";
                        let label = "Link";
                        if (url.includes("github.com")) {
                            icon = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`;
                            label = "GitHub";
                        } else if (
                            url.includes("x.com") ||
                            url.includes("twitter.com")
                        ) {
                            icon = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
                            label = "Twitter";
                        } else if (url.includes("linkedin.com")) {
                            icon = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
                            label = "LinkedIn";
                        } else if (url.includes("bsky.app")) {
                            icon = `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>`;
                            label = "Bluesky";
                        }
                        return icon
                            ? `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 transition-colors" title="${label}">${icon}</a>`
                            : "";
                    })
                    .filter(Boolean)
                    .join("");

                if (socialIcons) {
                    socialLinks = `<div class="flex items-center gap-2 mt-2">${socialIcons}</div>`;
                }
            }

            speakerHtml = `
                <div class="mb-6 p-5 bg-gradient-to-br from-gray-50 to-slate-50 rounded-xl border border-gray-100">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Demo Presenter</h4>
                    <div class="flex items-start gap-4">
                        ${
                            speaker.image
                                ? `
                            <img src="${speaker.image}" alt="${speaker.name}"
                                class="w-20 h-20 rounded-xl object-cover shadow-md flex-shrink-0" />
                        `
                                : ""
                        }
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-lg text-gray-900">${speaker.name}</p>
                            <p class="text-sm text-gray-600">${speaker.role || speaker.title || ""}</p>
                            ${speaker.company ? `<p class="text-sm text-gray-500">${speaker.company}</p>` : ""}
                            ${socialLinks}
                        </div>
                    </div>
                    ${speaker.bio ? `<p class="mt-4 text-sm text-gray-600 leading-relaxed">${speaker.bio}</p>` : ""}
                </div>
            `;
        }

        return `
            <div class="p-6">
                <button id="startupModalCloseBtn" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 transition-colors z-10">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-16 h-16 bg-gray-100 rounded-xl flex items-center justify-center p-2 flex-shrink-0">
                        <img src="${startup.logo}" alt="${startup.name}" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900">${startup.name}</h3>
                        <p class="text-gray-600">${startup.description}</p>
                        ${startup.isYC ? '<span class="inline-block mt-2 px-2 py-0.5 bg-orange-100 text-orange-700 text-xs font-medium rounded">YC Backed</span>' : ""}
                    </div>
                </div>
                ${videoHtml}
                ${speakerHtml}
                ${factsHtml}
                ${jobsHtml}
                <a href="${startup.url}" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 text-ruby-500 hover:text-ruby-600 font-medium">
                    Visit website
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        `;
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Handle startup card clicks - use StartupModal component functions
        document.querySelectorAll("[data-startup-id]").forEach((card) => {
            card.addEventListener("click", (e) => {
                e.preventDefault();
                const startupId = card.getAttribute("data-startup-id");
                const startup = enhancedStartupsData[startupId];
                if (
                    startup &&
                    window.setStartupModalContent &&
                    window.showStartupModal
                ) {
                    window.setStartupModalContent(buildModalContent(startup));
                    window.showStartupModal();
                }
            });
        });
    });
</script>

<script define:vars={{ hostsData }}>
    function buildHostModalContent(host) {
        // Tag color
        let tagClass = "bg-red-50 text-red-700";
        if (host.tag === "Ruby SDK") tagClass = "bg-purple-50 text-purple-700";

        let leadershipHtml = "";
        if (host.leadership) {
            leadershipHtml = `
                <div class="flex items-center gap-2 mt-2">
                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="text-sm text-gray-600">${host.leadership}</span>
                </div>
            `;
        }

        let foundersHtml = "";
        if (host.founders) {
            foundersHtml = `
                <div class="flex items-start gap-2 mt-2">
                    <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="text-sm text-gray-600">Founded ${host.founded || ""} by ${host.founders}</span>
                </div>
            `;
        }

        let productHtml = "";
        if (host.product) {
            productHtml = `
                <div class="mb-5">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">The Product</h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.product}</p>
                </div>
            `;
        }

        let historyHtml = "";
        if (host.history) {
            historyHtml = `
                <div class="mb-5">
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">The Story</h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.history}</p>
                </div>
            `;
        }

        let ecosystemHtml = "";
        if (host.rubyEcosystem) {
            let openSourceHtml = "";
            if (host.openSource && host.openSource.length > 0) {
                const repoLinks = host.openSource.map(repo =>
                    `<a href="${repo.url}" target="_blank" rel="noopener noreferrer" class="flex items-start gap-2 p-2 -mx-2 rounded-lg hover:bg-red-100/50 transition-colors group">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        <div class="min-w-0">
                            <span class="text-sm font-medium text-gray-900 group-hover:text-red-700">${repo.name}</span>
                            <span class="text-xs text-gray-500 ml-1">${repo.desc}</span>
                        </div>
                    </a>`
                ).join("");
                openSourceHtml = `
                    <div class="mt-3 pt-3 border-t border-red-100">
                        <p class="text-xs font-semibold text-red-700 uppercase tracking-wider mb-1">Open Source</p>
                        ${repoLinks}
                    </div>
                `;
            }
            ecosystemHtml = `
                <div class="mb-5 p-4 bg-gradient-to-br from-red-50 to-rose-50 rounded-xl border border-red-100">
                    <h4 class="text-xs font-semibold text-red-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z"/>
                        </svg>
                        Ruby & Rails Ecosystem
                    </h4>
                    <p class="text-sm text-gray-700 leading-relaxed">${host.rubyEcosystem}</p>
                    ${openSourceHtml}
                </div>
            `;
        }

        return `
            <div class="p-6">
                <button id="hostModalCloseBtn" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 transition-colors z-10">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Header -->
                <div class="flex items-start gap-4 mb-5">
                    <div class="w-16 h-16 bg-gray-50 rounded-xl flex items-center justify-center p-2 flex-shrink-0 border border-gray-100">
                        <img src="${host.logo}" alt="${host.name}" class="max-w-full max-h-full object-contain" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="text-xl font-bold text-gray-900">${host.name}</h3>
                            <span class="px-2 py-0.5 text-xs font-bold rounded-md ${tagClass}">${host.tag}</span>
                        </div>
                        <p class="text-gray-600 mt-1">${host.summary}</p>
                        ${foundersHtml}
                        ${leadershipHtml}
                    </div>
                </div>

                ${productHtml}
                ${historyHtml}
                ${ecosystemHtml}

                <a href="${host.url}" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-medium text-sm">
                    Visit ${host.name}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        `;
    }

    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-host-id]").forEach((card) => {
            card.addEventListener("click", (e) => {
                e.preventDefault();
                const hostId = card.getAttribute("data-host-id");
                const host = hostsData[hostId];
                if (
                    host &&
                    window.setHostModalContent &&
                    window.showHostModal
                ) {
                    window.setHostModalContent(buildHostModalContent(host));
                    window.showHostModal();
                }
            });
        });
    });
</script>
