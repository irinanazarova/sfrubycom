---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import KeyTopics from "../components/KeyTopics.astro";
import SpeakersHighlight from "../components/SpeakersHighlight.astro";
import StartupDemos from "../components/StartupDemos.astro";
import Sponsors from "../components/Sponsors.astro";
import Newsletter from "../components/Newsletter.astro";
import Testimonials from "../components/Testimonials.astro";
---

<Layout>
    <main class="scroll-smooth">
        <Hero />

        <!-- Introduction section -->
        <section id="intro" class="py-32 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <p
                        class="mb-12 text-2xl md:text-3xl font-light text-dark-700 max-w-4xl mx-auto leading-relaxed"
                    >
                        SF Ruby and Evil Martians are excited to invite you to
                        our premier event: the
                        <span
                            class="bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent font-semibold"
                        >
                            San Francisco Ruby Conference
                        </span>
                    </p>

                    <!-- Ultra-minimal YouTube embed for your index.astro -->
                    <div class="my-12 max-w-4xl mx-auto">
                        <div
                            class="relative rounded-xl overflow-hidden shadow-2xl bg-black"
                            style="padding-bottom: 56.25%;"
                        >
                            <iframe
                                src="https://www.youtube-nocookie.com/embed/m2P9PZwi8W4?autoplay=1&mute=1=0&controls=0&modestbranding=1&rel=0&showinfo=0&fs=0&iv_load_policy=3&disablekb=1&loop=1&playlist=m2P9PZwi8W4&enablejsapi=1"
                                class="absolute inset-0 w-full h-full"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
                                title="San Francisco Ruby Conference"
                                style="border: none;"></iframe>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            We're gathering <span
                                class="font-semibold text-dark-800"
                                >~600 Rubyists</span
                            > in San Francisco: where new Ruby dreams are born every
                            day. Three unforgettable days await, where you'll connect
                            with ambitious founders of new Ruby startups like bolt.new
                            and YC startups, and engineers scaling the big Ruby success
                            stories like <a
                                href="/schedule#dynamic-ruby-toolkit-workshop"
                                class="font-semibold text-dark-800">Chime</a
                            >, <a
                                href="/schedule#debugging-gusto-scale"
                                class="font-semibold text-dark-800">Gusto</a
                            >, <a
                                href="/schedule#derailing-our-application"
                                class="font-semibold text-dark-800">Cisco</a
                            >, <a
                                href="/schedule#zjit-ruby-performance"
                                class="font-semibold text-dark-800">Shopify</a
                            >, <a
                                href="/schedule#rails-expertise-distilled"
                                class="font-semibold text-dark-800"
                                >One Medical</a
                            >, Intercom. You'll meet authors of open source
                            shaping what's next for Ruby and Rails, like <a
                                href="/schedule#reaction-view"
                                class="font-semibold text-dark-800"
                                >Marco Roth</a
                            > and <a
                                href="/schedule#rails-ai-ruby-llm"
                                class="font-semibold text-dark-800"
                                >Carmine Paolino</a
                            >, as well as big stars like <a
                                href="/schedule#navigating-language-evolution"
                                class="font-semibold text-dark-800"
                                >José Valim</a
                            >, <a
                                href="/schedule#thin-client-approach"
                                class="font-semibold text-dark-800"
                                >Jeremy Evans</a
                            >, <a
                                href="/schedule#start-writing-ruby"
                                class="font-semibold text-dark-800"
                                >Dave Thomas</a
                            > and <a
                                href="/schedule#vladimir-dementyev-keynote"
                                class="font-semibold text-dark-800"
                                >Vladimir Dementiev</a
                            >.
                        </p>
                        <p
                            class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                        >
                            Demos from the fast-paced <a
                                href="#startup-demos"
                                class="font-semibold text-dark-800"
                                >Ruby startups</a
                            >, hands-on workshops on <a
                                href="/schedule#inertia-rails-workshop"
                                class="font-semibold text-dark-800"
                                >Inertia Rails</a
                            >, <a
                                href="/schedule#building-agents-rails"
                                class="font-semibold text-dark-800"
                                >building AI Agents</a
                            >, <a
                                href="/schedule#dynamic-ruby-toolkit-workshop"
                                class="font-semibold text-dark-800"
                                >dynamic Ruby types</a
                            >, <a
                                href="/schedule#upskill-diving-into-rails"
                                class="font-semibold text-dark-800"
                                >team upskill</a
                            >, and deep conversations in the hallway track. Join
                            a creative, generous, and unapologetically
                            mischievous Ruby community. This is where you
                            belong!
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <SpeakersHighlight />

        <StartupDemos />

        <KeyTopics />

        <Testimonials />

        <Sponsors />

        <Newsletter />
    </main>
</Layout>
