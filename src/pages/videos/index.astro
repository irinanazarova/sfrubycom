---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { talks } from "../../data/talks.js";
import { slotAssignments, scheduleSlots } from "../../data/schedule.js";
import { getSpeaker } from "../../data/speakers.js";
import { getAllMeetupRecordings } from "../../data/meetup-recordings.js";
import { getAllEmVideos } from "../../data/em-videos.js";
import youtubeDates from "../../content/youtube-dates.json";
import talkSummaries from "../../content/talk-summaries.json";

const meetupRecordings = getAllMeetupRecordings();
const emVideos = getAllEmVideos();

// Day 1 & 2 conference talks (exclude Day 3 community events).
const day1And2SlotIds = Object.keys(scheduleSlots).filter((s) => scheduleSlots[s].day <= 2);
const conferenceTalkIds = new Set(day1And2SlotIds.map((s) => slotAssignments[s]).filter(Boolean));
const allTalks = Object.values(talks);
const excludedTalkIds = new Set(["hack-day-angellist", "community-day-placeholder"]);
const conferenceTalks = allTalks.filter(
    (t: any) =>
        conferenceTalkIds.has(t.id) &&
        ["keynote", "talk", "workshop", "panel"].includes(t.type) &&
        !excludedTalkIds.has(t.id),
);
const startupDemos = allTalks.filter((t: any) => t.type === "demo");

function getTalkSpeakers(talk: any) {
    if (talk.speakerId) {
        const s = getSpeaker(talk.speakerId);
        return s ? [s] : [];
    }
    if (talk.speakers && talk.speakers.length) {
        return talk.speakers.map((id: string) => getSpeaker(id)).filter(Boolean);
    }
    return [];
}
function clean(desc: string, max = 240) {
    if (!desc) return "";
    const c = desc.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
    return c.length > max ? c.slice(0, max).trimEnd() + "…" : c;
}

// Real YouTube publish dates, scraped into src/content/youtube-dates.json by
// scripts/fetch-youtube-dates.js (run `npm run fetch-youtube-dates` to refresh).
const pubDate = (id: string) => (youtubeDates as Record<string, string>)[id] || null;

// Filter categories + accent dot. Literal class strings so Tailwind keeps them.
const CATEGORIES = [
    { slug: "studio", label: "Interviews", badge: "bg-pink-500" },
    { slug: "meetups", label: "Meetups", badge: "bg-sky-500" },
    { slug: "keynotes", label: "Conference Keynotes", badge: "bg-ruby-500" },
    { slug: "talks", label: "Conference Talks", badge: "bg-violet-500" },
    { slug: "workshops", label: "Conference Workshops", badge: "bg-emerald-500" },
    { slug: "demos", label: "Startup Demos", badge: "bg-amber-500" },
];
const badgeFor = Object.fromEntries(CATEGORIES.map((c) => [c.slug, c.badge]));
const slugForTalkType: Record<string, string> = {
    keynote: "keynotes",
    talk: "talks",
    panel: "talks",
    workshop: "workshops",
    demo: "demos",
};

// Event name shown on each row. Conference content shares one event; meetups use
// the recording's name + hosting venue; interviews use the series.
const CONF_EVENT = "SF Ruby Conference 2025";
const meetupEvent = (rec: any) => {
    const base = (rec.title || "Ruby Meetup").replace(/\s*[-–—]\s*[A-Za-z]+\s+\d{4}.*$/, "").trim();
    return rec.venue ? `${base} · ${rec.venue}` : base;
};
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const fmtMonthYear = (iso: string) => {
    const [y, m] = iso.split("-");
    return `${MONTHS[+m - 1]} ${y}`;
};

// A meetup recording is one video bundling many timestamped talks. We surface the
// substantial talks as their own playlist rows (≥12 min, or the final/unknown-length
// talk) and drop lightning talks, intros, hiring pitches, and announcements; those
// stay reachable via the "full recording" row. Heuristic so the data file stays clean.
const MEETUP_SHORT_KW =
    /(announc|hiring|open mic|stand[\s-]?up|q&a|newsletter|office hours|\bupdates?\b|recap|\bpsa\b|pre-vetted|looking for|job seeker|sponsorship|opening words)/i;
const MEETUP_MIN_SEC = 720;
function substantialMeetupTalks(rec: any) {
    const sorted = [...(rec.talks || [])].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));
    return sorted.filter((t, i) => {
        const next = sorted[i + 1];
        const dur =
            next && t.timestamp > 0 && next.timestamp > t.timestamp ? next.timestamp - t.timestamp : null;
        if (MEETUP_SHORT_KW.test(t.title)) return false;
        if (dur == null) return true; // final talk or unknown timestamp -> assume real talk
        return dur >= MEETUP_MIN_SEC;
    });
}

type Item = {
    yt: string;
    start: number;
    slug: string;
    event: string;
    title: string;
    speaker: string;
    org: string;
    desc: string;
    date: string;
    order: number;
    badge?: string;
    dateLabel?: string;
    href?: string;
    who?: string;
    sumKey?: string;
};
const items: Item[] = [];

// Conference talks (keynote/talk/panel/workshop) + startup demos.
for (const talk of [...conferenceTalks, ...startupDemos]) {
    if (!talk.youtubeId) continue;
    const date = pubDate(talk.youtubeId);
    if (!date) continue;
    const sp = getTalkSpeakers(talk);
    const slug = slugForTalkType[talk.type] || "talks";
    items.push({
        yt: talk.youtubeId,
        start: 0,
        slug,
        sumKey: `v:${talk.youtubeId}`,
        event: CONF_EVENT,
        title: talk.title,
        speaker: sp.map((s: any) => s.name).join(", "),
        org: sp[0]?.company || "",
        desc: clean(talk.description),
        date,
        order: 0,
    });
}

// Meetups: substantial talks (seek to timestamp) + one "full recording" row, last.
for (const rec of meetupRecordings) {
    if (!rec.youtubeId) continue;
    const date = pubDate(rec.youtubeId);
    if (!date) continue;
    for (const t of substantialMeetupTalks(rec)) {
        items.push({
            yt: rec.youtubeId,
            start: t.timestamp || 0,
            slug: "meetups",
            sumKey: `m:${rec.id}:${rec.talks.indexOf(t)}`,
            event: meetupEvent(rec),
            title: t.title,
            speaker: t.speaker || "",
            org: t.company || "",
            desc: "",
            date,
            order: t.timestamp || 0,
        });
    }
    items.push({
        yt: rec.youtubeId,
        start: 0,
        slug: "meetups",
        sumKey: `r:${rec.id}`,
        event: meetupEvent(rec),
        title: "Full recording",
        speaker: "",
        org: "",
        desc: "",
        date,
        order: Number.MAX_SAFE_INTEGER,
    });
}

// Evil Martians studio videos.
for (const v of emVideos) {
    if (!v.youtubeId) continue;
    const date = pubDate(v.youtubeId) || v.date;
    if (!date) continue;
    items.push({
        yt: v.youtubeId,
        start: 0,
        slug: "studio",
        sumKey: `v:${v.youtubeId}`,
        event: v.series || "Evil Martians",
        title: v.title,
        speaker: v.guest
            ? `${v.guest}${v.guestRole ? ", " + v.guestRole : ""}`
            : v.interviewer
                ? `Hosted by ${v.interviewer}`
                : "",
        org: v.guestCompany || "",
        desc: clean(v.description),
        date,
        order: 0,
    });
}

// Newest first; within a shared publish date, meetup talks keep timestamp order
// and the "full recording" row sorts to the end of its meetup.
items.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.order - b.order));
for (const it of items) {
    it.badge = badgeFor[it.slug];
    it.dateLabel = fmtMonthYear(it.date);
    it.href = `https://www.youtube.com/watch?v=${it.yt}${it.start ? `&t=${it.start}s` : ""}`;
    // "Name (Company)" when we have both.
    it.who = it.speaker ? `${it.speaker}${it.org ? ` (${it.org})` : ""}` : "";
    // Prefer the transcript-based summary over the raw abstract when we have one.
    const summary = it.sumKey ? (talkSummaries as Record<string, string>)[it.sumKey] : undefined;
    if (summary) it.desc = summary;
}

const categoryChips = CATEGORIES.map((c) => ({
    ...c,
    count: items.filter((it) => it.slug === c.slug).length,
})).filter((c) => c.count > 0);
const totalVideos = items.length;
const first = items[0];
---

<BaseLayout
    title="Ruby Videos - SF Ruby"
    description="Watch Ruby and Rails videos: Startups on Rails founder interviews, SF Ruby Conference 2025 talks, monthly meetup recordings, and more. Newest first."
>
    <!-- Hero -->
    <section class="relative pt-24 pb-4 sm:pt-28 sm:pb-8 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
        </div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white">Videos</h1>
            <p class="mt-1.5 sm:mt-2 text-sm sm:text-base md:text-lg text-gray-300">
                Meetup and conference talks, workshops, demos and founder interviews. {totalVideos} videos, newest first.
            </p>
        </div>
    </section>

    <!-- Player + playlist -->
    <section class="bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10 lg:grid lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-10 lg:items-start">
            <!-- Video: pinned on mobile and desktop while the list scrolls past it.
                 Sticks against the grid container (tall, holds the list), not a short column. -->
            <div class="sticky top-20 lg:top-24 z-30 lg:z-auto -mx-4 sm:-mx-6 lg:mx-0 px-4 sm:px-6 lg:px-0 pt-2 lg:pt-0 pb-3 lg:pb-0 bg-white lg:bg-transparent lg:col-start-1 lg:row-start-1">
                <div class="aspect-video rounded-xl lg:rounded-2xl overflow-hidden bg-black shadow-lg">
                    <iframe
                        id="player"
                        class="w-full h-full"
                        src={`https://www.youtube.com/embed/${first.yt}?start=${first.start}&rel=0`}
                        title="Video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            </div>

            <!-- Now playing: scrolls away under the pinned video -->
            <div class="px-1 pt-4 lg:col-start-1 lg:row-start-2">
                <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 mb-2">
                    <span id="pv-dot" class:list={["inline-block w-2 h-2 rounded-full", first.badge]}></span>
                    <span id="pv-meta">{[first.who, first.event, first.dateLabel].filter(Boolean).join(" · ")}</span>
                </div>
                <h2 id="pv-title" class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 leading-snug">{first.title}</h2>
                <p id="pv-desc" class:list={["mt-2 sm:mt-3 text-sm text-gray-600 leading-relaxed line-clamp-3 lg:line-clamp-none", { hidden: !first.desc }]}>{first.desc}</p>
                <button id="pv-desc-toggle" type="button" class="hidden lg:!hidden mt-1 text-xs font-semibold text-ruby-500">More</button>
            </div>

            <!-- Playlist column -->
            <div class="mt-5 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2">
                <div class="cat-strip flex flex-nowrap lg:flex-wrap gap-2 mb-4 overflow-x-auto lg:overflow-visible -mx-4 px-4 sm:mx-0 sm:px-0">
                    <button
                        type="button"
                        class="cat-chip shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium border bg-gray-900 text-white border-gray-900 whitespace-nowrap transition-colors"
                        data-cat="all"
                        data-active="true"
                    >
                        All <span class="opacity-60 tabular-nums">{totalVideos}</span>
                    </button>
                    {categoryChips.map((c) => (
                        <button
                            type="button"
                            class="cat-chip shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium border bg-white text-gray-700 border-gray-200 hover:border-gray-300 whitespace-nowrap transition-colors"
                            data-cat={c.slug}
                            data-active="false"
                        >
                            <span class:list={["w-2 h-2 rounded-full", c.badge]} />
                            {c.label} <span class="opacity-60 tabular-nums">{c.count}</span>
                        </button>
                    ))}
                </div>

                <ul id="video-list" class="rounded-xl border border-gray-200 divide-y divide-gray-100 overflow-hidden">
                    {items.map((it, i) => (
                        <li>
                            <button
                                type="button"
                                class:list={["video-row w-full text-left flex items-start gap-3 px-3.5 py-2.5 hover:bg-gray-50 transition-colors", { "bg-ruby-50": i === 0 }]}
                                data-idx={i}
                                data-yt={it.yt}
                                data-start={it.start}
                                data-title={it.title}
                                data-speaker={it.who}
                                data-desc={it.desc}
                                data-event={it.event}
                                data-date={it.dateLabel}
                                data-badge={it.badge}
                                data-category={it.slug}
                                aria-current={i === 0 ? "true" : undefined}
                            >
                                <span class:list={["mt-1.5 w-2 h-2 rounded-full shrink-0", it.badge]} />
                                <span class="min-w-0 flex-1">
                                    <span class="block font-medium text-gray-900">{it.who || it.title}</span>
                                    {it.who && <span class="block text-sm text-gray-600">{it.title}</span>}
                                    <span class="block text-xs text-gray-400 mt-1">{it.event}</span>
                                </span>
                                <span class="shrink-0 pl-2 text-xs text-gray-400 tabular-nums">{it.dateLabel}</span>
                            </button>
                        </li>
                    ))}
                </ul>
                <div id="videos-empty" class="hidden text-center py-16 text-gray-500">No videos in this category.</div>
            </div>
        </div>
    </section>

    <!-- CFP CTA -->
    <section class="py-16 bg-gray-50 border-t border-gray-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Want to give a talk?</h2>
            <p class="text-lg text-gray-600 mb-8">
                We're always looking for speakers. Submit a talk proposal for our next meetup.
            </p>
            <a
                href="https://forms.gle/EZLqENWd5VjiLduq8"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-ruby-500 to-pink-500 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105"
            >
                Submit a Talk
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
        </div>
    </section>
</BaseLayout>

<style>
    /* Mobile: the category filter is a single horizontally-scrolling strip. */
    .cat-strip {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .cat-strip::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    // Playlist: clicking a row plays it in the sticky player; chips filter the list.
    function initPlaylist() {
        const rows = Array.from(document.querySelectorAll<HTMLButtonElement>(".video-row"));
        const player = document.getElementById("player") as HTMLIFrameElement | null;
        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".cat-chip"));
        const empty = document.getElementById("videos-empty");
        if (!rows.length || !player) return;

        const pvDot = document.getElementById("pv-dot");
        const pvMeta = document.getElementById("pv-meta");
        const pvTitle = document.getElementById("pv-title");
        const pvDesc = document.getElementById("pv-desc");
        const pvToggle = document.getElementById("pv-desc-toggle");

        // On mobile the summary is clamped to 3 lines; show a More/Less toggle only
        // when the text actually overflows the clamp.
        function syncDescToggle() {
            if (!pvDesc || !pvToggle) return;
            pvDesc.classList.remove("line-clamp-none");
            pvDesc.classList.add("line-clamp-3");
            pvToggle.textContent = "More";
            const overflows = pvDesc.scrollHeight > pvDesc.clientHeight + 1;
            pvToggle.classList.toggle("hidden", !overflows || !pvDesc.textContent);
        }
        pvToggle?.addEventListener("click", () => {
            const clamped = pvDesc!.classList.toggle("line-clamp-3");
            pvDesc!.classList.toggle("line-clamp-none", !clamped);
            pvToggle.textContent = clamped ? "More" : "Less";
        });

        function play(row: HTMLButtonElement, autoplay: boolean) {
            const d = row.dataset;
            const start = d.start && d.start !== "0" ? d.start : "0";
            player!.src = `https://www.youtube.com/embed/${d.yt}?start=${start}&rel=0${autoplay ? "&autoplay=1" : ""}`;
            if (pvTitle) pvTitle.textContent = d.title || "";
            if (pvMeta) pvMeta.textContent = [d.speaker, d.event, d.date].filter(Boolean).join(" · ");
            if (pvDot) pvDot.className = "inline-block w-2 h-2 rounded-full " + (d.badge || "");
            if (pvDesc) {
                pvDesc.textContent = d.desc || "";
                pvDesc.classList.toggle("hidden", !d.desc);
                syncDescToggle();
            }
            rows.forEach((r) => {
                const on = r === row;
                r.classList.toggle("bg-ruby-50", on);
                if (on) r.setAttribute("aria-current", "true");
                else r.removeAttribute("aria-current");
            });
            const url = new URL(location.href);
            url.searchParams.set("v", d.yt || "");
            if (start !== "0") url.searchParams.set("t", start);
            else url.searchParams.delete("t");
            history.replaceState({}, "", url.toString());
        }

        rows.forEach((r) =>
            r.addEventListener("click", () => {
                play(r, true);
                // On mobile the player is pinned at the top; bring it into view.
                if (window.matchMedia("(max-width: 1023px)").matches) {
                    window.scrollTo({ top: 0, behavior: "smooth" });
                }
            }),
        );

        const ACTIVE = ["bg-gray-900", "text-white", "border-gray-900"];
        const INACTIVE = ["bg-white", "text-gray-700", "border-gray-200", "hover:border-gray-300"];
        function applyFilter(cat: string) {
            let shown = 0;
            rows.forEach((r) => {
                const match = cat === "all" || r.dataset.category === cat;
                r.closest("li")?.classList.toggle("hidden", !match);
                if (match) shown++;
            });
            chips.forEach((ch) => {
                const on = ch.dataset.cat === cat;
                ch.dataset.active = on ? "true" : "false";
                ch.classList.remove(...ACTIVE, ...INACTIVE);
                ch.classList.add(...(on ? ACTIVE : INACTIVE));
            });
            if (empty) empty.classList.toggle("hidden", shown > 0);
        }
        chips.forEach((ch) =>
            ch.addEventListener("click", () => {
                const cat = ch.dataset.cat || "all";
                applyFilter(cat);
                const url = new URL(location.href);
                if (cat === "all") url.searchParams.delete("category");
                else url.searchParams.set("category", cat);
                history.replaceState({}, "", url.toString());
            }),
        );

        // Deep links: ?category= filters, ?v= selects a video.
        const params = new URLSearchParams(location.search);
        const cat = params.get("category");
        if (cat && chips.some((c) => c.dataset.cat === cat)) applyFilter(cat);
        const v = params.get("v");
        if (v) {
            const match = rows.find((r) => r.dataset.yt === v);
            if (match) {
                play(match, false);
                // Deep link may land on a row far down the list; bring it into view.
                match.scrollIntoView({ block: "center" });
            }
        }
        // Initialize the More/Less toggle for the server-rendered first video.
        syncDescToggle();
        window.addEventListener("resize", syncDescToggle);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initPlaylist);
    } else {
        initPlaylist();
    }
</script>
