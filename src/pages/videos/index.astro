<script>
    // Wait for DOM and modal to be ready
    function initTalkCards() {
        const cards = document.querySelectorAll(".talk-card");

        cards.forEach((card) => {
            card.addEventListener("click", (e) => {
                e.preventDefault();
                const talkId = card.getAttribute("data-talk-id");
                if (!talkId) return;

                openTalkModal(talkId);
            });
        });
    }

    function openTalkModal(talkId: string) {
        const talk = (window as any).talksData[talkId];
        if (!talk) return;

        // Update URL with talk parameter (without page reload)
        const url = new URL(window.location.href);
        url.searchParams.set("talk", talkId);
        window.history.pushState({ talkId }, "", url.toString());

        // Build modal content
        const modalHtml = buildTalkModalContent(talk);

        // Show modal
        if (typeof (window as any).setTalkModalContent === "function") {
            (window as any).setTalkModalContent(modalHtml);
            (window as any).showTalkModal();
        }
    }

    function closeTalkModalAndUpdateUrl() {
        // Remove talk parameter from URL
        const url = new URL(window.location.href);
        url.searchParams.delete("talk");
        window.history.pushState({}, "", url.toString());

        // Close the modal
        if (typeof (window as any).hideTalkModal === "function") {
            (window as any).hideTalkModal();
        }
    }

    function buildTalkModalContent(talk: any): string {
        // Build YouTube video section or cover image for noVideo talks
        let videoHtml = "";
        if (talk.youtubeId) {
            videoHtml = `
                <div class="mb-6">
                    <div class="relative aspect-video rounded-xl overflow-hidden bg-black shadow-lg">
                        <iframe
                            src="https://www.youtube.com/embed/${talk.youtubeId}?autoplay=1"
                            title="${talk.title}"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            class="absolute inset-0 w-full h-full"
                        ></iframe>
                    </div>
                </div>
            `;
        } else if (talk.coverImage) {
            videoHtml = `
                <div class="mb-6">
                    <div class="relative aspect-video rounded-xl overflow-hidden bg-gray-900 shadow-lg">
                        <img
                            src="${talk.coverImage}"
                            alt="${talk.title}"
                            class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-black/30"></div>
                        ${talk.noVideo ? `
                            <div class="absolute bottom-4 left-4 right-4">
                                <span class="px-3 py-2 bg-gray-900/80 text-gray-200 text-sm rounded-lg inline-block">
                                    ${talk.noVideoReason || "Recording unavailable"}
                                </span>
                            </div>
                        ` : ""}
                    </div>
                </div>
            `;
        }

        // Build speakers section
        let speakersHtml = "";
        if (talk.speakers && talk.speakers.length > 0) {
            const speakersList = talk.speakers.map((speaker: any) => `
                <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
                    ${speaker.image ? `
                        <img
                            src="${speaker.image}"
                            alt="${speaker.name}"
                            class="w-16 h-16 rounded-full object-cover ring-2 ring-white shadow-md flex-shrink-0"
                        />
                    ` : `
                        <div class="w-16 h-16 rounded-full bg-gray-300 flex items-center justify-center flex-shrink-0">
                            <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                    `}
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-gray-900">${speaker.name}</p>
                        ${speaker.role || speaker.title ? `<p class="text-sm text-gray-600">${speaker.role || speaker.title}</p>` : ""}
                        ${speaker.company ? `<p class="text-sm text-gray-500">${speaker.company}</p>` : ""}
                        ${speaker.bio ? `<p class="text-sm text-gray-600 mt-2">${speaker.bio}</p>` : ""}
                        <div class="flex gap-3 mt-2">
                            ${speaker.twitter ? `
                                <a href="https://twitter.com/${speaker.twitter}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                    </svg>
                                </a>
                            ` : ""}
                            ${speaker.github ? `
                                <a href="https://github.com/${speaker.github}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                    </svg>
                                </a>
                            ` : ""}
                            ${speaker.linkedin ? `
                                <a href="${speaker.linkedin}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                    </svg>
                                </a>
                            ` : ""}
                        </div>
                    </div>
                </div>
            `).join("");

            speakersHtml = `
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        ${talk.speakers.length > 1 ? "Speakers" : "Speaker"}
                    </h3>
                    <div class="space-y-3">
                        ${speakersList}
                    </div>
                </div>
            `;
        }

        // Build tags section
        let tagsHtml = "";
        if (talk.tags && talk.tags.length > 0) {
            const tagsList = talk.tags.map((tag: string) => `
                <span class="text-xs px-2.5 py-1 bg-gray-100 text-gray-600 rounded-full">${tag}</span>
            `).join("");
            tagsHtml = `
                <div class="flex flex-wrap gap-2 mb-6">
                    ${tagsList}
                </div>
            `;
        }

        // Get talk type badge
        const typeColors: Record<string, string> = {
            keynote: "bg-ruby-500 text-white",
            talk: "bg-sky-500 text-white",
            workshop: "bg-emerald-500 text-white",
            panel: "bg-purple-500 text-white",
        };
        const typeColor = typeColors[talk.type] || "bg-gray-500 text-white";
        const typeBadge = `<span class="px-2.5 py-1 text-xs font-semibold ${typeColor} rounded-full uppercase">${talk.type}</span>`;

        // Clean description (remove HTML tags)
        const cleanDescription = talk.description
            ? talk.description.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim()
            : "";

        return `
            <div class="p-6 sm:p-8">
                <!-- Close button -->
                <button
                    id="talkModalCloseBtn"
                    onclick="if(window.closeTalkModalAndUpdateUrl) window.closeTalkModalAndUpdateUrl();"
                    class="absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors z-10"
                    aria-label="Close modal"
                >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Video Player -->
                ${videoHtml}

                <!-- Header -->
                <div class="mb-6">
                    <div class="flex items-center gap-2 mb-3">
                        ${typeBadge}
                    </div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">${talk.title}</h2>
                </div>

                <!-- Tags -->
                ${tagsHtml}

                <!-- Description -->
                ${cleanDescription ? `
                    <div class="mb-6">
                        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">About this talk</h3>
                        <p class="text-gray-700 leading-relaxed">${cleanDescription}</p>
                    </div>
                ` : ""}

                <!-- Speakers -->
                ${speakersHtml}

                <!-- Watch on YouTube link -->
                ${talk.youtubeId ? `
                    <div class="pt-4 border-t border-gray-100">
                        <a
                            href="https://www.youtube.com/watch?v=${talk.youtubeId}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-ruby-500 hover:text-ruby-600 font-medium"
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                            Watch on YouTube
                        </a>
                    </div>
                ` : ""}

                <!-- Blog post link -->
                ${talk.blogPost ? `
                    <div class="${talk.youtubeId ? 'pt-2' : 'pt-4 border-t border-gray-100'}">
                        <a
                            href="${talk.blogPost}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-ruby-500 hover:text-ruby-600 font-medium"
                        >
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                            Read: ${talk.blogPostTitle || "Blog Post"}
                        </a>
                    </div>
                ` : ""}
            </div>
        `;
    }

    // Check URL for talk parameter and open modal
    function checkUrlForTalk() {
        const urlParams = new URLSearchParams(window.location.search);
        const talkId = urlParams.get("talk");

        if (talkId) {
            const talk = (window as any).talksData[talkId];
            if (talk && typeof (window as any).setTalkModalContent === "function") {
                const modalHtml = buildTalkModalContent(talk);
                (window as any).setTalkModalContent(modalHtml);
                (window as any).showTalkModal();
            }
        } else {
            // No talk in URL, make sure modal is closed
            if (typeof (window as any).hideTalkModal === "function") {
                (window as any).hideTalkModal();
            }
        }
    }

    // Handle browser back/forward buttons
    window.addEventListener("popstate", () => {
        checkUrlForTalk();
    });

    // Export close function for use in modal
    (window as any).closeTalkModalAndUpdateUrl = closeTalkModalAndUpdateUrl;

    // Initialize when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            initTalkCards();
            // Small delay to ensure modal is ready
            setTimeout(checkUrlForTalk, 100);
        });
    } else {
        initTalkCards();
        setTimeout(checkUrlForTalk, 100);
    }
</script>
