---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TalkModal from "../../components/TalkModal.astro";
import { talks, getAllTags } from "../../data/talks.js";
import { slotAssignments, scheduleSlots } from "../../data/schedule.js";
import { getSpeaker, speakers } from "../../data/speakers.js";
import { getAllMeetupRecordings, formatTimestamp } from "../../data/meetup-recordings.js";
import { getAllEmVideos } from "../../data/em-videos.js";

const meetupRecordings = getAllMeetupRecordings();
const emVideos = getAllEmVideos();
const studioInterviews = emVideos.filter((v) => v.type === "interview");
const studioBonus = emVideos.filter((v) => v.type === "promo" || v.type === "event");

// Get only Day 1 & Day 2 conference talk IDs from schedule assignments (exclude Day 3 community events)
const day1And2SlotIds = Object.keys(scheduleSlots).filter(
    (slotId) => scheduleSlots[slotId].day <= 2
);
const conferenceTalkIds = new Set(
    day1And2SlotIds.map((slotId) => slotAssignments[slotId]).filter(Boolean)
);

// Get all talks as array and separate by event type
const allTalks = Object.values(talks);

// IDs to exclude from display
const excludedTalkIds = new Set(["hack-day-angellist", "community-day-placeholder"]);

// Conference talks (those in the schedule) - filter to keynotes, talks, workshops
const conferenceTalks = allTalks.filter(
    (talk) =>
        conferenceTalkIds.has(talk.id) &&
        ["keynote", "talk", "workshop", "panel"].includes(talk.type) &&
        !excludedTalkIds.has(talk.id)
);

// Startup demos - type "demo" with videos, sorted by recording
const startupDemos = allTalks
    .filter((talk) => talk.type === "demo")
    .sort((a: any, b: any) => {
        if (a.youtubeId && !b.youtubeId) return -1;
        if (!a.youtubeId && b.youtubeId) return 1;
        return 0;
    });

// Separate keynotes from regular talks for better display
// Sort each category with recordings first
const sortByRecording = (a: any, b: any) => {
    if (a.youtubeId && !b.youtubeId) return -1;
    if (!a.youtubeId && b.youtubeId) return 1;
    return 0;
};

const keynotes = conferenceTalks
    .filter((talk) => talk.type === "keynote")
    .sort(sortByRecording);
const regularTalks = conferenceTalks
    .filter((talk) => talk.type === "talk")
    .sort((a: any, b: any) => {
        // Welcome remarks always first
        if (a.id === "welcome-remarks-day1") return -1;
        if (b.id === "welcome-remarks-day1") return 1;
        // Then sort by recording
        if (a.youtubeId && !b.youtubeId) return -1;
        if (!a.youtubeId && b.youtubeId) return 1;
        return 0;
    });
const workshops = conferenceTalks
    .filter((talk) => talk.type === "workshop")
    .sort(sortByRecording);

// Talks with videos (including demos)
const talksWithVideos = [...conferenceTalks, ...startupDemos].filter((talk) => talk.youtubeId);
const demosWithVideos = startupDemos.filter((talk) => talk.youtubeId);
const workshopsWithVideos = workshops.filter((talk) => talk.youtubeId);

// Helper to get speaker info
function getTalkSpeakers(talk) {
    if (talk.speakerId) {
        const speaker = getSpeaker(talk.speakerId);
        return speaker ? [speaker] : [];
    }
    if (talk.speakers && talk.speakers.length > 0) {
        return talk.speakers.map((id) => getSpeaker(id)).filter(Boolean);
    }
    return [];
}

// Format description - remove HTML and limit length for cards
function formatDescription(desc, maxLength = 200) {
    if (!desc) return "";
    // Remove HTML tags
    const clean = desc.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
    return clean;
}

// Build enhanced talks data with speaker info for modal (including demos)
const enhancedTalksData: Record<string, any> = {};
for (const talk of [...conferenceTalks, ...startupDemos]) {
    const talkSpeakers = getTalkSpeakers(talk);
    enhancedTalksData[talk.id] = {
        ...talk,
        speakers: talkSpeakers,
    };
}
---

<BaseLayout
    title="Ruby Videos - SF Ruby"
    description="Watch Ruby and Rails videos: Startups on Rails founder interviews, SF Ruby Conference 2025 talks, monthly meetup recordings, and more."
>
    <!-- Hero Section -->
    <section class="relative pt-32 pb-16 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
                    Videos
                </h1>
                <p class="text-lg md:text-xl text-gray-300 mb-8">
                    Founder interviews, conference talks, meetup recordings, and more — Ruby in the wild.
                </p>

                <!-- Stats -->
                <div class="flex flex-wrap gap-8">
                    <div>
                        <div class="text-3xl font-bold text-pink-400">{studioInterviews.length}</div>
                        <div class="text-sm text-gray-400">Founder Interviews</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-white">{talksWithVideos.length}</div>
                        <div class="text-sm text-gray-400">Conference Recordings</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-ruby-400">{keynotes.length}</div>
                        <div class="text-sm text-gray-400">Keynotes</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-emerald-400">{workshopsWithVideos.length}</div>
                        <div class="text-sm text-gray-400">Workshops</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-amber-400">{demosWithVideos.length}</div>
                        <div class="text-sm text-gray-400">Startup Demos</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-sky-400">{meetupRecordings.length}</div>
                        <div class="text-sm text-gray-400">Meetup Recordings</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Navigation Menu -->
    <nav class="sticky top-16 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-2 py-3 overflow-x-auto scrollbar-hide">
                <a href="#studio" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-pink-600 hover:bg-pink-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-pink-500 rounded-full"></div>
                    Founder Interviews
                </a>
                <a href="#meetups" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-sky-600 hover:bg-sky-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-sky-500 rounded-full"></div>
                    Meetup Recordings
                </a>
                <a href="#keynotes" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-ruby-600 hover:bg-ruby-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-ruby-500 rounded-full"></div>
                    Keynotes
                </a>
                <a href="#workshops" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-emerald-600 hover:bg-emerald-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-emerald-500 rounded-full"></div>
                    Workshops
                </a>
                <a href="#talks" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-ruby-600 hover:bg-ruby-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-ruby-500 rounded-full"></div>
                    Conference Talks
                </a>
                <a href="#demos" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-amber-600 hover:bg-amber-50 transition-colors whitespace-nowrap">
                    <div class="w-2 h-2 bg-amber-500 rounded-full"></div>
                    Startup Demos
                </a>
            </div>
        </div>
    </nav>

    <!-- Studio: Evil Martians founder interviews & SF Ruby promo -->
    <section id="studio" class="py-12 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
                <a href="#studio" class="flex items-center gap-3 group">
                    <div class="w-1 h-8 bg-pink-500 rounded-full"></div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-pink-600 transition-colors">
                        Founder Interviews & Studio
                        <span class="opacity-0 group-hover:opacity-100 text-gray-400 text-lg ml-1 transition-opacity">#</span>
                    </h2>
                </a>
                <a
                    href="https://www.youtube.com/@evil.martians"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-pink-500 hover:text-pink-600 font-medium"
                >
                    Evil Martians on YouTube
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>

            <p class="text-gray-600 mb-8 max-w-3xl">
                The <strong class="text-gray-900">Startups on Rails</strong> series — Irina Nazarova in conversation with the founders behind Rails-built companies. Plus the occasional SF Ruby Conference promo.
            </p>

            <!-- Founder Interviews grid -->
            {studioInterviews.length > 0 && (
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
                    {studioInterviews.map((video) => (
                        <a
                            href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-xl hover:border-pink-200 transition-all duration-300"
                        >
                            <div class="block relative aspect-video bg-gray-900 overflow-hidden">
                                <img
                                    src={`https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`}
                                    alt={video.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                    <div class="w-16 h-16 bg-pink-500 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                        <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="absolute top-3 left-3">
                                    <span class="px-3 py-1 bg-pink-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
                                        {video.series || "Interview"}
                                    </span>
                                </div>
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-pink-600 transition-colors">
                                    {video.title}
                                </h3>
                                <p class="text-sm text-gray-500 mb-3">
                                    <strong class="text-gray-700">{video.guest}</strong>
                                    {video.guestRole && `, ${video.guestRole}`}
                                    {video.guestCompany && ` @ ${video.guestCompany}`}
                                    {" · "}
                                    <span class="text-gray-400">with {video.interviewer}</span>
                                </p>
                                <p class="text-gray-600 leading-relaxed text-sm line-clamp-3">
                                    {video.description}
                                </p>
                                {video.tags && video.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-2 mt-4">
                                        {video.tags.slice(0, 4).map((tag) => (
                                            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            )}

            <!-- Promo + event bonus row -->
            {studioBonus.length > 0 && (
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {studioBonus.map((video) => (
                        <a
                            href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-pink-200 transition-all duration-300"
                        >
                            <div class="block relative aspect-video bg-gray-900 overflow-hidden">
                                <img
                                    src={`https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`}
                                    alt={video.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                    <div class="w-12 h-12 bg-pink-500/90 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                        <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="absolute top-3 left-3">
                                    <span class="px-3 py-1 bg-pink-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
                                        {video.type === "promo" ? "Promo" : "Event"}
                                    </span>
                                </div>
                            </div>
                            <div class="p-5">
                                <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-pink-600 transition-colors">
                                    {video.title}
                                </h3>
                                <p class="text-sm text-gray-500 line-clamp-3">
                                    {video.description}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            )}
        </div>
    </section>

    <!-- Meetup Recordings -->
    <section id="meetups" class="py-12 bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
                <a href="#meetups" class="flex items-center gap-3 group">
                    <div class="w-1 h-8 bg-sky-500 rounded-full"></div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-sky-600 transition-colors">
                        Meetup Recordings
                        <span class="text-lg font-normal text-gray-400 ml-2">{meetupRecordings.length} meetups</span>
                        <span class="opacity-0 group-hover:opacity-100 text-gray-400 text-lg ml-1 transition-opacity">#</span>
                    </h2>
                </a>
                <a
                    href="https://www.rubyevents.org/events/sf-bay-area-ruby-meetup"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-sky-500 hover:text-sky-600 font-medium"
                >
                    Also on Ruby Events
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {meetupRecordings.map((recording) => (
                    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden group hover:shadow-lg transition-all duration-300">
                        <a
                            href={`https://www.youtube.com/watch?v=${recording.youtubeId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="block"
                        >
                            <div class="aspect-video bg-gray-900 relative overflow-hidden">
                                <img
                                    src={`https://img.youtube.com/vi/${recording.youtubeId}/mqdefault.jpg`}
                                    alt={recording.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                                    <div class="w-12 h-12 bg-white/90 rounded-full flex items-center justify-center">
                                        <svg class="w-5 h-5 text-sky-500 ml-1" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <div class="p-4">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="font-semibold text-gray-900 text-sm">
                                    {recording.title.replace("SF Bay Area Ruby Meetup - ", "").replace("SF Ruby & Elixir Special - ", "Elixir Special - ")}
                                </h3>
                                <span class="text-xs text-gray-400 whitespace-nowrap ml-2">
                                    {new Date(recording.date + "T00:00:00").toLocaleDateString("en-US", { month: "short", year: "numeric" })}
                                </span>
                            </div>

                            <div class="flex items-center gap-2 text-xs text-gray-500 mb-3">
                                <span>{recording.talks.length} talk{recording.talks.length !== 1 ? "s" : ""}</span>
                                <span class="text-gray-300">·</span>
                                <span>{recording.venue}</span>
                            </div>

                            <details class="meetup-details">
                                <summary class="text-xs text-sky-500 hover:text-sky-600 cursor-pointer font-medium select-none">
                                    Show talks
                                </summary>
                                <ul class="mt-2 space-y-1.5">
                                    {recording.talks.map((talk) => (
                                        <li class="text-xs">
                                            <a
                                                href={`https://www.youtube.com/watch?v=${recording.youtubeId}${talk.timestamp ? `&t=${talk.timestamp}` : ""}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex items-start gap-2 text-gray-600 hover:text-sky-600 transition-colors"
                                            >
                                                <span class="text-gray-400 font-mono whitespace-nowrap mt-px">{formatTimestamp(talk.timestamp)}</span>
                                                <span>
                                                    <span class="font-medium">{talk.speaker}</span>
                                                    {talk.company && <span class="text-gray-400"> ({talk.company})</span>}
                                                    <span class="text-gray-400"> — </span>
                                                    {talk.title}
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Conference Keynotes -->
    <section id="keynotes" class="py-12 bg-white border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
                <a href="#keynotes" class="flex items-center gap-3 group">
                    <div class="w-1 h-8 bg-ruby-500 rounded-full"></div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-ruby-600 transition-colors">
                        SF Ruby Conference 2025 - Keynotes
                        <span class="opacity-0 group-hover:opacity-100 text-gray-400 text-lg ml-1 transition-opacity">#</span>
                    </h2>
                </a>
                <a
                    href="https://www.rubyevents.org/events/sfruby-2025"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-ruby-500 hover:text-ruby-600 font-medium"
                >
                    Watch on Ruby Events
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {keynotes.map((talk) => {
                    const speakers = getTalkSpeakers(talk);
                    return (
                        <div
                            class="talk-card group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-xl hover:border-ruby-200 transition-all duration-300 cursor-pointer"
                            data-talk-id={talk.id}
                        >
                            <!-- YouTube Preview or Cover Image -->
                            {talk.youtubeId ? (
                                <div class="block relative aspect-video bg-gray-900 overflow-hidden">
                                    <img
                                        src={`https://img.youtube.com/vi/${talk.youtubeId}/maxresdefault.jpg`}
                                        alt={talk.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                        <div class="w-16 h-16 bg-ruby-500 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                            <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="absolute top-3 left-3">
                                        <span class="px-3 py-1 bg-ruby-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
                                            Keynote
                                        </span>
                                    </div>
                                </div>
                            ) : talk.coverImage ? (
                                <div class="block relative aspect-video bg-gray-900 overflow-hidden">
                                    <img
                                        src={talk.coverImage}
                                        alt={talk.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors"></div>
                                    <div class="absolute top-3 left-3">
                                        <span class="px-3 py-1 bg-ruby-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
                                            Keynote
                                        </span>
                                    </div>
                                    {talk.noVideo && (
                                        <div class="absolute bottom-3 left-3 right-3">
                                            <span class="px-3 py-1.5 bg-gray-900/80 text-gray-200 text-xs rounded-lg">
                                                {talk.noVideoReason}
                                            </span>
                                        </div>
                                    )}
                                </div>
                            ) : (
                                <div class="aspect-video bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
                                    <div class="text-center">
                                        <span class="px-3 py-1 bg-ruby-500 text-white text-xs font-bold rounded-full uppercase tracking-wider">
                                            Keynote
                                        </span>
                                        <p class="text-gray-400 mt-3 text-sm">Recording coming soon</p>
                                    </div>
                                </div>
                            )}

                            <div class="p-6">
