---
import BaseLayout from "../layouts/BaseLayout.astro";
import IslandNav from "../components/IslandNav.astro";
---

<BaseLayout
    darkHero={false}
    title="Page Not Found - SF Ruby"
    description="The page you're looking for doesn't exist."
>
    <section class="pt-32 pb-16 bg-sky-50 text-center">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="px-font text-5xl md:text-7xl text-ruby-500 px-shadow-ruby mb-8">
                404
            </p>
            <h1 class="px-font text-lg md:text-xl text-gray-900 mb-4">
                Level not found
            </h1>
            <p class="text-lg text-gray-600">
                The page you're looking for doesn't exist or has been moved.
                Pick an exit below.
            </p>
        </div>
    </section>

    <IslandNav
        title="Warp zones"
        items={[
            { href: "/", label: "Home", icon: "mascot" },
            { href: "/videos", label: "Videos", icon: "play" },
            { href: "/jobs", label: "Jobs", icon: "briefcase" },
            {
                href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
                label: "Join Slack",
                icon: "heart",
                external: true,
            },
        ]}
    />
</BaseLayout>
