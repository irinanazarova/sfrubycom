---
// The 2026 lineup in full. The homepage roster (SpeakerRoster.astro) is the
// character-select grid — sprite, name, company, one line of bio. This page is
// where the same people get their whole entry: the talk they're giving, the
// abstract, who they are.
//
// Two sources, merged on speakerKey: the hand-maintained roster
// (src/data/conference-2026.js) owns who is confirmed, the sprite and the bio;
// the CFP feed owns the talk. Titles and abstracts are baked in from the
// committed snapshot (src/content/cfp-talks.json) and then refreshed in place
// from the live API by the script at the bottom, so an edit in the CFP app
// shows up without a redeploy.
//
// The 2025 lineup lives on at /speakers-2025.
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLink from "../components/SocialLink.astro";
import {
    conferenceSpeakers,
    cfpNameAliases,
    LUMA_URL,
} from "../data/conference-2026.js";
import {
    buildTalkMap,
    speakerKey,
    isRealTitle,
    isRealAbstract,
} from "../utils/cfpTalks.js";
import { socialMetaList } from "../utils/socialLinks.js";
import cfpTalks from "../content/cfp-talks.json";

const { byKey, unmatched } = buildTalkMap(
    cfpTalks,
    conferenceSpeakers,
    cfpNameAliases,
);
// An unmatched CFP name means a missing cfpNameAliases entry or a speaker who
// isn't on the roster (a withdrawn talk still in the feed, say) — surface it in
// the build log, don't fail.
if (unmatched.length > 0)
    console.warn(`cfp-talks: no roster match for: ${unmatched.join(", ")}`);

// Merge once, here, so the markup below only ever reads flat fields.
const profiles = conferenceSpeakers.map((s) => {
    const key = speakerKey(s.name);
    const talk = byKey.get(key);
    return {
        ...s,
        key,
        title: talk && isRealTitle(talk.title) ? talk.title.trim() : "",
        abstract:
            talk && isRealAbstract(talk.abstract) ? talk.abstract.trim() : "",
        // The CFP role is the speaker's own wording and beats anything we'd
        // guess; the roster `role` is the fallback for speakers with no CFP entry.
        role: talk?.speaker?.role ?? s.role ?? "",
        socials: socialMetaList(talk?.speaker?.socials),
    };
});

const keynotes = profiles.filter((s) => s.keynote);
// Confirmed-with-a-talk first: a card carrying a title and an abstract is the
// reason to scroll, and speakers whose CFP entry hasn't landed yet would
// otherwise open the list with the thinnest cards on the page.
const lineup = profiles
    .filter((s) => !s.keynote)
    .sort((a, b) => Number(Boolean(b.title)) - Number(Boolean(a.title)));

const withTalks = profiles.filter((s) => s.title).length;
---

<BaseLayout
    title="Speakers - San Francisco Ruby Startup Conference 2026"
    description={`The ${conferenceSpeakers.length} speakers of the San Francisco Ruby Startup Conference, November 10-12 2026 at SFJAZZ. Keynote by Garry Tan of Y Combinator, plus the people behind Solid Queue, RubyLLM, GoodJob, Typesense, Herb and AnyCable.`}
    ogUrl="https://sfruby.com/speakers"
>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 px-sky-grad-dusk overflow-hidden">
        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
            <span class="px-plate px-font text-px8 px-3 py-1.5">
                Nov 10-12, 2026 &#183; SFJAZZ
            </span>
            <h1
                class="px-font px-shadow-ink text-xl md:text-3xl text-white mt-6"
            >
                Speakers
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mt-6 max-w-3xl">
                {conferenceSpeakers.length} confirmed for the San Francisco Ruby
                Startup Conference: the people who build the gems you run in production,
                and the founders running Ruby businesses.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a
                    href={LUMA_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press"
                >
                    Get a ticket
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
                <a
                    href="/speakers-2025"
                    class="px-4 py-3 text-white/80 hover:text-white font-medium transition-colors"
                >
                    2025 speakers &#8594;
                </a>
            </div>
        </div>
    </section>

    <!-- Character select: the whole lineup at a glance, each sprite jumping to
         its profile. Nineteen full profiles is a long scroll on a phone, so the
         page opens with every face in two screens. -->
    <section class="py-10 md:py-12 bg-white border-t-4 border-ink">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-sm md:text-base text-gray-900">
                Character select
            </h2>
            <ul
                class="mt-6 grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-8 gap-3 md:gap-4 list-none p-0"
            >
                {
                    profiles.map((s) => (
                        <li>
                            <a
                                href={`#${s.key}`}
                                class="flex flex-col items-center text-center p-2 hover:bg-sky-50 tap-press"
                            >
                                {s.pixel ? (
                                    <img
                                        src={s.pixel}
                                        alt=""
                                        width="256"
                                        height="256"
                                        class="px-pixelated w-14 md:w-16 h-auto"
                                    />
                                ) : (
                                    <div
                                        class="w-14 md:w-16 aspect-square flex items-center justify-center bg-sky-100 border-4 border-ink"
                                        aria-hidden="true"
                                    >
                                        <span class="px-font text-base text-sky-500">
                                            ?
                                        </span>
                                    </div>
                                )}
                                <span class="font-display font-semibold text-xs text-gray-900 leading-tight mt-1">
                                    {s.name}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Keynotes -->
    {
        keynotes.length > 0 && (
            <section class="py-12 md:py-16 bg-sky-50 border-t-4 border-ink">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <h2 class="px-font text-base md:text-xl text-gray-900">
                        Keynotes
                    </h2>
                    <ul class="mt-8 grid gap-6 lg:grid-cols-2 list-none p-0">
                        {keynotes.map((s) => (
                            <li
                                id={s.key}
                                data-cfp-key={s.key}
                                class="px-card bg-white p-5 sm:p-6 scroll-mt-28"
                            >
                                <div class="flex items-start gap-4">
                                    <div class="flex-shrink-0 flex flex-col items-center">
                                        {s.pixel ? (
                                            <img
                                                src={s.pixel}
                                                alt={`${s.name}, pixel character`}
                                                width="256"
                                                height="256"
                                                class="px-pixelated w-20 sm:w-24 h-auto"
                                            />
                                        ) : (
                                            <div
                                                class="w-20 sm:w-24 aspect-square flex items-center justify-center bg-sky-100 border-4 border-ink"
                                                aria-hidden="true"
                                            >
                                                <span class="px-font text-2xl text-sky-500">
                                                    ?
                                                </span>
                                            </div>
                                        )}
                                        <img
                                            src="/px-island.png"
                                            alt=""
                                            width="598"
                                            height="104"
                                            class="px-pixelated w-24 sm:w-28 h-auto -mt-2"
                                        />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="px-plate px-plate--gold px-font text-px8 px-2 py-1">
                                            Keynote
                                        </span>
                                        {/* Grotesk, not the pixel font: Press Start 2P
                                            has no accented capitals and mangles names
                                            like Gutiérrez. */}
                                        <h3 class="font-display font-semibold text-lg md:text-xl text-gray-900 mt-3 leading-snug">
                                            {s.name}
                                        </h3>
                                        {s.role && (
                                            <p class="text-sm text-gray-600 mt-1">
                                                {s.role}
                                            </p>
                                        )}
                                        <p class="text-sm text-ruby-600 mt-1">
                                            {s.orgs.map((org, i) => (
                                                <>{i > 0 && ", "}{org.url ? <a href={org.url} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-2">{org.name}</a> : org.name}</>
                                            ))}
                                        </p>
                                    </div>
                                </div>
                                <p
                                    data-talk-title
                                    hidden={!s.title}
                                    class="font-display font-semibold text-base md:text-lg text-gray-900 leading-snug mt-5"
                                >
                                    {s.title && `“${s.title}”`}
                                </p>
                                <p
                                    data-talk-abstract
                                    hidden={!s.abstract}
                                    class="text-sm text-gray-700 leading-relaxed mt-3"
                                >
                                    {s.abstract}
                                </p>
                                {s.bio && (
                                    <p class="text-sm text-gray-600 leading-relaxed mt-4 pt-4 border-t-2 border-sky-100">
                                        {s.bio}
                                    </p>
                                )}
                                {s.socials.length > 0 && (
                                    <div class="flex flex-wrap gap-3 mt-4">
                                        {s.socials.map((link) => (
                                            <SocialLink
                                                platform={link.platform}
                                                href={link.href}
                                            >
                                                <span class:list={[link.icon && "sr-only"]}>
                                                    {link.label}
                                                </span>
                                            </SocialLink>
                                        ))}
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <!-- The rest of the lineup -->
    <section class="py-12 md:py-16 bg-white border-t-4 border-ink">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-base md:text-xl text-gray-900">
                The lineup
            </h2>
            <p class="text-gray-600 mt-4 max-w-3xl">
                {withTalks} talks confirmed so far. Titles and abstracts land here
                as speakers submit them.
            </p>

            <ul class="mt-8 grid gap-6 lg:grid-cols-2 list-none p-0">
                {
                    lineup.map((s) => (
                        <li
                            id={s.key}
                            data-cfp-key={s.key}
                            class="px-card bg-white p-5 sm:p-6 scroll-mt-28"
                        >
                            <div class="flex items-start gap-4">
                                <div class="flex-shrink-0 flex flex-col items-center">
                                    {s.pixel ? (
                                        <img
                                            src={s.pixel}
                                            alt={`${s.name}, pixel character`}
                                            width="256"
                                            height="256"
                                            loading="lazy"
                                            class="px-pixelated w-20 sm:w-24 h-auto"
                                        />
                                    ) : (
                                        <div
                                            class="w-20 sm:w-24 aspect-square flex items-center justify-center bg-sky-100 border-4 border-ink"
                                            aria-hidden="true"
                                        >
                                            <span class="px-font text-2xl text-sky-500">
                                                ?
                                            </span>
                                        </div>
                                    )}
                                    <img
                                        src="/px-island.png"
                                        alt=""
                                        width="598"
                                        height="104"
                                        loading="lazy"
                                        class="px-pixelated w-24 sm:w-28 h-auto -mt-2"
                                    />
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h3 class="font-display font-semibold text-lg text-gray-900 leading-snug">
                                        {s.name}
                                    </h3>
                                    {s.role && (
                                        <p class="text-sm text-gray-600 mt-1">
                                            {s.role}
                                        </p>
                                    )}
                                    <p class="text-sm text-ruby-600 mt-1">
                                        {s.orgs.map((org, i) => (
                                            <>{i > 0 && ", "}{org.url ? <a href={org.url} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-2">{org.name}</a> : org.name}</>
                                        ))}
                                    </p>
                                </div>
                            </div>
                            <p
                                data-talk-title
                                hidden={!s.title}
                                class="font-display font-semibold text-base text-gray-900 leading-snug mt-5"
                            >
                                {s.title && `“${s.title}”`}
                            </p>
                            <p
                                data-talk-abstract
                                hidden={!s.abstract}
                                class="text-sm text-gray-700 leading-relaxed mt-3"
                            >
                                {s.abstract}
                            </p>
                            {s.bio && (
                                <p class="text-sm text-gray-600 leading-relaxed mt-4 pt-4 border-t-2 border-sky-100">
                                    {s.bio}
                                </p>
                            )}
                            {s.socials.length > 0 && (
                                <div class="flex flex-wrap gap-3 mt-4">
                                    {s.socials.map((link) => (
                                        <SocialLink
                                            platform={link.platform}
                                            href={link.href}
                                        >
                                            <span class:list={[link.icon && "sr-only"]}>
                                                {link.label}
                                            </span>
                                        </SocialLink>
                                    ))}
                                </div>
                            )}
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Closing CTA -->
    <section class="py-16 px-dither-sky border-t-4 border-ink">
        <div
            class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
        >
            <h2 class="px-font px-shadow-ink text-base md:text-xl text-white">
                More still landing
            </h2>
            <p class="text-gray-200 mt-6">
                The lineup grows through the summer. Tickets rise as it does.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a
                    href={LUMA_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press"
                >
                    Get a ticket
                </a>
                <a
                    href="/videos"
                    class="px-btn px-btn--sky px-font text-px10 px-6 py-4 tap-press"
                >
                    Watch past talks
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    // Refresh talk titles and abstracts in place from the live CFP feed, the
    // same deal as the homepage roster: the baked copy is already on screen, so
    // every failure path (dev server without the Netlify proxy, CFP app down,
    // 8s timeout) just means no silent upgrade this visit.
    import {
        conferenceSpeakers,
        cfpNameAliases,
    } from "../data/conference-2026.js";
    import {
        buildTalkMap,
        isRealTitle,
        isRealAbstract,
        CFP_API_PATH,
    } from "../utils/cfpTalks.js";

    function setText(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        if (node.textContent !== text) node.textContent = text;
        node.hidden = !text;
    }

    async function refreshTalks() {
        try {
            const res = await fetch(CFP_API_PATH, {
                signal: AbortSignal.timeout(8_000),
            });
            if (!res.ok) return;
            const { byKey } = buildTalkMap(
                await res.json(),
                conferenceSpeakers,
                cfpNameAliases,
            );
            for (const card of document.querySelectorAll("[data-cfp-key]")) {
                if (!(card instanceof HTMLElement)) continue;
                const talk = byKey.get(card.dataset.cfpKey ?? "");
                const title = isRealTitle(talk?.title) ? talk.title.trim() : "";
                setText(card, "[data-talk-title]", title ? `“${title}”` : "");
                setText(
                    card,
                    "[data-talk-abstract]",
                    isRealAbstract(talk?.abstract) ? talk.abstract.trim() : "",
                );
            }
        } catch {
            // keep the baked copy
        }
    }

    refreshTalks();
</script>
