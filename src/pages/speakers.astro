---
// The 2026 lineup in full. The homepage roster (SpeakerRoster.astro) is the
// character-select grid — sprite, name, company, one line of bio. This page is
// where the same people get their whole entry: the talk they're giving, the
// abstract, who they are.
//
// Card shape follows the 2025 page (speakers-2025.astro), which reads better
// than a compact roster row: one grid, portrait across the full card width at
// the top, everything else stacked underneath, keynotes called out with a
// corner badge instead of a section of their own. The 2025 portrait is a photo;
// here it is the pixel sprite on a dithered sky, which is what a transparent
// sprite needs behind it to read at size.
//
// Two sources, merged on speakerKey: the hand-maintained roster
// (src/data/conference-2026.js) owns who is confirmed, the sprite and the bio;
// the CFP feed owns the talk. Titles and abstracts are baked in from the
// committed snapshot (src/content/cfp-talks.json) and then refreshed in place
// from the live API by the script at the bottom, so an edit in the CFP app
// shows up without a redeploy.
//
// The 2025 lineup lives on at /speakers-2025.
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLink from "../components/SocialLink.astro";
import {
    conferenceSpeakers,
    cfpNameAliases,
    LUMA_URL,
} from "../data/conference-2026.js";
import {
    buildTalkMap,
    speakerKey,
    isRealTitle,
    isRealAbstract,
    isRealBio,
} from "../utils/cfpTalks.js";
import { socialMetaList } from "../utils/socialLinks.js";
import { toParagraphs } from "../utils/abstractText.js";
import cfpTalks from "../content/cfp-talks.json";

const { byKey, unmatched } = buildTalkMap(
    cfpTalks,
    conferenceSpeakers,
    cfpNameAliases,
);
// An unmatched CFP name means a missing cfpNameAliases entry or a speaker who
// isn't on the roster (a withdrawn talk still in the feed, say) — surface it in
// the build log, don't fail.
if (unmatched.length > 0)
    console.warn(`cfp-talks: no roster match for: ${unmatched.join(", ")}`);

// Merge once, here, so the markup below only ever reads flat fields.
const profiles = conferenceSpeakers.map((s) => {
    const key = speakerKey(s.name);
    const talk = byKey.get(key);
    return {
        ...s,
        key,
        title: talk && isRealTitle(talk.title) ? talk.title.trim() : "",
        // CFP abstract wins whenever there is one; `pitch` on the roster covers
        // a confirmed talk whose CFP entry is still a stub.
        abstract: toParagraphs(
            talk && isRealAbstract(talk.abstract)
                ? talk.abstract.trim()
                : (s.pitch ?? ""),
        ),
        fromPitch: !(talk && isRealAbstract(talk.abstract)) && Boolean(s.pitch),
        // The CFP role and bio are the speaker's own wording and beat anything
        // we'd guess; the roster fields are the fallback for speakers with no
        // CFP entry, and for the stub bios in it ("TBD", "Martian").
        role: talk?.speaker?.role ?? s.role ?? "",
        bio: toParagraphs(
            isRealBio(talk?.speaker?.bio) ? talk.speaker.bio.trim() : s.bio,
        ),
        fromRosterBio: !isRealBio(talk?.speaker?.bio),
        socials: socialMetaList(talk?.speaker?.socials),
    };
});

// Keynotes open the grid, then whoever has a confirmed talk: a card carrying a
// title and an abstract is the reason to scroll, and speakers whose CFP entry
// hasn't landed yet would otherwise hold the top of the page with the thinnest
// cards on it.
const speakers = [...profiles].sort(
    (a, b) =>
        Number(Boolean(b.keynote)) - Number(Boolean(a.keynote)) ||
        Number(Boolean(b.title)) - Number(Boolean(a.title)),
);

const withTalks = profiles.filter((s) => s.title).length;
---

<BaseLayout
    title="Speakers - San Francisco Ruby Startup Conference 2026"
    description={`The ${conferenceSpeakers.length} speakers of the San Francisco Ruby Startup Conference, November 10-12 2026 at SFJAZZ. Keynote by Garry Tan of Y Combinator, plus the people behind Solid Queue, RubyLLM, GoodJob, Typesense, Herb and AnyCable.`}
    ogUrl="https://sfruby.com/speakers"
>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 px-sky-grad-dusk overflow-hidden">
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
            <span class="px-plate px-font text-px8 px-3 py-1.5">
                Nov 10-12, 2026 &#183; SFJAZZ
            </span>
            <h1
                class="px-font px-shadow-ink text-xl md:text-3xl text-white mt-6"
            >
                Speakers
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mt-6 max-w-3xl">
                {conferenceSpeakers.length} confirmed for the San Francisco Ruby
                Startup Conference: the people who build the gems you run in production,
                and the founders running Ruby businesses.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a
                    href={LUMA_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press"
                >
                    Get a ticket
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
                <a
                    href="/speakers-2025"
                    class="px-4 py-3 text-white/80 hover:text-white font-medium transition-colors"
                >
                    2025 speakers &#8594;
                </a>
            </div>
        </div>
    </section>

    <!-- The lineup -->
    <section class="py-12 md:py-16 bg-white border-t-4 border-ink">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-base md:text-xl text-gray-900">
                The lineup
            </h2>
            <p class="text-gray-600 mt-4 max-w-3xl">
                {withTalks} talks confirmed so far. Titles and abstracts land here
                as speakers submit them.
            </p>

            {/* items-start, not the default stretch: abstract lengths vary by 5x,
                and a stretched short card is a card with 500px of empty white in
                it. Ragged bottoms read better than that. */}
            <ul
                class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 items-start list-none p-0"
            >
                {
                    speakers.map((s) => (
                        <li
                            id={s.key}
                            data-cfp-key={s.key}
                            data-local-abstract={s.fromPitch ? "" : undefined}
                            data-local-bio={s.fromRosterBio ? "" : undefined}
                            class="px-card bg-white overflow-hidden flex flex-col scroll-mt-28 relative"
                        >
                            {s.keynote && (
                                <span class="absolute top-3 right-3 z-10 px-plate px-plate--gold px-font text-px8 px-2 py-1">
                                    Keynote
                                </span>
                            )}
                            {/* Portrait stage. The sprite is a transparent PNG, so
                                it needs the dithered sky behind it to read at this
                                size, and a fixed height so every card in a row
                                starts its text on the same line. */}
                            <div class="px-dither-sky h-56 md:h-64 flex items-end justify-center border-b-4 border-ink">
                                {s.pixel ? (
                                    <div class="flex flex-col items-center pb-3">
                                        <img
                                            src={s.pixel}
                                            alt={`${s.name}, pixel character`}
                                            width="256"
                                            height="256"
                                            loading="lazy"
                                            class="px-pixelated w-36 md:w-40 h-auto"
                                        />
                                        <img
                                            src="/px-island.png"
                                            alt=""
                                            width="598"
                                            height="104"
                                            loading="lazy"
                                            class="px-pixelated w-44 md:w-48 h-auto -mt-3"
                                        />
                                    </div>
                                ) : (
                                    <div
                                        class="flex-1 flex items-center justify-center"
                                        aria-hidden="true"
                                    >
                                        <span class="px-font px-shadow-ink text-4xl text-white">
                                            ?
                                        </span>
                                    </div>
                                )}
                            </div>

                            <div class="p-6 flex flex-col flex-1">
                                {/* Grotesk, not the pixel font: Press Start 2P has
                                    no accented capitals and mangles names like
                                    Gutiérrez. */}
                                <h3 class="font-display font-bold text-xl text-gray-900 leading-snug">
                                    {s.name}
                                </h3>
                                {/* markup kept tight on purpose: line breaks inside
                                    the anchor render as spaces and detach the commas */}
                                <p class="font-display font-medium text-ruby-600 mt-2">
                                    {s.orgs.map((org, i) => (
                                        <>{i > 0 && ", "}{org.url ? <a href={org.url} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-2">{org.name}</a> : org.name}</>
                                    ))}
                                </p>
                                {s.role && (
                                    <p class="text-sm text-gray-500 mt-1">
                                        {s.role}
                                    </p>
                                )}

                                {/* always in the DOM (hidden when empty) so the
                                    client refresh has a node to fill when a title
                                    or abstract lands */}
                                <p
                                    data-talk-title
                                    hidden={!s.title}
                                    class="font-display font-semibold text-base text-gray-900 leading-snug mt-5"
                                >
                                    {s.title && `“${s.title}”`}
                                </p>
                                <div
                                    data-talk-abstract
                                    hidden={s.abstract.length === 0}
                                    class="text-sm text-gray-700 leading-relaxed"
                                >
                                    {s.abstract.map((parts) => (
                                        <p class="mt-3">
                                            {parts.map((part) =>
                                                part.type === "link" ? (
                                                    <a href={part.href} target="_blank" rel="noopener noreferrer" class="font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words">{part.label}</a>
                                                ) : (
                                                    part.value
                                                ),
                                            )}
                                        </p>
                                    ))}
                                </div>

                                <div
                                    data-speaker-bio
                                    hidden={s.bio.length === 0}
                                    class="text-sm text-gray-600 leading-relaxed mt-5 pt-5 border-t-2 border-sky-100"
                                >
                                    {s.bio.map((parts) => (
                                        <p class="[&+&]:mt-3">
                                            {parts.map((part) =>
                                                part.type === "link" ? (
                                                    <a href={part.href} target="_blank" rel="noopener noreferrer" class="font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words">{part.label}</a>
                                                ) : (
                                                    part.value
                                                ),
                                            )}
                                        </p>
                                    ))}
                                </div>

                                {s.socials.length > 0 && (
                                    <div class="flex flex-wrap gap-3 pt-6 mt-auto">
                                        {s.socials.map((link) => (
                                            <SocialLink
                                                platform={link.platform}
                                                href={link.href}
                                            >
                                                <span
                                                    class:list={[
                                                        link.icon && "sr-only",
                                                    ]}
                                                >
                                                    {link.label}
                                                </span>
                                            </SocialLink>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Closing CTA -->
    <section class="py-16 px-dither-sky border-t-4 border-ink">
        <div
            class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
        >
            <h2 class="px-font px-shadow-ink text-base md:text-xl text-white">
                More still landing
            </h2>
            <p class="text-gray-200 mt-6">
                The lineup grows through the summer. Tickets rise as it does.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a
                    href={LUMA_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press"
                >
                    Get a ticket
                </a>
                <a
                    href="/videos"
                    class="px-btn px-btn--sky px-font text-px10 px-6 py-4 tap-press"
                >
                    Watch past talks
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    // Refresh talk titles and abstracts in place from the live CFP feed, the
    // same deal as the homepage roster: the baked copy is already on screen, so
    // every failure path (dev server without the Netlify proxy, CFP app down,
    // 8s timeout) just means no silent upgrade this visit.
    import {
        conferenceSpeakers,
        cfpNameAliases,
    } from "../data/conference-2026.js";
    import {
        buildTalkMap,
        isRealTitle,
        isRealAbstract,
        isRealBio,
        CFP_API_PATH,
    } from "../utils/cfpTalks.js";
    import { toParagraphs } from "../utils/abstractText.js";

    function setText(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        if (node.textContent !== text) node.textContent = text;
        node.hidden = !text;
    }

    // Built with createElement rather than innerHTML: the abstract is text a
    // speaker typed into a third-party app, and it must never reach the page as
    // markup.
    function setProse(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        const paragraphs = toParagraphs(text);
        node.hidden = paragraphs.length === 0;
        node.replaceChildren(
            ...paragraphs.map((parts) => {
                const p = document.createElement("p");
                p.className = "mt-3";
                for (const part of parts) {
                    if (part.type === "link") {
                        const a = document.createElement("a");
                        a.href = part.href;
                        a.target = "_blank";
                        a.rel = "noopener noreferrer";
                        a.className =
                            "font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words";
                        a.textContent = part.label;
                        p.append(a);
                    } else {
                        p.append(part.value);
                    }
                }
                return p;
            }),
        );
    }

    async function refreshTalks() {
        try {
            const res = await fetch(CFP_API_PATH, {
                signal: AbortSignal.timeout(8_000),
            });
            if (!res.ok) return;
            const { byKey } = buildTalkMap(
                await res.json(),
                conferenceSpeakers,
                cfpNameAliases,
            );
            for (const card of document.querySelectorAll("[data-cfp-key]")) {
                if (!(card instanceof HTMLElement)) continue;
                const talk = byKey.get(card.dataset.cfpKey ?? "");
                const title = isRealTitle(talk?.title) ? talk.title.trim() : "";
                setText(card, "[data-talk-title]", title ? `“${title}”` : "");
                // An empty CFP abstract must not wipe a roster `pitch`; a real
                // one still replaces it, so the CFP stays the source of truth.
                const abstract = isRealAbstract(talk?.abstract)
                    ? talk.abstract.trim()
                    : "";
                if (abstract || card.dataset.localAbstract === undefined)
                    setProse(card, "[data-talk-abstract]", abstract);

                // Same guard for the bio: a stub in the feed must not wipe the
                // roster line the card was built with.
                const bio = isRealBio(talk?.speaker?.bio)
                    ? talk.speaker.bio.trim()
                    : "";
                if (bio || card.dataset.localBio === undefined)
                    setProse(card, "[data-speaker-bio]", bio);
            }
        } catch {
            // keep the baked copy
        }
    }

    refreshTalks();
</script>
