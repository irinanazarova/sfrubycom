---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import { speakers, getSpeakersByGroup } from "../data/speakers.js";

// Get speakers by group
const featuredSpeakers = getSpeakersByGroup('featured');
const regularSpeakers = getSpeakersByGroup('speaker');
const CTOSpeakers = getSpeakersByGroup('cto');
---

<Layout title="Speakers - San Francisco Ruby Conference 2025">
    <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Speakers
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Meet the speakers who will be sharing their stories
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Featured speakers section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Keynote Speakers
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    Object.values(featuredSpeakers).map((speaker) => (
                        <div class="bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                            <div class="aspect-w-1 aspect-h-1 bg-dark-200">
                                <img
                                    src={speaker.image}
                                    alt={speaker.name}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>

                            <div class="p-6">
                                <h3 class="font-bold text-xl text-dark-900">
                                    {speaker.name}
                                </h3>
                                <p class="text-ruby-500 font-display font-medium mt-2">
                                    {speaker.company}
                                </p>
                                <p class="text-dark-500 text-sm mb-2">
                                    {speaker.role}
                                </p>

                                <p class="text-dark-600 text-sm mb-4">
                                    {speaker.bio}
                                </p>

                                <div class="flex space-x-4">
                                    {speaker.socials.map((url) => (
                                        <SocialLink url={url} />
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Regular speakers section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Speakers
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    [
                        speakers['rachael-wright-munn'],
                        speakers['justin-bowen'],
                        speakers['jeremy-evans'],
                        speakers['noel-rappin'],
                        speakers['ngan-pham'],
                        speakers['mike-perham'],
                        speakers['svyatoslav-kryukov'],
                        speakers['fito-von-zastrow'],
                        speakers['alan-ridlehoover'],
                        speakers['brandon-weaver'],
                        speakers['takashi-kokubun'],
                        speakers['brandon-shar'],
                        speakers['brian-knoles']
                    ].map((speaker) => (
                        <div class="bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                            <div class="aspect-w-1 aspect-h-1 bg-dark-200">
                                <img
                                    src={speaker.image}
                                    alt={speaker.name}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>

                            <div class="p-6">
                                <h3 class="font-bold text-xl text-dark-900">
                                    {speaker.name}
                                </h3>
                                <p class="text-ruby-500 font-display font-medium mt-2">
                                    {speaker.company}
                                </p>
                                <p class="text-dark-500 text-sm mb-2">
                                    {speaker.role}
                                </p>

                                <p class="text-dark-600 text-sm mb-4">
                                    {speaker.bio}
                                </p>

                                <div class="flex space-x-4">
                                    {speaker.socials.map((url) => (
                                        <SocialLink url={url} />
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- CTO Panel section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                CTO Panel
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    [speakers['edward-kim']].map((speaker) => (
                        <div class="bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                            <div class="aspect-w-1 aspect-h-1 bg-dark-200">
                                <img
                                    src={speaker.image}
                                    alt={speaker.name}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>

                            <div class="p-6">
                                <h3 class="font-bold text-xl text-dark-900">
                                    {speaker.name}
                                </h3>
                                <p class="text-ruby-500 font-display font-medium mt-2">
                                    {speaker.company}
                                </p>
                                <p class="text-dark-500 text-sm mb-2">
                                    {speaker.role}
                                </p>

                                <p class="text-dark-600 text-sm mb-4">{speaker.bio}</p>

                                <div class="flex space-x-4">
                                    {speaker.socials.map((url) => (
                                        <SocialLink url={url} />
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Call for speakers banner -->
        <div class="mt-16 bg-dark-50 rounded-lg p-8 text-center">
            <h3 class="text-xl font-bold text-dark-900 mb-2">
                Join as a Speaker
            </h3>
            <p class="text-dark-600 mb-4">
                We just closed the CFP and the Program Committee is reviewing
                submissions. We'll announce the accepted talks on July 22.
            </p>
        </div>
    </div>
</Layout>