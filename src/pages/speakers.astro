---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import { speakers } from "../data/speakers.js";
import { talks } from "../data/talks.js";
import { startups } from "../data/startups.js";

// Get all speakers as an array with their status
const allSpeakers = Object.entries(speakers).map(([id, speaker]) => ({
    ...speaker,
    id,
}));

// Build a speaker-to-talks index for O(1) lookups
const speakerToTalksIndex = new Map();

// Single pass through all talks to build the index
Object.values(talks).forEach((talk) => {
    // Handle single speaker
    if (talk.speakerId) {
        if (!speakerToTalksIndex.has(talk.speakerId)) {
            speakerToTalksIndex.set(talk.speakerId, []);
        }
        speakerToTalksIndex.get(talk.speakerId).push(talk);
    }

    // Handle multiple speakers
    if (talk.speakers && Array.isArray(talk.speakers)) {
        talk.speakers.forEach((speakerId) => {
            if (!speakerToTalksIndex.has(speakerId)) {
                speakerToTalksIndex.set(speakerId, []);
            }
            speakerToTalksIndex.get(speakerId).push(talk);
        });
    }
});

// Helper function to get talks by speaker ID - now O(1)
function getTalksBySpeakerId(speakerId) {
    return speakerToTalksIndex.get(speakerId) || [];
}

// Helper function to get speaker status badge
function getSpeakerBadge(speaker) {
    if (speaker.group === "featured") {
        return { text: "Keynote", color: "bg-gradient-to-r from-ruby-500 to-pink-500" };
    }
    if (speaker.group === "cto") {
        return { text: "CTO Panel", color: "bg-gradient-to-r from-purple-500 to-indigo-500" };
    }
    // Check if speaker is associated with a startup demo
    const speakerStartup = Object.values(startups).find(startup =>
        startup.founders?.some(founder => founder.toLowerCase().includes(speaker.name.toLowerCase()))
    );
    if (speakerStartup) {
        return { text: "Startup Demo", color: "bg-gradient-to-r from-emerald-500 to-green-500" };
    }
    return null;
}

// Sort speakers: featured first, then CTO, then regular, then alphabetically by name
allSpeakers.sort((a, b) => {
    const orderMap = { featured: 0, cto: 1, speaker: 2 };
    const orderA = orderMap[a.group] ?? 3;
    const orderB = orderMap[b.group] ?? 3;
    if (orderA !== orderB) return orderA - orderB;
    return a.name.localeCompare(b.name);
});
---

<Layout title="Speakers - San Francisco Ruby Conference 2025">
    <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Speakers
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Meet the speakers who will be sharing their stories
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- All speakers in one grid -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                All Speakers
            </h2>

            <div
                id="speakers-grid"
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-8"
            >
                {
                    allSpeakers.map((speaker) => {
                        const speakerTalks = getTalksBySpeakerId(speaker.id);
                        const badge = getSpeakerBadge(speaker);
                        const ctoPanelTalk = speaker.group === "cto" ?
                            Object.values(talks).find(talk =>
                                talk.id === "cto-roundtable"
                            ) : null;

                        return (
                            <div id={`speaker-${speaker.id}`} class="group speaker-card bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl relative">
                                {/* Status Badge */}
                                {badge && (
                                    <div class={`absolute top-3 right-3 z-10 px-3 py-1 ${badge.color} text-white text-xs font-semibold rounded-full shadow-lg`}>
                                        {badge.text}
                                    </div>
                                )}

                                <!-- Full width on desktop, centered circle on mobile -->
                                <div class="hidden sm:block w-full aspect-[0.8] overflow-hidden">
                                    <img
                                        src={speaker.image}
                                        alt={`Photo of ${speaker.name}`}
                                        class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="sm:hidden flex justify-center pt-6">
                                    <div class="w-48 h-48 rounded-full overflow-hidden shadow-lg">
                                        <img
                                            src={speaker.image}
                                            alt={`Photo of ${speaker.name}`}
                                            class="w-full h-full object-cover object-top filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                            loading="lazy"
                                        />
                                    </div>
                                </div>

                                <div class="p-6">
                                    <h3 class="font-bold text-xl text-dark-900">
                                        {speaker.name}
                                    </h3>
                                    <p class="text-ruby-500 font-display font-medium mt-2">
                                        {speaker.company}
                                    </p>
                                    <p class="text-dark-500 text-sm mb-2">
                                        {speaker.role}
                                    </p>

                                    <p class="text-dark-600 text-sm mb-4">
                                        {speaker.bio}
                                    </p>

                                    {/* Show talks for non-CTO speakers or CTO panel link for CTO speakers */}
                                    {speaker.group === "cto" && ctoPanelTalk ? (
                                        <div class="mb-4 pt-3 border-t border-gray-200">
                                            <p class="text-xs text-gray-600 uppercase tracking-wide mb-2 font-semibold">
                                                Panel
                                            </p>
                                            <a
                                                href={`/schedule#${ctoPanelTalk.id}`}
                                                class="group inline-flex items-start gap-2 text-blue-600 hover:text-blue-700 text-sm font-medium mb-2 transition-colors"
                                            >
                                                <svg
                                                    class="w-4 h-4 mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                                    />
                                                </svg>
                                                <span class="break-words">
                                                    {ctoPanelTalk.title}
                                                </span>
                                            </a>
                                        </div>
                                    ) : speakerTalks.length > 0 ? (
                                        <div class="mb-4 pt-3 border-t border-gray-200">

                                            {speakerTalks.map((talk) => (
                                                <a
                                                    href={`/schedule#${talk.id}`}
                                                    class="group inline-flex items-start gap-2 text-blue-600 hover:text-blue-700 text-sm font-medium mb-2 transition-colors"
                                                >
                                                    <svg
                                                        class="w-4 h-4 mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                                                        />
                                                    </svg>
                                                    <span class="break-words">
                                                        {talk.title}
                                                    </span>
                                                </a>
                                            ))}
                                        </div>
                                    ) : null}

                                    <div class="flex space-x-4">
                                        {speaker.socials.map((url) => (
                                            <SocialLink url={url} />
                                        ))}
                                    </div>
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <!-- Call for speakers banner -->
        <div class="mt-16 bg-dark-50 rounded-lg p-8 text-center">
            <h3 class="text-xl font-bold text-dark-900 mb-2">
                Join as a Speaker
            </h3>
            <p class="text-dark-600 mb-4">
                The full program is now available! We are grateful to each and
                every application that was submitted. All applicants were
                contacted over email. Thank you for being an amazing community!
                We are excited to make this event inspiring and meaningful
                together with everyone participating.
            </p>
        </div>
    </div>


</Layout>
