---
// The 2026 lineup in full. The homepage roster (SpeakerRoster.astro) is the
// character-select grid — sprite, name, company, one line of bio. This page is
// where the same people get their whole entry: the talk they're giving, the
// abstract, who they are.
//
// Card shape follows the 2025 page (speakers-2025.astro), which reads better
// than a compact roster row: one grid, portrait across the full card width at
// the top, everything else stacked underneath, keynotes called out with a
// corner badge instead of a section of their own. The 2025 portrait is a photo;
// here it is the pixel sprite on a dithered sky, which is what a transparent
// sprite needs behind it to read at size.
//
// Content comes from buildProfiles (src/utils/speakerProfiles.js), the one merge
// of roster and CFP feed that the homepage roster uses too. Talk, role and bio
// are baked in from the committed snapshot (src/content/cfp-talks.json) and then
// refreshed in place from the live API by the script at the bottom, so an edit
// in the CFP app shows up without a redeploy.
//
// The 2025 lineup lives on at /speakers-2025.
import BaseLayout from "../layouts/BaseLayout.astro";
import SpeakerProfile from "../components/SpeakerProfile.astro";
import {
    conferenceSpeakers,
    cfpNameAliases,
    ticketLink,
    ticketEventClass,
} from "../data/conference-2026.js";
import { buildProfiles } from "../utils/speakerProfiles.js";
import cfpTalks from "../content/cfp-talks.json";

const { profiles, unmatched } = buildProfiles(
    cfpTalks,
    conferenceSpeakers,
    cfpNameAliases,
);
// An unmatched CFP name means a missing cfpNameAliases entry or a speaker who
// isn't on the roster (a withdrawn talk still in the feed, say) — surface it in
// the build log, don't fail.
if (unmatched.length > 0)
    console.warn(`cfp-talks: no roster match for: ${unmatched.join(", ")}`);

// Keynotes open the grid, then whoever has a confirmed talk: a card carrying a
// title and an abstract is the reason to scroll, and speakers whose CFP entry
// hasn't landed yet would otherwise hold the top of the page with the thinnest
// cards on it. The card itself is SpeakerProfile, shared with the homepage schedule.
const speakers = [...profiles].sort(
    (a, b) =>
        Number(Boolean(b.keynote)) - Number(Boolean(a.keynote)) ||
        Number(Boolean(b.title)) - Number(Boolean(a.title)),
);

const withTalks = profiles.filter((s) => s.title).length;
---

<BaseLayout
    title="Speakers - San Francisco Ruby Conference 2026"
    description={`The ${conferenceSpeakers.length} speakers of the San Francisco Ruby Conference, November 10-12 2026 at SFJAZZ: the people behind Solid Queue, RubyLLM, GoodJob, Typesense, Herb and AnyCable, and the engineers running Ruby at Gusto, Shopify, Persona and Fin.`}
    ogUrl="https://sfruby.com/speakers"
>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 px-sky-grad-dusk overflow-hidden">
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
            <span class="px-plate px-font text-px8 px-3 py-1.5">
                Nov 10-12, 2026 &#183; SFJAZZ
            </span>
            <h1
                class="px-font px-shadow-ink text-xl md:text-3xl text-white mt-6"
            >
                Speakers
            </h1>
            <p class="text-lg md:text-xl text-gray-200 mt-6 max-w-3xl">
                {conferenceSpeakers.length} confirmed for the San Francisco Ruby
                Conference: the people who build the gems you run in production,
                the founders running Ruby businesses, and the engineers running
                Ruby at household names. Every one of them was hand-picked, most
                of them found by screening GitHub for people actively building in
                Ruby open source.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a
                    href="/#schedule"
                    class="px-btn px-btn--gold px-font text-px10 px-6 py-4 tap-press"
                >
                    The schedule
                </a>
                <a
                    href={ticketLink("speakers-top")}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press ${ticketEventClass("speakers-top")}`}
                >
                    Get a ticket
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
                <a
                    href="/speakers-2025"
                    class="px-4 py-3 text-white/80 hover:text-white font-medium transition-colors"
                >
                    2025 speakers &#8594;
                </a>
            </div>
        </div>
    </section>

    <!-- The lineup -->
    <section class="py-12 md:py-16 bg-white border-t-4 border-ink">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="px-font text-base md:text-xl text-gray-900">
                The lineup
            </h2>
            <p class="text-gray-600 mt-4 max-w-3xl">
                {withTalks} talks confirmed so far. Titles and abstracts land here
                as speakers submit them.
            </p>

            {/* Two cards per row from lg, each with the sprite as a tile the
                text wraps around: three tall stacked cards read as stripes,
                and so does a full-height sky column. items-start, not the
                default stretch: abstract lengths vary by 5x, and a stretched
                short card is a card with 500px of empty white in it. Ragged
                bottoms read better than that. */}
            <ul
                class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-8 items-start list-none p-0"
            >
                {
                    speakers.map((s) => (
                        <li
                            id={s.key}
                            data-cfp-key={s.key}
                            class="px-card bg-white overflow-hidden block scroll-mt-28 relative"
                        >
                            <SpeakerProfile profile={s} layout="wrap" />
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Closing CTA -->
    <section class="py-16 px-dither-sky border-t-4 border-ink">
        <div
            class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
        >
            <h2 class="px-font px-shadow-ink text-base md:text-xl text-white">
                More still landing
            </h2>
            <p class="text-gray-200 mt-6">
                The lineup grows through the summer. Tickets rise as it does.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a
                    href={ticketLink("speakers-bottom")}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`px-btn px-btn--white px-font text-px10 px-6 py-4 tap-press ${ticketEventClass("speakers-bottom")}`}
                >
                    Get a ticket
                </a>
                <a
                    href="/videos"
                    class="px-btn px-btn--sky px-font text-px10 px-6 py-4 tap-press"
                >
                    Watch past talks
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    // Refresh the talk, role and bio in place from the live CFP feed. The baked
    // copy is already on screen, so every failure path (dev server without the
    // Netlify proxy, CFP app down, 8s timeout) just means no silent upgrade this
    // visit. buildProfiles applies the same roster fallbacks here as at build
    // time, so a stub in the feed can never blank a card.
    import {
        conferenceSpeakers,
        cfpNameAliases,
    } from "../data/conference-2026.js";
    import { buildProfiles } from "../utils/speakerProfiles.js";
    import { CFP_API_PATH } from "../utils/cfpTalks.js";
    import { toParagraphs } from "../utils/abstractText.js";

    function setText(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        if (node.textContent !== text) node.textContent = text;
        node.hidden = !text;
    }

    // Built with createElement rather than innerHTML: this is text a speaker
    // typed into a third-party app, and it must never reach the page as markup.
    function setProse(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        const paragraphs = toParagraphs(text);
        node.hidden = paragraphs.length === 0;
        node.replaceChildren(
            ...paragraphs.map((parts) => {
                const p = document.createElement("p");
                p.className = "mt-3";
                for (const part of parts) {
                    if (part.type === "link") {
                        const a = document.createElement("a");
                        a.href = part.href;
                        a.target = "_blank";
                        a.rel = "noopener noreferrer";
                        a.className =
                            "font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words";
                        a.textContent = part.label;
                        p.append(a);
                    } else {
                        p.append(part.value);
                    }
                }
                return p;
            }),
        );
    }

    async function refreshProfiles() {
        try {
            const res = await fetch(CFP_API_PATH, {
                signal: AbortSignal.timeout(8_000),
            });
            if (!res.ok) return;
            const { profiles } = buildProfiles(
                await res.json(),
                conferenceSpeakers,
                cfpNameAliases,
            );
            const byKey = new Map(profiles.map((p) => [p.key, p]));
            for (const card of document.querySelectorAll("[data-cfp-key]")) {
                if (!(card instanceof HTMLElement)) continue;
                const p = byKey.get(card.dataset.cfpKey ?? "");
                if (!p) continue;
                setText(
                    card,
                    "[data-talk-title]",
                    p.title ? `\u201C${p.title}\u201D` : "",
                );
                setProse(card, "[data-talk-abstract]", p.abstract);
                setProse(card, "[data-speaker-bio]", p.bio);
            }
        } catch {
            // keep the baked copy
        }
    }

    refreshProfiles();
</script>
