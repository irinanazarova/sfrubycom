---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import { speakers, getSpeakersByGroup } from "../data/speakers.js";
import { talks } from "../data/talks.js";

// Get speakers by group - returns arrays of speaker objects
const featuredSpeakersArray = getSpeakersByGroup("featured");
const regularSpeakersArray = getSpeakersByGroup("speaker");
const CTOSpeakers = getSpeakersByGroup("cto");

// Convert arrays to objects keyed by speaker ID for easier lookup
const featuredSpeakers = {};
featuredSpeakersArray.forEach((speaker) => {
    featuredSpeakers[speaker.id] = speaker;
});

const regularSpeakers = {};
regularSpeakersArray.forEach((speaker) => {
    regularSpeakers[speaker.id] = speaker;
});

// Build a speaker-to-talks index for O(1) lookups
const speakerToTalksIndex = new Map();

// Single pass through all talks to build the index
Object.values(talks).forEach((talk) => {
    // Handle single speaker
    if (talk.speakerId) {
        if (!speakerToTalksIndex.has(talk.speakerId)) {
            speakerToTalksIndex.set(talk.speakerId, []);
        }
        speakerToTalksIndex.get(talk.speakerId).push(talk);
    }

    // Handle multiple speakers
    if (talk.speakers && Array.isArray(talk.speakers)) {
        talk.speakers.forEach((speakerId) => {
            if (!speakerToTalksIndex.has(speakerId)) {
                speakerToTalksIndex.set(speakerId, []);
            }
            speakerToTalksIndex.get(speakerId).push(talk);
        });
    }
});

// Helper function to get talks by speaker ID - now O(1)
function getTalksBySpeakerId(speakerId) {
    return speakerToTalksIndex.get(speakerId) || [];
}
---

<Layout title="Speakers - San Francisco Ruby Conference 2025">
    <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Speakers
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Meet the speakers who will be sharing their stories
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Featured speakers section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Keynote Speakers
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    Object.entries(featuredSpeakers).map(
                        ([speakerId, speaker]) => {
                            const speakerTalks = getTalksBySpeakerId(
                                speaker.id,
                            );
                            return (
                                <div class="bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                                    <div class="flex justify-center pt-6">
                                        <div class="w-48 h-48 rounded-full overflow-hidden shadow-lg">
                                            <img
                                                src={speaker.image}
                                                alt={`Photo of ${speaker.name}`}
                                                class="w-full h-full object-cover object-top"
                                                loading="lazy"
                                            />
                                        </div>
                                    </div>

                                    <div class="p-6">
                                        <h3 class="font-bold text-xl text-dark-900">
                                            {speaker.name}
                                        </h3>
                                        <p class="text-ruby-500 font-display font-medium mt-2">
                                            {speaker.company}
                                        </p>
                                        <p class="text-dark-500 text-sm mb-2">
                                            {speaker.role}
                                        </p>

                                        <p class="text-dark-600 text-sm mb-4">
                                            {speaker.bio}
                                        </p>

                                        {speakerTalks.length > 0 && (
                                            <div class="mb-4 pt-3 border-t border-gray-200">
                                                <p class="text-xs text-gray-600 uppercase tracking-wide mb-2 font-semibold">
                                                    Talk
                                                    {speakerTalks.length > 1
                                                        ? "s"
                                                        : ""}
                                                </p>
                                                {speakerTalks.map((talk) => (
                                                    <a
                                                        href={`/schedule#${talk.id}`}
                                                        class="group inline-flex items-start gap-2 text-ruby-600 hover:text-ruby-700 text-sm font-medium mb-2 transition-colors"
                                                    >
                                                        <svg
                                                            class="w-4 h-4 mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                                                            />
                                                        </svg>
                                                        <span class="break-words">
                                                            {talk.title}
                                                        </span>
                                                    </a>
                                                ))}
                                            </div>
                                        )}

                                        <div class="flex space-x-4">
                                            {speaker.socials.map((url) => (
                                                <SocialLink url={url} />
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            );
                        },
                    )
                }
            </div>
        </div>

        <!-- Regular speakers section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Speakers
            </h2>

            <div
                id="regular-speakers-grid"
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
            >
                {
                    Object.entries(regularSpeakers).map(
                        ([speakerId, speaker]) => {
                            const speakerTalks = getTalksBySpeakerId(
                                speaker.id,
                            );
                            return (
                                <div class="speaker-card bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                                    <div class="flex justify-center pt-6">
                                        <div class="w-48 h-48 rounded-full overflow-hidden shadow-lg">
                                            <img
                                                src={speaker.image}
                                                alt={`Photo of ${speaker.name}`}
                                                class="w-full h-full object-cover object-top"
                                                loading="lazy"
                                            />
                                        </div>
                                    </div>

                                    <div class="p-6">
                                        <h3 class="font-bold text-xl text-dark-900">
                                            {speaker.name}
                                        </h3>
                                        <p class="text-ruby-500 font-display font-medium mt-2">
                                            {speaker.company}
                                        </p>
                                        <p class="text-dark-500 text-sm mb-2">
                                            {speaker.role}
                                        </p>

                                        <p class="text-dark-600 text-sm mb-4">
                                            {speaker.bio}
                                        </p>

                                        {speakerTalks.length > 0 && (
                                            <div class="mb-4 pt-3 border-t border-gray-200">
                                                <p class="text-xs text-gray-600 uppercase tracking-wide mb-2 font-semibold">
                                                    Talk
                                                    {speakerTalks.length > 1
                                                        ? "s"
                                                        : ""}
                                                </p>
                                                {speakerTalks.map((talk) => (
                                                    <a
                                                        href={`/schedule#${talk.id}`}
                                                        class="group inline-flex items-start gap-2 text-ruby-600 hover:text-ruby-700 text-sm font-medium mb-2 transition-colors"
                                                    >
                                                        <svg
                                                            class="w-4 h-4 mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                                                            />
                                                        </svg>
                                                        <span class="break-words">
                                                            {talk.title}
                                                        </span>
                                                    </a>
                                                ))}
                                            </div>
                                        )}

                                        <div class="flex space-x-4">
                                            {speaker.socials.map((url) => (
                                                <SocialLink url={url} />
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            );
                        },
                    )
                }
            </div>
        </div>

        <!-- CTO Panel section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                CTO Panel
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    CTOSpeakers.map((speaker) => {
                        // CTO speakers are part of the CTO Roundtable
                        const ctoPanelTalk = Object.values(talks).find(
                            (talk) =>
                                talk.id === "cto-roundtable" ||
                                (talk.title &&
                                    talk.title.toLowerCase().includes("cto")),
                        );
                        return (
                            <div class="bg-white rounded-lg shadow-md overflow-hidden transform transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                                <div class="flex justify-center pt-6">
                                    <div class="w-48 h-48 rounded-full overflow-hidden shadow-lg">
                                        <img
                                            src={speaker.image}
                                            alt={`Photo of ${speaker.name}`}
                                            class="w-full h-full object-cover object-top"
                                            loading="lazy"
                                        />
                                    </div>
                                </div>

                                <div class="p-6">
                                    <h3 class="font-bold text-xl text-dark-900">
                                        {speaker.name}
                                    </h3>
                                    <p class="text-ruby-500 font-display font-medium mt-2">
                                        {speaker.company}
                                    </p>
                                    <p class="text-dark-500 text-sm mb-2">
                                        {speaker.role}
                                    </p>

                                    <p class="text-dark-600 text-sm mb-4">
                                        {speaker.bio}
                                    </p>

                                    {ctoPanelTalk && (
                                        <div class="mb-4 pt-3 border-t border-gray-200">
                                            <p class="text-xs text-gray-600 uppercase tracking-wide mb-2 font-semibold">
                                                Panel
                                            </p>
                                            <a
                                                href={`/schedule#${ctoPanelTalk.id}`}
                                                class="group inline-flex items-start gap-2 text-ruby-600 hover:text-ruby-700 text-sm font-medium mb-2 transition-colors"
                                            >
                                                <svg
                                                    class="w-4 h-4 mt-0.5 flex-shrink-0 group-hover:scale-110 transition-transform"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                                    />
                                                </svg>
                                                <span class="break-words">
                                                    {ctoPanelTalk.title}
                                                </span>
                                            </a>
                                        </div>
                                    )}

                                    <div class="flex space-x-4">
                                        {speaker.socials.map((url) => (
                                            <SocialLink url={url} />
                                        ))}
                                    </div>
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <!-- Call for speakers banner -->
        <div class="mt-16 bg-dark-50 rounded-lg p-8 text-center">
            <h3 class="text-xl font-bold text-dark-900 mb-2">
                Join as a Speaker
            </h3>
            <p class="text-dark-600 mb-4">
                The full program is now available! We are grateful to each and
                every application that was submitted. All applicants were
                contacted over email. Thank you for being an amazing community!
                We are excited to make this event inspiring and meaningful
                together with everyone participating.
            </p>
        </div>
    </div>

    <script>
        // Shuffle function for client-side randomization
        function shuffleArray(array: any[]) {
            const shuffled = [...array];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            return shuffled;
        }

        // Shuffle regular speakers on page load
        document.addEventListener("DOMContentLoaded", function () {
            const grid = document.getElementById("regular-speakers-grid");
            if (grid) {
                const cards = Array.from(
                    grid.querySelectorAll(".speaker-card"),
                );
                const shuffledCards = shuffleArray(cards);

                // Clear the grid and append shuffled cards
                grid.innerHTML = "";
                shuffledCards.forEach((card) => grid.appendChild(card));
            }
        });
    </script>
</Layout>
