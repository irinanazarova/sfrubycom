---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IslandNav from "../../components/IslandNav.astro";
import { formatDate } from "../../utils/helpers";

import newsData from "../../content/news.json";
import type { NewsItem } from "../../utils/types";

// Newest first.
const news = (newsData as NewsItem[])
    .slice()
    .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));

// Consolidated, ICP-first category set (money → product → traction → community).
// Only categories actually present are shown as filter tags.
const CATEGORY_ORDER = [
    "Funding",
    "Acquisition",
    "Product",
    "Traction",
    "Community",
];
const present = new Set(news.map((n) => n.category));
const categories = CATEGORY_ORDER.filter((c) => present.has(c));


// Show the summary's lead sentence in full (no truncation). Splits on . ! ?
// but not inside decimals/versions ($2.5B, v0.10) or abbreviations (U.S.),
// and keeps going past a tiny lead fragment (e.g. a bare date "May 15-16.")
// until it has one substantive sentence.
function leadSentence(text: string): string {
    const s = (text || "").replace(/\s+/g, " ").trim();
    if (!s) return "";
    const out: string[] = [];
    let i = 0;
    let start = 0;
    while (i < s.length) {
        const c = s[i];
        if (c === "." || c === "!" || c === "?") {
            const prev = s[i - 1];
            const next = s[i + 1];
            const nextNext = s[i + 2];
            const isDecimal = /\d/.test(prev || "") && /\d/.test(next || "");
            const boundary =
                next === undefined ||
                (next === " " && /[A-Z0-9"“(]/.test(nextNext || ""));
            const seg = s.slice(start, i);
            const abbrev = /\b([A-Z]|U\.S|Inc|Corp|Ltd|vs|Mr|Ms|Dr|Jr|Sr|St|e\.g|i\.e|No)$/.test(seg);
            if (!isDecimal && boundary && !abbrev) {
                out.push(s.slice(start, i + 1).trim());
                start = i + 1;
                const acc = out.join(" ").trim();
                if (acc.replace(/^[^A-Za-z]*/, "").length >= 40) return acc;
            }
        }
        i++;
    }
    return (out.join(" ") || s).trim();
}
---

<BaseLayout
    ogImage="/og/news.png"
    darkHero={false}
    title="Ruby Startup News - SF Ruby"
    description="A running feed of Ruby startup news: funding rounds, IPOs, acquisitions, releases, and community events."
>
    <section class="pt-24 pb-16 bg-sky-50 min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="mb-8">
                <h1 class="px-font text-lg md:text-2xl text-gray-900">
                    SF Ruby News Feed
                </h1>
                <p class="mt-3 flex items-center gap-2 text-sm text-gray-500">
                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M4 11a9 9 0 019 9h2.5A11.5 11.5 0 004 8.5V11zm0 5a3 3 0 013 3H4v-3zm0-9a15 15 0 0115 15h2.5A17.5 17.5 0 004 4.5V7z"/>
                    </svg>
                    Follow along in your reader over
                    <a href="/news/rss.xml" class="underline decoration-gray-300 underline-offset-2 hover:text-ruby-600 hover:decoration-ruby-400">RSS</a>.
                </p>
            </div>

            <div class="mb-5 space-y-3">
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input
                        type="text"
                        id="news-search"
                        placeholder="Search the feed..."
                        class="w-full pl-10 pr-4 py-2.5 border border-gray-300 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-ruby-400/50 focus:border-transparent transition-all"
                    />
                </div>
                <div id="cat-tags" class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
                    <button type="button" data-cat="all" class="news-tag is-active" aria-pressed="true">All</button>
                    {
                        categories.map((cat) => (
                            <button type="button" data-cat={cat} class="news-tag" aria-pressed="false">
                                {cat}
                            </button>
                        ))
                    }
                </div>
            </div>

            <ol id="news-list" class="mt-4 border-t border-gray-200">
                {
                    news.map((item) => {
                        const internal = !item.link || item.link.startsWith("/") || item.link.startsWith("#");
                        return (
                            <li
                                data-filterable
                                data-search={`${item.headline} ${item.summary} ${item.startupName} ${item.source}`}
                                data-category={item.category.toLowerCase()}
                                class="border-b border-gray-200"
                            >
                                <a
                                    href={item.link}
                                    target={internal ? undefined : "_blank"}
                                    rel={internal ? undefined : "noopener noreferrer"}
                                    class="group block px-1 py-5 hover:bg-white/60 transition-colors tap-press"
                                >
                                    <div class="flex items-baseline gap-3 mb-2">
                                        <h2 class="flex-1 font-display font-semibold text-base leading-snug text-gray-900 group-hover:text-ruby-600 transition-colors">
                                            {item.headline}
                                        </h2>
                                        <time class="flex-shrink-0 text-xs text-gray-400 tabular-nums">
                                            {formatDate(item.date, { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
                                        </time>
                                    </div>
                                    <p class="news-body font-display text-sm leading-relaxed text-gray-600">
                                        {leadSentence(item.summary)}
                                    </p>
                                    {item.source && (
                                        <p class="mt-2.5 text-xs text-gray-400">{item.source}</p>
                                    )}
                                </a>
                            </li>
                        );
                    })
                }
            </ol>

            <div id="no-results" class="hidden text-center py-16">
                <p class="px-font text-px10 text-gray-400 mb-2">No matches</p>
                <p class="text-gray-500 text-sm">
                    Try a different category or search term.
                </p>
            </div>
        </div>
    </section>

    <!-- Newsletter CTA -->
    <IslandNav
        title="Get news in your inbox"
        lede="The monthly SF Ruby issue, plus tips from the community."
        items={[
            {
                href: "https://sfruby.substack.com",
                label: "Newsletter",
                icon: "envelope",
                external: true,
            },
            {
                href: "/news/rss.xml",
                label: "RSS feed",
                icon: "quest",
                external: true,
            },
            { href: "/contact", label: "Share a tip", icon: "heart" },
        ]}
    />
</BaseLayout>

<style>
    /* Martian Grotesk is loaded pinned wide (font-stretch: 150%); render the
       reading body at normal width for a calmer, less-stretched line. */
    .news-body {
        font-variation-settings: "wght" 400, "wdth" 100;
    }
    .news-tag {
        font-size: 0.75rem;
        line-height: 1;
        font-weight: 500;
        padding: 0.45rem 0.85rem;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
        cursor: pointer;
        transition:
            background-color 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }
    .news-tag:hover {
        background: #f9fafb;
        color: #374151;
    }
    .news-tag.is-active {
        background: #ff5545;
        border-color: #ff5545;
        color: #fff;
    }
    .news-tag.is-active:hover {
        background: #e6472f;
        border-color: #e6472f;
    }
</style>

<script>
    // Toggle-tag category filter (multi-select) + text search for the news feed.
    const tags = Array.from(
        document.querySelectorAll<HTMLButtonElement>("#cat-tags [data-cat]"),
    );
    const items = Array.from(
        document.querySelectorAll<HTMLElement>("#news-list [data-filterable]"),
    );
    const search = document.getElementById("news-search") as HTMLInputElement | null;
    const noResults = document.getElementById("no-results");
    const active = new Set<string>(); // lowercased categories; empty = show all

    function apply() {
        const q = (search?.value || "").trim().toLowerCase();
        let visible = 0;
        items.forEach((it) => {
            const cat = it.getAttribute("data-category") || "";
            const hay = (it.getAttribute("data-search") || "").toLowerCase();
            const catOk = active.size === 0 || active.has(cat);
            const searchOk = !q || hay.includes(q);
            const show = catOk && searchOk;
            it.style.display = show ? "" : "none";
            if (show) visible++;
        });
        noResults?.classList.toggle("hidden", visible > 0);
    }

    function syncTagStates() {
        tags.forEach((b) => {
            const c = (b.getAttribute("data-cat") || "").toLowerCase();
            const on = c === "all" ? active.size === 0 : active.has(c);
            b.classList.toggle("is-active", on);
            b.setAttribute("aria-pressed", String(on));
        });
    }

    tags.forEach((btn) => {
        btn.addEventListener("click", () => {
            const cat = (btn.getAttribute("data-cat") || "").toLowerCase();
            if (cat === "all") {
                active.clear();
            } else if (active.has(cat)) {
                active.delete(cat);
            } else {
                active.add(cat);
            }
            syncTagStates();
            apply();
        });
    });

    search?.addEventListener("input", apply);
    apply();
</script>
