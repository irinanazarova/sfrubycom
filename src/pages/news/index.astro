---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import IslandNav from "../../components/IslandNav.astro";
import Filters from "../../components/Filters.astro";

import newsData from "../../content/news.json";
import type { NewsItem } from "../../utils/types";

const news = newsData as NewsItem[];

// Get unique categories
const categories = [...new Set(news.map((n) => n.category))].sort();

const filters = [
    {
        id: "category",
        label: "Category",
        options: [
            { value: "all", label: "All Categories" },
            ...categories.map((cat) => ({
                value: cat.toLowerCase(),
                label: cat,
            })),
        ],
    },
];
---

<BaseLayout
    ogImage="/og/news.png"
    darkHero={false}
    title="Ruby Startup News - SF Ruby"
    description="Stay updated with the latest Ruby startup news, funding rounds, releases, and community events."
>
    <section class="pt-28 pb-12 bg-sky-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mb-12">
                <h1 class="px-font text-lg md:text-2xl text-gray-900 mb-5">
                    Ruby Startup News
                </h1>
                <p class="text-lg text-gray-600">
                    The latest from the Ruby ecosystem: funding rounds, product
                    launches, and community updates.
                </p>
            </div>

            <Filters filters={filters} searchPlaceholder="Search news..." />

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                id="news-grid"
            >
                {
                    news.map((item) => (
                        <div
                            data-filterable
                            data-search={`${item.headline} ${item.summary} ${item.startupName} ${item.source}`}
                            data-category={item.category.toLowerCase()}
                        >
                            <NewsCard news={item} />
                        </div>
                    ))
                }
            </div>

            {
                news.length === 0 && (
                    <div class="text-center py-12">
                        <div class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                            <svg
                                class="w-8 h-8 text-gray-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                                />
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">
                            No news yet
                        </h3>
                        <p class="text-gray-500">
                            Check back soon for Ruby startup updates.
                        </p>
                    </div>
                )
            }

            <div id="no-results" class="hidden text-center py-12">
                <div
                    class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center"
                >
                    <svg
                        class="w-8 h-8 text-gray-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">
                    No news matches your search
                </h3>
                <p class="text-gray-500">
                    Try adjusting your filters or search terms.
                </p>
            </div>
        </div>
    </section>

    <!-- Newsletter CTA -->
    <IslandNav
        title="Get news in your inbox"
        lede="The monthly SF Ruby issue, plus tips from the community."
        items={[
            {
                href: "https://sfruby.substack.com",
                label: "Newsletter",
                icon: "envelope",
                external: true,
            },
            {
                href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
                label: "Join Slack",
                icon: "heart",
                external: true,
            },
            { href: "/contact", label: "Share a tip", icon: "quest" },
        ]}
    />
</BaseLayout>

<script>
    function updateNoResults() {
        const items = document.querySelectorAll("[data-filterable]");
        const noResults = document.getElementById("no-results");

        let visibleCount = 0;
        items.forEach((item) => {
            if ((item as HTMLElement).style.display !== "none") {
                visibleCount++;
            }
        });

        if (noResults) {
            noResults.classList.toggle("hidden", visibleCount > 0);
        }
    }

    const observer = new MutationObserver(updateNoResults);
    document.querySelectorAll("[data-filterable]").forEach((item) => {
        observer.observe(item, {
            attributes: true,
            attributeFilter: ["style"],
        });
    });
</script>
