---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailModal from "../components/EmailModal.astro";
import { getAllHosts } from "../data/hosts.js";

const pastHosts = getAllHosts();
---

<BaseLayout
    title="Host the SF Ruby Meetup"
    description="How to host an SF Ruby meetup or Saturday hack day — venue requirements, format, what hosts get (speaker slot + 1-year jobs board access), and how to apply. Reach 650+ Bay Area Ruby and Rails builders."
>
    <!-- Hero -->
    <section class="relative pt-32 pb-20 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden">
        <!-- Background effects -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute top-20 left-10 w-72 h-72 bg-ruby-500/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 right-20 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        </div>

        <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
            <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-ruby-500/20 text-ruby-200 mb-4">
                For companies
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
                Host the SF Ruby Meetup
            </h1>
            <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-3xl">
                Open your doors to 70–100 of the Bay Area's best Ruby and Rails engineers, founders, and OSS maintainers. A weeknight evening or a Saturday Ruby Hack Day. We bring the community, talks, and format. You bring the room, the pizza, and one speaker.
            </p>
            <div class="flex flex-wrap gap-3">
                <button
                    data-email-modal="host-apply"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-ruby-600 rounded-lg font-semibold shadow-lg hover:shadow-xl hover:bg-gray-50 transition-all duration-300"
                >
                    Apply to host
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
                <a
                    href="https://cal.com/inazarova/meeting"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white/10 backdrop-blur-sm text-white border border-white/20 rounded-lg font-semibold hover:bg-white/20 transition-all duration-300"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    Book a call
                </a>
                <a href="#format" class="inline-flex items-center justify-center gap-2 px-4 py-3 text-white/80 hover:text-white font-medium transition-colors">
                    See the format →
                </a>
            </div>
        </div>
    </section>

    <!-- Stats strip -->
    <section class="py-12 bg-white border-b border-gray-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                <div>
                    <div class="text-4xl font-bold bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent">70–100</div>
                    <div class="text-gray-600 text-sm mt-1">Attendees per meetup</div>
                </div>
                <div>
                    <div class="text-4xl font-bold bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent">650+</div>
                    <div class="text-gray-600 text-sm mt-1">Slack members</div>
                </div>
                <div>
                    <div class="text-4xl font-bold bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent">120–250</div>
                    <div class="text-gray-600 text-sm mt-1">RSVPs per event</div>
                </div>
                <div>
                    <div class="text-4xl font-bold bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent">15+</div>
                    <div class="text-gray-600 text-sm mt-1">Past hosts</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why host -->
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Why host</h2>
            <p class="text-lg text-gray-600 mb-12 max-w-3xl">
                Hosting is the highest-signal way to reach Bay Area Ruby builders. The audience is opt-in, technical, and actively investing in their craft. They show up because they want to be there.
            </p>

            <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-white rounded-2xl border border-gray-200 p-8 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-ruby-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">Recruiting reach that converts</h3>
                        <p class="text-gray-600">70–100 senior Ruby/Rails engineers in your space for an evening. Your engineering managers, recruiters, and founders get face time. Past hosts have closed hires within weeks.</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-200 p-8 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-ruby-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">1 year on the job board</h3>
                        <p class="text-gray-600">A full year of free job postings on <a href="/jobs" class="text-ruby-600 hover:underline">sfruby.com/jobs</a> — featured by your company logo, with all your open Ruby/Rails roles in front of the same audience that came to your meetup.</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-200 p-8 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-ruby-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">A speaker slot for your team</h3>
                        <p class="text-gray-600">5 to 20 minutes on the agenda — your call. A short company welcome from a founder, a 20-minute deep technical talk from your staff engineer, or anywhere in between.</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-200 p-8 flex items-start gap-4">
                    <div class="w-10 h-10 rounded-lg bg-ruby-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-ruby-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">Brand on the SF Ruby map</h3>
                        <p class="text-gray-600">Your logo and story go to our 650+ member Slack, the Luma list, the homepage host wall, the monthly newsletter, X/LinkedIn, and Hacker News. Long-term goodwill, not a one-night burst.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The format -->
    <section id="format" class="py-16 bg-gradient-to-b from-cloud-50 to-white scroll-mt-24">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">What a meetup looks like</h2>
            <p class="text-lg text-gray-600 mb-4 max-w-3xl">
                Weekday evening (any day except Friday), <strong>5pm–9pm</strong>. We run a deliberate format that prioritizes connection over performance. Here's the flow:
            </p>
            <p class="text-sm text-gray-500 mb-10">
                Programmed content runs 5pm–8pm. The room stays open until 9pm for the conversations that always continue afterward.
            </p>

            <div class="space-y-4">
                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">5:00</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Doors open</h3>
                        <p class="text-gray-700">Pizza, drinks, mingling. People trickle in, find old friends, meet new ones.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">5:30</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Host welcome + community announcements</h3>
                        <p class="text-gray-700">A short introduction from someone on your team — founder, eng lead, hiring manager — plus brief community news. This can be the host's full speaker slot if you want a quick 5-minute version.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">5:40</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Talk #1</h3>
                        <p class="text-gray-700">~25 minutes. Either your team's main talk (if you took the longer 20-minute speaker slot) or a curated community talk we sourced.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">6:10</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Talk #2</h3>
                        <p class="text-gray-700">~25 minutes. A curated community talk — usually a founder, OSS maintainer, or another Rails shop with a story to tell.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">6:40</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Round of intros</h3>
                        <p class="text-gray-700">Everyone in the room gets ~20 seconds: name, what you build, one thing you're hacking on or curious about. No slides, no pitches.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">7:10</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Interest circles</h3>
                        <p class="text-gray-700">5–6 themed corners of the room (AI agents in Rails, founders &amp; startups, OSS maintainers, performance &amp; infra, security, hiring, etc. — voted on by Slack ahead of the night). People self-select and dig in.</p>
                    </div>
                </div>

                <div class="flex gap-6 p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
                    <div class="text-2xl font-bold text-ruby-500 w-20 shrink-0">8:00</div>
                    <div>
                        <h3 class="font-bold text-gray-900 mb-1">Programmed content ends · networking continues</h3>
                        <p class="text-gray-700">Lights stay on, conversations keep going. Hard stop at 9pm.</p>
                    </div>
                </div>
            </div>

            <!-- Saturday alternative -->
            <div class="mt-12 p-6 md:p-8 bg-gradient-to-br from-ruby-50 to-pink-50 rounded-2xl border border-ruby-100">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center flex-shrink-0 shadow-sm">
                        <svg class="w-6 h-6 text-ruby-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-xs font-semibold text-ruby-700 uppercase tracking-wider mb-2">
                            Or: a Saturday all-day format
                        </div>
                        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">Ruby Hack Day or Rails Girls</h3>
                        <p class="text-gray-700 mb-3">
                            If your team prefers a deeper, all-day experience, we also organize <strong>Ruby Hack Days</strong> (community OSS contribution sessions, ~30–60 attendees) and <strong>Rails Girls workshops</strong> (intro-to-Rails for newcomers — has launched many careers). Both run a full Saturday and need a slightly different setup: tables, power, breakout space, lunch.
                        </p>
                        <p class="text-gray-700">
                            Tell us in your application if either format fits your space and team better than a weeknight meetup — we'll walk through the differences.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Split: what you provide / what we provide -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10">Who does what</h2>

            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                        <span class="w-10 h-10 inline-flex items-center justify-center rounded-lg bg-ruby-100 text-ruby-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 7v14m18-14v14M3 21h18M5 21V7l7-4v18M5 11h2m-2 4h2m-2 4h2m4-8h2m-2 4h2m-2 4h2"></path>
                            </svg>
                        </span>
                        You provide
                    </h3>
                    <ul class="space-y-3">
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Date</strong> · any weekday <em>except Friday</em>, 5pm–9pm. (Or a full Saturday for a Ruby Hack Day or Rails Girls.)</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Venue for 70–100 attendees</strong> · open area or auditorium with seating and a clear speaker area.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Presenter A/V</strong> · projector or large screen, microphones, and sound system. Decent acoustics for talks of ~25 minutes.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Recording setup</strong> <span class="text-gray-500">(highly preferred)</span> · video + audio capture of the talks. We publish the edited recordings on the SF Ruby YouTube channel.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Food &amp; drinks</strong> · snacks, pizza, and salads, plus soft drinks and beer. Plan for ~80 people.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Lobby coverage</strong> · someone to let people up the elevator from 4:45 to ~6:30pm.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">One speaker (5–20 minutes)</strong> · founder, engineer, or hiring lead — your call on length and topic.</div>
                        </li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                        <span class="w-10 h-10 inline-flex items-center justify-center rounded-lg bg-ruby-100 text-ruby-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </span>
                        We provide
                    </h3>
                    <ul class="space-y-3">
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">The audience</strong> · we bring people. Promotion to our 650+ member Slack, Luma list, newsletter, X/LinkedIn, and Hacker News — typical RSVP volume is 120–250 for a 70-person night.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Speakers and agenda</strong> · we pick the other speakers, set the running order, and brief everyone on time + topic.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Organization &amp; facilitation</strong> · MCs run the welcome, the round of intros, and the interest circles. We handle the timing.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Editing &amp; publication</strong> · we edit your recording and publish the talks on the SF Ruby YouTube channel within ~2 weeks.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">Post-event coverage</strong> · highlights in the next monthly newsletter, a Slack recap, and a permanent host card on sfruby.com.</div>
                        </li>
                        <li class="flex gap-3 p-4 bg-cloud-50 rounded-lg border border-gray-100">
                            <span class="w-6 h-6 rounded-md bg-ruby-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5 text-ruby-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </span>
                            <div><strong class="text-gray-900">1 year of free job postings</strong> · your open Ruby/Rails roles featured on <a href="/jobs" class="text-ruby-600 hover:underline">sfruby.com/jobs</a> for 12 months after the event.</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Timeline -->
    <section class="py-16 bg-gradient-to-b from-white to-cloud-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Timeline</h2>
            <p class="text-lg text-gray-600 mb-10">From "we'd like to host" to "lights are on" usually takes 6–8 weeks. Faster is possible if a slot opens up.</p>

            <div class="relative">
                <div class="absolute left-6 top-2 bottom-2 w-0.5 bg-ruby-200"></div>

                <div class="space-y-6">
                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">1</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">8 weeks out · You apply</h3>
                            <p class="text-gray-700">Tell us your company, your space capacity, the talk you want to give, and any month preferences.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">2</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">6 weeks out · We confirm a date</h3>
                            <p class="text-gray-700">Meetups happen the third or fourth Wednesday of the month. We confirm a specific date with you and lock it in.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">3</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">4 weeks out · Luma + Slack go live</h3>
                            <p class="text-gray-700">We publish the event with your branding, draft the description together, and open RSVPs.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">4</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">2 weeks out · Talks finalized</h3>
                            <p class="text-gray-700">Your speaker confirms title and abstract. We brief them on the format. Interest circles get voted on in Slack.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">5</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">Day-of · Your team shows up</h3>
                            <p class="text-gray-700">We arrive at 4:00 to set up. Pizza arrives at 4:45. Doors at 5:00. We MC, you present, the room connects.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 relative">
                        <div class="w-12 h-12 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center shrink-0 z-10">6</div>
                        <div class="flex-1 pt-2">
                            <h3 class="font-bold text-gray-900 mb-1">2 weeks after · Recording + recap</h3>
                            <p class="text-gray-700">Edited talk video published to YouTube. Recap in the next newsletter. Your host card stays on sfruby.com forever.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Past hosts -->
    <section class="py-16 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Companies that have hosted us</h2>
            <p class="text-lg text-gray-600 mb-10 max-w-3xl">
                A partial list of teams that have opened their doors to the SF Ruby community.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
                {pastHosts.map((host) => (
                    <a
                        href={host.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="aspect-[3/2] flex items-center justify-center p-4 bg-cloud-50 rounded-xl border border-gray-100 hover:border-ruby-200 hover:shadow-md transition-all duration-300"
                        title={host.name}
                    >
                        <img
                            src={host.logo}
                            alt={host.name}
                            class="max-h-12 w-auto object-contain opacity-70 hover:opacity-100 transition-opacity"
                            loading="lazy"
                        />
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-cloud-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10">FAQ</h2>

            <div class="space-y-6">
                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        Do we have to be a Rails shop to host?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">No — but Ruby has to be a real part of how you build, ship, or support your product. If your engineers genuinely write Ruby, contribute to OSS, or your company sells something the Ruby community uses, you're a fit.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        Our office is small / has no auditorium. Can we still host?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">If you can fit 70+ people with seating and a clear speaker area, yes. Most SF tech offices clear a kitchen, lobby, or all-hands area for the night. If you're not sure, send us a photo or floor plan and we'll work it out.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        What's a Ruby Hack Day or Rails Girls?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">An all-Saturday alternative to the weeknight format. <strong>Ruby Hack Day</strong> is a community OSS day — engineers bring projects to work on, contribute to gems, and pair with each other. Smaller crowd (~30–60) but high-signal. <strong>Rails Girls</strong> is an intro-to-Rails workshop for newcomers; high-impact for the broader ecosystem and a great way for your engineers to mentor. Both need tables, power, breakout space, and lunch. Mention either in your application and we'll walk through it.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        Why no Fridays?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">Friday-night attendance for tech meetups in SF reliably drops off — people leave town, have plans, or are exhausted from the week. Tuesday/Wednesday/Thursday consistently fill the room.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        We don't have recording equipment. Is that a dealbreaker?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">No, but it's strongly preferred — recordings are how the talks reach the wider Ruby community on YouTube and are part of what makes hosting valuable. Even a single tripod-mounted camera on the speaker plus a clean audio feed from the mic works. If you don't have anything, tell us early and we'll figure something out.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        Can we recruit at the meetup?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">Strongly yes — recruiting is one of the main reasons companies host. Mention open roles in your welcome, post jobs on sfruby.com/jobs, hand out cards. We just ask you skip the hard pitch in the talk itself.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        What if no one from our team wants to give a long talk?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">The host speaker slot is anywhere from 5 to 20 minutes — your call. A 5-minute welcome from a founder or hiring lead is plenty if no one wants to give a deep technical talk. The room genuinely loves real engineering stories from your team, but we'd never force one.</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        Is this paid? Do you need sponsorship money?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">No fee. You cover space and food; we cover everything else. (If you want to go further and sponsor the annual SF Ruby Conference, that's a separate thing — see <a href="/sponsor-2026" class="text-ruby-600 hover:underline">/sponsor-2026</a>.)</p>
                </details>

                <details class="group p-6 bg-white rounded-xl border border-gray-100">
                    <summary class="font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                        We're not in SF — can we host remotely or in a different city?
                        <span class="text-ruby-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <p class="text-gray-700 mt-4">SF Ruby meetups are in-person in San Francisco proper. If you're out of town and want to be involved, the best path is sponsoring our annual conference or supporting community OSS — happy to chat about either.</p>
                </details>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="py-16 bg-gradient-to-br from-ruby-500 to-pink-500">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Ready to host?</h2>
            <p class="text-lg text-ruby-50 mb-8">
                Drop us a line or grab a 30-minute slot — we'll talk through the format, your space, and pick a month.
            </p>
            <div class="flex flex-wrap gap-3 justify-center">
                <button
                    data-email-modal="host-apply"
                    class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-ruby-600 rounded-lg font-bold shadow-lg hover:shadow-xl hover:bg-gray-50 transition-all duration-300"
                >
                    Apply to host
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
                <a
                    href="https://cal.com/inazarova/meeting"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-ruby-700 text-white border border-white/20 rounded-lg font-bold hover:bg-ruby-800 transition-all duration-300"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    Book a 30-min call
                </a>
            </div>
            <p class="text-sm text-ruby-100 mt-4">
                Or email <a href="mailto:irina@evilmartians.com" class="underline">irina@evilmartians.com</a> directly.
            </p>
        </div>
    </section>

    <EmailModal
        id="host-apply"
        email="irina@evilmartians.com"
        subject="Hosting an SF Ruby Meetup"
        title="Apply to host"
    />
</BaseLayout>
