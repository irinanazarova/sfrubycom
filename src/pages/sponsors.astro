---
import Layout from '../layouts/Layout.astro';

const sponsorTiers = [
  {
    name: 'Picaxe',
    price: '$10,000',
    description: 'Premier sponsorship with maximum visibility and branding.',
    benefits: [
      'Prominent logo placement on all materials',
      '10-minute keynote opportunity',
      'Premium 10x10 booth in main area',
      '5 conference passes',
      'Full-page ad in conference guide',
      'Sponsored email to attendees',
      'Social media promotion (5 dedicated posts)',
      'Access to opt-in attendee list'
    ],
    available: 1,
    claimed: 1
  },
  {
    name: 'Ruby',
    price: '$7,500',
    description: 'High-visibility sponsorship with excellent branding opportunities.',
    benefits: [
      'Logo placement on website and materials',
      '8x8 booth in prime location',
      '3 conference passes',
      'Half-page ad in conference guide',
      'Social media promotion (3 dedicated posts)',
      'Company description on conference website',
      'Access to opt-in attendee list'
    ],
    available: 3,
    claimed: 1
  },
  {
    name: 'Emerald',
    price: '$5,000',
    description: 'Strong presence with quality branding and networking.',
    benefits: [
      'Logo on website and conference materials',
      '6x6 booth',
      '2 conference passes',
      'Quarter-page ad in conference guide',
      'Social media mention (1 dedicated post)',
      'Company listing on conference website'
    ],
    available: 5,
    claimed: 0
  },
  {
    name: 'Sapphire',
    price: '$2,500',
    description: 'Entry-level sponsorship with good visibility.',
    benefits: [
      'Logo on website',
      'Shared table space',
      '1 conference pass',
      'Company name in conference guide',
      'Company listing on conference website'
    ],
    available: 10,
    claimed: 0
  }
];

// Special sponsorship opportunities
const specialOpportunities = [
  {
    name: 'Reception Sponsor',
    price: '$8,000',
    description: 'Exclusive sponsorship of the evening reception on Day 1.',
    available: 1,
    claimed: 0
  },
  {
    name: 'Lunch Sponsor',
    price: '$6,000',
    description: 'Sponsor lunch for all attendees (both days available).',
    available: 2,
    claimed: 0
  },
  {
    name: 'Coffee Break Sponsor',
    price: '$4,000',
    description: 'Sponsor coffee breaks throughout the conference.',
    available: 2,
    claimed: 0
  },
  {
    name: 'Lanyard Sponsor',
    price: '$3,500',
    description: 'Your logo on all attendee lanyards.',
    available: 1,
    claimed: 0
  }
];

// Current sponsors
const currentSponsors = [
  {
    name: 'Chime',
    tier: 'Picaxe',
    logo: 'https://images.pexels.com/photos/270637/pexels-photo-270637.jpeg?auto=compress&cs=tinysrgb&w=800',
    url: 'https://www.chime.com'
  },
  {
    name: 'Gusto',
    tier: 'Ruby',
    logo: 'https://images.pexels.com/photos/270637/pexels-photo-270637.jpeg?auto=compress&cs=tinysrgb&w=800',
    url: 'https://www.gusto.com'
  }
];
---

<Layout title="Sponsors - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Sponsors</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Support the Ruby community and connect with top developers
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Current sponsors section -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 text-center mb-8">Our Current Sponsors</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {currentSponsors.map((sponsor) => (
          <a 
            href={sponsor.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex flex-col items-center bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300"
          >
            <div class="text-sm font-medium text-dark-500 mb-4">{sponsor.tier} Sponsor</div>
            <div class="h-16 flex items-center justify-center mb-4">
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} logo`} 
                class="max-h-full max-w-full object-contain" 
                loading="lazy"
              />
            </div>
            <div class="font-bold text-lg text-dark-900">{sponsor.name}</div>
          </a>
        ))}
      </div>
    </div>
    
    <!-- Why sponsor section -->
    <div class="mb-16 bg-dark-50 rounded-lg p-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">Why Sponsor SF Ruby Conference?</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ruby-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
              </svg>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Connect with Talent</h3>
            <p class="text-dark-600">
              Meet over 500 Ruby developers and engineering leaders at the premier Ruby event in San Francisco.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ruby-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015
</path>
              </svg>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Brand Visibility</h3>
            <p class="text-dark-600">
              Showcase your brand to an engaged audience and the wider Ruby community through our marketing channels.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ruby-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
              </svg>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Community Support</h3>
            <p class="text-dark-600">
              Demonstrate your commitment to the Ruby ecosystem and help sustain the community that powers your business.
            </p>
          </div>
        </div>
        
        <div class="text-center">
          <p class="text-dark-600 mb-6">
            SF Ruby Conference attracts developers, CTOs, founders, and engineering leaders from companies including Stripe, GitHub, Shopify, Heroku, and hundreds of startups.
          </p>
          
          <div class="flex justify-center space-x-4">
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">500+</div>
              <div class="text-dark-600 text-sm">Attendees</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">70%</div>
              <div class="text-dark-600 text-sm">Senior Engineers</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">30%</div>
              <div class="text-dark-600 text-sm">Engineering Leaders</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Sponsorship tiers -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">Sponsorship Tiers</h2>
      
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-dark-200 border border-dark-200">
          <thead>
            <tr class="bg-dark-50">
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Tier</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Price</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Description</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Availability</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-dark-200">
            {sponsorTiers.map((tier) => (
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="font-bold text-dark-900">{tier.name}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-dark-900">{tier.price}</td>
                <td class="px-6 py-4">
                  <div class="text-sm text-dark-600">{tier.description}</div>
                  <button class="text-ruby-500 hover:text-ruby-600 text-sm mt-1 cursor-pointer">View benefits</button>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-dark-600">
                    {tier.claimed}/{tier.available} claimed
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <a 
                    href="/contact" 
                    class={`px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 ${
                      tier.claimed === tier.available 
                        ? 'bg-dark-100 text-dark-400 cursor-not-allowed' 
                        : 'bg-ruby-500 text-white hover:bg-ruby-600'
                    }`}
                  >
                    {tier.claimed === tier.available ? 'Sold Out' : 'Contact Us'}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Special sponsorship opportunities -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">Special Sponsorship Opportunities</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {specialOpportunities.map((opportunity) => (
          <div class="bg-white border border-dark-200 rounded-lg overflow-hidden">
            <div class="p-6">
              <h3 class="font-bold text-dark-900 mb-1">{opportunity.name}</h3>
              <div class="text-ruby-500 font-medium mb-2">{opportunity.price}</div>
              <p class="text-sm text-dark-600 mb-4">{opportunity.description}</p>
              
              <div class="flex justify-between items-center">
                <div class="text-xs text-dark-500">
                  {opportunity.claimed}/{opportunity.available} claimed
                </div>
                <a 
                  href="/contact" 
                  class={`px-3 py-1 rounded-md text-xs font-medium transition-colors duration-200 ${
                    opportunity.claimed === opportunity.available 
                      ? 'bg-dark-100 text-dark-400 cursor-not-allowed' 
                      : 'bg-gold-500 text-dark-900 hover:bg-gold-400'
                  }`}
                >
                  {opportunity.claimed === opportunity.available ? 'Sold Out' : 'Inquire'}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Call to action -->
    <div class="bg-gradient-to-r from-dark-800 to-dark-900 text-white rounded-lg overflow-hidden">
      <div class="p-8 md:p-12">
        <div class="md:flex justify-between items-center">
          <div class="mb-6 md:mb-0 md:mr-8">
            <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">Become a Sponsor</h2>
            <p class="text-dark-100">
              Join leading companies in supporting the Ruby community and connecting with top developers.
              Custom sponsorship packages are also available.
            </p>
          </div>
          
          <div class="flex-shrink-0">
            <a 
              href="/sponsorship-prospectus.pdf" 
              class="inline-block px-6 py-3 bg-white text-dark-900 font-medium rounded-md hover:bg-dark-100 transition-colors duration-200 mr-4"
            >
              Download Prospectus
            </a>
            <a 
              href="/contact" 
              class="inline-block px-6 py-3 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>