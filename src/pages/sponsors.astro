---
import Layout from "../layouts/Layout.astro";
import {
    sponsorTiers,
    specialOpportunities,
    getSponsorsForSponsorsPage,
} from "../data/sponsors.js";

const sponsors = getSponsorsForSponsorsPage();
---

<Layout title="Sponsors - San Francisco Ruby Conference 2025">
    <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl md:text-4xl font-display font-bold text-center">
                Sponsors
            </h1>
            <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
                Partner with us to reach the Ruby community
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Current Sponsors Section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Our Amazing Sponsors
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    sponsors.map((sponsor) => (
                        <div class="bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg">
                            <div class="h-32 bg-dark-50 flex items-center justify-center p-4">
                                <img
                                    src={sponsor.logo}
                                    alt={`${sponsor.name} logo`}
                                    class="max-h-full max-w-full object-contain"
                                    loading="lazy"
                                />
                            </div>

                            <div class="p-6">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-bold text-xl text-dark-900">
                                        {sponsor.name}
                                    </h3>
                                    <span class="text-xs font-medium text-ruby-500 bg-ruby-50 px-2 py-1 rounded">
                                        {sponsor.tier}
                                    </span>
                                </div>

                                <a
                                    href={sponsor.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-ruby-500 hover:text-ruby-600 font-medium inline-flex items-center"
                                >
                                    Visit Website
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="w-4 h-4 ml-1"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Sponsorship Tiers Section -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Sponsorship Opportunities
            </h2>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                {
                    sponsorTiers.map((tier) => (
                        <div class="bg-white rounded-lg shadow-md border border-dark-200 overflow-hidden">
                            <div class="bg-gradient-to-r from-ruby-500 to-ruby-600 text-white p-6">
                                <h3 class="text-xl font-display font-bold mb-2">
                                    {tier.name}
                                </h3>
                                <div class="text-2xl font-bold">
                                    {tier.price}
                                </div>
                                <p class="text-ruby-100 text-sm mt-2">
                                    {tier.description}
                                </p>
                            </div>

                            <div class="p-6">
                                <div class="mb-6">
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="text-dark-600">
                                            Available:
                                        </span>
                                        <span class="font-semibold text-dark-900">
                                            {tier.available}
                                        </span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-dark-600">
                                            Claimed:
                                        </span>
                                        <span class="font-semibold text-ruby-500">
                                            {tier.claimed}
                                        </span>
                                    </div>
                                    <div class="w-full bg-dark-200 rounded-full h-2 mt-2">
                                        <div
                                            class="bg-ruby-500 h-2 rounded-full"
                                            style={`width: ${(tier.claimed / tier.available) * 100}%`}
                                        />
                                    </div>
                                </div>

                                <ul class="space-y-3 mb-6">
                                    {tier.benefits.map((benefit) => (
                                        <li class="flex items-start">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke-width="1.5"
                                                stroke="currentColor"
                                                class="w-5 h-5 text-ruby-500 mr-2 flex-shrink-0 mt-0.5"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                                />
                                            </svg>
                                            <span class="text-dark-700 text-sm">
                                                {benefit}
                                            </span>
                                        </li>
                                    ))}
                                </ul>

                                <a
                                    href="/contact"
                                    class="w-full inline-flex items-center justify-center px-4 py-2 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200"
                                >
                                    Contact Us
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Special Opportunities -->
        <div class="mb-16">
            <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">
                Special Opportunities
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    specialOpportunities.map((opportunity) => (
                        <div class="bg-white rounded-lg shadow-md border border-dark-200 p-6">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-xl font-bold text-dark-900">
                                    {opportunity.name}
                                </h3>
                                <span class="text-lg font-bold text-ruby-500">
                                    {opportunity.price}
                                </span>
                            </div>

                            <p class="text-dark-600 mb-4">
                                {opportunity.description}
                            </p>

                            <div class="flex justify-between items-center">
                                <div class="text-sm text-dark-500">
                                    {opportunity.claimed} of{" "}
                                    {opportunity.available} claimed
                                </div>
                                <a
                                    href="/contact"
                                    class="inline-flex items-center px-4 py-2 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200"
                                >
                                    Inquire
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Contact section -->
        <div class="bg-dark-50 rounded-lg p-8 text-center">
            <h3 class="text-xl font-bold text-dark-900 mb-2">
                Ready to Sponsor?
            </h3>
            <p class="text-dark-600 mb-4">
                Contact us to discuss sponsorship opportunities and custom
                packages.
            </p>
            <a
                href="mailto:sponsors@sfruby.com"
                class="inline-flex items-center px-6 py-3 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200"
            >
                Email Us
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5 ml-2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                    ></path>
                </svg>
            </a>
        </div>
    </div>
</Layout>
