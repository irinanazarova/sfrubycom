---
import Layout from '../layouts/Layout.astro';
import {
  sponsorTiers,
  specialOpportunities,
  getSponsorsForSponsorsPage
} from '../data/sponsors.js';

const currentSponsors = getSponsorsForSponsorsPage();
---

<Layout
  title="Sponsors - San Francisco Ruby Conference 2025"
  description="Support the Ruby community and connect with top developers. Sponsorship opportunities available for San Francisco Ruby Conference 2025."
  ogImage="/sfruby_og.jpg"
  ogUrl="https://sfruby.com/sponsors"
>
  <div class="bg-gradient-to-b from-ruby-100 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Sponsors</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Support the Ruby community and connect with top developers
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">


    <!-- Why sponsor section -->
    <div class="mb-16 bg-dark-50 rounded-lg p-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">Why Sponsor the San Francisco Ruby Conference?</h2>

        <div class="text-center">
          <p class="text-dark-600 mb-6">
            San Francisco Ruby Conference brings together developers from Chime, Gusto, Cisco, Shopify, One Medical, Intercom and many more, and the hottest new Ruby startups like bolt.new, and Fin AI.
          </p>

          <div class="flex flex-wrap justify-center gap-4">
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">450</div>
              <div class="text-dark-600 text-sm">Attendees</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">70%</div>
              <div class="text-dark-600 text-sm">Senior Engineers</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">10%</div>
              <div class="text-dark-600 text-sm">Engineering Leaders</div>
            </div>
          </div>
        </div>
      </div>
    </div>
      <!-- Sponsorship tiers -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">Sponsorship Tiers</h2>

      <div class="overflow-x-auto">
        <table class="w-full divide-y divide-dark-200 border border-dark-200">
          <thead>
            <tr class="bg-dark-50">
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Tier</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Price</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Description</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Availability</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-dark-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-dark-200">
            {sponsorTiers.map((tier) => (
              <tr class={tier.active ? '' : 'opacity-50 bg-dark-50'}>
                <td class="px-4 py-4 whitespace-nowrap">
                  <div class={`font-bold ${tier.active ? 'text-dark-900' : 'text-dark-500'}`}>
                    {tier.name}
                    {tier.active && (
                      <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                        Available
                      </span>
                    )}
                    {!tier.active && (
                      <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                        Closed
                      </span>
                    )}
                  </div>
                </td>
                <td class={`px-4 py-4 whitespace-nowrap ${tier.active ? 'text-dark-900' : 'text-dark-500'}`}>{tier.price}</td>
                <td class="px-4 py-4">
                  <div class={`text-sm line-clamp-2 ${tier.active ? 'text-dark-600' : 'text-dark-400'}`}>{tier.description}</div>
                  <button
                    class={`text-sm mt-1 ${tier.active ? 'text-ruby-500 hover:text-ruby-600' : 'text-dark-400'}`}
                    onclick={`window.showBenefits('${tier.name}')`}
                  >
                    View benefits
                  </button>
                </td>
                <td class="px-4 py-4 whitespace-nowrap">
                  <div class={`text-sm ${tier.active ? 'text-dark-600' : 'text-dark-400'}`}>
                    {tier.claimed}/{tier.available} claimed
                  </div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-right">
                  {tier.active ? (
                    <>
                      <a
                        href="/contact"
                        class={`inline-block px-4 py-2 rounded-md text-sm font-medium transition-all duration-300 transform hover:scale-105 ${
                          tier.claimed === tier.available
                            ? 'bg-dark-100 text-dark-400 cursor-not-allowed'
                            : 'bg-ruby-500 text-white hover:bg-ruby-600'
                        }`}
                      >
                        {tier.claimed === tier.available ? 'Sold Out' : 'Contact Us'}
                      </a>
                      {tier.stripelink && tier.stripelink !== '' && (
                        <a
                          href={tier.stripelink}
                          class="inline-block px-4 py-2 rounded-md text-sm font-medium transition-all duration-300 transform hover:scale-105 bg-ruby-500 text-white hover:bg-ruby-600 ml-2"
                        >
                          Send Payment
                        </a>
                      )}
                    </>
                  ) : (
                    <span class="inline-block px-4 py-2 rounded-md text-sm font-medium bg-dark-100 text-dark-400 cursor-not-allowed">
                      Not Available
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>


    <!-- Call to action -->
    <div class="bg-gradient-to-r from-cloud-800 to-cloud-900 text-white rounded-lg overflow-hidden">
      <div class="p-8">
        <div class="md:flex justify-between items-center gap-8">
          <div class="mb-6 md:mb-0">
            <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">Become a Sponsor</h2>
            <p class="text-dark-100">
              Join leading companies in supporting the Ruby community and connecting with top developers.
              Custom sponsorship packages are also available.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/sfruby_prospectus.pdf"
              class="inline-block px-6 py-3 bg-white text-cloud-900 font-medium rounded-md transition-all duration-300 transform hover:scale-105 text-center"
            >
              Download Prospectus
            </a>
            <a
              href="/contact"
              class="inline-block px-6 py-3 bg-ruby-500 text-white font-medium rounded-md transition-all duration-300 transform hover:scale-105 text-center"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Benefits Modal -->
  <div id="benefitsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg max-w-lg w-full mx-4 overflow-hidden">
      <div class="p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-dark-900" id="modalTitle"></h3>
          <button id="closeModalBtn" class="text-dark-400 hover:text-dark-600">
            ✕
          </button>
        </div>
        <ul class="space-y-2" id="benefitsList"></ul>
      </div>
      <div class="bg-dark-50 px-6 py-4">
        <a href="/contact" class="inline-block w-full px-4 py-2 bg-ruby-500 text-white text-center font-medium rounded-md transition-all duration-300 transform hover:scale-105 duration-200">
          Contact Us About This Tier
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Current sponsors section -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 text-center mb-8">Confirmed Sponsors</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {currentSponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300"
          >
              <div class="text-sm font-medium text-dark-500 mb-4">{sponsor.tier} Sponsor</div>
            <div class="h-16 flex items-center justify-center mb-4">
              <img
                src={sponsor.logo}
                alt={`${sponsor.name} logo`}
                class="max-h-full max-w-full object-contain"
                loading="lazy"
              />
            </div>
            <!-- <div class="font-bold text-lg text-dark-900">{sponsor.name}</div>-->
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ sponsorTiers }}>
  function showBenefits(tierName) {
    const modal = document.getElementById('benefitsModal');
    const modalTitle = document.getElementById('modalTitle');
    const benefitsList = document.getElementById('benefitsList');

    const tier = sponsorTiers.find(t => t.name === tierName);

    if (tier && modal && modalTitle && benefitsList) {
      modalTitle.textContent = `${tier.name} Tier Benefits`;
      benefitsList.innerHTML = tier.benefits
        .map(benefit => `<li class="flex items-start">
          <span class="text-ruby-500 mr-2">✓</span>
          <span>${benefit}</span>
        </li>`)
        .join('');

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeBenefitsModal() {
    const modal = document.getElementById('benefitsModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  // Close modal when clicking outside
  const benefitsModal = document.getElementById('benefitsModal');
  if (benefitsModal) {
    benefitsModal.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        closeBenefitsModal();
      }
    });
  }

  // Close modal button handler
  const closeModalBtn = document.getElementById('closeModalBtn');
  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeBenefitsModal);
  }

  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeBenefitsModal();
    }
  });

  // Make functions globally accessible
  window.showBenefits = showBenefits;
  window.closeBenefitsModal = closeBenefitsModal;
</script>
