---
import Layout from '../layouts/Layout.astro';

const sponsorTiers = [
  {
    name: 'Picaxe',
    price: '$15,000',
    description: 'Premier sponsorship with maximum visibility and branding.',
    benefits: [
      'Prominent logo placement on all conference materials',
      'Featured sponsor acknowledgment during opening and closing remarks',
      'Dedicated sponsor spotlight on social media channels',
      'Premium exhibition space',
      'Opportunity to host a sponsored workshop or breakout session',
      '5 complimentary conference tickets'

    ],
    available: 3,
    claimed: 2
  },
  {
    name: 'Ruby',
    price: '$7,000',
    description: 'High-visibility sponsorship with excellent branding opportunities.',
    benefits: [
      'Logo on conference website and printed materials',
      'Sponsor acknowledgment during opening remarks',
      'Social media recognition',
      'Exhibition space or branded gifts for attendees',
      'Lightning talk opportunity (5 minutes)',
      '2 complimentary conference tickets'
    ],
    available: 5,
    claimed: 1
  },
  {
    name: 'Emerald',
    price: '$3,000',
    description: 'Strong presence with quality branding and networking.',
    benefits: [
      'Logo on conference website and printed materials',
      'Sponsor acknowledgment during opening remarks',
      'Social media recognition',
      '1 complimentary conference ticket'
    ],
    available: 10,
    claimed: 0
  }
];

const specialOpportunities = [
 {
    name: 'Reception Sponsor',
    price: 'TBD',
    description: 'Exclusive sponsorship of the evening reception on Day 1.',
    available: 1,
    claimed: 0
  }
];

const currentSponsors = [
  {
    name: 'Chime',
    tier: 'Picaxe',
    logo: '/chime.png',
    url: 'https://www.chime.com'
  },
  {
    name: 'Bolt.new by Stackblitz',
    tier: 'Picaxe',
    logo: '/bolt.png',
    url: 'https://www.bolt.new'
  },
  {
    name: 'Gusto',
    tier: 'Ruby',
    logo: '/gusto.png',
    url: 'https://www.gusto.com'
  }
];
---

<Layout title="Sponsors - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Sponsors</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Support the Ruby community and connect with top developers
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Current sponsors section -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 text-center mb-8">Our Current Sponsors</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {currentSponsors.map((sponsor) => (
          <a 
            href={sponsor.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex flex-col items-center bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300"
          >
            <div class="text-sm font-medium text-dark-500 mb-4">{sponsor.tier} Sponsor</div>
            <div class="h-16 flex items-center justify-center mb-4">
              <img 
                src={sponsor.logo} 
                alt={`${sponsor.name} logo`} 
                class="max-h-full max-w-full object-contain" 
                loading="lazy"
              />
            </div>
            <div class="font-bold text-lg text-dark-900">{sponsor.name}</div>
          </a>
        ))}
      </div>
    </div>
    
    <!-- Why sponsor section -->
    <div class="mb-16 bg-dark-50 rounded-lg p-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">Why Sponsor SF Ruby Conference?</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <span class="text-ruby-500 text-xl">👥</span>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Connect with Talent</h3>
            <p class="text-dark-600">
              Meet 400 Ruby developers and engineering leaders at the premier Ruby event in San Francisco.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <span class="text-ruby-500 text-xl">🎯</span>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Brand Visibility</h3>
            <p class="text-dark-600">
              Showcase your brand to an engaged audience and the wider Ruby community.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <div class="w-12 h-12 rounded-full bg-ruby-100 flex items-center justify-center mb-4">
              <span class="text-ruby-500 text-xl">🤝</span>
            </div>
            <h3 class="font-bold text-dark-900 mb-2">Community Support</h3>
            <p class="text-dark-600">
              Demonstrate your commitment to the Ruby ecosystem.
            </p>
          </div>
        </div>
        
        <div class="text-center">
          <p class="text-dark-600 mb-6">
            SF Ruby Conference attracts developers, CTOs, founders, and engineering leaders from companies including Cisco, GitHub, Shopify, Figma, and dozens of startups.
          </p>
          
          <div class="flex flex-wrap justify-center gap-4">
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">400</div>
              <div class="text-dark-600 text-sm">Attendees</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">70%</div>
              <div class="text-dark-600 text-sm">Senior Engineers</div>
            </div>
            <div class="bg-white py-2 px-4 rounded-md shadow-sm">
              <div class="text-2xl font-bold text-ruby-500">10%</div>
              <div class="text-dark-600 text-sm">Engineering Leaders</div>
            </div>
          </div>
        </div>
      </div>
    </div>
      <!-- Sponsorship tiers -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">Sponsorship Tiers</h2>
      
      <div class="overflow-x-auto">
        <table class="w-full divide-y divide-dark-200 border border-dark-200">
          <thead>
            <tr class="bg-dark-50">
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Tier</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Price</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Description</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider">Availability</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-dark-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-dark-200">
            {sponsorTiers.map((tier) => (
              <tr>
                <td class="px-4 py-4 whitespace-nowrap">
                  <div class="font-bold text-dark-900">{tier.name}</div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-dark-900">{tier.price}</td>
                <td class="px-4 py-4">
                  <div class="text-sm text-dark-600 line-clamp-2">{tier.description}</div>
                  <button 
                    class="text-ruby-500 hover:text-ruby-600 text-sm mt-1"
                    onclick={`window.showBenefits('${tier.name}')`}
                  >
                    View benefits
                  </button>
                </td>
                <td class="px-4 py-4 whitespace-nowrap">
                  <div class="text-sm text-dark-600">
                    {tier.claimed}/{tier.available} claimed
                  </div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-right">
                  <a 
                    href="/contact" 
                    class={`inline-block px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 ${
                      tier.claimed === tier.available 
                        ? 'bg-dark-100 text-dark-400 cursor-not-allowed' 
                        : 'bg-ruby-500 text-white hover:bg-ruby-600'
                    }`}
                  >
                    {tier.claimed === tier.available ? 'Sold Out' : 'Contact Us'}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Special sponsorship opportunities -->
    <div class="mb-16">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8">Special Sponsorship Opportunities</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {specialOpportunities.map((opportunity) => (
          <div class="bg-white border border-dark-200 rounded-lg overflow-hidden">
            <div class="p-6">
              <h3 class="font-bold text-dark-900 mb-1">{opportunity.name}</h3>
              <div class="text-ruby-500 font-medium mb-2">{opportunity.price}</div>
              <p class="text-sm text-dark-600 mb-4 line-clamp-2">{opportunity.description}</p>
              
              <div class="flex justify-between items-center">
                <div class="text-xs text-dark-500">
                  {opportunity.claimed}/{opportunity.available} claimed
                </div>
                <a 
                  href="/contact" 
                  class={`inline-block px-3 py-1 rounded-md text-xs font-medium transition-colors duration-200 ${
                    opportunity.claimed === opportunity.available 
                      ? 'bg-dark-100 text-dark-400 cursor-not-allowed' 
                      : 'bg-gold-500 text-dark-900 hover:bg-gold-400'
                  }`}
                >
                  {opportunity.claimed === opportunity.available ? 'Sold Out' : 'Inquire'}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Call to action -->
    <div class="bg-gradient-to-r from-dark-800 to-dark-900 text-white rounded-lg overflow-hidden">
      <div class="p-8">
        <div class="md:flex justify-between items-center gap-8">
          <div class="mb-6 md:mb-0">
            <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">Become a Sponsor</h2>
            <p class="text-dark-100">
              Join leading companies in supporting the Ruby community and connecting with top developers.
              Custom sponsorship packages are also available.
            </p>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="/sponsorship-prospectus.pdf" 
              class="inline-block px-6 py-3 bg-white text-dark-900 font-medium rounded-md hover:bg-dark-100 transition-colors duration-200 text-center"
            >
              Download Prospectus
            </a>
            <a 
              href="/contact" 
              class="inline-block px-6 py-3 bg-ruby-500 text-white font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200 text-center"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Benefits Modal -->
  <div id="benefitsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg max-w-lg w-full mx-4 overflow-hidden">
      <div class="p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-dark-900" id="modalTitle"></h3>
          <button onclick="window.closeBenefitsModal()" class="text-dark-400 hover:text-dark-600">
            ✕
          </button>
        </div>
        <ul class="space-y-2" id="benefitsList"></ul>
      </div>
      <div class="bg-dark-50 px-6 py-4">
        <a href="/contact" class="inline-block w-full px-4 py-2 bg-ruby-500 text-white text-center font-medium rounded-md hover:bg-ruby-600 transition-colors duration-200">
          Contact Us About This Tier
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Store tier data for the modal
  const tiers = {
    sponsorTiers: [
      {
        name: 'Picaxe',
        price: '$15,000',
        description: 'Premier sponsorship with maximum visibility and branding.',
        benefits: [
          'Prominent logo placement on all conference materials',
          'Featured sponsor acknowledgment during opening and closing remarks',
          'Dedicated sponsor spotlight on social media channels',
          'Premium exhibition space',
          'Opportunity to host a sponsored workshop or breakout session',
          '5 complimentary conference tickets'

        ],
        available: 3,
        claimed: 2
      },
      {
        name: 'Ruby',
        price: '$7,000',
        description: 'High-visibility sponsorship with excellent branding opportunities.',
        benefits: [
          'Logo on conference website and printed materials',
          'Sponsor acknowledgment during opening remarks',
          'Social media recognition',
          'Exhibition space or branded gifts for attendees',
          'Lightning talk opportunity (5 minutes)',
          '2 complimentary conference tickets'
        ],
        available: 5,
        claimed: 1
      },
      {
        name: 'Emerald',
        price: '$3,000',
        description: 'Strong presence with quality branding and networking.',
        benefits: [
          'Logo on conference website and printed materials',
          'Sponsor acknowledgment during opening remarks',
          'Social media recognition',
          '1 complimentary conference ticket'
        ],
        available: 10,
        claimed: 0
      }
    ]
  };

  function showBenefits(tierName) {
    const modal = document.getElementById('benefitsModal');
    const modalTitle = document.getElementById('modalTitle');
    const benefitsList = document.getElementById('benefitsList');
    
    const tier = tiers.sponsorTiers.find(t => t.name === tierName);
    
    if (tier) {
      modalTitle.textContent = `${tier.name} Tier Benefits`;
      benefitsList.innerHTML = tier.benefits
        .map(benefit => `<li class="flex items-start">
          <span class="text-ruby-500 mr-2">✓</span>
          <span>${benefit}</span>
        </li>`)
        .join('');
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeBenefitsModal() {
    const modal = document.getElementById('benefitsModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Close modal when clicking outside
  document.getElementById('benefitsModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      closeBenefitsModal();
    }
  });

  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeBenefitsModal();
    }
  });

  // Make functions globally accessible
  window.showBenefits = showBenefits;
  window.closeBenefitsModal = closeBenefitsModal;
</script>