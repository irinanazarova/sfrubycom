---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import SocialLink from "../components/SocialLink.astro";
import IslandNav from "../components/IslandNav.astro";
import { palette, cssVars, pixelSizes } from "../design/tokens.mjs";

// The living style guide for the 8-bit design language (2026 refresh).
// Values render straight from src/design/tokens.mjs so docs cannot drift.

const nav = [
    { id: "principles", label: "Principles" },
    { id: "tokens", label: "Tokens" },
    { id: "type", label: "Type" },
    { id: "skies", label: "Skies" },
    { id: "components", label: "Components" },
    { id: "islands", label: "Islands" },
    { id: "sprites", label: "Sprites" },
    { id: "motion", label: "Motion" },
    { id: "patterns", label: "Patterns" },
];

const scales = ["ruby", "sky", "indigo", "gold", "pumpkin"] as const;

const sprites = [
    { src: "/logo8bit-mascot.png", name: "mascot", note: "header, footer, game player, 404" },
    { src: "/logo8bit-transparent.png", name: "lockup", note: "conference + homepage heroes" },
    { src: "/px-island.png", name: "island", note: "island buttons, hero decoration, game ground" },
    { src: "/px-coin.png", name: "coin '26", note: "sponsor islands, game collectible" },
    { src: "/px-ruby.png", name: "ruby", note: "game bonus collectible" },
    { src: "/px-quest.png", name: "quest !", note: "CFP islands, new-quest markers" },
    { src: "/px-envelope.png", name: "envelope", note: "contact / newsletter islands" },
    { src: "/px-ticket.png", name: "ticket", note: "tickets / conference islands" },
    { src: "/px-heart.png", name: "heart", note: "Slack / community islands" },
    { src: "/px-play.png", name: "play", note: "videos islands" },
    { src: "/px-briefcase.png", name: "briefcase", note: "jobs islands, news hiring strip" },
    { src: "/px-cloud.png", name: "cloud", note: "hero + game decoration" },
    { src: "/px-scene-cfp.png", name: "CFP scene", note: "conference CFP section" },
];

const skies = [
    { cls: "px-sky-grad-day", name: "px-sky-grad-day", note: "conference + sponsor heroes" },
    { cls: "px-sky-grad-deep", name: "px-sky-grad-deep", note: "homepage hero" },
    { cls: "px-sky-grad-dusk", name: "px-sky-grad-dusk", note: "interior page heroes" },
    { cls: "px-royal-grad", name: "px-royal-grad", note: "notify / CTA sections" },
    { cls: "px-night", name: "px-night", note: "news sections (starry)" },
    { cls: "px-dither-sky", name: "px-dither-sky", note: "flat sky (overworld sections)" },
];
---

<BaseLayout
    title="Design System - SF Ruby"
    description="The SF Ruby 8-bit design system: tokens, type, skies, components, sprites, and page patterns."
>
    <!-- Hero -->
    <section class="relative pt-32 pb-16 px-sky-grad-dusk overflow-hidden">
        <img
            src="/px-cloud.png"
            alt=""
            width="34"
            height="14"
            class="px-pixelated absolute top-24 right-[12%] w-28 animate-float pointer-events-none"
            aria-hidden="true"
        />
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="px-font px-shadow-ink text-xl md:text-3xl text-white mb-5">
                Design System
            </h1>
            <p class="text-lg text-white/90 max-w-2xl">
                The 8-bit language, derived pixel by pixel from the 2026
                conference logo. One token source, generated assets, and
                components that press like buttons should.
            </p>
        </div>
    </section>

    <!-- In-page nav (z below the mobile bottom nav) -->
    <nav
        class="sticky top-20 z-30 bg-white border-b-4 border-ink overflow-x-auto px-scroll-row"
        aria-label="Design system sections"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-6 py-3 whitespace-nowrap">
            {
                nav.map((item) => (
                    <a
                        href={`#${item.id}`}
                        class="px-font text-px8 text-gray-600 hover:text-ruby-600 transition-colors"
                    >
                        {item.label}
                    </a>
                ))
            }
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Principles -->
        <section id="principles" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Principles
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-ruby-600 mb-3">
                        Everything is square
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Border radii are globally zero (including
                        <code>rounded-full</code>). Elevation is a hard ink
                        offset, never a blur. If a corner looks rounded or a
                        shadow looks soft, it's a bug.
                    </p>
                </div>
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-ruby-600 mb-3">
                        The logo is the source
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Every color, sprite, and sky is sampled or generated
                        from <code>public/logo8bit.png</code>. New art follows
                        its conventions: pure black outlines, flat fills, one
                        highlight and one shadow per hue.
                    </p>
                </div>
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-ruby-600 mb-3">
                        Playful, never gated
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Game elements (islands, coins, the news runner) are
                        opt-in delight layered over content that works without
                        them. Locks and unlocks live only inside a play
                        session.
                    </p>
                </div>
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-ruby-600 mb-3">
                        Mobile first, app feel
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Design at 390px first. Touch targets stay at 44px+,
                        press states use <code>.tap-press</code> or
                        <code>.px-btn</code>, and all motion respects
                        <code>prefers-reduced-motion</code>.
                    </p>
                </div>
            </div>
        </section>

        <!-- Tokens -->
        <section id="tokens" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Tokens
            </h2>
            <p class="text-gray-600 mb-8 max-w-2xl">
                <code>src/design/tokens.mjs</code> is the single source of
                truth. Tailwind imports it, <code>scripts/sync-tokens.mjs</code>
                generates the CSS variables, and the sprite and gradient
                generators consume the same object. Never edit
                <code>src/styles/tokens.css</code> or <code>public/px-*.png</code>
                by hand.
            </p>
            <div class="px-card bg-white p-6 mb-6">
                {
                    scales.map((name) => (
                        <div class="mb-4">
                            <p class="text-xs text-gray-500 mb-1.5 font-mono">
                                {name}
                            </p>
                            <div class="flex flex-wrap gap-1">
                                {Object.entries(palette[name]).map(([step, hex]) => (
                                    <span
                                        class="w-9 h-9 border-2 border-ink inline-block"
                                        style={`background:${hex}`}
                                        title={`${name}-${step} ${hex}`}
                                    />
                                ))}
                            </div>
                        </div>
                    ))
                }
                <div class="flex flex-wrap gap-4 mt-5">
                    <span class="inline-flex items-center gap-2 text-sm text-gray-600">
                        <span class="w-9 h-9 border-2 border-ink inline-block" style={`background:${palette.ink}`}></span>
                        <code>ink {palette.ink}</code>
                    </span>
                    <span class="inline-flex items-center gap-2 text-sm text-gray-600">
                        <span class="w-9 h-9 border-2 border-ink inline-block" style={`background:${palette.cloudshade}`}></span>
                        <code>cloudshade {palette.cloudshade}</code>
                    </span>
                </div>
            </div>
            <div class="px-card bg-white p-6">
                <h3 class="px-font text-px10 text-gray-900 mb-4">
                    CSS variables (generated)
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 font-mono text-xs text-gray-600">
                    {
                        Object.entries(cssVars).map(([name, value]) => (
                            <span class="inline-flex items-center gap-2">
                                <span
                                    class="w-4 h-4 border border-ink inline-block shrink-0"
                                    style={`background:${value}`}
                                />
                                --{name}: {value}
                            </span>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Type -->
        <section id="type" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Type
            </h2>
            <p class="text-gray-600 mb-8 max-w-2xl">
                Three tiers. Press Start 2P is loud and wide: use it only for
                short display strings, never faked bold, never long sentences.
            </p>
            <div class="space-y-6">
                <div class="px-card bg-white p-6">
                    <p class="text-xs text-gray-500 font-mono mb-3">
                        .px-font / font-pixel — Press Start 2P, display moments
                    </p>
                    <p class="px-font text-xl text-gray-900 mb-2">Choose your quest</p>
                    <div class="flex flex-wrap gap-x-8 gap-y-2 mt-4">
                        <span class="px-font text-px8 text-gray-700">text-px8 · 0.5rem</span>
                        <span class="px-font text-px9 text-gray-700">text-px9 · 0.5625rem</span>
                        <span class="px-font text-px10 text-gray-700">text-px10 · 0.625rem</span>
                    </div>
                </div>
                <div class="px-card bg-white p-6">
                    <p class="text-xs text-gray-500 font-mono mb-3">
                        font-display — Martian Grotesk, long headings
                    </p>
                    <p class="font-display font-bold text-3xl text-gray-900">
                        The new generation of Ruby success stories
                    </p>
                </div>
                <div class="px-card bg-white p-6">
                    <p class="text-xs text-gray-500 font-mono mb-3">
                        font-sans (default) — Martian Mono, body
                    </p>
                    <p class="text-gray-600 max-w-xl">
                        Join founders and engineers at monthly meetups, talks,
                        and the annual SF Ruby conference. The fixed-width
                        rhythm echoes the pixel grid.
                    </p>
                </div>
            </div>
        </section>

        <!-- Skies -->
        <section id="skies" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Skies
            </h2>
            <p class="text-gray-600 mb-8 max-w-2xl">
                Bayer-dithered gradients generated from the sky ramp tokens
                (<code>scripts/px-gradients.mjs</code>), plus a starry night
                for news. Pick by page mood; the crenellated divider steps one
                sky into the next section's background color.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    skies.map((sky) => (
                        <figure class="px-card bg-white overflow-hidden">
                            <div class={`h-28 ${sky.cls}`} />
                            <figcaption class="p-4">
                                <code class="text-sm text-gray-900">.{sky.name}</code>
                                <p class="text-xs text-gray-500 mt-1">{sky.note}</p>
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
            <div class="mt-8 px-card bg-white overflow-hidden">
                <div class="px-dither-sky h-16 relative">
                    <div
                        class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:#ffffff]"
                        aria-hidden="true"
                    >
                    </div>
                </div>
                <p class="p-4 text-xs text-gray-500">
                    <code>.px-crenel</code> divider: set
                    <code>--px-crenel-color</code> to the next section's
                    background.
                </p>
            </div>
        </section>

        <!-- Components -->
        <section id="components" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Components
            </h2>

            <div class="px-card bg-white p-6 mb-6">
                <h3 class="px-font text-px10 text-gray-900 mb-4">
                    Buttons — Button component / .px-btn
                </h3>
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <Button variant="primary">Primary</Button>
                    <Button variant="secondary">Secondary</Button>
                    <Button variant="white" class="ring-1 ring-gray-200">White</Button>
                    <Button variant="outline">Outline</Button>
                    <button class="px-btn px-btn--gold px-font text-px10 px-6 py-3.5">Gold (.px-btn--gold)</button>
                </div>
                <div class="flex flex-wrap items-center gap-4">
                    <Button variant="primary" size="sm">Small</Button>
                    <Button variant="primary" size="md">Medium</Button>
                    <Button variant="primary" size="lg">Large</Button>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    Hover nudges up, press pushes into the shadow. Ghost
                    variant stays chromeless for tertiary actions.
                </p>
            </div>

            <div class="px-card bg-white p-6 mb-6">
                <h3 class="px-font text-px10 text-gray-900 mb-4">
                    Badges & plates
                </h3>
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <Badge variant="ruby">Ruby</Badge>
                    <Badge variant="success">Funding</Badge>
                    <Badge variant="warning">Release</Badge>
                    <Badge variant="info">Info</Badge>
                    <Badge variant="featured">Featured</Badge>
                    <Badge variant="hiring">Hiring</Badge>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <span class="px-plate px-font text-px10 px-4 py-2">px-plate</span>
                    <span class="px-plate px-plate--gold px-font text-px10 px-4 py-2">px-plate--gold</span>
                    <span class="px-plate px-plate--orange px-font text-px10 px-4 py-2">px-plate--orange</span>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    Badges tag content inline; plates are standalone label
                    blocks (kickers, island labels, HUD chips).
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-gray-900 mb-4">.px-card</h3>
                    <p class="text-sm text-gray-600">
                        4px ink border + 8px hard shadow. The default surface
                        for content on light backgrounds.
                    </p>
                </div>
                <div class="px-dialog p-6">
                    <h3 class="px-font text-px10 text-white mb-4">.px-dialog</h3>
                    <p class="text-sm text-white/80">
                        NES dialog box: royal panel, white inner frame, ink
                        outline. News cards and dark-surface content.
                    </p>
                </div>
            </div>

            <div class="px-card bg-white p-6 mb-6">
                <h3 class="px-font text-px10 text-gray-900 mb-4">.px-bubble</h3>
                <div class="px-bubble px-font text-px10 text-ruby-600 px-5 py-4 mb-2">
                    CFP opens July 6!
                </div>
                <p class="text-xs text-gray-500 mt-5">
                    Speech bubble with a stepped pixel tail. Text stays live
                    HTML: change the copy, keep the art.
                </p>
            </div>

            <div class="px-card bg-white p-6">
                <h3 class="px-font text-px10 text-gray-900 mb-4">
                    Social links
                </h3>
                <div class="flex flex-wrap gap-3">
                    <SocialLink platform="slack" href="https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg">Join Slack</SocialLink>
                    <SocialLink platform="substack" href="https://sfruby.substack.com/">Newsletter</SocialLink>
                    <SocialLink platform="ruby" href="https://www.rubyevents.org/events">Ruby Events</SocialLink>
                </div>
            </div>
        </section>

        <!-- Islands -->
        <section id="islands" class="mb-8 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Islands
            </h2>
            <p class="text-gray-600 max-w-2xl">
                The interactive signature: a floating island with a bobbing
                item sprite and a plate label, the whole thing a link. Hover
                speeds the bob and lights the plate gold; press dips the
                island. Use the IslandNav component for rows (live example
                below); icons come from its catalog (coin, quest, envelope,
                ticket, heart, play, briefcase, mascot).
            </p>
        </section>
    </div>

    <IslandNav
        title="Live island nav"
        lede="This is the actual component, not a mockup."
        items={[
            { href: "#components", label: "Components", icon: "quest" },
            { href: "#sprites", label: "Sprites", icon: "coin" },
            { href: "#patterns", label: "Patterns", icon: "envelope" },
        ]}
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Sprites -->
        <section id="sprites" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Sprites
            </h2>
            <p class="text-gray-600 mb-8 max-w-2xl">
                Cut from Anton's art or hand-mapped in
                <code>scripts/px-sprites.mjs</code> using the token palette.
                Always render with <code>.px-pixelated</code> and real
                width/height attributes.
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
                {
                    sprites.map((s) => (
                        <figure class="px-card bg-sky-50 p-4 flex flex-col items-center text-center">
                            <div class="h-20 flex items-center justify-center">
                                <img
                                    src={s.src}
                                    alt={s.name}
                                    class="px-pixelated max-h-16 w-auto max-w-full"
                                />
                            </div>
                            <figcaption class="mt-3">
                                <code class="text-xs text-gray-900">{s.name}</code>
                                <p class="text-[11px] text-gray-500 mt-1">{s.note}</p>
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </section>

        <!-- Motion -->
        <section id="motion" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Motion
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="px-card bg-white p-6 text-center">
                    <img src="/px-coin.png" alt="" width="135" height="139" class="px-pixelated h-10 w-auto mx-auto px-island-btn__item" />
                    <p class="text-xs text-gray-500 mt-4">
                        <code>px-bob</code>: idle float for item sprites.
                        Stagger with <code>--px-bob-delay</code>.
                    </p>
                </div>
                <div class="px-card bg-white p-6 text-center">
                    <p class="px-font px-blink text-px10 text-ruby-600 mt-2">&#9654; Press Start &#9664;</p>
                    <p class="text-xs text-gray-500 mt-5">
                        <code>px-blink</code>: stepped blink for prompts. One
                        per screen, maximum.
                    </p>
                </div>
                <div class="px-card bg-white p-6 text-center">
                    <button class="px-btn px-btn--gold px-font text-px10 px-5 py-3">Press me</button>
                    <p class="text-xs text-gray-500 mt-4">
                        Press states translate into the shadow (no scale, no
                        fade). All motion is disabled under
                        <code>prefers-reduced-motion</code>.
                    </p>
                </div>
            </div>
        </section>

        <!-- Patterns -->
        <section id="patterns" class="mb-24 scroll-mt-32">
            <h2 class="px-font text-base md:text-xl text-gray-900 mb-6">
                Page patterns
            </h2>
            <div class="space-y-6">
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-gray-900 mb-3">
                        Hero recipes
                    </h3>
                    <ul class="text-sm text-gray-600 space-y-2 list-none">
                        <li><code>px-sky-grad-day</code> + lockup + crenel: conference, sponsor</li>
                        <li><code>px-sky-grad-deep</code> + lockup + islands: homepage</li>
                        <li><code>px-sky-grad-dusk</code> + pixel h1: jobs, videos, startups, about, host, contact</li>
                        <li><code>px-night</code> + HUD masthead: news, everywhere stories live</li>
                        <li>Light pages (<code>bg-sky-50</code> tops) pass <code>darkHero=false</code> so the header starts solid.</li>
                    </ul>
                </div>
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-gray-900 mb-3">
                        z-index ladder (mobile)
                    </h3>
                    <p class="text-sm text-gray-600">
                        Page stickies <code>&le; z-30</code> &lt; bottom nav
                        <code>z-40</code> &lt; jobs filter sheet
                        <code>z-45/46</code> &lt; More sheet
                        <code>z-50/51</code>. The floating dock is the only
                        mobile nav; give content bottom clearance with
                        <code>pb-tabbar</code>.
                    </p>
                </div>
                <div class="px-card bg-white p-6">
                    <h3 class="px-font text-px10 text-gray-900 mb-3">
                        Regeneration workflow
                    </h3>
                    <p class="text-sm text-gray-600 font-mono">
                        node scripts/sync-tokens.mjs && node scripts/px-gradients.mjs && node scripts/px-sprites.mjs
                    </p>
                    <p class="text-xs text-gray-500 mt-3">
                        Run after any change to
                        <code>src/design/tokens.mjs</code>. OG cards regenerate
                        via <code>scripts/og-template.html</code> (recipe in
                        the file header). Verify with <code>npm run qa</code>.
                    </p>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>
