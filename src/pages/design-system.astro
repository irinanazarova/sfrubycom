---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import SocialLink from "../components/SocialLink.astro";
import EmailModal from "../components/EmailModal.astro";
import ResourceCard from "../components/ResourceCard.astro";
import DistanceBadge from "../components/DistanceBadge.astro";
---

<BaseLayout
    title="Design System - SF Ruby"
    description="SF Ruby Design System documentation. Typography, colors, components, and usage guidelines."
>
    <!-- Hero -->
    <section
        class="relative pt-32 pb-16 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden"
    >
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute inset-0"
                style="background-image: url('data:image/svg+xml,%3Csvg width=\"
                60\"
                height='\"60\"'
                viewBox='\"0'
                0
                60
                60\"
                xmlns='\"http://www.w3.org/2000/svg\"%3E%3Cg'
                fill='\"none\"'
                fill-rule='\"evenodd\"%3E%3Cg'
                fill='\"%23ffffff\"'
                fill-opacity='\"0.4\"%3E%3Cpath'
                d='\"M36'
                34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6
                34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6
                4V0H4v4H0v2h4v4h2V6h4V4H6z\"
                %3E%3C
                g%3E%3C
                g%3E%3C
                svg%3E')"
            >
            </div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <Badge variant="ruby" size="md" class="mb-4"
                    >Design System</Badge
                >
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
                    SF Ruby Design System
                </h1>
                <p class="text-xl text-gray-300">
                    A comprehensive guide to our visual language, components,
                    and patterns. Build consistent, beautiful interfaces across
                    the SF Ruby ecosystem.
                </p>
            </div>
        </div>
    </section>

    <!-- Navigation -->
    <nav class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex gap-8 overflow-x-auto py-4 text-sm font-medium">
                <a
                    href="#foundations"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Foundations</a
                >
                <a
                    href="#colors"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Colors</a
                >
                <a
                    href="#typography"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Typography</a
                >
                <a
                    href="#spacing"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Spacing</a
                >
                <a
                    href="#buttons"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Buttons</a
                >
                <a
                    href="#badges"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Badges</a
                >
                <a
                    href="#social-links"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Social Links</a
                >
                <a
                    href="#cards"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Cards</a
                >
                <a
                    href="#modals"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Modals</a
                >
                <a
                    href="#navigation"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Navigation</a
                >
                <a
                    href="#sections"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Sections</a
                >
                <a
                    href="#filters"
                    class="text-gray-600 hover:text-ruby-500 whitespace-nowrap"
                    >Filters</a
                >
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Foundations -->
        <section id="foundations" class="mb-24 scroll-mt-24">
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">
                    Foundations
                </h2>
                <p class="text-lg text-gray-600 max-w-3xl">
                    The building blocks of our design system. These foundational
                    elements ensure consistency and cohesion across all SF Ruby
                    properties.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <a
                    href="#colors"
                    class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-ruby-300 hover:shadow-lg transition-all"
                >
                    <div
                        class="w-12 h-12 bg-gradient-to-br from-ruby-500 to-pink-500 rounded-xl mb-4"
                    >
                    </div>
                    <h3
                        class="font-bold text-gray-900 group-hover:text-ruby-600 mb-2"
                    >
                        Colors
                    </h3>
                    <p class="text-sm text-gray-600">
                        Our color palette including Ruby red, neutrals, and
                        semantic colors.
                    </p>
                </a>
                <a
                    href="#typography"
                    class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-ruby-300 hover:shadow-lg transition-all"
                >
                    <div
                        class="w-12 h-12 bg-gray-900 rounded-xl mb-4 flex items-center justify-center text-white font-bold text-xl"
                    >
                        Aa
                    </div>
                    <h3
                        class="font-bold text-gray-900 group-hover:text-ruby-600 mb-2"
                    >
                        Typography
                    </h3>
                    <p class="text-sm text-gray-600">
                        Martian Grotesk and Martian Mono typefaces with scale.
                    </p>
                </a>
                <a
                    href="#spacing"
                    class="group p-6 bg-white rounded-xl border border-gray-200 hover:border-ruby-300 hover:shadow-lg transition-all"
                >
                    <div
                        class="w-12 h-12 bg-gray-100 rounded-xl mb-4 flex items-center justify-center"
                    >
                        <div class="grid grid-cols-3 gap-1">
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-sm"></div>
                        </div>
                    </div>
                    <h3
                        class="font-bold text-gray-900 group-hover:text-ruby-600 mb-2"
                    >
                        Spacing
                    </h3>
                    <p class="text-sm text-gray-600">
                        Consistent spacing scale for layouts and components.
                    </p>
                </a>
            </div>
        </section>

        <!-- Colors -->
        <section id="colors" class="mb-24 scroll-mt-24">
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Colors</h2>
                <p class="text-lg text-gray-600 max-w-3xl">
                    Our color system is built around Ruby red as the primary
                    brand color, with a full gray scale and semantic colors for
                    different states.
                </p>
            </div>

            <!-- Ruby Palette -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Ruby (Primary)
                </h3>
                <p class="text-gray-600 mb-6">
                    The signature SF Ruby color. Use ruby-500 for primary
                    actions and branding.
                </p>
                <div
                    class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-11 gap-2"
                >
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-50"></div>
                        <p class="text-xs text-center font-mono">50</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-100"></div>
                        <p class="text-xs text-center font-mono">100</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-200"></div>
                        <p class="text-xs text-center font-mono">200</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-300"></div>
                        <p class="text-xs text-center font-mono">300</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-400"></div>
                        <p class="text-xs text-center font-mono">400</p>
                    </div>
                    <div class="space-y-2">
                        <div
                            class="h-16 rounded-lg bg-ruby-500 ring-2 ring-ruby-500 ring-offset-2"
                        >
                        </div>
                        <p class="text-xs text-center font-mono font-bold">
                            500
                        </p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-600"></div>
                        <p class="text-xs text-center font-mono">600</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-700"></div>
                        <p class="text-xs text-center font-mono">700</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-800"></div>
                        <p class="text-xs text-center font-mono">800</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-900"></div>
                        <p class="text-xs text-center font-mono">900</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-ruby-950"></div>
                        <p class="text-xs text-center font-mono">950</p>
                    </div>
                </div>
            </div>

            <!-- Gray Palette -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Gray (Neutral)
                </h3>
                <p class="text-gray-600 mb-6">
                    For text, backgrounds, and borders. Gray-900 for headings,
                    gray-600 for body text.
                </p>
                <div
                    class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-10 gap-2"
                >
                    <div class="space-y-2">
                        <div
                            class="h-16 rounded-lg bg-gray-50 border border-gray-200"
                        >
                        </div>
                        <p class="text-xs text-center font-mono">50</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-100"></div>
                        <p class="text-xs text-center font-mono">100</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-200"></div>
                        <p class="text-xs text-center font-mono">200</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-300"></div>
                        <p class="text-xs text-center font-mono">300</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-400"></div>
                        <p class="text-xs text-center font-mono">400</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-500"></div>
                        <p class="text-xs text-center font-mono">500</p>
                    </div>
                    <div class="space-y-2">
                        <div
                            class="h-16 rounded-lg bg-gray-600 ring-2 ring-gray-600 ring-offset-2"
                        >
                        </div>
                        <p class="text-xs text-center font-mono font-bold">
                            600
                        </p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-700"></div>
                        <p class="text-xs text-center font-mono">700</p>
                    </div>
                    <div class="space-y-2">
                        <div class="h-16 rounded-lg bg-gray-800"></div>
                        <p class="text-xs text-center font-mono">800</p>
                    </div>
                    <div class="space-y-2">
                        <div
                            class="h-16 rounded-lg bg-gray-900 ring-2 ring-gray-900 ring-offset-2"
                        >
                        </div>
                        <p class="text-xs text-center font-mono font-bold">
                            900
                        </p>
                    </div>
                </div>
            </div>

            <!-- Semantic Colors -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Semantic Colors
                </h3>
                <p class="text-gray-600 mb-6">
                    For status indicators, alerts, and contextual information.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div
                        class="p-4 bg-emerald-50 rounded-xl border border-emerald-200"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 bg-emerald-500 rounded-lg">
                            </div>
                            <span class="font-bold text-emerald-700"
                                >Success</span
                            >
                        </div>
                        <p class="text-xs text-emerald-600 font-mono">
                            emerald-500
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            Hiring badges, positive states
                        </p>
                    </div>
                    <div
                        class="p-4 bg-amber-50 rounded-xl border border-amber-200"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 bg-amber-500 rounded-lg"></div>
                            <span class="font-bold text-amber-700">Warning</span
                            >
                        </div>
                        <p class="text-xs text-amber-600 font-mono">
                            amber-500
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            Valuations, sponsor tiers
                        </p>
                    </div>
                    <div
                        class="p-4 bg-blue-50 rounded-xl border border-blue-200"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 bg-blue-500 rounded-lg"></div>
                            <span class="font-bold text-blue-700">Info</span>
                        </div>
                        <p class="text-xs text-blue-600 font-mono">blue-500</p>
                        <p class="text-xs text-gray-500 mt-1">
                            Informational badges
                        </p>
                    </div>
                    <div
                        class="p-4 bg-orange-50 rounded-xl border border-orange-200"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 bg-orange-500 rounded-lg"></div>
                            <span class="font-bold text-orange-700">YC</span>
                        </div>
                        <p class="text-xs text-orange-600 font-mono">
                            orange-500
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            Y Combinator badges
                        </p>
                    </div>
                </div>
            </div>

            <!-- Social Brand Colors -->
            <div>
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Social Brand Colors
                </h3>
                <p class="text-gray-600 mb-6">
                    Official brand colors for social media links.
                </p>
                <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
                    <div class="text-center">
                        <div
                            class="h-16 rounded-lg mb-2"
                            style="background-color: #4A154B"
                        >
                        </div>
                        <p class="text-sm font-medium">Slack</p>
                        <p class="text-xs text-gray-500 font-mono">#4A154B</p>
                    </div>
                    <div class="text-center">
                        <div
                            class="h-16 rounded-lg mb-2"
                            style="background-color: #FF6719"
                        >
                        </div>
                        <p class="text-sm font-medium">Substack</p>
                        <p class="text-xs text-gray-500 font-mono">#FF6719</p>
                    </div>
                    <div class="text-center">
                        <div class="h-16 rounded-lg mb-2 bg-black"></div>
                        <p class="text-sm font-medium">X/Twitter</p>
                        <p class="text-xs text-gray-500 font-mono">#000000</p>
                    </div>
                    <div class="text-center">
                        <div
                            class="h-16 rounded-lg mb-2"
                            style="background-color: #0085FF"
                        >
                        </div>
                        <p class="text-sm font-medium">Bluesky</p>
                        <p class="text-xs text-gray-500 font-mono">#0085FF</p>
                    </div>
                    <div class="text-center">
                        <div
                            class="h-16 rounded-lg mb-2"
                            style="background-color: #0A66C2"
                        >
                        </div>
                        <p class="text-sm font-medium">LinkedIn</p>
                        <p class="text-xs text-gray-500 font-mono">#0A66C2</p>
                    </div>
                    <div class="text-center">
                        <div
                            class="h-16 rounded-lg mb-2"
                            style="background-color: #FF0000"
                        >
                        </div>
                        <p class="text-sm font-medium">YouTube</p>
                        <p class="text-xs text-gray-500 font-mono">#FF0000</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Typography -->
        <section id="typography" class="mb-24 scroll-mt-24">
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">
                    Typography
                </h2>
                <p class="text-lg text-gray-600 max-w-3xl">
                    We use the Martian font family: Martian Grotesk for display
                    text and Martian Mono for body text and UI elements.
                </p>
            </div>

            <!-- Font Families -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Font Families
                </h3>
                <div class="grid md:grid-cols-2 gap-8">
                    <div class="p-6 bg-gray-50 rounded-xl">
                        <p class="text-sm text-gray-500 mb-2 font-mono">
                            font-display
                        </p>
                        <p
                            class="text-4xl font-display font-bold text-gray-900 mb-4"
                        >
                            Martian Grotesk
                        </p>
                        <p class="text-gray-600">
                            Used for headings, hero text, and display elements
                            where visual impact is important.
                        </p>
                    </div>
                    <div class="p-6 bg-gray-50 rounded-xl">
                        <p class="text-sm text-gray-500 mb-2 font-mono">
                            font-sans (default)
                        </p>
                        <p class="text-4xl font-sans text-gray-900 mb-4">
                            Martian Mono
                        </p>
                        <p class="text-gray-600">
                            Our default font for body text, UI elements, and
                            general content. Monospace for that dev feel.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Type Scale -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Type Scale</h3>
                <div class="space-y-6 p-6 bg-gray-50 rounded-xl">
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-5xl</span
                        >
                        <span class="text-5xl font-bold text-gray-900"
                            >Display</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-4xl</span
                        >
                        <span class="text-4xl font-bold text-gray-900"
                            >Heading 1</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-3xl</span
                        >
                        <span class="text-3xl font-bold text-gray-900"
                            >Heading 2</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-2xl</span
                        >
                        <span class="text-2xl font-bold text-gray-900"
                            >Heading 3</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-xl</span
                        >
                        <span class="text-xl font-semibold text-gray-900"
                            >Heading 4</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-lg</span
                        >
                        <span class="text-lg text-gray-900"
                            >Large body text for introductions</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-base</span
                        >
                        <span class="text-base text-gray-600"
                            >Standard body text for paragraphs and content</span
                        >
                    </div>
                    <div
                        class="flex items-baseline gap-4 pb-4 border-b border-gray-200"
                    >
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-sm</span
                        >
                        <span class="text-sm text-gray-500"
                            >Small text for captions and metadata</span
                        >
                    </div>
                    <div class="flex items-baseline gap-4">
                        <span class="text-xs text-gray-500 font-mono w-24"
                            >text-xs</span
                        >
                        <span class="text-xs text-gray-400"
                            >Extra small for badges and labels</span
                        >
                    </div>
                </div>
            </div>

            <!-- Font Weights -->
            <div>
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Font Weights
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="p-4 bg-gray-50 rounded-xl text-center">
                        <p class="text-2xl font-light text-gray-900 mb-2">
                            Light
                        </p>
                        <p class="text-xs text-gray-500 font-mono">
                            font-light (300)
                        </p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-xl text-center">
                        <p class="text-2xl font-normal text-gray-900 mb-2">
                            Regular
                        </p>
                        <p class="text-xs text-gray-500 font-mono">
                            font-normal (400)
                        </p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-xl text-center">
                        <p class="text-2xl font-semibold text-gray-900 mb-2">
                            Semibold
                        </p>
                        <p class="text-xs text-gray-500 font-mono">
                            font-semibold (600)
                        </p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-xl text-center">
                        <p class="text-2xl font-bold text-gray-900 mb-2">
                            Bold
                        </p>
                        <p class="text-xs text-gray-500 font-mono">
                            font-bold (700)
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Spacing -->
        <section id="spacing" class="mb-24 scroll-mt-24">
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Spacing</h2>
                <p class="text-lg text-gray-600 max-w-3xl">
                    Consistent spacing creates visual rhythm and hierarchy. We
                    use Tailwind's spacing scale with specific tokens for
                    sections and components.
                </p>
            </div>

            <!-- Section Spacing -->
            <div class="mb-12">
                <h3 class="text-xl font-bold text-gray-900 mb-4">
                    Section Spacing (Vertical Padding)
                </h3>
