// Define colors for different session types
const sessionColors = {
  'keynote': 'bg-gradient-to-r from-ruby-500 to-pink-500 text-white border-ruby-400',
  'panel': 'bg-gradient-to-r from-purple-500 to-indigo-500 text-white border-purple-400',
  'demos': 'bg-gradient-to-r from-green-500 to-emerald-500 text-white border-green-400',
  'break': 'bg-gradient-to-r from-sky-400 to-blue-500 text-white border-sky-400',
  'logistics': 'bg-gray-100 text-gray-700 border-gray-200',
  'talk': 'bg-white text-gray-900 border-gray-200 hover:border-ruby-300 hover:shadow-lg',
  'workshop': 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:border-emerald-300 hover:shadow-lg'
};

function getSessionColor(sessionType) {
  return sessionColors[sessionType] || 'bg-white text-gray-900 border-gray-200';
}

// Helper function to get session data
function getSessionData(session) {
  if (!session) return null;

  if (session.talkId) {
    const talkData = getTalkWithSpeaker(session.talkId);
    return {
      ...session,
      title: talkData?.title || 'TBA',
      speaker: talkData?.speaker?.name || '',
      talkData
    };
  }

  return session;
}
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
    <!-- Hero Section -->
    <section class="py-32 bg-gradient-to-b from-gray-50 to-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20">
                <div class="inline-block">
                    <a href="#schedule" class="group">
                        <h1
                            class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-gray-900 mb-4 tracking-tight transition-colors duration-300 group-hover:text-ruby-600"
                        >
                            Conference Schedule
                        </h1>
                    </a>
                    <div
                        class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
                    >
                    </div>
                </div>
                <p
                    class="mt-6 text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed font-light"
                >
                    Two days packed with inspiring talks, hands-on workshops, and networking opportunities
                </p>
            </div>


        </div>
    </section>

    <!-- Schedule Content -->
    <section id="schedule" class="py-16 bg-white relative overflow-hidden">
        <!-- Subtle background pattern -->
        <div class="absolute inset-0 opacity-5">
            <div class="absolute top-20 right-20 w-32 h-32 bg-ruby-400 rounded-full filter blur-xl"></div>
            <div class="absolute bottom-40 left-20 w-24 h-24 bg-sky-400 rounded-full filter blur-xl"></div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Day Navigation -->
            <div class="mb-16 flex justify-center">
                <div class="bg-gray-100 rounded-xl p-2 inline-flex space-x-2">
                    {days.map((day, index) => (
                        <button
                            class={`schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 ${
                                index === 0
                                    ? 'bg-ruby-500 text-white shadow-md'
                                    : 'text-gray-700 hover:bg-white hover:shadow-sm'
                            }`}
                            data-index={index}
                            style="display: block; visibility: visible;"
                        >
                            <div class="font-display font-bold">{day.dayLabel}</div>
                            <div class="text-sm opacity-90">{day.date}</div>
                        </button>
                    ))}
                </div>
            </div>

            <!-- Schedule Days -->
            <div class="space-y-8">
                {days.map((day, dayIndex) => (
                    <div
                        class="schedule-content"
                        data-index={dayIndex}
                        style={dayIndex === 0 ? "display: block; visibility: visible;" : "display: none;"}
                    >
                        <!-- Day Header -->
                        <div class="text-center mb-12">
                            <h2 class="text-3xl font-display font-bold text-gray-900 mb-2">
                                {day.dayLabel}
                            </h2>
                            <p class="text-gray-600 text-lg">{day.date}</p>
                        </div>

                        <!-- Schedule Grid -->
                        <div class="space-y-8">
                        <!-- Desktop Column Headers -->
                        <div class="hidden md:grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
                            <div class="lg:col-span-2"></div>
                            <div class="lg:col-span-10">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div class="text-center">
                                        <h4 class="font-display font-bold text-ruby-600 text-sm tracking-wide mb-2">MAIN STAGE</h4>
                                        <div class="w-8 h-0.5 bg-ruby-500 rounded-full mx-auto"></div>
                                    </div>
                                    <div class="text-center">
                                        <h4 class="font-display font-bold text-sky-600 text-sm tracking-wide mb-2">BLACKBOX THEATER</h4>
                                        <div class="w-8 h-0.5 bg-sky-500 rounded-full mx-auto"></div>
                                    </div>
                                    <div class="text-center">
                                        <h4 class="font-display font-bold text-emerald-600 text-sm tracking-wide mb-2">WORKSHOPS STUDIO</h4>
                                        <div class="w-8 h-0.5 bg-emerald-500 rounded-full mx-auto"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                            {day.sessions.map((session) => (
                                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                                    <!-- Time Column -->
                                    <div class="lg:col-span-2">
                                        <div class="text-center lg:text-left sticky top-24">
                                            <div class="font-display font-bold text-gray-900 text-xl mb-1">
                                                {session.time}
                                            </div>
                                            <div class="text-gray-500 text-sm">
                                                to {session.endTime}
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Sessions Column -->
                                    <div class="lg:col-span-10">
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                            <!-- Main Stage -->
                                            <div class="md:col-span-1">
                                                {(() => {
                                                    const sessionData = getSessionData(session.main);
                                                    if (!sessionData) return null;

                                                    return (
                                                        <div
                                                            class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 ${getSessionColor(sessionData.type)}`}
                                                            style="display: block; visibility: visible;"
                                                        >
                                                            <div class="mb-3 md:hidden">
                                                                <span class="px-3 py-1 bg-ruby-100 text-ruby-700 text-xs font-medium rounded-full">
                                                                    Main Stage
                                                                </span>
                                                            </div>
                                                            <h3 class="font-bold text-lg mb-2 leading-tight">
                                                                {sessionData.title}
                                                            </h3>
                                                            {sessionData.speaker && (
                                                                <p class="text-sm opacity-80 mb-3">
                                                                    {sessionData.speaker}
                                                                </p>
                                                            )}
                                                            {sessionData.talkData?.description && (
                                                                <p class="text-sm opacity-70 line-clamp-3">
                                                                    {sessionData.talkData.description}
                                                                </p>
                                                            )}
                                                        </div>
                                                    );
                                                })()}
                                            </div>

                                            <!-- Blackbox Theater -->
                                            <div class="md:col-span-1">
                                                {(() => {
                                                    const sessionData = getSessionData(session.track2);
                                                    if (!sessionData) return (
                                                        <div class="p-6 rounded-lg border-2 border-dashed border-gray-200 bg-gray-50 flex items-center justify-center min-h-[140px]">
                                                            <span class="text-gray-400 text-sm">No session</span>
                                                        </div>
                                                    );

                                                    return (
                                                        <div
                                                            class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 ${getSessionColor(sessionData.type)}`}
                                                            style="display: block; visibility: visible;"
                                                        >
                                                            <div class="mb-3 md:hidden">
                                                                <span class="px-3 py-1 bg-sky-100 text-sky-700 text-xs font-medium rounded-full">
                                                                    Blackbox Theater
                                                                </span>
                                                            </div>
                                                            <h3 class="font-bold text-lg mb-2 leading-tight">
                                                                {sessionData.title}
                                                            </h3>
                                                            {sessionData.speaker && (
                                                                <p class="text-sm opacity-80 mb-3">
                                                                    {sessionData.speaker}
                                                                </p>
                                                            )}
                                                            {sessionData.talkData?.description && (
                                                                <p class="text-sm opacity-70 line-clamp-3">
                                                                    {sessionData.talkData.description}
                                                                </p>
                                                            )}
                                                        </div>
                                                    );
                                                })()}
                                            </div>

                                            <!-- Workshops Studio -->
                                            <div class="md:col-span-1">
                                                {(() => {
                                                    const sessionData = getSessionData(session.workshop);
                                                    if (!sessionData) return (
                                                        <div class="p-6 rounded-lg border-2 border-dashed border-gray-200 bg-gray-50 flex items-center justify-center min-h-[140px]">
                                                            <span class="text-gray-400 text-sm">No workshop</span>
                                                        </div>
                                                    );

                                                    // Handle multiple speakers for workshops
                                                    let speakerNames = '';
                                                    if (sessionData.talkData && sessionData.talkData.speakerId) {
                                                        if (Array.isArray(sessionData.talkData.speakerId)) {
                                                            const speakersList = sessionData.talkData.speakerId.map(id => speakers?.[id]?.name).filter(Boolean);
                                                            if (speakersList.length > 1) {
                                                                speakerNames = speakersList.slice(0, -1).join(', ') + ' & ' + speakersList[speakersList.length - 1];
                                                            } else if (speakersList.length === 1) {
                                                                speakerNames = speakersList[0];
                                                            }
                                                        } else {
                                                            speakerNames = speakers?.[sessionData.talkData.speakerId]?.name || '';
                                                        }
                                                    } else if (sessionData.speaker) {
                                                        speakerNames = sessionData.speaker;
                                                    }

                                                    return (
                                                        <div
                                                            class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 ${getSessionColor(sessionData.type)}`}
                                                            style="display: block; visibility: visible;"
                                                        >
                                                            <div class="mb-3 md:hidden">
                                                                <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-medium rounded-full">
                                                                    Workshops Studio
                                                                </span>
                                                            </div>
                                                            <h3 class="font-bold text-lg mb-2 leading-tight">
                                                                {sessionData.title}
                                                            </h3>
                                                            {speakerNames && (
                                                                <p class="text-sm opacity-80 mb-3">
                                                                    {speakerNames}
                                                                </p>
                                                            )}
                                                            {sessionData.talkData?.description && (
                                                                <p class="text-sm opacity-70 line-clamp-3 mb-4">
                                                                    {sessionData.talkData.description}
                                                                </p>
                                                            )}
                                                            {sessionData.talkData?.lumaId && (
                                                                <a
                                                                    href={`https://lu.ma/${sessionData.talkData.lumaId}`}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                    class="inline-block px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 transition-colors duration-200"
                                                                >
                                                                    Sign Up
                                                                </a>
                                                            )}
                                                        </div>
                                                    );
                                                })()}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                ))}
            </div>

            <!-- Schedule Notes -->
            <div class="mt-16 bg-gray-50 rounded-xl p-8">
                <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">
                    Important Notes
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-600">
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">📍 Location</h4>
                        <p>Fort Mason Center for Arts & Culture<br/>2 Marina Blvd, San Francisco, CA 94123</p>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">🎫 Workshops</h4>
                        <p>Separate registration required for hands-on workshops. Limited capacity.</p>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">☕ Refreshments</h4>
                        <p>Coffee, lunch, and snacks are included with your conference ticket.</p>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-2">📱 Updates</h4>
                        <p>Follow <a href="https://x.com/sfruby" class="text-ruby-600 hover:text-ruby-700">@sfruby</a> for any schedule changes or announcements.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-gradient-to-r from-ruby-500 to-pink-500">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h3 class="text-3xl font-display font-bold text-white mb-4">
                Ready to Join Us?
            </h3>
            <p class="text-xl text-ruby-100 mb-8">
                Don't miss out on two incredible days of Ruby learning and networking
            </p>
            <a
                href="https://lu.ma/sfrubyconf2025"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-10 py-4 bg-white text-ruby-600 rounded-xl font-semibold shadow-xl transition-all duration-300 transform hover:shadow-2xl hover:scale-105"
            >
                <span class="mr-2">Get Your Ticket</span>
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                    ></path>
                </svg>
            </a>
        </div>
    </section>
</Layout>

<script>
    // Handle tab switching
    const tabs = document.querySelectorAll('.schedule-tab');
    const contents = document.querySelectorAll('.schedule-content');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            // Update tab styling
            tabs.forEach(t => {
                t.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 text-gray-700 hover:bg-white hover:shadow-sm';
            });

            tab.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 bg-ruby-500 text-white shadow-md';

            // Show selected content
            const index = tab.getAttribute('data-index');
            contents.forEach(content => {
                if (content.getAttribute('data-index') === index) {
                    content.style.display = 'block';
                    content.style.visibility = 'visible';
                } else {
                    content.style.display = 'none';
                }
            });
        });
    });

    // Smooth scroll for anchor links
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener("click", function (e) {
                e.preventDefault();
                const href = this.getAttribute("href");
                if (href && href !== "#") {
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({
                            behavior: "smooth",
                            block: "start",
                        });
                    }
                }
            });
        });
    });
</script>

<style>
    /* Ensure proper display */
    .schedule-tab,
    .schedule-content {
        visibility: visible !important;
    }

    /* Line clamp utility for text truncation */
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Smooth transitions */
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>
