        background: linear-gradient(to right, oklch(0.5325 0.1109 183.03), oklch(0.633 0.0862 189.64));
        border-color: oklch(0.5325 0.1109 183.03) !important;
    }

    .gitbutler-gradient * {
        color: white !important;
    }

    /* Sticky day navigation styles - always sticky */
    .sticky-day-nav {
