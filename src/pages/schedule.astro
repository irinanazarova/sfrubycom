        track2: null, 
        workshop: null 
      }
    ]
  }
];

// Define colors for different session types
const sessionColors = {
  'keynote': 'bg-ruby-500 text-white',
  'panel': 'bg-purple-500 text-white',
  'demos': 'bg-green-500 text-white',
  'break': 'bg-sky-500 text-white',
  'logistics': 'bg-cloud-600 text-white',
  'talk': 'bg-white text-dark-700 border border-dark-200',
  'workshop': 'bg-emerald-100 text-emerald-800 border border-emerald-200'
};

function getSessionColor(sessionType) {
  return sessionColors[sessionType] || 'bg-white text-dark-700 border border-dark-200';
}

// Helper function to get session data
function getSessionData(session) {
  if (!session) return null;
  
  if (session.talkId) {
    const talkData = getTalkWithSpeaker(session.talkId);
    return {
      ...session,
      title: talkData?.title || 'TBA',
      speaker: talkData?.speaker?.name || '',
      talkData
    };
  }
  
  return session;
}
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Schedule</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Two days of Ruby excellence across three venues at Fort Mason
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Venue Overview Cards -->
    <div class="mb-16">
      <h2 class="text-3xl font-display font-bold text-dark-900 mb-8 text-center">Conference Venues</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl shadow-lg p-8 text-center border-t-4 border-ruby-500 transform transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-ruby-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🎤</span>
          </div>
          <h3 class="font-bold text-ruby-600 mb-3 text-xl">Main Stage</h3>
          <p class="text-dark-600">Keynotes and featured presentations</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-8 text-center border-t-4 border-sky-500 transform transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🎭</span>
          </div>
          <h3 class="font-bold text-sky-600 mb-3 text-xl">Blackbox Theater</h3>
          <p class="text-dark-600">Technical talks and specialized sessions</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-8 text-center border-t-4 border-emerald-500 transform transition-all duration-300 hover:-translate-y-2">
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🛠️</span>
          </div>
          <h3 class="font-bold text-emerald-600 mb-3 text-xl">Workshops Studio</h3>
          <p class="text-dark-600">Hands-on learning experiences</p>
        </div>
      </div>
    </div>

    <!-- Day Navigation -->
    <div class="mb-12 flex justify-center">
      <div class="bg-white rounded-xl shadow-lg p-2 inline-flex space-x-2">
        {days.map((day, index) => (
          <button 
            class={`schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none ${
              index === 0 
                ? 'bg-ruby-500 text-white shadow-md transform scale-105' 
                : 'text-dark-700 hover:bg-dark-50'
            }`}
            data-index={index}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            <div class="font-bold">{day.dayLabel}</div>
            <div class="text-sm opacity-90">{day.date}</div>
          </button>
        ))}
      </div>
    </div>
    
    <!-- Schedule Content -->
    <div class="space-y-8">
      {days.map((day, dayIndex) => (
        <div 
          class="schedule-content" 
          data-index={dayIndex}
          style={dayIndex === 0 ? "" : "display: none;"}
        >
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <!-- Day Header -->
            <div class="bg-gradient-to-r from-ruby-500 to-ruby-600 text-white px-8 py-6">
              <h3 class="text-2xl font-display font-bold">{day.dayLabel}</h3>
              <p class="text-ruby-100 mt-1">{day.date}</p>
            </div>
            
            <!-- Schedule Grid Header -->
            <div class="px-8 py-4 bg-dark-50 border-b border-dark-200">
              <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 md:col-span-2">
                  <h4 class="font-bold text-dark-700 text-sm">TIME</h4>
                </div>
                <div class="col-span-12 md:col-span-4">
                  <h4 class="font-bold text-ruby-600 text-sm">MAIN STAGE</h4>
                </div>
                <div class="col-span-12 md:col-span-3">
                  <h4 class="font-bold text-sky-600 text-sm">BLACKBOX THEATER</h4>
                </div>
                <div class="col-span-12 md:col-span-3">
                  <h4 class="font-bold text-emerald-600 text-sm">WORKSHOPS STUDIO</h4>
                </div>
              </div>
            </div>
            
            <!-- Schedule Grid -->
            <div class="p-8">
              <div class="space-y-6">
                {day.sessions.map((session, index) => (
                  <div class="grid grid-cols-12 gap-6 items-start py-4 border-b border-dark-100 last:border-b-0">
                    <!-- Time Column -->
                    <div class="col-span-12 md:col-span-2">
                      <div class="text-center md:text-left">
                        <div class="font-bold text-dark-900 text-lg">{session.time}</div>
                        <div class="text-dark-500 text-sm">to {session.endTime}</div>
                      </div>
                    </div>
                    
                    <!-- Main Stage -->
                    <div class="col-span-12 md:col-span-4">
                      {(() => {
                        const sessionData = getSessionData(session.main);
                        if (!sessionData) return null;
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-medium text-sm mb-1">{sessionData.title}</div>
                            {sessionData.speaker && (
                              <div class="text-xs opacity-75">{sessionData.speaker}</div>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                    
                    <!-- Blackbox Theater -->
                    <div class="col-span-12 md:col-span-3">
                      {(() => {
                        const sessionData = getSessionData(session.track2);
                        if (!sessionData) return null;
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-medium text-sm mb-1">{sessionData.title}</div>
                            {sessionData.speaker && (
                              <div class="text-xs opacity-75">{sessionData.speaker}</div>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                    
                    <!-- Workshops Studio -->
                    <div class="col-span-12 md:col-span-3">
                      {(() => {
                        const sessionData = getSessionData(session.workshop);
                        if (!sessionData) return null;
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-medium text-sm mb-1">{sessionData.title}</div>
                            {sessionData.speaker && (
                              <div class="text-xs opacity-75 mb-2">{sessionData.speaker}</div>
                            )}
                            {sessionData.talkData?.lumaId && (
                              <a
                                href={`https://lu.ma/${sessionData.talkData.lumaId}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block px-3 py-1 bg-emerald-500 text-white text-xs font-medium rounded-md hover:bg-emerald-600 transition-colors duration-200"
                                onclick="event.stopPropagation()"
                              >
                                Sign Up
                              </a>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Talk Details Modal -->
    <div id="talkModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b border-dark-200 px-6 py-4 flex justify-between items-center">
          <h3 class="text-xl font-bold text-dark-900" id="modalTitle">Talk Details</h3>
          <button onclick="closeTalkModal()" class="text-dark-400 hover:text-dark-600 text-2xl">
            ×
          </button>
        </div>
        
        <div class="p-6">
          <div id="modalContent">
            <!-- Content will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>
    
    <!-- Schedule Notes -->
    <div class="mt-16 bg-dark-50 rounded-xl p-8">
      <h3 class="text-2xl font-display font-bold text-dark-900 mb-6 text-center">Important Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center mr-3">
              <span class="text-emerald-600">🎫</span>
            </div>
            <h4 class="font-bold text-dark-900">Workshop Registration</h4>
          </div>
          <p class="text-dark-600">
            Workshops have limited capacity and require separate registration via Luma. Click the "Sign Up" button for each workshop you'd like to attend.
          </p>
        </div>
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-3">
              <span class="text-amber-600">📍</span>
            </div>
            <h4 class="font-bold text-dark-900">Venue Locations</h4>
          </div>
          <p class="text-dark-600">
            All three venues are located within Fort Mason Center. Maps and directions will be provided at registration.
          </p>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="mt-16 text-center bg-gradient-to-r from-ruby-500 to-ruby-700 text-white rounded-xl p-12">
      <h3 class="text-3xl font-display font-bold mb-4">Ready to Join Us?</h3>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Don't miss out on two days of Ruby excellence across three venues at Fort Mason Center.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://lu.ma/sfrubyconf2025"
          target="_blank"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-ruby-600 rounded-lg font-medium shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl"
        >
          Get Tickets
        </a>
        <a 
          href="/#newsletter"
          class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white rounded-lg font-medium transition-all duration-300 transform hover:scale-105 hover:bg-white hover:text-ruby-600"
        >
          Sign up for updates
        </a>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ talks }}>
  // Handle tab switching
  const tabs = document.querySelectorAll('.schedule-tab');
  const contents = document.querySelectorAll('.schedule-content');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tab styling
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none text-dark-700 hover:bg-dark-50';
      });
      
      tab.setAttribute('aria-selected', 'true');
      tab.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none bg-ruby-500 text-white shadow-md transform scale-105';
      
      // Show selected content
      const index = tab.getAttribute('data-index');
      contents.forEach(content => {
        content.style.display = content.getAttribute('data-index') === index ? '' : 'none';
      });
    });
  });
  
  // Talk modal functionality
  function openTalkModal(talkId) {
    const talk = talks[talkId];
    if (!talk) return;
    
    const modal = document.getElementById('talkModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalContent = document.getElementById('modalContent');
    
    modalTitle.textContent = talk.title;
    
    // Get speaker data from the global speakers object
    const speakerData = window.speakersData?.[talk.speakerId];
    
    modalContent.innerHTML = `
      <div class="mb-6">
        <h4 class="text-lg font-bold text-dark-900 mb-2">${talk.title}</h4>
        <div class="flex items-center gap-4 mb-4">
          <span class="px-3 py-1 bg-ruby-100 text-ruby-800 rounded-full text-sm font-medium">
            ${talk.type.charAt(0).toUpperCase() + talk.type.slice(1)}
          </span>
          <span class="text-dark-500 text-sm">
            Day ${talk.day} • ${talk.time} - ${talk.endTime}
          </span>
        </div>
        <p class="text-dark-700 leading-relaxed">${talk.description}</p>
      </div>
      
      ${speakerData ? `
        <div class="border-t border-dark-200 pt-6">
          <h5 class="font-bold text-dark-900 mb-4">About the Speaker</h5>
          <div class="flex items-start gap-4">
            <img 
              src="${speakerData.image}" 
              alt="${speakerData.name}"
              class="w-16 h-16 rounded-full object-cover"
            />
            <div class="flex-1">
              <h6 class="font-bold text-dark-900">${speakerData.name}</h6>
              <p class="text-ruby-500 text-sm mb-2">${speakerData.company}</p>
              <p class="text-dark-600 text-sm">${speakerData.bio}</p>
            </div>
          </div>
        </div>
      ` : ''}
      
      ${talk.lumaId ? `
        <div class="mt-6 text-center">
          <a
            href="https://lu.ma/${talk.lumaId}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-emerald-500 text-white font-medium rounded-lg hover:bg-emerald-600 transition-colors duration-200"
          >
            Sign Up for Workshop
          </a>
        </div>
      ` : ''}
    `;
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  
  function closeTalkModal() {
    const modal = document.getElementById('talkModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }
  
  // Close modal when clicking outside
  document.getElementById('talkModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      closeTalkModal();
    }
  });
  
  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeTalkModal();
    }
  });
  
  // Make functions globally accessible
  window.openTalkModal = openTalkModal;
  window.closeTalkModal = closeTalkModal;
</script>

<script>
  // Import speaker data for the modal
  import { speakers } from '../data/speakers.js';
  window.speakersData = speakers;
</script>
                          )}
                        </div>
                      )}
                    </div>
                    
                    <!-- Blackbox Theater -->
                    <div class="col-span-12 md:col-span-3">
                      {session.track2 && (
                        <div class={`p-4 rounded-lg ${getSessionColor(session.track2.type)}`}>
