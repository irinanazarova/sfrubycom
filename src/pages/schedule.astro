        main: { talkId: 'ruby-security', type: 'talk' }, 
        track2: { talkId: 'database-optimization', type: 'talk' }, 
        workshop: { talkId: 'metaprogramming-workshop', type: 'workshop' }
      },
      { 
        time: '2:45 PM', 
        endTime: '3:15 PM',
        main: { talkId: 'building-developer-tools', type: 'talk' }, 
        track2: { talkId: 'microservices-architecture', type: 'talk' }, 
        workshop: { talkId: 'metaprogramming-workshop', type: 'workshop' }
      },
      { 
        time: '3:30 PM', 
        endTime: '4:00 PM',
        main: { talkId: 'ruby-concurrency', type: 'talk' }, 
        track2: { talkId: 'graphql-best-practices', type: 'talk' }, 
        workshop: { talkId: 'metaprogramming-workshop', type: 'workshop' }
      },
      { 
        time: '4:15 PM', 
        endTime: '4:45 PM',
        main: { talkId: 'ruby-modern-startups', type: 'keynote' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '5:00 PM', 
        endTime: '6:00 PM',
        main: { title: 'CTO Panel: Scaling Engineering Teams', speaker: 'Edward Kim, Ngan Pham & More', type: 'panel' }, 
        track2: null, 
        workshop: null 
      }
    ]
  },
  {
    date: 'November 20, 2025',
    dayLabel: 'Day 2',
    sessions: [
      { 
        time: '9:00 AM', 
        endTime: '9:10 AM',
        main: { title: 'Day 2 Welcome & Announcements', speaker: '', type: 'logistics' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '9:25 AM', 
        endTime: '9:55 AM',
        main: { talkId: 'art-of-ruby', type: 'keynote' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '10:10 AM', 
        endTime: '10:40 AM',
        main: { talkId: 'rails-8-whats-new', type: 'talk' }, 
        track2: { talkId: 'background-jobs-scale', type: 'talk' }, 
        workshop: { talkId: 'inertia-rails-workshop', type: 'workshop' }
      },
      { 
        time: '10:55 AM', 
        endTime: '11:25 AM',
        main: { talkId: 'ruby-gems-building', type: 'talk' }, 
        track2: { talkId: 'debugging-ruby', type: 'talk' }, 
        workshop: { talkId: 'inertia-rails-workshop', type: 'workshop' }
      },
      { 
        time: '11:40 AM', 
        endTime: '12:10 PM',
        main: { talkId: 'machine-learning-ruby', type: 'talk' }, 
        track2: { talkId: 'code-review-practices', type: 'talk' }, 
        workshop: { talkId: 'inertia-rails-workshop', type: 'workshop' }
      },
      { 
        time: '12:25 PM', 
        endTime: '2:00 PM',
        main: { title: 'Lunch Break & Networking', speaker: '', type: 'break' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '2:00 PM', 
        endTime: '2:30 PM',
        main: { talkId: 'ruby-cloud-deployment', type: 'talk' }, 
        track2: { talkId: 'api-design-ruby', type: 'talk' }, 
        workshop: { title: 'TBA', speaker: '', type: 'workshop' }
      },
      { 
        time: '2:45 PM', 
        endTime: '3:15 PM',
        main: { talkId: 'open-source-sustainability', type: 'talk' }, 
        track2: { talkId: 'ruby-memory-management', type: 'talk' }, 
        workshop: { title: 'TBA', speaker: '', type: 'workshop' }
      },
      { 
        time: '3:30 PM', 
        endTime: '5:00 PM',
        main: { title: 'Startup Demo Showcase', speaker: 'Various Founders', type: 'demos' }, 
        track2: null, 
        workshop: { title: 'TBA', speaker: '', type: 'workshop' }
      },
      { 
        time: '5:15 PM', 
        endTime: '5:45 PM',
        main: { title: 'VC Panel: Funding Ruby Startups', speaker: 'Industry VCs', type: 'panel' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '6:00 PM', 
        endTime: '6:30 PM',
        main: { talkId: 'closing-keynote', type: 'keynote' }, 
        track2: null, 
        workshop: null 
      }
    ]
  }
];

// Define colors for different session types
const sessionColors = {
  'keynote': 'bg-ruby-500 text-white',
  'panel': 'bg-purple-500 text-white',
  'demos': 'bg-green-500 text-white',
  'break': 'bg-sky-500 text-white',
  'logistics': 'bg-cloud-600 text-white',
  'talk': 'bg-white text-dark-700 border border-dark-200',
  'workshop': 'bg-emerald-100 text-emerald-800 border border-emerald-200'
};

function getSessionColor(sessionType) {
  return sessionColors[sessionType] || 'bg-white text-dark-700 border border-dark-200';
}

// Helper function to get session data
function getSessionData(session) {
  if (!session) return null;
  
  if (session.talkId) {
    const talkData = getTalkWithSpeaker(session.talkId);
    return {
      ...session,
      title: talkData?.title || 'TBA',
      speaker: talkData?.speaker?.name || '',
      talkData
    };
  }
  
  return session;
}
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Schedule</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Two days and three tracks at Fort Mason, San Francisco
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Day Navigation -->
    <div class="mb-12 flex justify-center">
      <div class="bg-white rounded-xl shadow-lg p-2 inline-flex space-x-2">
        {days.map((day, index) => (
          <button 
            class={`schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none ${
              index === 0 
                ? 'bg-ruby-500 text-white shadow-md transform scale-105' 
                : 'text-dark-700 hover:bg-dark-50'
            }`}
            data-index={index}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            <div class="font-display font-bold">{day.dayLabel}</div>
            <div class="text-sm opacity-90">{day.date}</div>
          </button>
        ))}
      </div>
    </div>
    
    <!-- Schedule Content -->
    <div class="space-y-8">
      {days.map((day, dayIndex) => (
        <div 
          class="schedule-content" 
          data-index={dayIndex}
          style={dayIndex === 0 ? "" : "display: none;"}
        >
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <!-- Day Header -->
            <div class="bg-gradient-to-r from-ruby-500 to-ruby-600 text-white px-8 py-6">
              <h3 class="text-2xl font-display font-bold">{day.dayLabel}</h3>
              <p class="text-ruby-100 mt-1">{day.date}</p>
            </div>
            
            <!-- Schedule Grid Header -->
            <div class="px-8 py-4 bg-dark-50 border-b border-dark-200">
              <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 md:col-span-2">
                  <h4 class="font-display font-bold text-dark-700 text-sm tracking-wide">TIME</h4>
                </div>
                <div class="col-span-12 md:col-span-4">
                  <h4 class="font-display font-bold text-ruby-600 text-sm tracking-wide">MAIN STAGE</h4>
                </div>
                <div class="col-span-12 md:col-span-3">
                  <h4 class="font-display font-bold text-sky-600 text-sm tracking-wide">BLACKBOX THEATER</h4>
                </div>
                <div class="col-span-12 md:col-span-3">
                  <h4 class="font-display font-bold text-emerald-600 text-sm tracking-wide">WORKSHOPS STUDIO</h4>
                </div>
              </div>
            </div>
            
            <!-- Schedule Grid -->
            <div class="p-8">
              <div class="space-y-6">
                {day.sessions.map((session, index) => (
                  <div class="grid grid-cols-12 gap-6 items-start py-4 border-b border-dark-100 last:border-b-0">
                    <!-- Time Column -->
                    <div class="col-span-12 md:col-span-2">
                      <div class="text-center md:text-left">
                        <div class="font-display font-bold text-dark-900 text-lg">{session.time}</div>
                        <div class="text-dark-500 text-sm">to {session.endTime}</div>
                      </div>
                    </div>
                    
                    <!-- Main Stage -->
                    <div class="col-span-12 md:col-span-4">
                      {(() => {
                        const sessionData = getSessionData(session.main);
                        if (!sessionData) return null;
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-display font-medium text-sm mb-1">{sessionData.title}</div>
                            {sessionData.speaker && (
                              <div class="text-xs opacity-75">{sessionData.speaker}</div>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                    
                    <!-- Blackbox Theater -->
                    <div class="col-span-12 md:col-span-3">
                      {(() => {
                        const sessionData = getSessionData(session.track2);
                        if (!sessionData) return null;
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-display font-medium text-sm mb-1">{sessionData.title}</div>
                            {sessionData.speaker && (
                              <div class="text-xs opacity-75">{sessionData.speaker}</div>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                    
                    <!-- Workshops Studio -->
                    <div class="col-span-12 md:col-span-3">
                      {(() => {
                        const sessionData = getSessionData(session.workshop);
                        if (!sessionData) return null;
                        
                        // Handle multiple speakers
                        let speakerNames = '';
                        if (sessionData.talkData && sessionData.talkData.speakerId) {
                          if (Array.isArray(sessionData.talkData.speakerId)) {
                            // Multiple speakers
                            const speakersList = sessionData.talkData.speakerId.map(id => speakers?.[id]?.name).filter(Boolean);
                            if (speakersList.length > 1) {
                              speakerNames = speakersList.slice(0, -1).join(', ') + ' & ' + speakersList[speakersList.length - 1];
                            } else if (speakersList.length === 1) {
                              speakerNames = speakersList[0];
                            }
                          } else {
                            // Single speaker
                            speakerNames = speakers?.[sessionData.talkData.speakerId]?.name || '';
                          }
                        } else if (sessionData.speaker) {
                          speakerNames = sessionData.speaker;
                        }
                        
                        return (
                          <div 
                            class={`p-4 rounded-lg cursor-pointer transition-all duration-200 hover:shadow-md ${getSessionColor(sessionData.type)}`}
                            onclick={sessionData.talkData ? `openTalkModal('${sessionData.talkData.id}')` : ''}
                          >
                            <div class="font-display font-medium text-sm mb-1">{sessionData.title}</div>
                            {speakerNames && (
                              <div class="text-xs opacity-75 mb-2">{speakerNames}</div>
                            )}
                            {sessionData.talkData?.lumaId && (
                              <a
                                href={`https://lu.ma/${sessionData.talkData.lumaId}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-block px-3 py-1 bg-emerald-500 text-white text-xs font-medium rounded-md hover:bg-emerald-600 transition-colors duration-200"
                                onclick="event.stopPropagation()"
                              >
                                Sign Up
                              </a>
                            )}
                          </div>
                        );
                      })()}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Talk Details Modal -->
    <div id="talkModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b border-dark-200 px-6 py-4 flex justify-between items-center">
          <h3 class="text-xl font-bold text-dark-900" id="modalTitle">Talk Details</h3>
          <button onclick="closeTalkModal()" class="text-dark-400 hover:text-dark-600 text-2xl">
            ×
          </button>
        </div>
        
        <div class="p-6">
          <div id="modalContent">
            <!-- Content will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>
    
    <!-- Schedule Notes -->
    <div class="mt-16 bg-dark-50 rounded-xl p-8">
      <h3 class="text-2xl font-display font-bold text-dark-900 mb-6 text-center">Important Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center mr-3">
              <span class="text-emerald-600">🎫</span>
            </div>
            <h4 class="font-display font-bold text-dark-900">Workshop Registration</h4>
          </div>
          <p class="text-dark-600">
            Workshops have limited capacity and require separate registration via Luma. Click the "Sign Up" button for each workshop you'd like to attend.
          </p>
        </div>
        <div class="bg-white rounded-lg p-6 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-3">
              <span class="text-amber-600">📍</span>
            </div>
            <h4 class="font-display font-bold text-dark-900">Venue Locations</h4>
          </div>
          <p class="text-dark-600">
            All three venues are located within Fort Mason Center. Maps and directions will be provided at registration.
          </p>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="mt-16 text-center bg-gradient-to-r from-ruby-500 to-ruby-700 text-white rounded-xl p-12">
      <h3 class="text-3xl font-display font-bold mb-4">Ready to Join Us?</h3>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Don't miss out on two days of Ruby excellence across three venues at Fort Mason Center.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://lu.ma/sfrubyconf2025"
          target="_blank"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-ruby-600 rounded-lg font-medium shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl"
        >
          Get Tickets
        </a>
        <a 
          href="/#newsletter"
          class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white rounded-lg font-medium transition-all duration-300 transform hover:scale-105 hover:bg-white hover:text-ruby-600"
        >
          Sign up for updates
        </a>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ talks, speakers }} client:load>
  // Handle tab switching
  const tabs = document.querySelectorAll('.schedule-tab');
  const contents = document.querySelectorAll('.schedule-content');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tab styling
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none text-dark-700 hover:bg-dark-50';
      });
      
      tab.setAttribute('aria-selected', 'true');
      tab.className = 'schedule-tab px-8 py-4 rounded-lg font-medium transition-all duration-300 focus:outline-none bg-ruby-500 text-white shadow-md transform scale-105';
      
      // Show selected content
      const index = tab.getAttribute('data-index');
      contents.forEach(content => {
        content.style.display = content.getAttribute('data-index') === index ? '' : 'none';
      });
    });
  });
  
  // Talk modal functionality
  function openTalkModal(talkId) {
    const talk = talks[talkId];
    if (!talk) return;
    
    const modal = document.getElementById('talkModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalContent = document.getElementById('modalContent');
    
    modalTitle.textContent = talk.title;
    
    // Get speaker data from the global speakers object
    const speakerData = speakers?.[talk.speakerId];
    
    // Determine location based on track
    let location = '';
    let locationColor = '';
    if (talk.track === 'main') {
      location = 'Main Stage';
      locationColor = 'bg-ruby-100 text-ruby-800';
    } else if (talk.track === 'blackbox') {
      location = 'Blackbox Theater';
      locationColor = 'bg-sky-100 text-sky-800';
    } else if (talk.track === 'workshop') {
      location = 'Workshops Studio';
      locationColor = 'bg-emerald-100 text-emerald-800';
    }
    
    modalContent.innerHTML = `
      <div class="mb-6">
        <div class="flex items-center gap-4 mb-4">
          <span class="px-3 py-1 ${locationColor} rounded-full text-sm font-medium">
            ${location}
          </span>
          <span class="text-dark-500 text-sm">
            Day ${talk.day} • ${talk.time} - ${talk.endTime}
          </span>
        </div>
        <p class="text-dark-700 leading-relaxed">${talk.description}</p>
      </div>
      
      ${(() => {
        // Handle multiple speakers
        if (Array.isArray(talk.speakerId)) {
          const speakersList = talk.speakerId.map(id => speakers?.[id]).filter(Boolean);
          if (speakersList.length === 0) return '';
          
          return `
            <div class="border-t border-dark-200 pt-6">
              <h5 class="font-bold text-dark-900 mb-4">About the Speaker${speakersList.length > 1 ? 's' : ''}</h5>
              <div class="space-y-6">
                ${speakersList.map(speaker => `
                  <div class="flex items-start gap-4">
                    <img 
                      src="${speaker.image}" 
                      alt="${speaker.name}"
                      class="w-16 h-16 rounded-full object-cover"
                    />
                    <div class="flex-1">
                      <h6 class="font-bold text-dark-900">${speaker.name}</h6>
                      <p class="text-ruby-500 text-sm mb-2">${speaker.company}</p>
                      <p class="text-dark-600 text-sm">${speaker.bio}</p>
                      ${speaker.socials && speaker.socials.length > 0 ? `
                        <div class="flex items-center gap-3 mt-3">
                          <div id="social-links-${speaker.id || speaker.name.replace(/\\s+/g, '-').toLowerCase()}"></div>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                `).join('')}
                
                <!-- Render social links after DOM is ready -->
                <script>
                  ${speakersList.map(speaker => `
                    if (document.getElementById('social-links-${speaker.id || speaker.name.replace(/\\s+/g, '-').toLowerCase()}')) {
                      ${speaker.socials ? speaker.socials.map(url => `
                        const link${speaker.id || speaker.name.replace(/\\s+/g, '')}${speaker.socials.indexOf(url)} = document.createElement('div');
                        link${speaker.id || speaker.name.replace(/\\s+/g, '')}${speaker.socials.indexOf(url)}.innerHTML = \`<astro-island uid="social-link-${speaker.id || speaker.name.replace(/\\s+/g, '-').toLowerCase()}-${speaker.socials.indexOf(url)}" component-url="/_astro/SocialLink.astro" component-export="default" renderer-url="/_astro/client.js" props='{"url":"${url}"}' ssr="" client="load" opts='{"name":"SocialLink","value":true}' await-children=""><a href="${url}" target="_blank" rel="noopener noreferrer" class="text-dark-400 hover:text-ruby-500 transition-colors duration-200" style="margin-right: 0.5rem;"></a></astro-island>\`;
                        document.getElementById('social-links-${speaker.id || speaker.name.replace(/\\s+/g, '-').toLowerCase()}').appendChild(link${speaker.id || speaker.name.replace(/\\s+/g, '')}${speaker.socials.indexOf(url)});
                      `).join('') : ''}
                    }
                  `).join('')}
                </script>
              </div>
            </div>
          `;
        } else {
          // Single speaker
          const speakerData = speakers?.[talk.speakerId];
          if (!speakerData) return '';
          
          return `
        <div class="border-t border-dark-200 pt-6">
          <h5 class="font-bold text-dark-900 mb-4">About the Speaker</h5>
          <div class="flex items-start gap-4">
            <img 
              src="${speakerData.image}" 
              alt="${speakerData.name}"
              class="w-16 h-16 rounded-full object-cover"
            />
            <div class="flex-1">
              <h6 class="font-bold text-dark-900">${speakerData.name}</h6>
              <p class="text-ruby-500 text-sm mb-2">${speakerData.company}</p>
              <p class="text-dark-600 text-sm">${speakerData.bio}</p>
              ${speakerData.socials && speakerData.socials.length > 0 ? `
                <div class="flex items-center gap-3 mt-3">
                  ${speakerData.socials.map(url => {
                    let icon = '';
                    let label = '';
                    
                    if (url.includes('github.com')) {
