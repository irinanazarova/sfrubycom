        track2: { talkId: 'advanced-testing', type: 'talk' }, 
        workshop: { talkId: 'building-modern-rails-apis', type: 'workshop' }
      },
      { 
        time: '11:50 AM', 
        endTime: '12:20 PM',
        main: { talkId: 'ruby-production-patterns', type: 'talk' }, 
        track2: { talkId: 'hotwire-stimulus', type: 'talk' }, 
