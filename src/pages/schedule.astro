  {
    date: 'November 19, 2025',
    dayLabel: 'Day 1',
    sessions: [
      { 
        time: '8:00 AM', 
        endTime: '',
        main: { title: 'Doors Open & Registration', speaker: '', type: 'logistics' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '9:00 AM', 
        endTime: '9:20 AM',
        main: { title: 'Welcome & Opening Remarks', speaker: '', type: 'logistics' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '9:35 AM', 
        endTime: '10:05 AM',
        main: { talkId: 'future-of-ruby', type: 'keynote' }, 
        track2: null, 
        workshop: null 
      },
      { 
        time: '10:20 AM', 
        endTime: '10:50 AM',
