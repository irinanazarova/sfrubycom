          <!-- Render social links after DOM is ready -->
          <script>
            if (document.getElementById('social-links-${speakerData.id || speakerData.name.replace(/\\s+/g, '-').toLowerCase()}')) {
              ${speakerData.socials ? speakerData.socials.map(url => `
                const link${speakerData.id || speakerData.name.replace(/\\s+/g, '')}${speakerData.socials.indexOf(url)} = document.createElement('div');
                link${speakerData.id || speakerData.name.replace(/\\s+/g, '')}${speakerData.socials.indexOf(url)}.innerHTML = \`<astro-island uid="social-link-${speakerData.id || speakerData.name.replace(/\\s+/g, '-').toLowerCase()}-${speakerData.socials.indexOf(url)}" component-url="/_astro/SocialLink.astro" component-export="default" renderer-url="/_astro/client.js" props='{"url":"${url}"}' ssr="" client="load" opts='{"name":"SocialLink","value":true}' await-children=""><a href="${url}" target="_blank" rel="noopener noreferrer" class="text-dark-400 hover:text-ruby-500 transition-colors duration-200" style="margin-right: 0.5rem;"></a></astro-island>\`;
                document.getElementById('social-links-${speakerData.id || speakerData.name.replace(/\\s+/g, '-').toLowerCase()}').appendChild(link${speakerData.id || speakerData.name.replace(/\\s+/g, '')}${speakerData.socials.indexOf(url)});
