            top: 4rem; /* Slightly less on mobile - 64px */
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }

        .sticky-day-nav .schedule-tab {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
        }

        .sticky-day-nav .schedule-tab div:first-child {
