---
import Layout from '../layouts/Layout.astro';

const days = [
  {
    date: 'November 19, 2025',
    sessions: [
      { time: '8:00 AM - 9:00 AM', title: 'Registration & Breakfast', track: null },
      { time: '9:00 AM - 9:30 AM', title: 'Welcome & Opening Remarks', track: null },
      { time: '9:30 AM - 10:30 AM', title: 'Keynote: The Future of Ruby in the AI Era', speaker: 'Andrew Kane', track: null },
      { time: '10:45 AM - 11:30 AM', title: 'Building AI-Powered Rails Apps with ActiveAgent', speaker: 'Sarah Chen', track: 'Open Source & AI' },
      { time: '10:45 AM - 11:30 AM', title: 'Scaling Ruby at Stripe: Lessons Learned', speaker: 'Miguel Rodriguez', track: 'Scaling Ruby' },
      { time: '11:45 AM - 12:30 PM', title: 'RubyLLM: Bringing Large Language Models to Ruby', speaker: 'Aisha Johnson', track: 'Open Source & AI' },
      { time: '11:45 AM - 12:30 PM', title: 'Using Sorbet & Packwerk for Large Codebases', speaker: 'James Wilson', track: 'Scaling Ruby' },
      { time: '12:30 PM - 2:00 PM', title: 'Lunch & Networking', track: null },
      { time: '2:00 PM - 3:30 PM', title: 'Startup Demo Showcase (10-minute sessions)', track: 'Startup Demos' },
      { time: '3:45 PM - 4:30 PM', title: 'VC Panel: Why Ruby Wins in AI', track: 'VC Insights' },
      { time: '4:45 PM - 5:30 PM', title: 'Lightning Talks', track: null },
      { time: '6:00 PM - 8:00 PM', title: 'Evening Reception', track: null }
    ]
  },
  {
    date: 'November 20, 2025',
    sessions: [
      { time: '8:30 AM - 9:30 AM', title: 'Breakfast & Morning Networking', track: null },
      { time: '9:30 AM - 10:30 AM', title: 'Keynote: Ruby Beyond 4.0', speaker: 'Emma Thompson', track: null },
      { time: '10:45 AM - 11:30 AM', title: 'Performance Optimization Techniques for Ruby Apps', speaker: 'David Park', track: 'Scaling Ruby' },
      { time: '10:45 AM - 11:30 AM', title: 'Building Ruby Gems for AI Integration', speaker: 'Olivia Martinez', track: 'Open Source & AI' },
      { time: '11:45 AM - 12:30 PM', title: 'Big on Ruby Roundtable: Success Stories', track: 'Scaling Ruby' },
      { time: '11:45 AM - 12:30 PM', title: 'Startup Founder Panel: From MVP to Scale', track: 'Startup Demos' },
      { time: '12:30 PM - 2:00 PM', title: 'Lunch & Networking', track: null },
      { time: '2:00 PM - 2:45 PM', title: 'The Future of Ruby Tooling', speaker: 'Lucas Kim', track: 'Open Source & AI' },
      { time: '3:00 PM - 3:45 PM', title: 'Ruby Security Best Practices', speaker: 'Sophia Chen', track: 'Scaling Ruby' },
      { time: '4:00 PM - 5:00 PM', title: 'Closing Keynote: Building Community in Tech', speaker: 'Marcus Johnson', track: null },
      { time: '5:00 PM - 5:30 PM', title: 'Closing Remarks & Farewell', track: null }
    ]
  }
];

// Define colors for different tracks
const trackColors = {
  'Open Source & AI': 'bg-blue-100 text-blue-800',
  'Scaling Ruby': 'bg-green-100 text-green-800',
  'Startup Demos': 'bg-purple-100 text-purple-800',
  'VC Insights': 'bg-amber-100 text-amber-800'
};
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Conference Schedule</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Plan your SF Ruby Conference experience with our comprehensive schedule
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Schedule navigation -->
    <div class="mb-8 flex justify-center space-x-4">
      {days.map((day, index) => (
        <button 
          class="schedule-tab px-6 py-2 rounded-md text-dark-800 font-medium transition-colors duration-200 focus:outline-none"
          data-index={index}
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          Day {index + 1}
          <span class="hidden md:inline ml-2">{day.date}</span>
        </button>
      ))}
    </div>
    
    <!-- Track legend -->
    <div class="mb-8 flex flex-wrap justify-center gap-4">
      {Object.entries(trackColors).map(([track, color]) => (
        <div class="flex items-center">
          <span class={`inline-block w-3 h-3 rounded-full ${color.split(' ')[0]} mr-2`}></span>
          <span class="text-dark-600 text-sm">{track}</span>
        </div>
      ))}
    </div>
    
    <!-- Schedule tabs content -->
    <div class="space-y-8">
      {days.map((day, dayIndex) => (
        <div 
          class="schedule-content" 
          data-index={dayIndex}
          style={dayIndex === 0 ? "" : "display: none;"}
        >
          <h2 class="text-2xl font-display font-bold text-dark-900 mb-6">{day.date}</h2>
          
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-dark-200">
              <thead class="bg-dark-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider w-1/4">Time</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider w-1/2">Session</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-dark-500 uppercase tracking-wider w-1/4">Speaker</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-dark-200">
                {day.sessions.map((session) => (
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-dark-900">{session.time}</td>
                    <td class="px-6 py-4">
                      <div class="text-sm font-medium text-dark-900">{session.title}</div>
                      {session.track && (
                        <span class={`mt-1 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${trackColors[session.track]}`}>
                          {session.track}
                        </span>
                      )}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-dark-500">
                      {session.speaker ? session.speaker : ''}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <p class="text-dark-600 mb-4">
        Schedule is subject to change. Last updated: August 10, 2025
      </p>
      <a 
        href="/calendar.ics" 
        class="inline-flex items-center justify-center px-4 py-2 border border-dark-300 rounded-md shadow-sm text-sm font-medium text-dark-700 bg-white hover:bg-dark-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
        </svg>
        Add to Calendar
      </a>
    </div>
  </div>
</Layout>

<style>
  .schedule-tab[aria-selected="true"] {
    background-color: #e0115f;
    color: white;
  }
  .schedule-tab[aria-selected="false"] {
    background-color: #f1f5f9;
  }
</style>

<script>
  // Handle tab switching
  const tabs = document.querySelectorAll('.schedule-tab');
  const contents = document.querySelectorAll('.schedule-content');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tab styling
      tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');
      
      // Show selected content
      const index = tab.getAttribute('data-index');
      contents.forEach(content => {
        content.style.display = content.getAttribute('data-index') === index ? '' : 'none';
      });
    });
  });
</script>