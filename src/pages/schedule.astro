// Define colors for different session types
const sessionColors = {
  'Keynote': 'bg-ruby-100 text-ruby-800 border-ruby-200',
  'CTO roundtable': 'bg-purple-100 text-purple-800 border-purple-200',
  'VC roundtable': 'bg-amber-100 text-amber-800 border-amber-200',
  'Startup demos': 'bg-green-100 text-green-800 border-green-200',
  'Lunch break': 'bg-sky-100 text-sky-800 border-sky-200',
  'Doors open': 'bg-cloud-100 text-cloud-800 border-cloud-200',
  'Intro': 'bg-cloud-100 text-cloud-800 border-cloud-200'
};

function getSessionColor(sessionName) {
  for (const [key, color] of Object.entries(sessionColors)) {
    if (sessionName.includes(key)) {
      return color;
    }
  }
  return 'bg-white border-cloud-200';
}
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
  <div class="bg-gradient-to-b from-ruby-500 to-ruby-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-center">Schedule</h1>
      <p class="mt-4 text-xl text-center max-w-3xl mx-auto">
        Two days of Ruby excellence with three concurrent tracks
      </p>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Schedule navigation -->
    <div class="mb-12 flex justify-center space-x-4">
      {days.map((day, index) => (
        <button 
          class={`schedule-tab px-8 py-3 rounded-md font-medium transition-all duration-200 focus:outline-none ${
            index === 0 
              ? 'bg-ruby-500 text-white shadow-md' 
              : 'bg-white text-dark-700 border border-dark-200 hover:bg-dark-50'
          }`}
          data-index={index}
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          {day.dayLabel}
          <span class="hidden md:inline ml-2 text-sm opacity-90">{day.date}</span>
        </button>
      ))}
    </div>
    
    <!-- Track legend -->
    <div class="mb-12">
      <h2 class="text-2xl font-display font-bold text-dark-900 mb-8 text-center">Conference Tracks</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow-md p-6 text-center border border-ruby-200">
          <h3 class="font-bold text-ruby-600 mb-3 text-lg">Main Track</h3>
          <p class="text-dark-600">Keynotes, featured talks, and major presentations</p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center border border-sky-200">
          <h3 class="font-bold text-sky-600 mb-3 text-lg">Track #2</h3>
          <p class="text-dark-600">Specialized talks and technical deep-dives</p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center border border-green-200">
          <h3 class="font-bold text-green-600 mb-3 text-lg">Workshops</h3>
          <p class="text-dark-600">Hands-on learning and interactive sessions</p>
        </div>
      </div>
    </div>
    
    <!-- Schedule tabs content -->
    <div class="space-y-8">
      {days.map((day, dayIndex) => (
        <div 
          class="schedule-content bg-white rounded-lg shadow-md overflow-hidden" 
          data-index={dayIndex}
          style={dayIndex === 0 ? "" : "display: none;"}
        >
          <div class="bg-dark-50 px-6 py-4 border-b border-dark-200">
            <h3 class="text-xl font-display font-bold text-dark-900">{day.dayLabel} - {day.date}</h3>
          </div>
          
          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead class="bg-dark-100">
                <tr>
                  <th scope="col" class="px-6 py-4 text-left text-sm font-medium text-dark-700 uppercase tracking-wider w-1/6">Time</th>
                  <th scope="col" class="px-6 py-4 text-left text-sm font-medium text-dark-700 uppercase tracking-wider w-1/3">Main Track</th>
                  <th scope="col" class="px-6 py-4 text-left text-sm font-medium text-dark-700 uppercase tracking-wider w-1/3">Track #2</th>
                  <th scope="col" class="px-6 py-4 text-left text-sm font-medium text-dark-700 uppercase tracking-wider w-1/6">Workshops</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-dark-200">
                {day.sessions.map((session, index) => (
                  <tr class={index % 2 === 0 ? 'bg-white' : 'bg-dark-50'}>
                    <td class="px-6 py-4 text-sm font-medium text-dark-900">
                      <div class="font-semibold">{session.time}</div>
                      <div class="text-dark-500 text-xs">- {session.endTime}</div>
                    </td>
                    <td class="px-6 py-4">
                      {session.main && (
                        <div class={`inline-flex items-center px-3 py-2 rounded-full text-sm font-medium border ${getSessionColor(session.main)}`}>
                          {session.main}
                        </div>
                      )}
                    </td>
                    <td class="px-6 py-4">
                      {session.track2 && (
                        <div class={`inline-flex items-center px-3 py-2 rounded-full text-sm font-medium border ${getSessionColor(session.track2)}`}>
                          {session.track2}
                        </div>
                      )}
                    </td>
                    <td class="px-6 py-4">
                      {session.workshop && (
                        <div class={`inline-flex items-center px-3 py-2 rounded-full text-sm font-medium border ${getSessionColor(session.workshop)}`}>
                          {session.workshop}
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Additional info -->
    <div class="mt-16 bg-dark-50 rounded-lg p-8">
      <h3 class="text-2xl font-display font-bold text-dark-900 mb-6">Schedule Notes</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h4 class="font-bold text-dark-900 mb-3">Workshop Registration</h4>
          <p class="text-dark-600">
            Workshops have limited capacity and require separate registration. Details will be announced closer to the conference date.
          </p>
        </div>
        <div>
          <h4 class="font-bold text-dark-900 mb-3">Schedule Updates</h4>
          <p class="text-dark-600">
            This schedule is preliminary and subject to change. Final speaker assignments and session details will be announced in October 2025.
          </p>
        </div>
      </div>
    </div>

    <!-- Call to action -->
    <div class="mt-16 text-center bg-gradient-to-r from-ruby-500 to-ruby-700 text-white rounded-lg p-8">
      <h3 class="text-2xl font-display font-bold mb-4">Ready to Join Us?</h3>
      <p class="text-lg mb-6 max-w-2xl mx-auto">
        Don't miss out on two days of Ruby excellence with three concurrent tracks designed for every skill level.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://lu.ma/sfrubyconf2025"
          target="_blank"
          class="inline-flex items-center justify-center px-8 py-3 bg-white text-ruby-600 rounded-md font-medium shadow-md transition-all duration-300 transform hover:scale-105"
        >
          Get Tickets
        </a>
        <a 
          href="/#newsletter"
          class="inline-flex items-center justify-center px-8 py-3 bg-transparent border border-white text-white rounded-md font-medium transition-all duration-300 transform hover:scale-105"
        >
          Sign up for updates
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Handle tab switching
  const tabs = document.querySelectorAll('.schedule-tab');
  const contents = document.querySelectorAll('.schedule-content');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tab styling
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.className = 'schedule-tab px-8 py-3 rounded-md font-medium transition-all duration-200 focus:outline-none bg-white text-dark-700 border border-dark-200 hover:bg-dark-50';
      });
      
      tab.setAttribute('aria-selected', 'true');
      tab.className = 'schedule-tab px-8 py-3 rounded-md font-medium transition-all duration-200 focus:outline-none bg-ruby-500 text-white shadow-md';
      
      // Show selected content
      const index = tab.getAttribute('data-index');
      contents.forEach(content => {
        content.style.display = content.getAttribute('data-index') === index ? '' : 'none';
      });
    });
  });
</script>