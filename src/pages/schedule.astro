---
import Layout from '../layouts/Layout.astro';
import {
  getCompleteSchedule,
  getTimeBlocks,
  formatTimeRange,
  getTrackDisplayName,
  scheduleSlots,
  slotAssignments,
  talks,
  speakers
} from '../data/index.js';
import { startups, getStartupsByIds } from '../data/startups.js';
import TalkModal from '../components/schedule/TalkModal.astro';
import ScheduleTabs from '../components/schedule/ScheduleTabs.astro';
import { formatTime as utilFormatTime, timeToMinutes } from '../utils/schedule/formatTime';
import { getSessionColor as utilGetSessionColor, getTrackDisplayName as utilGetTrackDisplayName } from '../utils/schedule/constants';

// Get the complete schedule with all data joined
const fullSchedule = getCompleteSchedule();

// Group schedule by day
const day1Schedule = fullSchedule.filter(slot => slot.day === 1);
const day2Schedule = fullSchedule.filter(slot => slot.day === 2);
const day3Schedule = fullSchedule.filter(slot => slot.day === 3);

// Get time blocks for each day
const day1TimeBlocks = getTimeBlocks(1);
const day2TimeBlocks = getTimeBlocks(2);
const day3TimeBlocks = getTimeBlocks(3);

// Define colors for different session types
const sessionColors = {
  'keynote': 'bg-gradient-to-r from-ruby-500 to-pink-500 text-white border-ruby-400',
  'panel': 'bg-gradient-to-r from-purple-500 to-indigo-500 text-white border-purple-400',
  'demo': 'bg-gradient-to-r from-green-500 to-emerald-500 text-white border-green-400',
  'break': 'bg-gradient-to-r from-sky-400 to-blue-500 text-white border-sky-400',
  'social': 'gitbutler-gradient text-white border-[oklch(0.5325_0.1109_183.03)]',
  'logistics': 'bg-gray-100 text-gray-700 border-gray-200',
  'talk': 'bg-white text-gray-900 border-gray-200 hover:border-ruby-300 hover:shadow-lg',
  'workshop': 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:border-emerald-300 hover:shadow-lg'
};

function getSessionColor(sessionType: string) {
  return sessionColors[sessionType as keyof typeof sessionColors] || 'bg-white text-gray-900 border-gray-200';
}

// Format time for display
function formatTime(time: string) {
  const [hours, minutes] = time.split(':').map(Number);
  const period = hours >= 12 ? 'PM' : 'AM';
  const displayHours = hours > 12 ? hours - 12 : hours === 0 ? 12 : hours;
  return `${displayHours}:${minutes.toString().padStart(2, '0')} ${period}`;
}

// Get track color
function getTrackColor(track: string) {
  const trackColors: Record<string, string> = {
    'main': 'ruby',
    'blackbox': 'sky',
    'workshop': 'emerald'
  };
  return trackColors[track] || 'gray';
}

// Special time blocks (breaks, registration, etc.)
const specialBlocks = {
  1: [
    { startTime: '8:00', endTime: '8:50', title: 'Doors Open & Registration', type: 'logistics' },
    { startTime: '8:50', endTime: '9:00', title: 'Welcome & Opening Remarks', type: 'logistics' },
    { startTime: '11:40', endTime: '13:10', title: 'Lunch', type: 'break', id: 'lunch-day1' },
  ],
  2: [
    { startTime: '8:00', endTime: '8:50', title: 'Doors Open & Coffee', type: 'logistics' },
    { startTime: '11:40', endTime: '13:10', title: 'Lunch', type: 'break', id: 'lunch-day2' },
  ]
};

// Combine special blocks with time blocks
function getCombinedTimeBlocks(day: number) {
  // Get all slots for this day with complete data
  const completeSchedule = getCompleteSchedule().filter(slot => slot.day === day);

  // Group slots by start time only (not end time) to keep workshops with concurrent sessions
  const timeGroups = new Map();

  completeSchedule.forEach(slot => {
    if (!timeGroups.has(slot.startTime)) {
      timeGroups.set(slot.startTime, {
        startTime: slot.startTime,
        endTime: slot.endTime, // Use the first slot's end time as default
        slots: []
      });
    }
    timeGroups.get(slot.startTime).slots.push(slot);
  });

  const timeBlocks = Array.from(timeGroups.values());
  const specials = specialBlocks[day as keyof typeof specialBlocks] || [];

  // Add special blocks to time blocks
  specials.forEach((special: any) => {
    const existingBlock = timeBlocks.find(
      block => block.startTime === special.startTime
    );

    if (!existingBlock) {
      timeBlocks.push({
        startTime: special.startTime,
        endTime: special.endTime,
        slots: [],
        special: special
      });
    } else {
      existingBlock.special = special;
    }
  });

  // Sort by start time
  return timeBlocks.sort((a, b) => {
    const timeToMinutes = (time: string) => {
      const [hours, minutes] = time.split(':').map(Number);
      return hours * 60 + minutes;
    };
    return timeToMinutes(a.startTime) - timeToMinutes(b.startTime);
  });
}

const day1CombinedBlocks = getCombinedTimeBlocks(1);
const day2CombinedBlocks = getCombinedTimeBlocks(2);
const day3CombinedBlocks = getCombinedTimeBlocks(3);

const days = [
  { date: 'November 19, 2025', dayLabel: 'Day 1', dayNumber: 1, blocks: day1CombinedBlocks },
  { date: 'November 20, 2025', dayLabel: 'Day 2', dayNumber: 2, blocks: day2CombinedBlocks },
  { date: 'November 21, 2025', dayLabel: 'Day 3', dayNumber: 3, blocks: day3CombinedBlocks }
];
---

<Layout title="Schedule - San Francisco Ruby Conference 2025">
    <!-- Schedule Content -->
    <section id="schedule" class="pt-20 bg-white relative overflow-hidden">
        <!-- Invisible anchor points at the top to prevent scroll-to-bottom -->
        <div id="day1" class="day-anchor"></div>
        <div id="day2" class="day-anchor"></div>
        <div id="day3" class="day-anchor"></div>

        <!-- Subtle background pattern -->
        <div class="absolute inset-0 opacity-5">
            <div class="absolute top-20 right-20 w-32 h-32 bg-ruby-400 rounded-full filter blur-xl"></div>
            <div class="absolute bottom-40 left-20 w-24 h-24 bg-sky-400 rounded-full filter blur-xl"></div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Venue Map (Collapsible) -->
            <details class="venue-map-details mb-6">
                <summary class="venue-map-summary">
                    <div class="flex items-center justify-between cursor-pointer">
                        <div class="flex items-center gap-3">
                            <svg class="w-6 h-6 text-ruby-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span class="text-lg font-display font-bold text-gray-900">Venue Map</span>
                        </div>
                        <svg class="w-5 h-5 text-gray-500 chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </summary>
                <div class="venue-map-content mt-4">
                    <img
                        src="/venue-map.png"
                        alt="Fort Mason Conference Center Venue Map"
                        class="w-full h-auto rounded-lg shadow-lg border border-gray-200"
                        loading="lazy"
                    />
                </div>
            </details>

            <!-- Day Navigation -->
            <ScheduleTabs days={days} />

            <!-- Schedule Days -->
            <div class="space-y-8 mt-4">
                {days.map((day, dayIndex) => (
                    <div
                        class="schedule-content"
                        data-day={`day${day.dayNumber}`}
                        data-index={dayIndex}
                    >


                        <!-- Schedule Grid -->
                        <div class="space-y-8">
                            <!-- Desktop Column Headers (hide for Day 3) -->
                            {dayIndex !== 2 && (
                                <div class="hidden md:grid grid-cols-12 gap-4 mb-8">
                                    <div class="col-span-2"></div>
                                    <div class="col-span-10">
                                        <div class="grid grid-cols-3 gap-4">
                                            <div class="text-center">
                                                <h4 class="font-display font-bold text-ruby-600 text-sm tracking-wide mb-2">MAIN STAGE</h4>
                                                <div class="w-8 h-0.5 bg-ruby-500 rounded-full mx-auto"></div>
                                            </div>
                                            <div class="text-center">
                                                <h4 class="font-display font-bold text-sky-600 text-sm tracking-wide mb-2">BLACKBOX THEATER</h4>
                                                <div class="w-8 h-0.5 bg-sky-500 rounded-full mx-auto"></div>
                                            </div>
                                            <div class="text-center">
                                                <h4 class="font-display font-bold text-emerald-600 text-sm tracking-wide mb-2">WORKSHOP STUDIO</h4>
                                                <div class="w-8 h-0.5 bg-emerald-500 rounded-full mx-auto"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            )}

                            {day.blocks.map((block, blockIndex) => {
                                // Check if this is a special block (break, registration, etc.)
                                if (block.special) {
                                    return (
                                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
                                            <!-- Time Column -->
                                            <div class="lg:col-span-2">
                                                <div class="text-center lg:text-left sticky top-24">
                                                    <div class="font-display font-bold text-gray-900 text-xl mb-1">
                                                        {formatTime(block.startTime)}
                                                    </div>
                                                    <div class="text-gray-500 text-sm">
                                                        to {formatTime(block.endTime)}
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Special Block Content -->
                                            <div class="lg:col-span-10">
                                                <div class={`p-6 rounded-lg border-2 transition-all duration-300 ${block.special.type === 'break' ? 'transform hover:scale-105 cursor-pointer' : ''} ${getSessionColor(block.special.type)}`}
                                                     data-special-id={block.special.id}
                                                     data-special-type={block.special.type}>
                                                    <h3 class="font-bold text-xl text-center">
                                                        {block.special.title}
                                                    </h3>
                                                    {block.special.description && (
                                                        <p class="text-center text-sm text-gray-600 mt-2">
                                                            {block.special.description}
                                                        </p>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    );
                                }

                                // Regular session blocks
                                const mainSlot = block.slots.find((s: any) => s.track === 'main');
                                const blackboxSlot = block.slots.find((s: any) => s.track === 'blackbox');
                                const workshopSlot = block.slots.find((s: any) => s.track === 'workshop');

                                // Skip if this is a keynote, panel, or social event (they span all tracks)
                                const isFullWidth = mainSlot && (mainSlot.type === 'keynote' || mainSlot.type === 'panel' || mainSlot.type === 'demo' || mainSlot.type === 'social') && !blackboxSlot && !workshopSlot;

                                return (
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
                                        <!-- Time Column -->
                                        <div class="lg:col-span-2">
                                            <div class="text-center lg:text-left sticky top-24">
                                                <div class="font-display font-bold text-gray-900 text-xl mb-1">
                                                    {formatTime(block.startTime)}
                                                </div>
                                                <div class="text-gray-500 text-sm">
                                                    to {formatTime(block.endTime)}
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Sessions Column -->
                                        <div class="lg:col-span-10">
                                            {isFullWidth ? (
                                                // Full-width session (keynote, panel, demo)
                                                <div
                                                    class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 cursor-pointer ${getSessionColor(mainSlot.type)}`}
                                                    data-talk-id={mainSlot.talk?.id}
                                                    data-slot-id={mainSlot.id}
                                                >
                                                    {mainSlot.talk && (
                                                        <>
                                                            <h3 class={`font-bold mb-2 leading-tight ${mainSlot.type === 'social' ? 'text-3xl md:text-4xl' : 'text-xl'}`}>
                                                                {mainSlot.talk.title}
                                                            </h3>
                                                            {mainSlot.speakers && mainSlot.speakers.length > 0 && (
                                                                <p class="text-sm opacity-90 mb-3">
                                                                    {mainSlot.speakers.map((s: any) => s.name).join(', ')}
                                                                </p>
                                                            )}
                                                            {mainSlot.talk.type === 'demo' && mainSlot.talk.startupIds && (
                                                                <div class="grid grid-cols-3 sm:grid-cols-5 gap-3 mt-4">
                                                                    {getStartupsByIds(mainSlot.talk.startupIds).map((startup: any) => (
                                                                        <div class="bg-white/20 rounded-lg p-2 flex items-center justify-center" title={startup.name}>
                                                                            <img
                                                                                src={startup.logo}
                                                                                alt={startup.name}
                                                                                class="w-full h-auto max-h-8 object-contain filter brightness-0 invert opacity-90"
                                                                                loading="lazy"
                                                                            />
                                                                        </div>
                                                                    ))}
                                                                </div>
                                                            )}
                                                            {mainSlot.talk.type !== 'demo' && mainSlot.talk.description && (
                                                                <p class={`opacity-80 line-clamp-3 ${mainSlot.type === 'social' ? 'text-lg' : 'text-sm'}`}>
                                                                    {mainSlot.talk.description}
                                                                </p>
                                                            )}
                                                        </>
                                                    )}
                                                </div>
                                            ) : (
                                                // Multi-track sessions
                                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                                    {/* Main Stage */}
                                                    <div>
                                                        {mainSlot && mainSlot.talk ? (
                                                            <div
                                                                class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 cursor-pointer ${getSessionColor(mainSlot.type)}`}
                                                                data-talk-id={mainSlot.talk.id}
                                                                data-slot-id={mainSlot.id}
                                                            >
                                                                {day.dayLabel !== 'Day 3' && (
                                                                    <div class="mb-3 md:hidden">
                                                                        <span class="px-3 py-1 bg-ruby-100 text-ruby-700 text-xs font-medium rounded-full">
                                                                            Main Stage
                                                                        </span>
                                                                    </div>
                                                                )}
                                                                <h3 class="font-bold text-lg mb-2 leading-tight">
                                                                    {mainSlot.talk.title}
                                                                </h3>
                                                                {mainSlot.speakers && mainSlot.speakers.length > 0 && (
                                                                    <p class="text-sm text-gray-600 mb-2">
                                                                        {mainSlot.speakers.map((s: any) => s.name).join(', ')}
                                                                    </p>
                                                                )}
                                                                {mainSlot.talk.type === 'demo' && mainSlot.talk.startupIds && (
                                                                    <div class="grid grid-cols-2 gap-2 mt-3">
                                                                        {getStartupsByIds(mainSlot.talk.startupIds).map((startup: any) => (
                                                                            <div class="bg-gray-100 rounded p-1.5 flex items-center justify-center" title={startup.name}>
                                                                                <img
                                                                                    src={startup.logo}
                                                                                    alt={startup.name}
                                                                                    class="w-full h-auto max-h-6 object-contain"
                                                                                    loading="lazy"
                                                                                />
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                                {mainSlot.talk.type !== 'demo' && mainSlot.talk.description && (
                                                                    <p class="text-sm text-gray-500 line-clamp-3">
                                                                        {mainSlot.talk.description}
                                                                    </p>
                                                                )}
                                                            </div>
                                                        ) : (
                                                            <div class="hidden md:block"></div>
                                                        )}
                                                    </div>

                                                    {/* Blackbox Theater */}
                                                    <div>
                                                        {blackboxSlot && blackboxSlot.talk ? (
                                                            <div
                                                                class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 cursor-pointer ${getSessionColor('talk')}`}
                                                                data-talk-id={blackboxSlot.talk.id}
                                                                data-slot-id={blackboxSlot.id}
                                                            >
                                                                {day.dayLabel !== 'Day 3' && (
                                                                    <div class="mb-3 md:hidden">
                                                                        <span class="px-3 py-1 bg-sky-100 text-sky-700 text-xs font-medium rounded-full">
                                                                            Blackbox Theater
                                                                        </span>
                                                                    </div>
                                                                )}
                                                                <h3 class="font-bold text-lg mb-2 leading-tight">
                                                                    {blackboxSlot.talk.title}
                                                                </h3>
                                                                {blackboxSlot.speakers && blackboxSlot.speakers.length > 0 && (
                                                                    <p class="text-sm text-gray-600 mb-2">
                                                                        {blackboxSlot.speakers.map((s: any) => s.name).join(', ')}
                                                                    </p>
                                                                )}
                                                                {blackboxSlot.talk.type === 'demo' && blackboxSlot.talk.startupIds && (
                                                                    <div class="grid grid-cols-2 gap-2 mt-3">
                                                                        {getStartupsByIds(blackboxSlot.talk.startupIds).map((startup: any) => (
                                                                            <div class="bg-gray-100 rounded p-1.5 flex items-center justify-center" title={startup.name}>
                                                                                <img
                                                                                    src={startup.logo}
                                                                                    alt={startup.name}
                                                                                    class="w-full h-auto max-h-6 object-contain"
                                                                                    loading="lazy"
                                                                                />
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                                {blackboxSlot.talk.type !== 'demo' && blackboxSlot.talk.description && (
                                                                    <p class="text-sm text-gray-500 line-clamp-3">
                                                                        {blackboxSlot.talk.description}
                                                                    </p>
                                                                )}
                                                            </div>
                                                        ) : (
                                                            <div class="hidden md:block"></div>
                                                        )}
                                                    </div>

                                                    {/* Workshop Studio */}
                                                    <div>
                                                        {workshopSlot && workshopSlot.talk ? (
                                                            <div
                                                                class={`p-6 rounded-lg border-2 transition-all duration-300 transform hover:scale-105 cursor-pointer ${getSessionColor('workshop')}`}
                                                                data-talk-id={workshopSlot.talk.id}
                                                                data-slot-id={workshopSlot.id}
                                                            >
                                                                {day.dayLabel !== 'Day 3' && (
                                                                    <div class="mb-3 md:hidden">
                                                                        <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-medium rounded-full">
                                                                            Workshop Studio
                                                                        </span>
                                                                    </div>
                                                                )}
                                                                <div class="flex items-center gap-2 mb-2">
                                                                    <h3 class="font-bold text-lg leading-tight">
                                                                        {workshopSlot.talk.title}
                                                                    </h3>
                                                                </div>
                                                                <p class="text-xs text-emerald-600 mb-2">
                                                                    {formatTime(workshopSlot.startTime)} - {formatTime(workshopSlot.endTime)}
                                                                </p>
                                                                {workshopSlot.speakers && workshopSlot.speakers.length > 0 && (
                                                                    <p class="text-sm text-gray-600 mb-2">
                                                                        {workshopSlot.speakers.map((s: any) => s.name).join(', ')}
                                                                    </p>
                                                                )}
                                                                {workshopSlot.talk.maxParticipants && (
                                                                    <p class="text-xs text-emerald-600 mb-2">
                                                                        Max {workshopSlot.talk.maxParticipants} participants
                                                                    </p>
                                                                )}
                                                                {workshopSlot.talk.description && (
                                                                    <p class="text-sm text-gray-500 line-clamp-3">
                                                                        {workshopSlot.talk.description}
                                                                    </p>
                                                                )}
                                                            </div>
                                                        ) : (
                                                            <div></div>
                                                        )}
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Legend -->
    <section class="pt-12 pb-12 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-8">
                <h3 class="text-2xl font-display font-bold text-gray-900">Session Types</h3>
            </div>
            <div class="flex flex-wrap justify-center gap-4">
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 bg-gradient-to-r from-ruby-500 to-pink-500 rounded"></div>
                    <span class="text-sm text-gray-700">Keynote</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 bg-white border-2 border-gray-200 rounded"></div>
                    <span class="text-sm text-gray-700">Talk</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 bg-emerald-50 border-2 border-emerald-200 rounded"></div>
                    <span class="text-sm text-gray-700">Workshop</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 bg-gradient-to-r from-purple-500 to-indigo-500 rounded"></div>
                    <span class="text-sm text-gray-700">Panel</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 bg-gradient-to-r from-green-500 to-emerald-500 rounded"></div>
                    <span class="text-sm text-gray-700">Demo</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Talk Detail Modal (Native Dialog) -->
    <TalkModal />
</Layout>

<style>
    .speaker-card {
        transition: all 0.3s ease;
    }

    .speaker-card:hover {
        transform: translateY(-2px);
    }

    /* Invisible anchor points for hash navigation */
    .day-anchor {
        position: absolute;
        top: -5rem; /* Offset for main navigation */
        left: 0;
        width: 1px;
        height: 1px;
        visibility: hidden;
        pointer-events: none;
        scroll-margin-top: 5rem; /* Account for fixed header */
    }

    /* CSS-based tab content switching using :target */
    .schedule-content {
        display: none;
    }

    /* Show Day 1 by default (no hash) */
    .schedule-content[data-day="day1"] {
        display: block;
    }

    /* Show targeted day content when anchor is targeted */
    #day1:target ~ * .schedule-content[data-day="day1"] {
        display: block;
    }

    #day2:target ~ * .schedule-content[data-day="day2"] {
        display: block;
    }

    #day3:target ~ * .schedule-content[data-day="day3"] {
        display: block;
    }

    /* Hide other days when a specific day is targeted */
    #day1:target ~ * .schedule-content[data-day="day2"],
    #day1:target ~ * .schedule-content[data-day="day3"] {
        display: none;
    }

    #day2:target ~ * .schedule-content[data-day="day1"],
    #day2:target ~ * .schedule-content[data-day="day3"] {
        display: none;
    }

    #day3:target ~ * .schedule-content[data-day="day1"],
    #day3:target ~ * .schedule-content[data-day="day2"] {
        display: none;
    }

    /* Smooth scroll behavior */
    html {
        scroll-behavior: smooth;
    }

    /* Venue Map Collapsible Styles */
    .venue-map-details {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1rem;
        transition: all 0.3s ease;
    }

    .venue-map-details:hover {
        border-color: #dc2626;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .venue-map-details[open] {
        border-color: #dc2626;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .venue-map-summary {
        list-style: none;
        user-select: none;
    }

    .venue-map-summary::-webkit-details-marker {
        display: none;
    }

    .venue-map-summary::marker {
        display: none;
    }

    /* Rotate chevron when open */
    .venue-map-details[open] .chevron {
        transform: rotate(180deg);
        transition: transform 0.3s ease;
    }

    .chevron {
        transition: transform 0.3s ease;
    }

    .venue-map-content {
        animation: slideDown 0.3s ease-out;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile adjustments */
    @media (max-width: 640px) {
        .venue-map-details {
            padding: 0.75rem;
        }

        .venue-map-summary span {
            font-size: 1rem;
        }
    }
</style>

<style>
