</style>

<script>
    import { talks, speakers, scheduleSlots, slotAssignments } from '../data/index.js';
    import { startups } from '../data/startups.js';

    // Tab switching functionality
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.schedule-tab');
        const contents = document.querySelectorAll('.schedule-content');

        const switchToDay = (index: number, preventScroll = false) => {
            // Update URL hash without triggering scroll
            if (preventScroll) {
                history.replaceState(null, '', `#day${index + 1}`);
            } else {
                window.location.hash = `day${index + 1}`;
            }

            // Don't scroll - let CSS handle the display, or scroll to top of schedule
            if (!preventScroll) {
                const scheduleSection = document.getElementById('schedule');
                const mainNav = document.querySelector('header.fixed') as HTMLElement;
                const mainNavHeight = mainNav ? mainNav.offsetHeight : 80;

                if (scheduleSection) {
                    const scrollTarget = scheduleSection.offsetTop - mainNavHeight;
                    window.scrollTo({
                        top: scrollTarget,
                        behavior: 'smooth'
                    });
                }
            }

            // Update tabs
            tabs.forEach((t, i) => {
                if (i === index) {
                    t.classList.add('bg-ruby-500', 'text-white', 'shadow-md');
                    t.classList.remove('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                } else {
                    t.classList.remove('bg-ruby-500', 'text-white', 'shadow-md');
                    t.classList.add('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                }
            });

            // Update content
            contents.forEach((content, i) => {
                const contentEl = content as HTMLElement;
                if (i === index) {
                    contentEl.style.display = 'block';
                    contentEl.style.visibility = 'visible';
                } else {
                    contentEl.style.display = 'none';
                }
                });
        };

        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {
                switchToDay(index);
            });
        });

        // Check URL hash on page load and switch to that day without scrolling
        const hash = window.location.hash;
        if (hash && hash.match(/^#day[123]$/)) {
            const dayIndex = parseInt(hash.replace('#day', '')) - 1;
            if (dayIndex >= 0 && dayIndex < tabs.length) {
                // Update tabs without scrolling on initial load
                tabs.forEach((t, i) => {
                    if (i === dayIndex) {
                        t.classList.add('bg-ruby-500', 'text-white', 'shadow-md');
                        t.classList.remove('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                    } else {
                        t.classList.remove('bg-ruby-500', 'text-white', 'shadow-md');
                        t.classList.add('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                    }
                });
                // CSS will handle showing the correct day via :target
            }
        }

        // Get references for navigation
        const dayNav = document.getElementById('dayNavigation') as HTMLElement;
        const mainNav = document.querySelector('header.fixed') as HTMLElement;
        const mainNavHeight = mainNav ? mainNav.offsetHeight : 80;

        // Set the top position dynamically based on main nav height
        if (mainNav && dayNav) {
            dayNav.style.top = `${mainNav.offsetHeight}px`;
        }



        // Scroll spy for day sections
        const dayContents = document.querySelectorAll('.schedule-content');
        const dayTabs = document.querySelectorAll('.schedule-tab');

        // Create observers for each day section
        const scrollSpyObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const index = parseInt((entry.target as HTMLElement).dataset.index || '0');

                        // Update tabs to show current day
                        dayTabs.forEach((tab, i) => {
                            if (i === index) {
                                tab.classList.add('bg-ruby-500', 'text-white', 'shadow-md');
                                tab.classList.remove('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                            } else {
                                tab.classList.remove('bg-ruby-500', 'text-white', 'shadow-md');
                                tab.classList.add('text-gray-700', 'hover:bg-white', 'hover:shadow-sm');
                            }
                        });
                    }
                });
            },
            {
                rootMargin: '-180px 0px -70% 0px', /* Adjusted for main nav + sticky nav */
                threshold: 0
            }
        );

        // Observe all day content sections
        dayContents.forEach(content => {
            scrollSpyObserver.observe(content);
        });

        // Modal functionality - using native dialog
        const modal = document.getElementById('talkModal') as HTMLDialogElement;

        // Function to format time
        function formatTime(time: string) {
            const [hours, minutes] = time.split(':').map(Number);
            const period = hours >= 12 ? 'PM' : 'AM';
            const displayHours = hours > 12 ? hours - 12 : hours === 0 ? 12 : hours;
            return `${displayHours}:${minutes.toString().padStart(2, '0')} ${period}`;
        }

        // Function to open lunch modal
        function openLunchModal(day: number) {
                const modalHTML = `
                    <div class="relative">
                        <!-- Close button -->
                        <button id="modalCloseBtn" class="absolute right-2 top-2 sm:right-4 sm:top-4 z-10 rounded-lg bg-white/90 p-1.5 sm:p-2 hover:bg-gray-100 transition-colors">
                            <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>

                        <!-- Header -->
                        <div class="bg-gradient-to-r from-amber-400 to-orange-400 p-6 sm:p-8 text-white">
                            <div class="max-w-3xl">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-medium">
                                        Break
                                    </span>
                                    <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-medium">
                                        Day ${day}
                                    </span>
                                </div>
                                <h2 class="text-2xl sm:text-3xl font-bold mb-4">Lunch Break</h2>
                                <div class="flex items-center gap-4 text-white/90">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>11:40 AM - 1:10 PM</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-6 sm:p-8">
                            <!-- Main Info -->
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                                    <span>🚚</span> Off The Grid Food Trucks
                                </h3>
                                <div class="prose prose-lg max-w-none text-gray-700 space-y-4">
                                    <p>
                                        Pick up lunch from our curated selection of Off The Grid food trucks,
                                        conveniently parked right in front of the venue at Fort Mason.
                                    </p>
                                    <p>
                                        We've arranged for a fantastic variety of local San Francisco vendors
                                        to provide diverse cuisine options. The trucks will be stationed on the
                                        street level, just outside the main entrance.
                                    </p>
                                </div>
                            </div>

                            <!-- Dietary Options -->
                            <div class="mb-8">
                                <h3 class="text-lg font-bold text-gray-900 mb-4">Dietary Options Available</h3>
                                <div class="flex flex-wrap gap-3">
                                    <span class="inline-flex items-center px-4 py-2 bg-green-100 text-green-800 text-sm font-medium rounded-full">
                                        🥗 Vegetarian
                                    </span>
                                    <span class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-800 text-sm font-medium rounded-full">
                                        🌱 Vegan
                                    </span>
                                    <span class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">
                                        🐟 Pescatarian
                                    </span>
                                    <span class="inline-flex items-center px-4 py-2 bg-amber-100 text-amber-800 text-sm font-medium rounded-full">
                                        🌾 Gluten-Free
                                    </span>
                                </div>
                            </div>

                            <!-- Important Note -->
                            <div class="bg-amber-50 border-2 border-amber-200 rounded-lg p-6 mb-8">
                                <h3 class="text-lg font-bold text-amber-900 mb-3">Please Note</h3>
                                <p class="text-amber-700">
                                    Lunch is not included in your conference ticket. Food trucks accept
                                    cash and card payments. We recommend budgeting $15-20 for a meal.
                                </p>
                            </div>

                            <!-- Tips -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-3">Pro Tips</h3>
                                <ul class="space-y-2 text-gray-700">
                                    <li class="flex items-start gap-2">
                                        <span class="text-ruby-500">•</span>
                                        <span>Beat the rush by going early or late in the lunch window</span>
                                    </li>
                                    <li class="flex items-start gap-2">
                                        <span class="text-ruby-500">•</span>
                                        <span>Enjoy your meal at the Fort Mason picnic areas with bay views</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                `;

                // Use native dialog API
                (window as any).setTalkModalContent(modalHTML);
                (window as any).openTalkModal();
            }

        // Function to get track display name
        function getTrackDisplayName(track: string) {
            const trackNames = {
                main: 'Main Stage',
                blackbox: 'Blackbox Theater',
                workshop: 'Workshop Studio'
            };
            return trackNames[track as keyof typeof trackNames] || track;
        }

        // Function to open modal with talk details
        function openTalkModal(talkId: string, slotId: string) {
            const talk = (talks as any)[talkId];
            const slot = (scheduleSlots as any)[slotId];

            if (!talk) return;

            // Get speakers data
            const speakerData = [];
            if (talk.speakers && Array.isArray(talk.speakers)) {
                talk.speakers.forEach((speakerId: string) => {
                    if ((speakers as any)[speakerId]) speakerData.push((speakers as any)[speakerId]);
                });
            } else if (talk.speakerId && (speakers as any)[talk.speakerId]) {
                speakerData.push((speakers as any)[talk.speakerId]);
            }

            // Get startup data for demo sessions
            const startupData = talk.type === 'demo' && talk.startupIds
                ? talk.startupIds.map((id: string) => (startups as any)[id]).filter(Boolean)
                : [];

            // Build modal HTML
            let modalHTML = `
                <div class="relative">
                    <!-- Close button -->
                    <button id="modalCloseBtn" class="absolute right-2 top-2 sm:right-4 sm:top-4 z-10 rounded-lg bg-white/90 p-1.5 sm:p-2 hover:bg-gray-100 transition-colors">
                        <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>

                    <!-- Header with track color -->
                    <div class="${
                        talk.type === 'social' ? '' : 'bg-gradient-to-r'
                    } ${
                        talk.type === 'keynote' ? 'from-ruby-500 to-pink-500' :
                        talk.type === 'workshop' ? 'from-emerald-500 to-green-500' :
                        talk.type === 'panel' ? 'from-purple-500 to-indigo-500' :
                        talk.type === 'demo' ? 'from-green-500 to-emerald-500' :
                        talk.type === 'social' ? '' :
                        'from-gray-500 to-gray-600'
                    } p-6 sm:p-8 text-white"
                    style="${talk.type === 'social' ? 'background: linear-gradient(to right, oklch(0.5325 0.1109 183.03), oklch(0.633 0.0862 189.64)); border-color: oklch(0.5325 0.1109 183.03);' : ''}">
                        <div class="max-w-3xl">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-medium">
                                    ${talk.type.charAt(0).toUpperCase() + talk.type.slice(1)}
                                </span>
                                ${slot ? `
                                    <span class="px-3 py-1 bg-white/20 rounded-full text-sm font-medium">
                                        ${getTrackDisplayName(slot.track)}
                                    </span>
                                ` : ''}
                                ${talk.status === 'tentative' ? `
                                    <span class="px-3 py-1 bg-yellow-400/30 rounded-full text-sm font-medium">
                                        Tentative
                                    </span>
                                ` : ''}
                            </div>
                            <h2 class="text-2xl sm:text-3xl font-bold mb-4">${talk.title}</h2>
                            ${slot ? `
                                <div class="flex flex-wrap items-center gap-4 text-white/90">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>Day ${slot.day}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>${formatTime(slot.startTime)} - ${formatTime(slot.endTime)}</span>
                                    </div>
                                </div>
                            ` : ''}
                            ${talk.venue || talk.address ? `
                                <div class="flex items-start gap-2 text-white/90 mt-3">
                                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    <div>
                                        ${talk.venue ? `<div class="font-semibold">${talk.venue}</div>` : ''}
                                        ${talk.address ? `<div class="text-sm">${talk.address}</div>` : ''}
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="p-6 sm:p-8">
                        <!-- Startup Demos -->
                        ${startupData.length > 0 ? `
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-6">Featured Startups</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                    ${startupData.map((startup: any) => {
                                        const name = String(startup.name || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                                        const desc = String(startup.description || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
                                        return `
                                        <a href="${startup.url}" target="_blank" rel="noopener noreferrer"
                                           class="group bg-gray-50 rounded-xl p-6 hover:bg-gray-100 transition-all duration-300 hover:shadow-lg border border-gray-200 hover:border-emerald-300">
                                            <div class="flex items-start gap-4">
                                                <div class="flex-shrink-0 w-16 h-16 bg-white rounded-lg p-2 flex items-center justify-center shadow-sm">
                                                    <img src="${startup.logo}" alt="${name}"
                                                         class="w-full h-full object-contain" />
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <h4 class="font-bold text-gray-900 mb-1 group-hover:text-emerald-600 transition-colors flex items-center gap-2">
                                                        ${name}
                                                        ${startup.isYC ? `
                                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-orange-100 border border-orange-200 rounded text-xs font-medium text-orange-700">
                                                                <img src="/yc_icon.png" alt="YC" class="w-3 h-3" />
                                                                YC
                                                            </span>
                                                        ` : ''}
                                                    </h4>
                                                    <p class="text-sm text-gray-600">${desc}</p>
                                                </div>
                                            </div>
                                        </a>
                                    `}).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <!-- Description -->
                        ${talk.description ? `
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-4">About this ${talk.type}</h3>
                                <div class="prose prose-lg max-w-none text-gray-700 space-y-4">
                                    ${talk.description.split('\n').map((p: string) => `<p class="mb-4">${p}</p>`).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <!-- Tags -->
                        ${talk.tags && talk.tags.length > 0 ? `
                            <div class="mb-8">
                                <div class="flex flex-wrap gap-2">
                                    ${talk.tags.map((tag: string) => `
                                        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                                            #${tag}
                                        </span>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}


                        ${talk.link ? `
                          <div class="mb-8"> <a href="${talk.link}" target="_blank" rel="noopener noreferrer"
                           class="inline-block mt-4 px-6 py-3 bg-emerald-600 text-white font-semibold rounded-lg hover:bg-emerald-700 transition-colors">
                            ${talk.linkText || 'Sign Up'}
                            </a>
                          </div>
                        ` : ''}

                        <!-- Speakers -->
                        ${speakerData.length > 0 ? `
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-6">
                                    ${talk.type === 'panel' ? (speakerData.length > 1 ? 'Panelists' : 'Panelist') : (speakerData.length > 1 ? 'Speakers' : 'Speaker')}
                                </h3>
                                <div class="space-y-6">
                                    ${speakerData.map((speaker: any) => `
                                        <div class="speaker-card bg-gray-50 rounded-lg p-4 sm:p-6">
                                            <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6">
                                                ${speaker.image ? `
                                                    <a href="/speakers#speaker-${speaker.id}"
                                                       class="flex-shrink-0 mx-auto sm:mx-0 group/photo cursor-pointer"
                                                       title="View ${speaker.name}'s full profile">
                                                        <img src="${speaker.image}" alt="${speaker.name}"
                                                             class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover group-hover/photo:ring-4 group-hover/photo:ring-ruby-500 group-hover/photo:scale-105 transition-all duration-300">
                                                    </a>
                                                ` : `
                                                    <a href="/speakers#speaker-${speaker.id}"
                                                       class="flex-shrink-0 mx-auto sm:mx-0 group/photo cursor-pointer"
                                                       title="View ${speaker.name}'s full profile">
                                                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-ruby-400 to-pink-400 flex items-center justify-center group-hover/photo:ring-4 group-hover/photo:ring-ruby-500 group-hover/photo:scale-105 transition-all duration-300">
                                                            <span class="text-white text-xl sm:text-2xl font-bold">
                                                                ${speaker.name.split(' ').map((n: string) => n[0]).join('')}
                                                            </span>
                                                        </div>
                                                    </a>
                                                `}
                                                <div class="flex-1 w-full text-center sm:text-left">
                                                    <h4 class="text-lg font-bold text-gray-900">${speaker.name}</h4>
                                                    ${speaker.role ? `
                                                        <p class="text-gray-600 mb-1">${speaker.role}</p>
                                                    ` : ''}
                                                    ${speaker.company ? `
                                                        <p class="text-gray-600 mb-3">${speaker.company}</p>
                                                    ` : ''}
                                                    ${speaker.bio ? `
                                                        <p class="text-gray-700 mb-4 text-sm sm:text-base">${speaker.bio}</p>
                                                    ` : ''}
                                                    ${speaker.socials && speaker.socials.length > 0 ? `
                                                        <div class="flex gap-3 justify-center sm:justify-start">
                                                            ${speaker.socials.map((url: string) => {
                                                                // Detect social platform from URL
                                                                if (url.includes('twitter.com') || url.includes('x.com')) {
                                                                    return `
                                                                        <a href="${url}" target="_blank" rel="noopener noreferrer"
                                                                           class="text-gray-600 hover:text-ruby-600 transition-colors"
                                                                           title="X (Twitter)">
                                                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                                                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                                                            </svg>
                                                                        </a>
                                                                    `;
                                                                } else if (url.includes('github.com')) {
                                                                    return `
                                                                        <a href="${url}" target="_blank" rel="noopener noreferrer"
                                                                           class="text-gray-600 hover:text-ruby-600 transition-colors"
                                                                           title="GitHub">
                                                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                                                            </svg>
                                                                        </a>
                                                                    `;
                                                                } else if (url.includes('linkedin.com')) {
                                                                    return `
                                                                        <a href="${url}" target="_blank" rel="noopener noreferrer"
                                                                           class="text-gray-600 hover:text-ruby-600 transition-colors"
                                                                           title="LinkedIn">
                                                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                                                            </svg>
                                                                        </a>
                                                                    `;
                                                                } else if (url.includes('bsky.app') || url.includes('bluesky')) {
                                                                    return `
                                                                        <a href="${url}" target="_blank" rel="noopener noreferrer"
                                                                           class="text-gray-600 hover:text-ruby-600 transition-colors"
                                                                           title="Bluesky">
                                                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                                                <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>
                                                                            </svg>
                                                                        </a>
                                                                    `;
                                                                } else {
                                                                    // Generic link icon for other URLs
                                                                    return `
                                                                        <a href="${url}" target="_blank" rel="noopener noreferrer"
                                                                           class="text-gray-600 hover:text-ruby-600 transition-colors"
                                                                           title="Website">
                                                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                                                            </svg>
                                                                        </a>
                                                                    `;
                                                                }
                                                            }).join('')}
                                                        </div>
                                                    ` : ''}
                                                </div>
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <!-- Workshop specific info -->
                        ${talk.type === 'workshop' ? `
                            <div class="bg-emerald-50 border-2 border-emerald-200 rounded-lg p-6 mb-8">
                                <h3 class="text-lg font-bold text-emerald-900 mb-3">Workshop Details</h3>
                                ${talk.duration ? `
                                    <p class="text-emerald-700 mb-2">
                                        <strong>Duration:</strong> ${talk.duration} minutes
                                    </p>
                                ` : ''}
                                ${talk.maxParticipants ? `
                                    <p class="text-emerald-700 mb-2">
                                        <strong>Max Participants:</strong> ${talk.maxParticipants}
                                    </p>
                                ` : ''}
                                ${talk.prerequisites && talk.prerequisites.length > 0 ? `
                                    <div class="text-emerald-700">
                                        <strong>Prerequisites:</strong>
                                        <ul class="list-disc list-inside mt-1">
                                            ${talk.prerequisites.map((pre: string) => `<li>${pre}</li>`).join('')}
                                        </ul>
                                    </div>
                                ` : ''}

                            </div>
                        ` : ''}

                        <!-- Share section -->
                        <div class="border-t pt-6">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-600">Share this talk:</span>
                                    <button onclick="copyTalkLink('${talkId}')" class="text-gray-600 hover:text-ruby-600 transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        </svg>
                                    </button>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Use native dialog API
            (window as any).setTalkModalContent(modalHTML);
            (window as any).openTalkModal();

            // Update URL hash
            history.pushState(null, '', `#${talkId}`);
        }

        // Function to close modal - uses native dialog
        function closeTalkModal() {
            (window as any).closeTalkModal();
        }

        // Function to copy talk link
        (window as any).copyTalkLink = function(talkId: string) {
            const url = `${window.location.origin}${window.location.pathname}#${talkId}`;
            navigator.clipboard.writeText(url).then(() => {
                alert('Link copied to clipboard!');
            });
        };

        // Add click handlers to all talk cards
        // Attach event listeners
        document.querySelectorAll('[data-talk-id]').forEach(button => {
            button.addEventListener('click', () => {
                const talkId = (button as HTMLElement).dataset.talkId;
                const slotId = (button as HTMLElement).dataset.slotId;
                if (talkId && slotId) openTalkModal(talkId, slotId);
            });
        });

        // Add click handlers to special blocks (like lunch)
        document.querySelectorAll('[data-special-id]').forEach(block => {
            block.addEventListener('click', () => {
                const specialId = (block as HTMLElement).dataset.specialId;
                const specialType = (block as HTMLElement).dataset.specialType;
                if (specialType === 'break' && specialId) {
                    const day = specialId.includes('day1') ? 1 : (specialId.includes('day2') ? 2 : 3);
                    openLunchModal(day);
                }
            });
        });

        // Native dialog handles ESC key and backdrop clicks automatically

        // Handle hash on page load
        if (window.location.hash) {
            const talkId = window.location.hash.substring(1);
            // Find the slot for this talk
            const slotId = Object.entries(slotAssignments as any).find(([_, id]) => id === talkId)?.[0];
            if (slotId) {
                setTimeout(() => openTalkModal(talkId, slotId), 100);
            }
        }

        // Handle hash changes
        window.addEventListener('hashchange', () => {
            if (window.location.hash) {
                const talkId = window.location.hash.substring(1);
                const slotId = Object.entries(slotAssignments as any).find(([_, id]) => id === talkId)?.[0];
                if (slotId && modal && !modal.open) {
                    openTalkModal(talkId, slotId);
                }
            } else if (modal && modal.open) {
                closeTalkModal();
            }
        });
    });
</script>
