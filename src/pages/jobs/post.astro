---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
    darkHero={false}
    title="Post a Ruby Job - SF Ruby"
    description="Post your Ruby and Rails job to reach the SF Ruby community. $1,000 for 3 months of visibility."
>
    <section class="pt-28 pb-12 bg-sky-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="px-font text-lg md:text-2xl text-gray-900 mb-5">
                    Post a Job at SF Ruby
                </h1>
                <p class="text-xl text-gray-600">
                    <span class="font-semibold text-ruby-500">$1,000</span> for 3
                    months of visibility
                </p>
            </div>

            <!-- Benefits -->
            <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-12">
                <h2 class="text-xl font-bold text-gray-900 mb-6">
                    What you get
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-green-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Targeted Ruby Audience
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Reach senior engineers and founders actively
                                building with Ruby.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-green-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                90 Days Visibility
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Your job stays live for 3 full months with no
                                renewal required.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-green-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Slack Promotion
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Get featured in our 400+ member Slack community.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-green-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Newsletter Feature
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Included in our weekly newsletter to
                                subscribers.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- How it works -->
            <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-12">
                <h2 class="text-xl font-bold text-gray-900 mb-6">
                    How it works
                </h2>
                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-8 h-8 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center flex-shrink-0"
                        >
                            1
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Fill out the form below
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Provide your company and job details.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-8 h-8 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center flex-shrink-0"
                        >
                            2
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                We'll send you a payment link
                            </h3>
                            <p class="text-gray-600 text-sm">
                                Secure payment via Stripe for $1,000.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-8 h-8 rounded-full bg-ruby-500 text-white font-bold flex items-center justify-center flex-shrink-0"
                        >
                            3
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                Job goes live within 1 business day
                            </h3>
                            <p class="text-gray-600 text-sm">
                                We review and publish your listing promptly.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Embed -->
            <div class="bg-white rounded-2xl border border-gray-200 p-8">
                <h2 class="text-xl font-bold text-gray-900 mb-6">
                    Submit your job
                </h2>

                <div class="aspect-[4/3] bg-gray-50 rounded-xl overflow-hidden">
                    <iframe
                        src="https://docs.google.com/forms/d/e/1FAIpQLSf_example_job_form/viewform?embedded=true"
                        width="100%"
                        height="100%"
                        frameborder="0"
                        marginheight="0"
                        marginwidth="0"
                        title="Job Posting Form"
                        class="w-full h-full min-h-[600px]"
                    >
                        Loading form...
                    </iframe>
                </div>

                <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600">
                        <strong>Having trouble with the form?</strong> Email us at{
                            " "
                        }
                        <a
                            href="mailto:jobs@sfruby.com"
                            class="text-ruby-500 hover:text-ruby-600"
                        >
                            jobs@sfruby.com
                        </a>{" "}
                        with your job details and we'll set everything up for you.
                    </p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
