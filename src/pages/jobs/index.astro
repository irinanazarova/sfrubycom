---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import EmailModal from "../../components/EmailModal.astro";
import PostingRulesModal from "../../components/PostingRulesModal.astro";
import { getSortedJobs, jobCompanyId } from "../../data/jobs.js";
import { getSponsor } from "../../data/sponsors.js";
import { getStartup } from "../../data/startups.js";
import {
    slugify,
    parseWorkType,
    parseGeo,
    parseLevel,
    parseSalary,
    COMPANY_META,
    WORK_TYPE_LABELS,
    WORK_TYPE_ORDER,
    GEO_LABELS,
    GEO_ORDER,
    LEVEL_LABELS,
    LEVEL_ORDER,
    STAGE_ORDER,
    SALARY_THRESHOLDS,
    chipKind,
    orderChips,
} from "../../utils/jobFacets.js";

// Full-text haystack per job for the search box: title, company, location,
// chips, industry/stage, and the description. Lowercased once at build time.
function searchText(job) {
    return [
        job.title,
        job.companyName,
        job.location,
        ...(job.chips || []),
        job.industry,
        job.stage,
        job.description,
    ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();
}

// Enrich each job with company info (sponsor / startup / inline) + derived facets.
const jobs = getSortedJobs().map((job) => {
    let companyName = job.companyName;
    let companyLogo = job.companyLogo || null;
    const companyId = jobCompanyId(job);
    let isYC = false;

    if (job.sponsorId) {
        const sponsor = getSponsor(job.sponsorId);
        companyName = sponsor?.name || job.sponsorId;
        companyLogo = sponsor?.logo || null;
    } else if (job.startupId) {
        const startup = getStartup(job.startupId);
        companyName = startup?.name || job.startupId;
        companyLogo = startup?.logo || null;
        isYC = startup?.isYC || false;
    }

    const meta = COMPANY_META[companyId] || {};
    const salary = parseSalary(job.salary);

    return {
        ...job,
        companyName,
        companyLogo,
        companyId,
        isYC,
        isFeatured: !!job.sponsorId || !!job.featured,
        workType: parseWorkType(job.location),
        geo: parseGeo(job.location),
        level: parseLevel(job.title),
        industry: meta.industry || null,
        stage: meta.stage || null,
        salaryRange: salary,
    };
});

// Sponsors pinned first, then editorially featured listings, then the rest;
// the stable sort keeps recency within each group.
const pinRank = (j) => (j.sponsorId ? 2 : j.featured ? 1 : 0);
jobs.sort((a, b) => pinRank(b) - pinRank(a));

const uniqueCompanies = new Set(jobs.map((j) => j.companyId).filter(Boolean));

// Build filter options with live counts, only for values present in the data.
function multiCounts(valueOf) {
    const counts = {};
    for (const j of jobs) {
        for (const v of valueOf(j)) counts[v] = (counts[v] || 0) + 1;
    }
    return counts;
}

const wtCounts = multiCounts((j) => j.workType);
const geoCounts = multiCounts((j) => j.geo);
const levelCounts = multiCounts((j) => [j.level]);
const industryCounts = multiCounts((j) => (j.industry ? [j.industry] : []));
const stageCounts = multiCounts((j) => (j.stage ? [j.stage] : []));

const workTypeOpts = WORK_TYPE_ORDER.filter((v) => wtCounts[v]).map((v) => ({
    value: v,
    label: WORK_TYPE_LABELS[v],
    count: wtCounts[v],
}));
const geoOpts = GEO_ORDER.filter((v) => geoCounts[v]).map((v) => ({
    value: v,
    label: GEO_LABELS[v],
    count: geoCounts[v],
}));
const levelOpts = LEVEL_ORDER.filter((v) => levelCounts[v]).map((v) => ({
    value: v,
    label: LEVEL_LABELS[v],
    count: levelCounts[v],
}));
const industryOpts = Object.keys(industryCounts)
    .sort((a, b) => industryCounts[b] - industryCounts[a])
    .map((name) => ({ value: slugify(name), label: name, count: industryCounts[name] }));
const stageOpts = STAGE_ORDER.filter((v) => stageCounts[v]).map((name) => ({
    value: slugify(name),
    label: name,
    count: stageCounts[name],
}));
const salaryOpts = SALARY_THRESHOLDS.map((t) => ({
    value: String(t),
    label: `$${t}k+`,
    count: jobs.filter((j) => j.salaryRange && j.salaryRange.max >= t).length,
})).filter((o) => o.count > 0);

const facetGroups = [
    { key: "worktype", label: "Work", options: workTypeOpts },
    { key: "geo", label: "Location", options: geoOpts },
    { key: "level", label: "Level", options: levelOpts },
    { key: "industry", label: "Industry", options: industryOpts },
    { key: "stage", label: "Stage", options: stageOpts },
    { key: "salary", label: "Min salary", options: salaryOpts, single: true },
].filter((g) => g.options.length > 1 || g.single);
---

<BaseLayout
    hashScroll="manual"
    ogImage="/og/jobs.png"
    title="Ruby Jobs - SF Ruby"
    description="Find your next Ruby opportunity. Filter Ruby and Rails roles by location, work arrangement, seniority, industry, and salary."
>
    <PageHero
        title="Ruby Jobs"
        lede="Ruby and Rails roles, from new grad to staff, in the Bay Area, elsewhere in California, and remote across the US. Filter to what fits you."
        next="var(--white)"
    >
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
            <div class="flex items-baseline gap-2">
                <span class="px-font px-shadow-ink text-base md:text-lg text-white">{jobs.length}</span>
                <span class="text-sm md:text-base text-white px-shadow-ink-sm">Open Positions</span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="px-font px-shadow-ink text-base md:text-lg text-gold-400">{uniqueCompanies.size}</span>
                <span class="text-sm md:text-base text-white px-shadow-ink-sm">Companies Hiring</span>
            </div>
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
            <button
                data-email-modal="post-job"
                class="tap-press px-btn px-btn--white px-font text-px9 gap-2 px-5 py-3"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="square" stroke-width="3" d="M12 4v16m8-8H4"></path>
                </svg>
                Post a Job
            </button>
            <button
                type="button"
                data-posting-rules-open
                class="tap-press tap-hit px-font text-px9 text-white px-shadow-ink-sm underline decoration-white/60 underline-offset-4 hover:decoration-white"
            >
                Posting rules
            </button>
        </div>
    </PageHero>

    <!-- Jobs: filters (left) + results (right) -->
    <section class="bg-white">
        <div id="jobs-app" data-filters="closed" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Mobile filter toggle bar -->
            <div class="lg:hidden sticky top-20 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2.5 bg-white/95 backdrop-blur-md border-b-2 border-ink flex items-center justify-between gap-3">
                <button id="filter-open" type="button" class="tap-press px-btn px-btn--white px-font text-px9 gap-2 px-3.5 py-2.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M3 4h18v2.5l-7 7.5v6l-4 2v-8L3 6.5z"></path></svg>
                    Filters
                    <span class="active-badge hidden inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 bg-gold-500 text-ink border-2 border-ink text-px9">0</span>
                </button>
                <span class="text-sm text-dark-700"><span class="result-count font-semibold text-ink">{jobs.length}</span> roles</span>
            </div>

            <div class="lg:grid lg:grid-cols-[15rem_1fr] xl:grid-cols-[16rem_1fr] lg:gap-10 lg:py-10">

                <!-- Dim backdrop behind the mobile filter sheet -->
                <div id="filter-backdrop" class="lg:hidden" aria-hidden="true"></div>

                <!-- Filter sidebar (desktop) / bottom sheet (mobile) -->
                <aside id="filter-panel" class="filter-panel py-6 lg:py-0">
                    <!-- Mobile-only drag handle -->
                    <div class="filter-grabber lg:hidden" aria-hidden="true"></div>
                    <div class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1 lg:-mr-1">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="px-font text-px10 text-ink">Filters</h2>
                            <button id="clear-filters" type="button" class="tap-hit hidden text-sm font-semibold text-ruby-700 underline underline-offset-4 hover:text-ruby-800">
                                Clear all
                            </button>
                        </div>

                        {facetGroups.map((group) => (
                            <div class="facet-group">
                                <h3 class="facet-label px-font">{group.label}</h3>
                                <div class="flex flex-wrap gap-2">
                                    {group.options.map((opt) => (
                                        <button
                                            type="button"
                                            class="chip"
                                            data-facet={group.key}
                                            data-value={opt.value}
                                            data-single={group.single ? "true" : undefined}
                                        >
                                            {opt.label}
                                            <span class="chip-count">{opt.count}</span>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        ))}

                        <!-- Mobile-only: apply / clear -->
                        <div class="lg:hidden sticky bottom-0 -mx-4 sm:-mx-6 mt-6 px-4 sm:px-6 py-3 bg-white border-t-2 border-ink flex items-center gap-4">
                            <button id="filter-done" type="button" class="tap-press flex-1 px-btn px-btn--gold px-font text-px10 px-5 py-3">
                                Show <span class="result-count">{jobs.length}</span> results
                            </button>
                            <button id="clear-filters-mobile" type="button" class="tap-hit px-2 py-2.5 text-sm font-semibold text-dark-700 underline underline-offset-4 hover:text-ruby-700">
                                Clear
                            </button>
                        </div>
                    </div>
                </aside>

                <!-- Results -->
                <div class="min-w-0 pt-4 pb-12 lg:pt-0 lg:pb-0">
                    <!-- Text search -->
                    <div class="relative mb-4">
                        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <input
                            id="job-search"
                            type="search"
                            autocomplete="off"
                            enterkeyhint="search"
                            placeholder="Search roles, companies, stack…"
                            aria-label="Search jobs by role, company, or stack"
                            class="job-search w-full h-11 pl-10 pr-10 bg-white text-base text-ink placeholder:text-dark-500 focus:outline-none"
                        />
                        <button id="job-search-clear" type="button" aria-label="Clear search" class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 inline-flex items-center justify-center text-dark-500 hover:text-ink hover:bg-dark-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>

                    <div class="hidden lg:flex items-center justify-between mb-4">
                        <p class="text-sm text-dark-600">
                            Showing <span class="result-count font-semibold text-ink">{jobs.length}</span> of {jobs.length} roles
                        </p>
                    </div>

                    <div id="jobs-list" class="space-y-3 sm:space-y-4">
                        {jobs.map((job) => (
                            <article
                                id={job.id}
                                class="job-row scroll-mt-28 bg-white"
                                data-worktype={job.workType.join(" ")}
                                data-geo={job.geo.join(" ")}
                                data-level={job.level}
                                data-industry={job.industry ? slugify(job.industry) : ""}
                                data-stage={job.stage ? slugify(job.stage) : ""}
                                data-salmax={job.salaryRange ? job.salaryRange.max : ""}
                                data-search={searchText(job)}
                            >
                                <div class="p-3 sm:p-4">
                                    <!-- logo, title, company -->
                                    <div class="flex items-start gap-3 sm:gap-4">
                                        {job.companyLogo ? (
                                            <div class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-white border-2 border-dark-200 flex items-center justify-center overflow-hidden">
                                                <img src={job.companyLogo} alt={job.companyName} class="w-full h-full object-contain p-0.5 sm:p-1" loading="lazy" />
                                            </div>
                                        ) : (
                                            <div class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-ruby-50 border-2 border-ruby-200 flex items-center justify-center px-font text-sm text-ruby-700">
                                                {job.companyName?.[0] ?? "?"}
                                            </div>
                                        )}

                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-display font-semibold text-base sm:text-lg leading-tight sm:leading-snug text-ink">
                                                {job.title}
                                            </h3>
                                            <p class="mt-1 flex items-center gap-2 min-w-0 font-display text-sm text-dark-700">
                                                <span class="truncate">
                                                    <span class="font-semibold text-ink">{job.companyName}</span>
                                                    {job.industry && <span class="hidden sm:inline"><span class="text-dark-400" aria-hidden="true"> · </span>{job.industry}</span>}
                                                    {job.stage && <span class="hidden sm:inline"><span class="text-dark-400" aria-hidden="true"> · </span>{job.stage}</span>}
                                                </span>
                                                {job.isFeatured && <span class="job-badge job-badge--featured">Featured</span>}
                                                {job.isYC && <span class="job-badge job-badge--yc">YC</span>}
                                            </p>
                                        </div>

                                        <a
                                            href={`#${job.id}`}
                                            class="copy-link tap-hit shrink-0 mt-1"
                                            data-job-id={job.id}
                                            aria-label="Copy link to this role"
                                            title="Copy link to this role"
                                        >
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5"></path></svg>
                                        </a>
                                    </div>

                                    <!-- where, level, pay + Apply -->
                                    <div class="mt-2 flex items-center gap-3 sm:gap-4 sm:pl-16">
                                        <p class="job-meta flex-1 min-w-0 font-display text-sm leading-snug text-dark-700">
                                            <span>
                                                <svg class="inline-block w-3.5 h-3.5 mr-0.5 align-[-2px] text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                                {job.location}
                                            </span><span class="hidden sm:inline"><span class="text-dark-400" aria-hidden="true"> · </span>{LEVEL_LABELS[job.level]}</span>{job.salary && (
                                                <span class="block sm:inline"><span class="hidden sm:inline text-dark-400" aria-hidden="true"> · </span><span class="font-semibold text-grass-700">{job.salary}</span></span>
                                            )}
                                        </p>
                                        <a
                                            href={job.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="tap-press shrink-0 px-btn px-btn--gold job-apply px-font text-px9 sm:text-px10 gap-1.5 px-3.5 py-2.5 sm:px-4"
                                        >
                                            Apply
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="3" d="M14 5l7 7-7 7M21 12H3"></path></svg>
                                        </a>
                                    </div>

                                    <!-- chips + details -->
                                    <div class="mt-2 flex items-center gap-3 sm:pl-16">
                                        {job.chips && job.chips.length > 0 ? (
                                            <div class="job-chips flex-1 min-w-0" data-chips={job.chips.join(" ")}>
                                                <div class="job-chips-track flex gap-1.5 sm:flex-wrap">
                                                    {orderChips(job.chips).map((chip) => (
                                                        <span class={`job-chip job-chip--${chipKind(chip)}`}>{chip}</span>
                                                    ))}
                                                </div>
                                            </div>
                                        ) : (
                                            <div class="flex-1" />
                                        )}
                                        <button
                                            type="button"
                                            class="more-btn tap-hit shrink-0 inline-flex items-center gap-1 text-sm font-medium text-dark-700 hover:text-ruby-700"
                                            aria-expanded="false"
                                        >
                                            <span class="more-label">Details</span>
                                            <svg class="more-chevron w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="more-panel hidden border-t-2 border-dark-100 px-3 sm:px-5 py-4 sm:pl-[5.25rem]">
                                    <p class="font-display text-sm sm:text-base text-dark-800 leading-relaxed">{job.description}</p>
                                    <a
                                        href={job.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-ruby-700 underline underline-offset-4 hover:text-ruby-800"
                                    >
                                        View full posting
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                    </a>
                                </div>
                            </article>
                        ))}
                    </div>

                    <!-- Empty State (filtered to nothing) -->
                    <div id="no-results" class="hidden text-center py-16">
                        <h3 class="px-font text-px10 md:text-xs text-ink mb-3">No roles match these filters</h3>
                        <p class="text-dark-700 mb-6">Try removing a filter to widen your search.</p>
                        <button id="clear-filters-empty" type="button" class="tap-press px-btn px-btn--gold px-font text-px10 px-5 py-3">
                            Clear all filters
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Post / Host CTA -->
    <section class="py-16 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="px-card px-sky-grad-dusk p-6 md:p-8 text-white flex flex-col md:flex-row items-start md:items-center gap-6 justify-between">
                <div>
                    <div class="px-font text-px9 text-gold-400 mb-3">
                        For companies serious about hiring
                    </div>
                    <h3 class="font-display text-xl md:text-2xl font-bold mb-2 px-shadow-ink-sm">
                        Host a meetup, meet 60–100 Bay Area Ruby engineers in one night
                    </h3>
                    <p class="text-white text-sm md:text-base max-w-2xl">
                        Hosting reaches the same audience as a job post, in person, with your engineers on stage and your team meeting candidates face-to-face.
                    </p>
                </div>
                <a
                    href="/host"
                    class="tap-press px-btn px-btn--gold px-font text-px10 gap-2 px-5 py-3.5 whitespace-nowrap shrink-0"
                >
                    See how to host
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="square" stroke-width="3" d="M14 5l7 7-7 7M21 12H3"></path></svg>
                </a>
            </div>
        </div>
    </section>

    <EmailModal
        id="post-job"
        email="irina@evilmartians.com"
        subject="Post a Job on SF Ruby"
        title="Post a Job"
    />

    <style>
        /* Suppress the native search clear/decoration; we render our own ×. */
        #job-search::-webkit-search-cancel-button,
        #job-search::-webkit-search-decoration {
            -webkit-appearance: none;
            appearance: none;
        }
        .facet-group {
            margin-bottom: 1.5rem;
        }
        .facet-label {
            font-size: 0.5625rem;
            color: var(--dark-600);
            margin-bottom: 0.625rem;
        }
        /* Filter options: square, ink-lined, gold when on (the site's primary
           accent), like a pressed px-btn. */
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.3125rem 0.625rem;
            border-radius: 0;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.25rem;
            color: var(--dark-800);
            background: var(--white);
            border: 2px solid var(--dark-300);
            cursor: pointer;
            transition: border-color 0.12s, background-color 0.12s;
            white-space: nowrap;
        }
        .chip:hover {
            border-color: var(--px-ink);
        }
        .chip-active {
            color: var(--px-ink);
            background: var(--px-gold);
            border-color: var(--px-ink);
            box-shadow: 2px 2px 0 0 var(--px-ink);
        }
        .chip-count {
            font-size: 0.75rem;
            color: var(--dark-500);
        }
        .chip-active .chip-count {
            color: var(--px-ink);
        }
        /* Options that would narrow results to zero, and facets with no options
           left, are removed from the panel until the selection changes. */
        .chip-hidden,
        .facet-group-hidden {
            display: none;
        }

        /* Job row: a lighter px-card (3px ink line, 4px hard shadow) so three
           rows still fit a phone screen. */
        .job-row {
            border: 3px solid var(--px-ink);
            border-radius: 0;
            box-shadow: 4px 4px 0 0 var(--px-ink);
        }
        .job-row:target {
            outline: 4px solid var(--px-gold);
            outline-offset: 2px;
        }
        .job-search {
            border: 3px solid var(--px-ink);
            border-radius: 0;
            box-shadow: 3px 3px 0 0 var(--px-ink);
        }
        .job-search:focus {
            outline: 3px solid var(--px-gold);
            outline-offset: 2px;
        }

        /* Matching chips: three kinds (focus / stack / signal), square, told
           apart by palette. Labels are the one place under 14px (12px). */
        .job-chip {
            display: inline-flex;
            align-items: center;
            flex: none;
            padding: 0.125rem 0.4375rem;
            border: 2px solid;
            border-radius: 0;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1rem;
            white-space: nowrap;
        }
        .job-chip--focus {
            color: var(--ruby-800);
            background: var(--ruby-50);
            border-color: var(--ruby-300);
        }
        .job-chip--stack {
            color: var(--sky-900);
            background: var(--sky-50);
            border-color: var(--sky-300);
        }
        .job-chip--signal {
            color: var(--px-ink);
            background: var(--gold-100);
            border-color: var(--gold-600);
        }
        .job-badge {
            flex: none;
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.375rem;
            border: 2px solid var(--px-ink);
            font-family: "Press Start 2P", "Martian Mono", monospace;
            font-size: 0.5rem;
            line-height: 1;
            text-transform: uppercase;
        }
        .job-badge--featured {
            background: var(--px-gold);
            color: var(--px-ink);
        }
        .job-badge--yc {
            background: var(--pumpkin-500);
            color: var(--px-ink);
        }
        .job-apply {
            box-shadow: 4px 4px 0 0 var(--px-ink);
        }

        /* Phones: the chips stay one row that scrolls sideways and fades at
           the edge while more are hidden (is-clipped, set by the script), so a
           long chip list never adds height to the row. */
        @media (max-width: 639px) {
            .job-chips {
                overflow-x: auto;
                overscroll-behavior-x: contain;
                scrollbar-width: none;
            }
            .job-chips::-webkit-scrollbar {
                display: none;
            }
            .job-chips.is-clipped {
                -webkit-mask-image: linear-gradient(to right, black calc(100% - 2.5rem), transparent);
                mask-image: linear-gradient(to right, black calc(100% - 2.5rem), transparent);
            }
        }

        .copy-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            color: var(--dark-400);
            opacity: 0;
            transition: opacity 0.15s, color 0.15s;
        }
        .job-row:hover .copy-link,
        .copy-link:focus-visible {
            opacity: 1;
        }
        .copy-link:hover {
            color: var(--ruby-600);
        }
        .copy-link.copied {
            color: var(--grass-700);
            opacity: 1;
        }
        .copy-link.copied::after {
            content: "Link copied";
            position: absolute;
            left: 50%;
            bottom: calc(100% + 0.35rem);
            transform: translateX(-50%);
            white-space: nowrap;
            background: var(--dark-900);
            color: var(--white);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.2rem 0.45rem;
            border-radius: 0;
            pointer-events: none;
        }
        @media (max-width: 1023px) {
            /* Always tappable on touch devices (no hover). */
            .copy-link {
                opacity: 1;
            }
        }

        /* Mobile: filter panel is an iOS-style bottom sheet (rounded top, grab
           handle, drag-to-dismiss, dim backdrop). On desktop it is always a
           visible sidebar regardless of the data-filters state. */
        .filter-grabber {
            display: none;
        }
        @media (max-width: 1023px) {
            #jobs-app[data-filters="closed"] #filter-panel,
            #jobs-app[data-filters="closed"] #filter-backdrop {
                display: none;
            }

            #filter-backdrop {
                position: fixed;
                inset: 0;
                z-index: 45; /* above the bottom tab bar (z-40) */
                background: rgba(17, 24, 39, 0.45);
                opacity: 0;
                animation: filter-backdrop-in 0.28s ease forwards;
            }

            #jobs-app[data-filters="open"] #filter-panel {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                top: auto;
                z-index: 46; /* above the bottom tab bar (z-40) and its backdrop */
                max-height: 85vh; /* fallback for iOS < 15.4 */
                max-height: 85dvh;
                overflow-y: auto;
                overscroll-behavior: contain;
                background: var(--white);
                border-radius: 0;
                border-top: 4px solid var(--px-ink);
                padding: 0 1rem env(safe-area-inset-bottom);
                animation: filter-sheet-up 0.32s cubic-bezier(0.32, 0.72, 0, 1);
                will-change: transform;
            }

            .filter-grabber {
                position: sticky;
                top: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 0.625rem 0 0.5rem;
                margin: 0 -1rem;
                background: var(--white);
                border-radius: 0;
                cursor: grab;
                touch-action: none;
                z-index: 2;
            }
            .filter-grabber::before {
                content: "";
                width: 2.25rem;
                height: 0.375rem;
                border-radius: 0;
                background: var(--px-ink);
            }
        }
        @keyframes filter-sheet-up {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
        @keyframes filter-backdrop-in {
            to { opacity: 1; }
        }
    </style>

    <script>
        const app = document.getElementById("jobs-app")!;
        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"));
        const facetGroupEls = Array.from(
            document.querySelectorAll<HTMLElement>(".facet-group"),
        );
        const rows = Array.from(document.querySelectorAll<HTMLElement>(".job-row"));
        const countEls = Array.from(document.querySelectorAll<HTMLElement>(".result-count"));
        const badges = Array.from(document.querySelectorAll<HTMLElement>(".active-badge"));
        const noResults = document.getElementById("no-results");
        const list = document.getElementById("jobs-list");
        const clearBtns = Array.from(
            document.querySelectorAll<HTMLButtonElement>(
                "#clear-filters, #clear-filters-mobile, #clear-filters-empty",
            ),
        );
        const searchInput = document.getElementById("job-search") as HTMLInputElement | null;
        const searchClear = document.getElementById("job-search-clear");
        let searchTerms: string[] = [];

        type Facet = "worktype" | "geo" | "level" | "industry" | "stage";
        const multiFacets: Facet[] = ["worktype", "geo", "level", "industry", "stage"];
        const state: Record<Facet, Set<string>> = {
            worktype: new Set(),
            geo: new Set(),
            level: new Set(),
            industry: new Set(),
            stage: new Set(),
        };
        let salaryMin: number | null = null;

        function tokens(el: HTMLElement, attr: string): string[] {
            const v = el.getAttribute(attr);
            return v ? v.split(" ").filter(Boolean) : [];
        }

        function matchFacet(rowTokens: string[], active: Set<string>): boolean {
            if (active.size === 0) return true;
            return rowTokens.some((t) => active.has(t));
        }

        // Precompute each row's facet data once, so recounting on every click is cheap.
        const rowData = rows.map((el) => ({
            el,
            worktype: tokens(el, "data-worktype"),
            geo: tokens(el, "data-geo"),
            level: el.getAttribute("data-level") || "",
            industry: el.getAttribute("data-industry") || "",
            stage: el.getAttribute("data-stage") || "",
            salmax: el.getAttribute("data-salmax")
                ? Number(el.getAttribute("data-salmax"))
                : null,
            search: el.getAttribute("data-search") || "",
        }));
        type Row = (typeof rowData)[number];

        type FilterState = {
            worktype: Set<string>;
            geo: Set<string>;
            level: Set<string>;
            industry: Set<string>;
            stage: Set<string>;
            salaryMin: number | null;
            search: string[];
        };

        function snapshot(): FilterState {
            return {
                worktype: state.worktype,
                geo: state.geo,
                level: state.level,
                industry: state.industry,
                stage: state.stage,
                salaryMin,
                search: searchTerms,
            };
        }

        function facetTokens(d: Row, facet: string): string[] {
            if (facet === "worktype") return d.worktype;
            if (facet === "geo") return d.geo;
            if (facet === "level") return [d.level];
            if (facet === "industry") return [d.industry];
            if (facet === "stage") return [d.stage];
            return [];
        }

        function rowMatches(d: Row, st: FilterState): boolean {
            return (
                matchFacet(d.worktype, st.worktype) &&
                matchFacet(d.geo, st.geo) &&
                matchFacet([d.level], st.level) &&
                matchFacet([d.industry], st.industry) &&
                matchFacet([d.stage], st.stage) &&
                (st.salaryMin === null ||
                    (d.salmax !== null && d.salmax >= st.salaryMin)) &&
                // Every search term must appear (AND) in the row's haystack.
                st.search.every((t) => d.search.includes(t))
            );
        }

        function countMatches(st: FilterState): number {
            let n = 0;
            for (const d of rowData) if (rowMatches(d, st)) n++;
            return n;
        }

        function apply() {
            const cur = snapshot();
            let visible = 0;
            for (const d of rowData) {
                const ok = rowMatches(d, cur);
                d.el.style.display = ok ? "" : "none";
                if (ok) visible++;
            }
            for (const el of countEls) el.textContent = String(visible);
            if (noResults) noResults.classList.toggle("hidden", visible !== 0);
            if (list) list.classList.toggle("hidden", visible === 0);

            const activeCount =
                multiFacets.reduce((n, f) => n + state[f].size, 0) +
                (salaryMin !== null ? 1 : 0);
            const hasSearch = searchTerms.length > 0;
            // Clear buttons appear for facets OR search; the filter-drawer badge
            // stays facet-only (search lives outside the drawer).
            for (const btn of clearBtns)
                btn.classList.toggle("hidden", activeCount === 0 && !hasSearch);
            for (const badge of badges) {
                badge.textContent = String(activeCount);
                badge.classList.toggle("hidden", activeCount === 0);
            }
            if (searchClear) searchClear.classList.toggle("hidden", !hasSearch);

            updateChips(cur);
        }

        // Conditional facet counts (disjunctive faceting): every chip's number is
        // recomputed against the CURRENT selection. An inactive chip shows the
        // result count you'd get by clicking it on top of what you have now (a
        // second value in the same facet widens via OR; a value in another facet
        // narrows via AND). An active chip shows its share of the current results.
        // Inactive options that would narrow the list to zero are hidden, and a
        // facet whose options all disappear is hidden entirely, so the panel only
        // ever offers filters that lead somewhere.
        function updateChips(cur: FilterState) {
            const visibleRows = rowData.filter((d) => rowMatches(d, cur));
            for (const chip of chips) {
                const facet = chip.dataset.facet!;
                const value = chip.dataset.value!;
                const isSalary = chip.dataset.single === "true";
                const active = isSalary
                    ? salaryMin === Number(value)
                    : state[facet as Facet].has(value);

                let count: number;
                if (active) {
                    count = isSalary
                        ? visibleRows.length
                        : visibleRows.filter((d) =>
                              facetTokens(d, facet).includes(value),
                          ).length;
                } else if (isSalary) {
                    count = countMatches({ ...cur, salaryMin: Number(value) });
                } else {
                    const next = new Set(cur[facet as Facet]);
                    next.add(value);
                    count = countMatches({ ...cur, [facet]: next });
                }

                const countEl = chip.querySelector(".chip-count");
                if (countEl) countEl.textContent = String(count);

                chip.classList.toggle("chip-hidden", !active && count === 0);
            }

            // Hide a facet group once none of its options remain available.
            for (const group of facetGroupEls) {
                const anyVisible = Array.from(
                    group.querySelectorAll<HTMLElement>(".chip"),
                ).some((c) => !c.classList.contains("chip-hidden"));
                group.classList.toggle("facet-group-hidden", !anyVisible);
            }
        }

        // Bring results back into view from the top when filters change, so you
        // are never left mid-list looking at rows that shifted under you. On
        // desktop only scroll up (don't yank you down mid-browse); when forced
        // (mobile "Show results") always land on the list. No-op while the
        // mobile drawer is open, since the results are hidden behind it.
        function scrollToListTop(force = false) {
            if (!list) return;
            if (document.body.classList.contains("overflow-hidden")) return;
            const isMobile = window.matchMedia("(max-width: 1023px)").matches;
            const offset = isMobile ? 140 : 96; // clear fixed header (+ mobile filter bar)
            const target = Math.max(
                0,
                list.getBoundingClientRect().top + window.scrollY - offset,
            );
            if (force || window.scrollY > target) {
                window.scrollTo({ top: target, behavior: "smooth" });
            }
        }

        for (const chip of chips) {
            chip.addEventListener("click", () => {
                const facet = chip.dataset.facet!;
                const value = chip.dataset.value!;
                if (chip.dataset.single === "true") {
                    const t = Number(value);
                    const wasActive = chip.classList.contains("chip-active");
                    for (const c of chips) {
                        if (c.dataset.facet === facet) c.classList.remove("chip-active");
                    }
                    if (wasActive) {
                        salaryMin = null;
                    } else {
                        salaryMin = t;
                        chip.classList.add("chip-active");
                    }
                } else {
                    const set = state[facet as Facet];
                    if (set.has(value)) {
                        set.delete(value);
                        chip.classList.remove("chip-active");
                    } else {
                        set.add(value);
                        chip.classList.add("chip-active");
                    }
                }
                apply();
                scrollToListTop();
            });
        }

        function clearAll() {
            for (const f of multiFacets) state[f].clear();
            salaryMin = null;
            for (const c of chips) c.classList.remove("chip-active");
            searchTerms = [];
            if (searchInput) searchInput.value = "";
            apply();
            scrollToListTop();
        }
        for (const btn of clearBtns) btn.addEventListener("click", clearAll);

        // Text search: split on whitespace, AND the terms. No debounce needed at
        // this row count; filtering is a cheap in-memory pass.
        function readSearch() {
            searchTerms = (searchInput?.value || "")
                .toLowerCase()
                .split(/\s+/)
                .filter(Boolean);
        }
        searchInput?.addEventListener("input", () => {
            readSearch();
            apply();
        });
        searchClear?.addEventListener("click", () => {
            if (searchInput) searchInput.value = "";
            searchTerms = [];
            apply();
            searchInput?.focus();
        });

        // Initialize conditional counts / availability on load.
        apply();

        // Mobile filter sheet: closed on load so the list is readable first; opens via the Filters button.
        const mql = window.matchMedia("(max-width: 1023px)");
        const panel = document.getElementById("filter-panel");
        const backdrop = document.getElementById("filter-backdrop");
        const grabber = document.querySelector<HTMLElement>(".filter-grabber");

        function setDrawer(open: boolean) {
            app.dataset.filters = open ? "open" : "closed";
            document.body.classList.toggle("overflow-hidden", open && mql.matches);
            // Clear any leftover drag transform so the open animation runs clean.
            if (open && panel) {
                panel.style.transition = "";
                panel.style.transform = "";
            }
        }
        document.getElementById("filter-open")?.addEventListener("click", () => setDrawer(true));
        document.getElementById("filter-done")?.addEventListener("click", () => {
            setDrawer(false);
            scrollToListTop(true);
        });
        // Tap the dim backdrop to dismiss.
        backdrop?.addEventListener("click", () => setDrawer(false));

        // Drag the grab handle down to dismiss, like an iOS sheet. Follows the
        // finger; past ~30% of the sheet height (or a quick flick) it closes,
        // otherwise it springs back.
        if (grabber && panel) {
            let startY = 0;
            let dy = 0;
            let dragging = false;
            const spring = "transform 0.32s cubic-bezier(0.32, 0.72, 0, 1)";

            grabber.addEventListener("touchstart", (e) => {
                dragging = true;
                startY = e.touches[0].clientY;
                dy = 0;
                panel.style.transition = "none";
            }, { passive: true });

            grabber.addEventListener("touchmove", (e) => {
                if (!dragging) return;
                dy = Math.max(0, e.touches[0].clientY - startY);
                panel.style.transform = `translateY(${dy}px)`;
            }, { passive: true });

            grabber.addEventListener("touchend", () => {
                if (!dragging) return;
                dragging = false;
                panel.style.transition = spring;
                if (dy > panel.offsetHeight * 0.3 || dy > 140) {
                    panel.style.transform = `translateY(100%)`;
                    window.setTimeout(() => setDrawer(false), 220);
                } else {
                    panel.style.transform = "translateY(0)";
                }
            });

            // If the OS cancels the gesture mid-drag (incoming call, system
            // edge-swipe), spring back instead of leaving the sheet frozen at
            // the dragged offset.
            grabber.addEventListener("touchcancel", () => {
                if (!dragging) return;
                dragging = false;
                panel.style.transition = spring;
                panel.style.transform = "translateY(0)";
            });
        }
        // Resolve a deep link to a specific card (/jobs#job-id) up front.
        const hashEl =
            location.hash.length > 1
                ? document.getElementById(decodeURIComponent(location.hash.slice(1)))
                : null;
        const deepLink = hashEl?.classList.contains("job-row") ? hashEl : null;

        // The sheet starts closed (markup default). A deep link re-asserts that
        // so the linked card is visible even if state was left open (harmless on
        // desktop, where the panel is a static sidebar).
        if (deepLink) setDrawer(false);

        // Cold-load deep link: the native on-load hash scroll animates (global
        // scroll-behavior: smooth) over a long distance and lands stale, and
        // lazy images keep shifting the target. Jump instantly each frame, with
        // scroll-behavior forced to auto so the native smooth scroll can't fight
        // us, until the position holds steady; then restore smooth.
        if (deepLink) {
            const root = document.documentElement;
            const prevBehavior = root.style.scrollBehavior;
            root.style.scrollBehavior = "auto";
            let stable = 0;
            let frames = 0;
            const converge = () => {
                const offset = mql.matches ? 140 : 96; // header (+ mobile filter bar)
                const y = Math.max(
                    0,
                    deepLink.getBoundingClientRect().top + window.scrollY - offset,
                );
                window.scrollTo(0, y);
                stable = Math.abs(y - window.scrollY) < 2 ? stable + 1 : 0;
                if (stable < 3 && ++frames < 120) requestAnimationFrame(converge);
                else root.style.scrollBehavior = prevBehavior;
            };
            requestAnimationFrame(converge);
        }

        // Per-card anchor links: scroll + highlight, and copy a shareable URL.
        for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>(".copy-link"))) {
            link.addEventListener("click", (e) => {
                const id = link.dataset.jobId!;
                e.preventDefault();
                location.hash = id; // scrolls to the card (scroll-mt) and triggers :target
                if (navigator.clipboard) {
                    const url = location.origin + location.pathname + "#" + id;
                    navigator.clipboard.writeText(url).catch(() => {});
                    link.classList.add("copied");
                    window.setTimeout(() => link.classList.remove("copied"), 1400);
                }
            });
        }
        // If the viewport crosses the breakpoint, never leave the body scroll-locked.
        mql.addEventListener("change", (e) => {
            if (!e.matches) document.body.classList.remove("overflow-hidden");
        });

        // Expand / collapse "Details"
        for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>(".more-btn"))) {
            btn.addEventListener("click", () => {
                const row = btn.closest(".job-row");
                const panel = row?.querySelector<HTMLElement>(".more-panel");
                const label = btn.querySelector<HTMLElement>(".more-label");
                const chevron = btn.querySelector<HTMLElement>(".more-chevron");
                if (!panel) return;
                const open = panel.classList.toggle("hidden");
                btn.setAttribute("aria-expanded", String(!open));
                if (label) label.textContent = open ? "Details" : "Hide";
                if (chevron) chevron.style.transform = open ? "" : "rotate(180deg)";
            });
        }

        // Phones: fade the chip row's right edge only while chips are hidden
        // past it; scrolled to the end (or nothing hidden), no fade.
        const chipRows = Array.from(document.querySelectorAll<HTMLElement>(".job-chips"));
        const markClipped = (el: HTMLElement) =>
            el.classList.toggle(
                "is-clipped",
                el.scrollWidth - el.clientWidth - el.scrollLeft > 2,
            );
        for (const el of chipRows) {
            markClipped(el);
            el.addEventListener("scroll", () => markClipped(el), { passive: true });
        }
        window.addEventListener("resize", () => chipRows.forEach(markClipped), { passive: true });
    </script>
<PostingRulesModal />
</BaseLayout>
