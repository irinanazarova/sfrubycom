---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailModal from "../../components/EmailModal.astro";
import { getSortedJobs } from "../../data/jobs.js";
import { getSponsor } from "../../data/sponsors.js";
import { getStartup } from "../../data/startups.js";
import {
    slugify,
    parseWorkType,
    parseGeo,
    parseLevel,
    parseSalary,
    COMPANY_META,
    WORK_TYPE_LABELS,
    WORK_TYPE_ORDER,
    GEO_LABELS,
    GEO_ORDER,
    LEVEL_LABELS,
    LEVEL_ORDER,
    STAGE_ORDER,
    SALARY_THRESHOLDS,
    chipKind,
    orderChips,
} from "../../utils/jobFacets.js";

// Chip pill styling per kind (focus / stack / signal).
const CHIP_CLASS = {
    focus: "border-ruby-200 text-ruby-700 bg-ruby-50/60",
    stack: "border-indigo-200 text-indigo-700 bg-indigo-50/60",
    signal: "border-amber-200 text-amber-800 bg-amber-50/60",
};

// Full-text haystack per job for the search box: title, company, location,
// chips, industry/stage, and the description. Lowercased once at build time.
function searchText(job) {
    return [
        job.title,
        job.companyName,
        job.location,
        ...(job.chips || []),
        job.industry,
        job.stage,
        job.description,
    ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();
}

// Enrich each job with company info (sponsor / startup / inline) + derived facets.
const jobs = getSortedJobs().map((job) => {
    let companyName = job.companyName;
    let companyLogo = job.companyLogo || null;
    let companyId = job.companyId || null;
    let isYC = false;

    if (job.sponsorId) {
        const sponsor = getSponsor(job.sponsorId);
        companyName = sponsor?.name || job.sponsorId;
        companyLogo = sponsor?.logo || null;
        companyId = job.sponsorId;
    } else if (job.startupId) {
        const startup = getStartup(job.startupId);
        companyName = startup?.name || job.startupId;
        companyLogo = startup?.logo || null;
        companyId = job.startupId;
        isYC = startup?.isYC || false;
    }

    const meta = COMPANY_META[companyId] || {};
    const salary = parseSalary(job.salary);

    return {
        ...job,
        companyName,
        companyLogo,
        companyId,
        isYC,
        isFeatured: !!job.sponsorId,
        workType: parseWorkType(job.location),
        geo: parseGeo(job.location),
        level: parseLevel(job.title),
        industry: meta.industry || null,
        stage: meta.stage || null,
        salaryRange: salary,
    };
});

// Sponsors pinned: stable sort puts featured first, recency preserved within.
jobs.sort((a, b) => (b.isFeatured ? 1 : 0) - (a.isFeatured ? 1 : 0));

const uniqueCompanies = new Set(jobs.map((j) => j.companyId).filter(Boolean));

// Build filter options with live counts, only for values present in the data.
function multiCounts(valueOf) {
    const counts = {};
    for (const j of jobs) {
        for (const v of valueOf(j)) counts[v] = (counts[v] || 0) + 1;
    }
    return counts;
}

const wtCounts = multiCounts((j) => j.workType);
const geoCounts = multiCounts((j) => j.geo);
const levelCounts = multiCounts((j) => [j.level]);
const industryCounts = multiCounts((j) => (j.industry ? [j.industry] : []));
const stageCounts = multiCounts((j) => (j.stage ? [j.stage] : []));

const workTypeOpts = WORK_TYPE_ORDER.filter((v) => wtCounts[v]).map((v) => ({
    value: v,
    label: WORK_TYPE_LABELS[v],
    count: wtCounts[v],
}));
const geoOpts = GEO_ORDER.filter((v) => geoCounts[v]).map((v) => ({
    value: v,
    label: GEO_LABELS[v],
    count: geoCounts[v],
}));
const levelOpts = LEVEL_ORDER.filter((v) => levelCounts[v]).map((v) => ({
    value: v,
    label: LEVEL_LABELS[v],
    count: levelCounts[v],
}));
const industryOpts = Object.keys(industryCounts)
    .sort((a, b) => industryCounts[b] - industryCounts[a])
    .map((name) => ({ value: slugify(name), label: name, count: industryCounts[name] }));
const stageOpts = STAGE_ORDER.filter((v) => stageCounts[v]).map((name) => ({
    value: slugify(name),
    label: name,
    count: stageCounts[name],
}));
const salaryOpts = SALARY_THRESHOLDS.map((t) => ({
    value: String(t),
    label: `$${t}k+`,
    count: jobs.filter((j) => j.salaryRange && j.salaryRange.max >= t).length,
})).filter((o) => o.count > 0);

const facetGroups = [
    { key: "worktype", label: "Work", options: workTypeOpts },
    { key: "geo", label: "Location", options: geoOpts },
    { key: "level", label: "Level", options: levelOpts },
    { key: "industry", label: "Industry", options: industryOpts },
    { key: "stage", label: "Stage", options: stageOpts },
    { key: "salary", label: "Min salary", options: salaryOpts, single: true },
].filter((g) => g.options.length > 1 || g.single);
---

<BaseLayout
    title="Ruby Jobs - SF Ruby"
    description="Find your next Ruby opportunity. Filter Ruby and Rails roles by location, work arrangement, seniority, industry, and salary."
>
    <!-- Hero Section -->
    <section class="relative pt-32 pb-12 bg-gradient-to-br from-gray-900 via-gray-800 to-ruby-900 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.4\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
                    Ruby Jobs
                </h1>
                <p class="text-lg md:text-xl text-gray-300 mb-6">
                    Ruby and Rails roles for experienced engineers in the SF Bay Area and remote across the US. Filter to what fits you.
                </p>

                <div class="flex flex-wrap items-center gap-8">
                    <div>
                        <div class="text-3xl font-bold text-white">{jobs.length}</div>
                        <div class="text-sm text-gray-400">Open Positions</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-emerald-400">{uniqueCompanies.size}</div>
                        <div class="text-sm text-gray-400">Companies Hiring</div>
                    </div>
                    <button
                        data-email-modal="post-job"
                        class="tap-press inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-white text-ruby-600 rounded-lg font-semibold shadow-lg hover:shadow-xl hover:bg-gray-50 transition-all"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Post a Job
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Jobs: filters (left) + results (right) -->
    <section class="bg-gradient-to-b from-white to-cloud-50">
        <div id="jobs-app" data-filters="open" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Mobile filter toggle bar -->
            <div class="lg:hidden sticky top-20 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 bg-cloud-50/95 backdrop-blur-md border-b border-gray-200 flex items-center justify-between gap-3">
                <button id="filter-open" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-semibold text-gray-800 shadow-sm active:scale-[0.98] transition-transform">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L14 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 018 21v-7.586L3.293 6.707A1 1 0 013 6V4z"></path></svg>
                    Filters
                    <span class="active-badge hidden inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 rounded-full bg-ruby-500 text-white text-[11px] font-bold">0</span>
                </button>
                <span class="text-sm text-gray-600"><span class="result-count font-semibold text-gray-900">{jobs.length}</span> roles</span>
            </div>

            <div class="lg:grid lg:grid-cols-[15rem_1fr] xl:grid-cols-[16rem_1fr] lg:gap-8 lg:py-10">

                <!-- Dim backdrop behind the mobile filter sheet -->
                <div id="filter-backdrop" class="lg:hidden" aria-hidden="true"></div>

                <!-- Filter sidebar (desktop) / bottom sheet (mobile) -->
                <aside id="filter-panel" class="filter-panel py-6 lg:py-0">
                    <!-- Mobile-only drag handle -->
                    <div class="filter-grabber lg:hidden" aria-hidden="true"></div>
                    <div class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1 lg:-mr-1">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-900">Filters</h2>
                            <button id="clear-filters" type="button" class="hidden text-xs font-semibold text-ruby-600 hover:text-ruby-700">
                                Clear all
                            </button>
                        </div>

                        {facetGroups.map((group) => (
                            <div class="facet-group">
                                <h3 class="facet-label">{group.label}</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {group.options.map((opt) => (
                                        <button
                                            type="button"
                                            class="chip"
                                            data-facet={group.key}
                                            data-value={opt.value}
                                            data-single={group.single ? "true" : undefined}
                                        >
                                            {opt.label}
                                            <span class="chip-count">{opt.count}</span>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        ))}

                        <!-- Mobile-only: apply / clear -->
                        <div class="lg:hidden sticky bottom-0 -mx-4 sm:-mx-6 mt-6 px-4 sm:px-6 py-3 bg-white/95 backdrop-blur-md border-t border-gray-200 flex items-center gap-3">
                            <button id="filter-done" type="button" class="flex-1 inline-flex items-center justify-center px-5 py-2.5 bg-gradient-to-r from-ruby-500 to-pink-500 text-white rounded-lg font-semibold shadow-sm hover:shadow-md hover:from-ruby-400 hover:to-pink-400 transition-all">
                                Show <span class="result-count mx-1">{jobs.length}</span> results
                            </button>
                            <button id="clear-filters-mobile" type="button" class="px-4 py-2.5 text-sm font-semibold text-gray-600 hover:text-ruby-600">
                                Clear
                            </button>
                        </div>
                    </div>
                </aside>

                <!-- Results -->
                <div class="min-w-0 pb-12 lg:pb-0">
                    <!-- Text search -->
                    <div class="relative mb-4">
                        <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <input
                            id="job-search"
                            type="search"
                            autocomplete="off"
                            enterkeyhint="search"
                            placeholder="Search roles, companies, stack…"
                            aria-label="Search jobs by role, company, or stack"
                            class="w-full h-11 pl-10 pr-10 rounded-lg border border-gray-300 bg-white text-sm text-gray-900 placeholder:text-gray-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-ruby-300 focus:border-ruby-300"
                        />
                        <button id="job-search-clear" type="button" aria-label="Clear search" class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 inline-flex items-center justify-center rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>

                    <div class="hidden lg:flex items-center justify-between mb-4">
                        <p class="text-sm text-gray-500">
                            Showing <span class="result-count font-semibold text-gray-900">{jobs.length}</span> of {jobs.length} roles
                        </p>
                    </div>

                    <div id="jobs-list" class="space-y-3">
                        {jobs.map((job) => (
                            <article
                                id={job.id}
                                class="job-row scroll-mt-28 bg-white rounded-xl border border-gray-200 hover:border-ruby-200 hover:shadow-md transition-all"
                                data-worktype={job.workType.join(" ")}
                                data-geo={job.geo.join(" ")}
                                data-level={job.level}
                                data-industry={job.industry ? slugify(job.industry) : ""}
                                data-stage={job.stage ? slugify(job.stage) : ""}
                                data-salmax={job.salaryRange ? job.salaryRange.max : ""}
                                data-search={searchText(job)}
                            >
                                <div class="flex flex-wrap sm:flex-nowrap items-start gap-x-4 gap-y-3 p-4 sm:p-5">
                                    {job.companyLogo ? (
                                        <div class="shrink-0 w-12 h-12 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center overflow-hidden">
                                            <img src={job.companyLogo} alt={job.companyName} class="w-full h-full object-contain p-1" loading="lazy" />
                                        </div>
                                    ) : (
                                        <div class="shrink-0 w-12 h-12 rounded-lg bg-ruby-50 flex items-center justify-center text-ruby-500 font-bold">
                                            {job.companyName?.[0] ?? "?"}
                                        </div>
                                    )}

                                    <div class="flex-1 min-w-0">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1">
                                            <h3 class="font-semibold text-gray-900 text-base sm:text-lg leading-snug">
                                                {job.title}
                                            </h3>
                                            <a
                                                href={`#${job.id}`}
                                                class="copy-link"
                                                data-job-id={job.id}
                                                aria-label="Copy link to this role"
                                                title="Copy link to this role"
                                            >
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5"></path></svg>
                                            </a>
                                            {job.isFeatured && (
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-ruby-100 text-ruby-700">
                                                    Featured
                                                </span>
                                            )}
                                            {job.isYC && (
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-orange-100 text-orange-700">
                                                    YC
                                                </span>
                                            )}
                                        </div>
                                        <p class="text-sm text-gray-600 mb-2">{job.companyName}</p>

                                        <div class="flex flex-wrap items-center gap-1.5 text-xs">
                                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-gray-100 text-gray-700">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                                {job.location}
                                            </span>
                                            <span class="px-2 py-1 rounded bg-gray-100 text-gray-700">{LEVEL_LABELS[job.level]}</span>
                                            {job.industry && (
                                                <span class="px-2 py-1 rounded bg-gray-100 text-gray-700">{job.industry}</span>
                                            )}
                                            {job.stage && (
                                                <span class="px-2 py-1 rounded bg-gray-100 text-gray-500">{job.stage}</span>
                                            )}
                                            {job.salary && (
                                                <span class="px-2 py-1 rounded bg-emerald-50 text-emerald-700 font-medium">{job.salary}</span>
                                            )}
                                        </div>

                                        {job.chips && job.chips.length > 0 && (
                                            <div class="flex flex-wrap items-center gap-1.5 mt-2" data-chips={job.chips.join(" ")}>
                                                {orderChips(job.chips).map((chip) => (
                                                    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border ${CHIP_CLASS[chipKind(chip)]}`}>
                                                        {chip}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </div>

                                    <div class="order-last sm:order-none w-full sm:w-auto shrink-0 flex items-center gap-2 sm:flex-col sm:items-end">
                                        <a
                                            href={job.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="tap-press flex-1 sm:flex-none justify-center inline-flex items-center gap-1 px-4 py-2 bg-gradient-to-r from-ruby-500 to-pink-500 text-white text-sm font-medium rounded-lg shadow-sm hover:shadow-md hover:from-ruby-400 hover:to-pink-400 transition-all"
                                        >
                                            Apply
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                        </a>
                                        <button
                                            type="button"
                                            class="more-btn inline-flex items-center gap-1 text-xs font-medium text-gray-500 hover:text-ruby-600"
                                            aria-expanded="false"
                                        >
                                            <span class="more-label">Details</span>
                                            <svg class="more-chevron w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="more-panel hidden border-t border-gray-100 px-4 sm:px-5 py-4">
                                    <p class="text-sm text-gray-700 leading-relaxed">{job.description}</p>
                                    <a
                                        href={job.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-ruby-600 hover:text-ruby-700"
                                    >
                                        View full posting
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                    </a>
                                </div>
                            </article>
                        ))}
                    </div>

                    <!-- Empty State (filtered to nothing) -->
                    <div id="no-results" class="hidden text-center py-16">
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No roles match these filters</h3>
                        <p class="text-gray-600 mb-4">Try removing a filter to widen your search.</p>
                        <button id="clear-filters-empty" type="button" class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-ruby-500 to-pink-500 text-white rounded-lg font-semibold shadow-sm hover:shadow-md hover:from-ruby-400 hover:to-pink-400 transition-all">
                            Clear all filters
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Post / Host CTA -->
    <section class="py-16 bg-white border-t border-gray-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="p-6 md:p-8 bg-gradient-to-br from-gray-900 to-ruby-900 rounded-2xl text-white flex flex-col md:flex-row items-start md:items-center gap-6 justify-between">
                <div>
                    <div class="text-xs font-semibold text-ruby-200 uppercase tracking-wider mb-2">
                        For companies serious about hiring
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2">
                        Host a meetup, meet 60–100 Bay Area Ruby engineers in one night
                    </h3>
                    <p class="text-gray-300 text-sm md:text-base max-w-2xl">
                        Hosting reaches the same audience as a job post, in person, with your engineers on stage and your team meeting candidates face-to-face.
                    </p>
                </div>
                <a
                    href="/host"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-ruby-700 rounded-lg font-semibold whitespace-nowrap hover:bg-gray-50 transition-colors shrink-0"
                >
                    See how to host
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <EmailModal
        id="post-job"
        email="irina@evilmartians.com"
        subject="Post a Job on SF Ruby"
        title="Post a Job"
    />

    <style>
        /* Suppress the native search clear/decoration; we render our own ×. */
        #job-search::-webkit-search-cancel-button,
        #job-search::-webkit-search-decoration {
            -webkit-appearance: none;
            appearance: none;
        }
        .facet-group {
            margin-bottom: 1.5rem;
        }
        .facet-label {
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #9ca3af;
            margin-bottom: 0.5rem;
        }
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            border-radius: 9999px;
            font-size: 0.8125rem;
            font-weight: 500;
            line-height: 1.25rem;
            color: #374151;
            background: #fff;
            border: 1px solid #d1d5db;
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .chip:hover {
            border-color: #f87171;
        }
        .chip-active {
            color: #fff;
            background: #dc2626;
            border-color: #dc2626;
        }
        .chip-count {
            font-size: 0.6875rem;
            opacity: 0.6;
        }
        .chip-active .chip-count {
            opacity: 0.85;
        }
        /* Options that would narrow results to zero, and facets with no options
           left, are removed from the panel until the selection changes. */
        .chip-hidden,
        .facet-group-hidden {
            display: none;
        }

        /* Per-card anchor: highlight when linked, copy-link affordance. */
        .job-row:target {
            border-color: #f87171;
            box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.25);
        }
        .copy-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            color: #9ca3af;
            opacity: 0;
            transition: opacity 0.15s, color 0.15s;
        }
        .job-row:hover .copy-link,
        .copy-link:focus-visible {
            opacity: 1;
        }
        .copy-link:hover {
            color: #dc2626;
        }
        .copy-link.copied {
            color: #059669;
            opacity: 1;
        }
        .copy-link.copied::after {
            content: "Link copied";
            position: absolute;
            left: 50%;
            bottom: calc(100% + 0.35rem);
            transform: translateX(-50%);
            white-space: nowrap;
            background: #111827;
            color: #fff;
            font-size: 0.6875rem;
            font-weight: 600;
            padding: 0.2rem 0.45rem;
            border-radius: 0.35rem;
            pointer-events: none;
        }
        @media (max-width: 1023px) {
            /* Always tappable on touch devices (no hover). */
            .copy-link {
                opacity: 1;
            }
        }

        /* Mobile: filter panel is an iOS-style bottom sheet (rounded top, grab
           handle, drag-to-dismiss, dim backdrop). On desktop it is always a
           visible sidebar regardless of the data-filters state. */
        .filter-grabber {
            display: none;
        }
        @media (max-width: 1023px) {
            #jobs-app[data-filters="closed"] #filter-panel,
            #jobs-app[data-filters="closed"] #filter-backdrop {
                display: none;
            }

            #filter-backdrop {
                position: fixed;
                inset: 0;
                z-index: 45; /* above the bottom tab bar (z-40) */
                background: rgba(17, 24, 39, 0.45);
                opacity: 0;
                animation: filter-backdrop-in 0.28s ease forwards;
            }

            #jobs-app[data-filters="open"] #filter-panel {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                top: auto;
                z-index: 46; /* above the bottom tab bar (z-40) and its backdrop */
                max-height: 85vh; /* fallback for iOS < 15.4 */
                max-height: 85dvh;
                overflow-y: auto;
                overscroll-behavior: contain;
                background: #fff;
                border-radius: 1.25rem 1.25rem 0 0;
                box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.18);
                padding: 0 1rem env(safe-area-inset-bottom);
                animation: filter-sheet-up 0.32s cubic-bezier(0.32, 0.72, 0, 1);
                will-change: transform;
            }

            .filter-grabber {
                position: sticky;
                top: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 0.625rem 0 0.5rem;
                margin: 0 -1rem;
                background: #fff;
                border-radius: 1.25rem 1.25rem 0 0;
                cursor: grab;
                touch-action: none;
                z-index: 2;
            }
            .filter-grabber::before {
                content: "";
                width: 2.25rem;
                height: 0.3125rem;
                border-radius: 9999px;
                background: #d1d5db;
            }
        }
        @keyframes filter-sheet-up {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
        @keyframes filter-backdrop-in {
            to { opacity: 1; }
        }
    </style>

    <script>
        const app = document.getElementById("jobs-app")!;
        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip"));
        const facetGroupEls = Array.from(
            document.querySelectorAll<HTMLElement>(".facet-group"),
        );
        const rows = Array.from(document.querySelectorAll<HTMLElement>(".job-row"));
        const countEls = Array.from(document.querySelectorAll<HTMLElement>(".result-count"));
        const badges = Array.from(document.querySelectorAll<HTMLElement>(".active-badge"));
        const noResults = document.getElementById("no-results");
        const list = document.getElementById("jobs-list");
        const clearBtns = Array.from(
            document.querySelectorAll<HTMLButtonElement>(
                "#clear-filters, #clear-filters-mobile, #clear-filters-empty",
            ),
        );
        const searchInput = document.getElementById("job-search") as HTMLInputElement | null;
        const searchClear = document.getElementById("job-search-clear");
        let searchTerms: string[] = [];

        type Facet = "worktype" | "geo" | "level" | "industry" | "stage";
        const multiFacets: Facet[] = ["worktype", "geo", "level", "industry", "stage"];
        const state: Record<Facet, Set<string>> = {
            worktype: new Set(),
            geo: new Set(),
            level: new Set(),
            industry: new Set(),
            stage: new Set(),
        };
        let salaryMin: number | null = null;

        function tokens(el: HTMLElement, attr: string): string[] {
            const v = el.getAttribute(attr);
            return v ? v.split(" ").filter(Boolean) : [];
        }

        function matchFacet(rowTokens: string[], active: Set<string>): boolean {
            if (active.size === 0) return true;
            return rowTokens.some((t) => active.has(t));
        }

        // Precompute each row's facet data once, so recounting on every click is cheap.
        const rowData = rows.map((el) => ({
            el,
            worktype: tokens(el, "data-worktype"),
            geo: tokens(el, "data-geo"),
            level: el.getAttribute("data-level") || "",
            industry: el.getAttribute("data-industry") || "",
            stage: el.getAttribute("data-stage") || "",
            salmax: el.getAttribute("data-salmax")
                ? Number(el.getAttribute("data-salmax"))
                : null,
            search: el.getAttribute("data-search") || "",
        }));
        type Row = (typeof rowData)[number];

        type FilterState = {
            worktype: Set<string>;
            geo: Set<string>;
            level: Set<string>;
            industry: Set<string>;
            stage: Set<string>;
            salaryMin: number | null;
            search: string[];
        };

        function snapshot(): FilterState {
            return {
                worktype: state.worktype,
                geo: state.geo,
                level: state.level,
                industry: state.industry,
                stage: state.stage,
                salaryMin,
                search: searchTerms,
            };
        }

        function facetTokens(d: Row, facet: string): string[] {
            if (facet === "worktype") return d.worktype;
            if (facet === "geo") return d.geo;
            if (facet === "level") return [d.level];
            if (facet === "industry") return [d.industry];
            if (facet === "stage") return [d.stage];
            return [];
        }

        function rowMatches(d: Row, st: FilterState): boolean {
            return (
                matchFacet(d.worktype, st.worktype) &&
                matchFacet(d.geo, st.geo) &&
                matchFacet([d.level], st.level) &&
                matchFacet([d.industry], st.industry) &&
                matchFacet([d.stage], st.stage) &&
                (st.salaryMin === null ||
                    (d.salmax !== null && d.salmax >= st.salaryMin)) &&
                // Every search term must appear (AND) in the row's haystack.
                st.search.every((t) => d.search.includes(t))
            );
        }

        function countMatches(st: FilterState): number {
            let n = 0;
            for (const d of rowData) if (rowMatches(d, st)) n++;
            return n;
        }

        function apply() {
            const cur = snapshot();
            let visible = 0;
            for (const d of rowData) {
                const ok = rowMatches(d, cur);
                d.el.style.display = ok ? "" : "none";
                if (ok) visible++;
            }
            for (const el of countEls) el.textContent = String(visible);
            if (noResults) noResults.classList.toggle("hidden", visible !== 0);
            if (list) list.classList.toggle("hidden", visible === 0);

            const activeCount =
                multiFacets.reduce((n, f) => n + state[f].size, 0) +
                (salaryMin !== null ? 1 : 0);
            const hasSearch = searchTerms.length > 0;
            // Clear buttons appear for facets OR search; the filter-drawer badge
            // stays facet-only (search lives outside the drawer).
            for (const btn of clearBtns)
                btn.classList.toggle("hidden", activeCount === 0 && !hasSearch);
            for (const badge of badges) {
                badge.textContent = String(activeCount);
                badge.classList.toggle("hidden", activeCount === 0);
            }
            if (searchClear) searchClear.classList.toggle("hidden", !hasSearch);

            updateChips(cur);
        }

        // Conditional facet counts (disjunctive faceting): every chip's number is
        // recomputed against the CURRENT selection. An inactive chip shows the
        // result count you'd get by clicking it on top of what you have now (a
        // second value in the same facet widens via OR; a value in another facet
        // narrows via AND). An active chip shows its share of the current results.
        // Inactive options that would narrow the list to zero are hidden, and a
        // facet whose options all disappear is hidden entirely, so the panel only
        // ever offers filters that lead somewhere.
        function updateChips(cur: FilterState) {
            const visibleRows = rowData.filter((d) => rowMatches(d, cur));
            for (const chip of chips) {
                const facet = chip.dataset.facet!;
                const value = chip.dataset.value!;
                const isSalary = chip.dataset.single === "true";
                const active = isSalary
                    ? salaryMin === Number(value)
                    : state[facet as Facet].has(value);

                let count: number;
                if (active) {
                    count = isSalary
                        ? visibleRows.length
                        : visibleRows.filter((d) =>
                              facetTokens(d, facet).includes(value),
                          ).length;
                } else if (isSalary) {
                    count = countMatches({ ...cur, salaryMin: Number(value) });
                } else {
                    const next = new Set(cur[facet as Facet]);
                    next.add(value);
                    count = countMatches({ ...cur, [facet]: next });
                }

                const countEl = chip.querySelector(".chip-count");
                if (countEl) countEl.textContent = String(count);

                chip.classList.toggle("chip-hidden", !active && count === 0);
            }

            // Hide a facet group once none of its options remain available.
            for (const group of facetGroupEls) {
                const anyVisible = Array.from(
                    group.querySelectorAll<HTMLElement>(".chip"),
                ).some((c) => !c.classList.contains("chip-hidden"));
                group.classList.toggle("facet-group-hidden", !anyVisible);
            }
        }

        // Bring results back into view from the top when filters change, so you
        // are never left mid-list looking at rows that shifted under you. On
        // desktop only scroll up (don't yank you down mid-browse); when forced
        // (mobile "Show results") always land on the list. No-op while the
        // mobile drawer is open, since the results are hidden behind it.
        function scrollToListTop(force = false) {
            if (!list) return;
            if (document.body.classList.contains("overflow-hidden")) return;
            const isMobile = window.matchMedia("(max-width: 1023px)").matches;
            const offset = isMobile ? 140 : 96; // clear fixed header (+ mobile filter bar)
            const target = Math.max(
                0,
                list.getBoundingClientRect().top + window.scrollY - offset,
            );
            if (force || window.scrollY > target) {
                window.scrollTo({ top: target, behavior: "smooth" });
            }
        }

        for (const chip of chips) {
            chip.addEventListener("click", () => {
                const facet = chip.dataset.facet!;
                const value = chip.dataset.value!;
                if (chip.dataset.single === "true") {
                    const t = Number(value);
                    const wasActive = chip.classList.contains("chip-active");
                    for (const c of chips) {
                        if (c.dataset.facet === facet) c.classList.remove("chip-active");
                    }
                    if (wasActive) {
                        salaryMin = null;
                    } else {
                        salaryMin = t;
                        chip.classList.add("chip-active");
                    }
                } else {
                    const set = state[facet as Facet];
                    if (set.has(value)) {
                        set.delete(value);
                        chip.classList.remove("chip-active");
                    } else {
                        set.add(value);
                        chip.classList.add("chip-active");
                    }
                }
                apply();
                scrollToListTop();
            });
        }

        function clearAll() {
            for (const f of multiFacets) state[f].clear();
            salaryMin = null;
            for (const c of chips) c.classList.remove("chip-active");
            searchTerms = [];
            if (searchInput) searchInput.value = "";
            apply();
            scrollToListTop();
        }
        for (const btn of clearBtns) btn.addEventListener("click", clearAll);

        // Text search: split on whitespace, AND the terms. No debounce needed at
        // this row count; filtering is a cheap in-memory pass.
        function readSearch() {
            searchTerms = (searchInput?.value || "")
                .toLowerCase()
                .split(/\s+/)
                .filter(Boolean);
        }
        searchInput?.addEventListener("input", () => {
            readSearch();
            apply();
        });
        searchClear?.addEventListener("click", () => {
            if (searchInput) searchInput.value = "";
            searchTerms = [];
            apply();
            searchInput?.focus();
        });

        // Initialize conditional counts / availability on load.
        apply();

        // Mobile filter sheet: open on load, collapse to read results, reopen via button.
        const mql = window.matchMedia("(max-width: 1023px)");
        const panel = document.getElementById("filter-panel");
        const backdrop = document.getElementById("filter-backdrop");
        const grabber = document.querySelector<HTMLElement>(".filter-grabber");

        function setDrawer(open: boolean) {
            app.dataset.filters = open ? "open" : "closed";
            document.body.classList.toggle("overflow-hidden", open && mql.matches);
            // Clear any leftover drag transform so the open animation runs clean.
            if (open && panel) {
                panel.style.transition = "";
                panel.style.transform = "";
            }
        }
        document.getElementById("filter-open")?.addEventListener("click", () => setDrawer(true));
        document.getElementById("filter-done")?.addEventListener("click", () => {
            setDrawer(false);
            scrollToListTop(true);
        });
        // Tap the dim backdrop to dismiss.
        backdrop?.addEventListener("click", () => setDrawer(false));

        // Drag the grab handle down to dismiss, like an iOS sheet. Follows the
        // finger; past ~30% of the sheet height (or a quick flick) it closes,
        // otherwise it springs back.
        if (grabber && panel) {
            let startY = 0;
            let dy = 0;
            let dragging = false;
            const spring = "transform 0.32s cubic-bezier(0.32, 0.72, 0, 1)";

            grabber.addEventListener("touchstart", (e) => {
                dragging = true;
                startY = e.touches[0].clientY;
                dy = 0;
                panel.style.transition = "none";
            }, { passive: true });

            grabber.addEventListener("touchmove", (e) => {
                if (!dragging) return;
                dy = Math.max(0, e.touches[0].clientY - startY);
                panel.style.transform = `translateY(${dy}px)`;
            }, { passive: true });

            grabber.addEventListener("touchend", () => {
                if (!dragging) return;
                dragging = false;
                panel.style.transition = spring;
                if (dy > panel.offsetHeight * 0.3 || dy > 140) {
                    panel.style.transform = `translateY(100%)`;
                    window.setTimeout(() => setDrawer(false), 220);
                } else {
                    panel.style.transform = "translateY(0)";
                }
            });

            // If the OS cancels the gesture mid-drag (incoming call, system
            // edge-swipe), spring back instead of leaving the sheet frozen at
            // the dragged offset.
            grabber.addEventListener("touchcancel", () => {
                if (!dragging) return;
                dragging = false;
                panel.style.transition = spring;
                panel.style.transform = "translateY(0)";
            });
        }
        // Resolve a deep link to a specific card (/jobs#job-id) up front.
        const hashEl =
            location.hash.length > 1
                ? document.getElementById(decodeURIComponent(location.hash.slice(1)))
                : null;
        const deepLink = hashEl?.classList.contains("job-row") ? hashEl : null;

        // A deep link always closes the sheet so the linked card is visible
        // (harmless on desktop, where the panel is a static sidebar). Otherwise
        // mobile starts filter-first with the sheet open.
        if (deepLink) setDrawer(false);
        else if (mql.matches) setDrawer(true);

        // Cold-load deep link: the native on-load hash scroll animates (global
        // scroll-behavior: smooth) over a long distance and lands stale, and
        // lazy images keep shifting the target. Jump instantly each frame, with
        // scroll-behavior forced to auto so the native smooth scroll can't fight
        // us, until the position holds steady; then restore smooth.
        if (deepLink) {
            const root = document.documentElement;
            const prevBehavior = root.style.scrollBehavior;
            root.style.scrollBehavior = "auto";
            let stable = 0;
            let frames = 0;
            const converge = () => {
                const offset = mql.matches ? 140 : 96; // header (+ mobile filter bar)
                const y = Math.max(
                    0,
                    deepLink.getBoundingClientRect().top + window.scrollY - offset,
                );
                window.scrollTo(0, y);
                stable = Math.abs(y - window.scrollY) < 2 ? stable + 1 : 0;
                if (stable < 3 && ++frames < 120) requestAnimationFrame(converge);
                else root.style.scrollBehavior = prevBehavior;
            };
            requestAnimationFrame(converge);
        }

        // Per-card anchor links: scroll + highlight, and copy a shareable URL.
        for (const link of Array.from(document.querySelectorAll<HTMLAnchorElement>(".copy-link"))) {
            link.addEventListener("click", (e) => {
                const id = link.dataset.jobId!;
                e.preventDefault();
                location.hash = id; // scrolls to the card (scroll-mt) and triggers :target
                if (navigator.clipboard) {
                    const url = location.origin + location.pathname + "#" + id;
                    navigator.clipboard.writeText(url).catch(() => {});
                    link.classList.add("copied");
                    window.setTimeout(() => link.classList.remove("copied"), 1400);
                }
            });
        }
        // If the viewport crosses the breakpoint, never leave the body scroll-locked.
        mql.addEventListener("change", (e) => {
            if (!e.matches) document.body.classList.remove("overflow-hidden");
        });

        // Expand / collapse "Details"
        for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>(".more-btn"))) {
            btn.addEventListener("click", () => {
                const row = btn.closest(".job-row");
                const panel = row?.querySelector<HTMLElement>(".more-panel");
                const label = btn.querySelector<HTMLElement>(".more-label");
                const chevron = btn.querySelector<HTMLElement>(".more-chevron");
                if (!panel) return;
                const open = panel.classList.toggle("hidden");
                btn.setAttribute("aria-expanded", String(!open));
                if (label) label.textContent = open ? "Details" : "Hide";
                if (chevron) chevron.style.transform = open ? "" : "rotate(180deg)";
            });
        }
    </script>
</BaseLayout>
