---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import IslandNav from "../components/IslandNav.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="The San Francisco Ruby Startup Conference, November 10–12, 2026 at SF Jazz. Keynote by Garry Tan, President & CEO of Y Combinator."
        />
        <meta name="theme-color" content="#62bbee" />
        <title>San Francisco Ruby Startup Conference 2026 - SF Ruby</title>

        <link
            rel="preload"
            href="/fonts/PressStart2P.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="San Francisco Ruby Startup Conference 2026 - SF Ruby"
        />
        <meta
            property="og:description"
            content="November 10–12, 2026 at SF Jazz. Keynote by Garry Tan, President & CEO of Y Combinator."
        />
        <meta
            property="og:image"
            content="https://sfruby.com/og/conference.png"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            property="twitter:image"
            content="https://sfruby.com/og/conference.png"
        />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col pb-tabbar"
    >
        <Header />

        <main class="flex-grow">
            <!-- Announcement hero: the logo's title screen, blown up to a page -->
            <section
                class="relative min-h-[80vh] flex items-center text-white overflow-hidden px-sky-grad-day"
            >
                <!-- blocky retro clouds -->
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-28 left-[12%] w-36 md:w-44 animate-float pointer-events-none" aria-hidden="true" />
                <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-48 right-[10%] w-24 md:w-32 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
                <img
                    src="/px-island.png"
                    alt=""
                    width="598"
                    height="104"
                    class="px-pixelated absolute bottom-[16%] left-[6%] w-36 md:w-44 h-auto animate-float [animation-delay:-1.5s] pointer-events-none hidden sm:block"
                    aria-hidden="true"
                />
                <img
                    src="/px-island.png"
                    alt=""
                    width="598"
                    height="104"
                    class="px-pixelated absolute top-[34%] right-[6%] w-40 h-auto animate-float [animation-delay:-4.5s] pointer-events-none hidden lg:block"
                    aria-hidden="true"
                />

                <div
                    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 py-28 text-center"
                >
                    <h1 class="sr-only">
                        San Francisco Ruby Startup Conference 2026
                    </h1>
                    <span
                        class="px-plate px-font text-px10 md:text-xs px-4 py-2 mb-10"
                        >Conference Announced</span
                    >
                    <img
                        src="/logo8bit-transparent.png"
                        alt="San Francisco Ruby Startup Conference '26"
                        width="520"
                        height="830"
                        class="px-pixelated w-full max-w-[17rem] md:max-w-xs h-auto mx-auto mb-10"
                    />
                    <p
                        class="px-font px-shadow-ink text-lg md:text-2xl text-white"
                    >
                        Nov 10-12, 2026
                    </p>
                    <p class="text-lg md:text-xl text-white mt-3">
                        <a
                            href="https://www.sfjazz.org/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline decoration-white/50 hover:decoration-white transition-colors"
                            >SF Jazz</a
                        > · San Francisco
                    </p>

                    <a
                        href="#notify"
                        class="px-font px-blink inline-block mt-10 text-sm md:text-base text-indigo-900"
                        >&#9654; Press Start &#9664;</a
                    >

                    <!-- Organized by -->
                    <div class="mt-12 flex flex-col items-center gap-3">
                        <span
                            class="text-xs uppercase tracking-widest text-white"
                            >Organized by</span
                        >
                        <a
                            href="https://evilmartians.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block hover:opacity-90 transition-opacity"
                        >
                            <img
                                src="/evilmartians.png"
                                alt="Evil Martians"
                                width="2500"
                                height="2500"
                                class="h-16 md:h-20 w-auto"
                            />
                        </a>
                    </div>
                </div>

                <!-- crenellated step into the keynote section -->
                <div
                    class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:#f0f9ff]"
                    aria-hidden="true"
                >
                </div>
            </section>

            <!-- Keynote -->
            <section class="py-20 md:py-24 bg-sky-50">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <p
                        class="px-font text-center text-xs md:text-sm text-ruby-600 mb-10"
                    >
                        Keynote
                    </p>
                    <div class="px-card bg-white p-8 md:p-12">
                        <div
                            class="flex flex-col md:flex-row items-center gap-8 md:gap-12"
                        >
                            <!-- Photo: Seb Daly / Web Summit / Sportsfile, CC BY 2.0 (Wikimedia Commons) -->
                            <div class="shrink-0 animate-float">
                                <img
                                    src="/garry_pixel_256.png"
                                    alt="Garry Tan, pixel character by Anton Lovchikov"
                                    width="256"
                                    height="256"
                                    loading="lazy"
                                    class="px-pixelated w-52 md:w-64 h-auto relative z-10 mx-auto"
                                />
                                <img
                                    src="/px-island.png"
                                    alt=""
                                    width="598"
                                    height="104"
                                    loading="lazy"
                                    class="px-pixelated w-56 md:w-72 h-auto -mt-4 mx-auto"
                                />
                            </div>
                            <div class="text-center md:text-left">
                                <h2
                                    class="px-font text-lg md:text-2xl text-gray-900"
                                >
                                    Garry Tan
                                </h2>
                                <span
                                    class="px-plate px-plate--gold px-font text-px8 px-3 py-1.5 mt-4"
                                >
                                    President &amp; CEO, Y Combinator
                                </span>
                                <p
                                    class="text-base text-gray-600 leading-relaxed mt-6 text-left"
                                >
                                    Garry co-founded Initialized Capital, built
                                    Bookface, YC's internal software, on Rails,
                                    and created <a
                                        href="https://github.com/garrytan/gstack"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-ruby-600 underline hover:text-ruby-700 transition-colors"
                                        >GStack</a
                                    >, his open-source Claude Code toolkit. Since
                                    2023, he's led YC's fastest-growing and most
                                    profitable batches on record.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Call for proposals: Anton's island scene -->
            <section
                id="cfp"
                class="relative overflow-hidden py-20 md:py-24 px-dither-sky border-t-4 border-ink"
            >
                <div
                    class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
                >
                    <div class="flex justify-center">
                        <div
                            class="px-bubble px-font text-px10 md:text-xs text-ruby-600 px-5 py-4"
                        >
                            CFP opens July 6!
                        </div>
                    </div>
                    <img
                        src="/px-scene-cfp.png"
                        alt="Two pixel characters chatting on a floating island"
                        width="610"
                        height="444"
                        loading="lazy"
                        class="px-pixelated w-full max-w-[17rem] md:max-w-xs h-auto mx-auto mt-6"
                    />
                    <h2
                        class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-10"
                    >
                        Speak at the conference
                    </h2>
                    <p class="text-lg text-white mt-4 mb-8">
                        Have a Ruby story to tell? The stage is yours: propose a
                        talk for 2026.
                    </p>
                    <a
                        href="https://cfp.sfruby.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4"
                    >
                        <img
                            src="/px-quest.png"
                            alt=""
                            width="64"
                            height="296"
                            class="px-pixelated h-5 w-auto"
                        />
                        Propose a talk
                    </a>
                </div>
            </section>

            <!-- Venue photo, framed like a cutscene still -->
            <section class="relative w-full border-y-4 border-ink">
                <img
                    src="/sfjazz.webp"
                    alt="SFJAZZ Center, San Francisco"
                    width="1600"
                    height="900"
                    loading="lazy"
                    class="w-full h-[40vh] md:h-[60vh] object-cover"
                />
                <div class="absolute bottom-0 left-0 w-full p-6 md:p-10">
                    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="px-card inline-block bg-white p-4 md:p-5">
                            <p
                                class="px-font text-xs md:text-sm text-gray-900"
                            >
                                <a
                                    href="https://www.sfjazz.org/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="hover:underline"
                                    >The Venue: SFJAZZ Center</a
                                >
                            </p>
                            <p
                                class="text-xs md:text-sm text-gray-600 mt-2"
                            >
                                San Francisco
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Get notified -->
            <section
                id="notify"
                class="relative overflow-hidden pt-20 pb-28 px-royal-grad text-white"
            >
                <div
                    class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
                >
                    <h2
                        class="px-font px-shadow-ink text-lg md:text-2xl text-white"
                    >
                        Be the first to know
                    </h2>
                    <p class="text-lg text-white/90 mt-5 mb-8">
                        Tickets aren't on sale yet. Get the drop the moment they
                        go live.
                    </p>

                    <!-- Primary: channels that actually notify you -->
                    <div
                        class="flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <a
                            href="https://sfruby.substack.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
                                />
                            </svg>
                            Subscribe on Substack
                        </a>
                        <a
                            href="https://lu.ma/sfruby"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                            </svg>
                            Follow on Luma
                        </a>
                    </div>

                    <!-- Secondary: follow-along socials -->
                    <div
                        class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <span
                            class="text-xs uppercase tracking-widest text-white/60"
                            >Follow along</span
                        >
                        <div class="flex items-center gap-3">
                            <a
                                href="https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Join the SF Ruby Slack"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.685 8.834a2.528 2.528 0 0 1-2.521 2.521 2.527 2.527 0 0 1-2.521-2.521V2.522A2.527 2.527 0 0 1 15.164 0a2.528 2.528 0 0 1 2.521 2.522v6.312zM15.164 18.956a2.528 2.528 0 0 1 2.521 2.522A2.528 2.528 0 0 1 15.164 24a2.527 2.527 0 0 1-2.521-2.522v-2.522h2.521zM15.164 17.685a2.527 2.527 0 0 1-2.521-2.521 2.526 2.526 0 0 1 2.521-2.521h6.314A2.527 2.527 0 0 1 24 15.164a2.528 2.528 0 0 1-2.522 2.521h-6.314z"
                                    />
                                </svg>
                            </a>
                            <a
                                href="https://x.com/sfrubyconf"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Follow SF Ruby on X"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                    />
                                </svg>
                            </a>
                            <a
                                href="https://www.linkedin.com/company/sfrubyconf/"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Follow SF Ruby on LinkedIn"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                    />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- crenellated step into the sponsor section -->
                <div
                    class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:#62bbee]"
                    aria-hidden="true"
                >
                </div>
            </section>

            <!-- Get involved: the overworld -->
            <IslandNav
                id="get-involved"
                kicker="World 2026"
                title="Choose your quest"
                lede="Tickets, talks, sponsorship, or just say hi."
                items={[
                    {
                        href: "https://luma.com/sfrubyconf2026",
                        label: "Tickets",
                        icon: "ticket",
                        external: true,
                    },
                    {
                        href: "https://cfp.sfruby.com",
                        label: "Propose a talk",
                        icon: "quest",
                        external: true,
                    },
                    { href: "/sponsor-2026", label: "Sponsor", icon: "coin" },
                    { href: "/contact", label: "Contact us", icon: "envelope" },
                ]}
            />
        </main>

        <Footer />
        <BottomNav />
    </body>
</html>
