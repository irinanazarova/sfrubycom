---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta
            name="description"
            content="The San Francisco Ruby Startup Conference, November 10–12, 2026 at SF Jazz. Keynote by Garry Tan, President & CEO of Y Combinator."
        />
        <meta name="theme-color" content="#dc2626" />
        <title>San Francisco Ruby Startup Conference 2026 - SF Ruby</title>

        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="San Francisco Ruby Startup Conference 2026 - SF Ruby"
        />
        <meta
            property="og:description"
            content="November 10–12, 2026 at SF Jazz. Keynote by Garry Tan, President & CEO of Y Combinator."
        />
        <meta
            property="og:image"
            content="https://iqtfijxk.ogplus.net/conference-2026"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            property="twitter:image"
            content="https://iqtfijxk.ogplus.net/conference-2026"
        />

        <script
            defer
            data-domain="sfruby.com"
            src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
        ></script>
    </head>
    <body
        class="bg-white text-gray-900 font-sans font-light min-h-screen flex flex-col"
    >
        <Header />

        <main class="flex-grow">
            <!-- Announcement hero -->
            <section
                class="relative min-h-[80vh] flex items-center bg-gradient-to-b from-sky-400 via-sky-500 to-indigo-700 text-white overflow-hidden"
            >
                <!-- soft clouds -->
                <div
                    class="absolute top-24 left-1/5 w-80 h-36 bg-white/20 rounded-full blur-3xl pointer-events-none"
                >
                </div>
                <div
                    class="absolute top-44 right-12 w-64 h-28 bg-white/10 rounded-full blur-3xl pointer-events-none"
                >
                </div>

                <div
                    class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 py-28 text-center"
                >
                    <h1 class="sr-only">
                        San Francisco Ruby Startup Conference 2026
                    </h1>
                    <span
                        class="inline-block px-3 py-1 bg-white/15 text-white text-xs md:text-sm font-bold uppercase tracking-wider rounded mb-8"
                        >Conference Announced</span
                    >
                    <img
                        src="/sfruby-startup-2026.png"
                        alt="San Francisco Ruby Startup Conference"
                        width="2048"
                        height="1550"
                        class="w-full max-w-lg lg:max-w-xl h-auto mx-auto mb-8"
                    />
                    <p
                        class="font-display text-3xl md:text-4xl font-bold text-white"
                    >
                        November 10–12, 2026
                    </p>
                    <p class="text-lg md:text-xl text-white/80 mt-2">
                        <a
                            href="https://www.sfjazz.org/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline decoration-white/40 hover:decoration-white transition-colors"
                            >SF Jazz</a
                        > · San Francisco
                    </p>

                    <!-- Organized by -->
                    <div class="mt-14 flex flex-col items-center gap-3">
                        <span
                            class="text-xs uppercase tracking-widest text-white/60"
                            >Organized by</span
                        >
                        <a
                            href="https://evilmartians.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block hover:opacity-90 transition-opacity"
                        >
                            <img
                                src="/evilmartians.png"
                                alt="Evil Martians"
                                width="2500"
                                height="2500"
                                class="h-16 md:h-20 w-auto"
                            />
                        </a>
                    </div>
                </div>

                <!-- wave into the keynote section -->
                <svg
                    preserveAspectRatio="none"
                    viewBox="0 0 1200 120"
                    xmlns="http://www.w3.org/2000/svg"
                    class="absolute bottom-0 left-0 w-full h-12 md:h-20"
                    aria-hidden="true"
                >
                    <path
                        d="M0,120 L0,80 C120,60 240,50 360,55 C480,45 600,48 720,55 C840,45 960,48 1080,55 C1140,52 1170,53 1200,55 L1200,120 Z"
                        fill="#f0f9ff"></path>
                </svg>
            </section>

            <!-- Keynote -->
            <section class="py-20 md:py-24 bg-gradient-to-b from-sky-50 to-white">
                <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                    <p
                        class="text-center text-sm font-bold uppercase tracking-widest text-ruby-600 mb-8"
                    >
                        Keynote
                    </p>
                    <div
                        class="bg-white rounded-3xl shadow-xl ring-1 ring-gray-900/5 p-8 md:p-12"
                    >
                        <div
                            class="flex flex-col md:flex-row items-center gap-8 md:gap-12"
                        >
                            <!-- Photo: Seb Daly / Web Summit / Sportsfile, CC BY 2.0 (Wikimedia Commons) -->
                            <img
                                src="/speaker_garry_tan.jpg"
                                alt="Garry Tan"
                                width="500"
                                height="667"
                                loading="lazy"
                                class="w-44 h-44 md:w-56 md:h-56 rounded-2xl object-cover object-top shadow-lg shrink-0"
                            />
                            <div class="text-center md:text-left">
                                <h2
                                    class="font-display text-3xl md:text-4xl font-bold text-gray-900"
                                >
                                    Garry Tan
                                </h2>
                                <p
                                    class="text-lg md:text-xl text-ruby-600 font-medium mt-1"
                                >
                                    President &amp; CEO, Y Combinator
                                </p>
                                <p
                                    class="text-base md:text-lg text-gray-600 leading-relaxed mt-5"
                                >
                                    Garry co-founded Initialized Capital, built
                                    Bookface, YC's internal software, on Rails,
                                    and created <a
                                        href="https://github.com/garrytan/gstack"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-ruby-600 underline hover:text-ruby-700 transition-colors"
                                        >GStack</a
                                    >, his open-source Claude Code toolkit. Since
                                    2023, he's led YC's fastest-growing and most
                                    profitable batches on record.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Get notified -->
            <section
                class="relative overflow-hidden pt-20 pb-28 bg-gradient-to-br from-sky-500 via-sky-600 to-indigo-700 text-white"
            >
                <div
                    class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
                >
                    <h2
                        class="font-display text-3xl md:text-4xl font-bold text-white"
                    >
                        Be the first to know
                    </h2>
                    <p class="text-lg text-white/85 mt-3 mb-8">
                        Tickets aren't on sale yet. Get the drop the moment they
                        go live.
                    </p>

                    <!-- Primary: channels that actually notify you -->
                    <div
                        class="flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <a
                            href="https://sfruby.substack.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2.5 rounded-lg bg-white px-6 py-3 text-base font-semibold text-sky-700 shadow-sm hover:bg-white/90 transition-colors"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
                                />
                            </svg>
                            Subscribe on Substack
                        </a>
                        <a
                            href="https://lu.ma/sfruby"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2.5 rounded-lg border border-white/50 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 transition-colors"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                            </svg>
                            Follow on Luma
                        </a>
                    </div>

                    <!-- Secondary: follow-along socials -->
                    <div
                        class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <span
                            class="text-xs uppercase tracking-widest text-white/60"
                            >Follow along</span
                        >
                        <div class="flex items-center gap-3">
                            <a
                                href="https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Join the SF Ruby Slack"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.685 8.834a2.528 2.528 0 0 1-2.521 2.521 2.527 2.527 0 0 1-2.521-2.521V2.522A2.527 2.527 0 0 1 15.164 0a2.528 2.528 0 0 1 2.521 2.522v6.312zM15.164 18.956a2.528 2.528 0 0 1 2.521 2.522A2.528 2.528 0 0 1 15.164 24a2.527 2.527 0 0 1-2.521-2.522v-2.522h2.521zM15.164 17.685a2.527 2.527 0 0 1-2.521-2.521 2.526 2.526 0 0 1 2.521-2.521h6.314A2.527 2.527 0 0 1 24 15.164a2.528 2.528 0 0 1-2.522 2.521h-6.314z"
                                    />
                                </svg>
                            </a>
                            <a
                                href="https://x.com/sfrubyconf"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Follow SF Ruby on X"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                    />
                                </svg>
                            </a>
                            <a
                                href="https://www.linkedin.com/company/sfrubyconf/"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Follow SF Ruby on LinkedIn"
                                class="w-11 h-11 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                    />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- wave into the sponsor section -->
                <svg
                    preserveAspectRatio="none"
                    viewBox="0 0 1200 120"
                    xmlns="http://www.w3.org/2000/svg"
                    class="absolute bottom-0 left-0 w-full h-12 md:h-16"
                    aria-hidden="true"
                >
                    <path
                        d="M0,120 L0,80 C120,60 240,50 360,55 C480,45 600,48 720,55 C840,45 960,48 1080,55 C1140,52 1170,53 1200,55 L1200,120 Z"
                        fill="#f8fafc"></path>
                </svg>
            </section>

            <!-- Sponsor CTA -->
            <section class="py-16 bg-slate-50">
                <div
                    class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
                >
                    <h2
                        class="font-display text-2xl md:text-3xl font-bold text-gray-900"
                    >
                        Partner with the conference
                    </h2>
                    <p class="text-base md:text-lg text-gray-600 mt-3 mb-8">
                        Put your company in front of the Ruby community: founders,
                        engineers, and the people shipping production Ruby.
                    </p>
                    <a
                        href="/sponsor-2026"
                        class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-ruby-500 to-pink-500 px-6 py-3 text-base font-semibold text-white shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105"
                    >
                        Become a 2026 sponsor
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"></path></svg
                        >
                    </a>
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>
