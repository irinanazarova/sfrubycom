---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import {
    SCHOLARSHIP_APPLICATION_URL,
    SCHOLARSHIP_EMAIL,
    DEADLINE,
    DEADLINE_DISPLAY,
    DEADLINE_SHORT,
    FAQ_ITEMS,
} from "../data/scholarship-2026.js";

const stripHtml = (html) => html.replace(/<[^>]*>/g, "");

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ_ITEMS.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: stripHtml(item.answer),
        },
    })),
};
---

<BaseLayout
    title="Scholarship Program - San Francisco Ruby Conference 2026"
    description="Free tickets to the San Francisco Ruby Conference 2026 for students learning Ruby. Recent grads and career changers are welcome to apply too."
>
    <PageHero
        title="Scholarship Program"
        lede="A free conference ticket for students learning Ruby."
    >
        <div class="flex flex-wrap justify-center gap-x-10 gap-y-5">
            <div>
                <div class="px-font px-shadow-ink text-base md:text-lg text-white">Free</div>
                <div class="text-sm text-white px-shadow-ink-sm mt-1.5">Ticket</div>
            </div>
            <div>
                <div class="px-font px-shadow-ink text-base md:text-lg text-gold-400">Nov 10&ndash;12</div>
                <div class="text-sm text-white px-shadow-ink-sm mt-1.5">SFJAZZ</div>
            </div>
            <div>
                <div class="px-font px-shadow-ink text-base md:text-lg text-sky-100">{DEADLINE_SHORT}</div>
                <div class="text-sm text-white px-shadow-ink-sm mt-1.5">Apply by</div>
            </div>
        </div>
        <a
            href={SCHOLARSHIP_APPLICATION_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="px-btn px-btn--gold px-font text-px9 md:text-px10 px-6 py-4 mt-6 md:mt-8 tap-press justify-center"
        >
            Apply
        </a>
    </PageHero>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
        <!-- Program overview -->
        <section>
            <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                The Program
            </h2>
            <div class="px-card bg-white p-8">
                <p class="text-gray-600 leading-relaxed mb-4">
                    The scholarship gives students a free ticket to the San
                    Francisco Ruby Conference 2026. Recent grads, career
                    changers, and self-taught developers are welcome to apply
                    too. No Ruby experience needed. Ruby is a programming language, similar in spirit
                    to Python or JavaScript, and a lot of well-known startups
                    are built on it.
                </p>
                <p class="text-gray-600 leading-relaxed">
                    Come hear the talks, meet the engineers and founders
                    building with Ruby, and find your people.
                </p>
            </div>
        </section>

        <!-- What's Included -->
        <section>
            <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                What the Scholarship Includes
            </h2>
            <div class="px-card bg-white p-8">
                <div class="space-y-6">
                    <div class="grid grid-cols-[4rem_1fr] gap-4 items-start">
                        <img
                            src="/px-ticket.png"
                            alt=""
                            width="26"
                            height="12"
                            class="px-pixelated h-7 w-auto justify-self-center mt-1"
                        />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                A full conference ticket
                            </h3>
                            <p class="text-gray-600 text-sm">
                                All three days at SFJAZZ: every talk, workshop,
                                and networking session.
                            </p>
                        </div>
                    </div>
                    <div class="grid grid-cols-[4rem_1fr] gap-4 items-start">
                        <img
                            src="/px-heart.png"
                            alt=""
                            width="14"
                            height="13"
                            class="px-pixelated h-8 w-auto justify-self-center mt-1"
                        />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                The other scholars
                            </h3>
                            <p class="text-gray-600 text-sm">
                                A Slack channel with the other scholars, to
                                say hi, swap lodging ideas, and meet up before,
                                during, and after the conference.
                            </p>
                        </div>
                    </div>
                    <div class="grid grid-cols-[4rem_1fr] gap-4 items-start">
                        <img
                            src="/px-matz.png"
                            alt=""
                            width="18"
                            height="21"
                            class="px-pixelated h-9 w-auto justify-self-center mt-1"
                        />
                        <div>
                            <h3 class="font-semibold text-gray-900">
                                A friendly face from day one
                            </h3>
                            <p class="text-gray-600 text-sm">
                                A scholars' meet-up early on the first day, so
                                you don't walk into a big room of strangers
                                alone.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="mt-6 p-4 border-2 border-ink bg-amber-50">
                    <p class="text-amber-800 text-sm font-medium">
                        The scholarship does not cover travel, lodging, or
                        meals. We're also unable to support the visa process,
                        so if you'd need a U.S. visa, read the visa question
                        below first.
                    </p>
                </div>
            </div>
        </section>

        <!-- Who Can Apply -->
        <section>
            <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                Who Can Apply
            </h2>
            <div class="px-card bg-white p-8">
                <ul class="text-gray-600 space-y-3 list-disc list-outside pl-5">
                    <li>
                        Students come first: high school, college, or
                        bootcamp.
                    </li>
                    <li>
                        Recent grads, career changers, and self-taught
                        developers are welcome to apply too.
                    </li>
                    <li>
                        No Ruby experience needed, from day one to already
                        writing code.
                    </li>
                    <li>
                        People from groups underrepresented in tech are
                        especially welcome.
                    </li>
                </ul>
                <p class="text-gray-600 mt-5">
                    You can apply from anywhere, as long as you can be in San
                    Francisco on November 10&ndash;12.
                </p>
            </div>
        </section>

        <!-- Timeline -->
        <section>
            <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                Timeline
            </h2>
            <div class="px-card bg-white p-8">
                <p class="text-gray-600">
                    <strong class="text-gray-900"
                        >Apply by {DEADLINE_DISPLAY}</strong
                    ><span id="countdown" class="text-gray-500"></span>. We
                    review applications as they come in and reply to
                    everyone within a few days of the deadline.
                </p>
            </div>
        </section>

        <!-- FAQ (before the CTA on purpose: visas, travel and age questions
             should be answered before the ask, not after) -->
        <section>
            <div class="px-card bg-white p-8">
                <h2 class="px-font text-sm md:text-base text-gray-900 mb-6">
                    Frequently Asked Questions
                </h2>
                <div class="space-y-4">
                    {FAQ_ITEMS.map((item) => (
                        <div class="border-2 border-ink bg-gray-50 p-6">
                            <h3 class="font-bold text-gray-900 mb-2">
                                {item.question}
                            </h3>
                            <p class="text-gray-600" set:html={item.answer} />
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="text-center">
            <div class="px-card bg-ruby-700 p-8 text-white">
                <h2 class="px-font px-shadow-ink text-sm md:text-base mb-5">
                    Ready to Apply?
                </h2>
                <p class="text-lg mb-6 text-white">
                    It takes a few minutes.
                </p>
                <a
                    href={SCHOLARSHIP_APPLICATION_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-btn px-font text-px9 md:text-px10 gap-2 px-6 py-4 bg-white text-ruby-700 hover:bg-gray-50 normal-case focus-visible:outline-white"
                >
                    Apply for the Scholarship
                </a>
                <p class="text-sm mt-4 text-white">
                    Questions? Email us at <a
                        href={`mailto:${SCHOLARSHIP_EMAIL}`}
                        class="underline focus-visible:outline-white">{SCHOLARSHIP_EMAIL}</a
                    >
                </p>
            </div>
        </section>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<script define:vars={{ DEADLINE }}>
    function updateCountdown() {
        const el = document.getElementById("countdown");
        if (!el) return;

        const deadline = new Date(DEADLINE);
        const now = new Date();
        const diff = deadline.getTime() - now.getTime();

        let text;
        if (diff <= 0) {
            text = " (applications are now closed)";
        } else {
            const hours = Math.floor(diff / (1000 * 60 * 60));
            const days = Math.floor(hours / 24);
            if (days > 0) {
                text = ` (${days} day${days !== 1 ? "s" : ""} left)`;
            } else if (hours < 3) {
                text = " (closing in a couple of hours)";
            } else {
                text = ` (${hours} hour${hours !== 1 ? "s" : ""} left)`;
            }
        }
        el.textContent = text;
    }

    updateCountdown();
    setInterval(updateCountdown, 60000);
</script>
