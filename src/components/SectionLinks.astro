---
// A copy-link button beside every section heading on the page, so any block
// (speakers, networking, tickets, sponsors...) can be shared as a URL that
// lands on it. Sections already carry ids and HashScroll handles the landing;
// this only adds the button, at runtime, to every `main section[id]` with an
// h2, so a new section gets one without being edited.
//
// The icon inherits the heading's color, so it reads on dark and light bands
// alike. Always visible on touch (no hover there), quiet until hover or focus
// with a pointer. The hit area is padded out to 44px without moving the
// heading, and the button is appended after the heading text so centered
// headings stay centered.
---

<style is:global>
    .px-share {
        display: inline-block;
        vertical-align: -0.05em;
        width: 0.85em;
        height: 0.85em;
        margin-left: 0.4em;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        cursor: pointer;
        opacity: 0.45;
        transition: opacity 120ms ease;
        position: relative;
        line-height: 0;
    }
    /* The tap target, grown around the icon without moving the heading. */
    .px-share::before {
        content: "";
        position: absolute;
        inset: -0.85rem;
        min-width: 2.75rem;
        min-height: 2.75rem;
    }
    .px-share svg {
        width: 100%;
        height: 100%;
        display: block;
    }
    .px-share:hover,
    .px-share:focus-visible,
    .px-share.is-copied {
        opacity: 1;
    }
    .px-share:focus-visible {
        outline: 3px solid var(--gold-500);
        outline-offset: 2px;
    }
    @media (hover: none) {
        .px-share {
            opacity: 0.7;
        }
    }
    .px-share.is-copied::after {
        content: "Copied";
        position: absolute;
        left: 50%;
        bottom: calc(100% - 0.25rem);
        transform: translateX(-50%);
        font-family: "Press Start 2P", monospace;
        font-size: 8px;
        line-height: 1;
        letter-spacing: 0.04em;
        padding: 0.375rem 0.5rem;
        color: var(--ink);
        background: var(--gold-500);
        border: 2px solid var(--ink);
        white-space: nowrap;
        pointer-events: none;
    }
</style>

<script>
    const ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';

    for (const section of document.querySelectorAll("main section[id]")) {
        const heading = section.querySelector("h2");
        if (!heading || heading.querySelector(".px-share")) continue;

        const title = heading.textContent?.trim() ?? section.id;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "px-share";
        button.setAttribute("aria-label", `Copy link to ${title}`);
        button.innerHTML = ICON;

        button.addEventListener("click", async () => {
            const url = `${location.origin}${location.pathname}#${section.id}`;
            try {
                await navigator.clipboard.writeText(url);
            } catch {
                // No clipboard (insecure context, old browser): put the hash
                // in the address bar so the URL can be copied from there.
                history.replaceState(null, "", `#${section.id}`);
            }
            button.classList.add("is-copied");
            button.setAttribute("aria-label", "Link copied");
            setTimeout(() => {
                button.classList.remove("is-copied");
                button.setAttribute("aria-label", `Copy link to ${title}`);
            }, 1600);
        });

        // A word joiner glues the icon to the last word, so a centered
        // heading never wraps the icon onto a line of its own.
        heading.append("\u2060", button);
    }
</script>
