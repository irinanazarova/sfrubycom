---
// The pre-conference game: the argument for buying today instead of in
// October. Activities start at registration (Cloud Card character, tasks and
// games in the conference app and Slack), so every week of waiting is missed
// play. Sits right before the ticket ladder to set up the price ask.
import { LUMA_URL } from "../data/conference-2026.js";

const stages = [
    {
        title: "Your character joins the map",
        body: "Upload a photo and get your Cloud Card: an 8-bit version of you, up on the clouds on one big shared picture with everyone else who is going.",
    },
    {
        title: "Tasks and games, starting now",
        body: "Quests run in the conference app and the SF Ruby Slack from the day you register until November. Complete them and badges stack up on your Cloud Card.",
    },
    {
        title: "Arrive knowing your crew",
        body: "We match you into a group by shared interests. Find your people online first, then in person at SFJAZZ, where the last badges are earned face to face.",
    },
];
---

<section
    id="quest"
    class="relative overflow-hidden py-20 md:py-24 px-dither-sky border-t-4 border-ink"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-2xl mx-auto text-center">
            <span class="px-plate px-plate--gold px-font text-px8 px-3 py-1.5"
                >Season open</span
            >
            <h2 class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6">
                The conference starts now
            </h2>
            <p class="text-base md:text-lg text-white/90 leading-relaxed mt-5">
                Your ticket is a character slot. The game begins the day you
                register, months before the doors open.
            </p>
        </div>

        <ul class="mt-14 grid gap-5 md:grid-cols-3 list-none p-0">
            {
                stages.map((s, i) => (
                    <li class="px-card bg-white p-6 flex flex-col">
                        <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3 class="px-font text-px9 md:text-px10 text-gray-900 mt-5 leading-relaxed">
                            {s.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed mt-4">
                            {s.body}
                        </p>
                    </li>
                ))
            }
        </ul>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
                href={LUMA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                <img
                    src="/px-ticket.png"
                    alt=""
                    width="26"
                    height="12"
                    class="px-pixelated h-5 w-auto"
                />
                Claim your slot
            </a>
            <a
                href="https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg"
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                Join the Slack
            </a>
        </div>
    </div>
</section>
