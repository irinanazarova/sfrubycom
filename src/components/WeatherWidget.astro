<div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
    <h4 class="font-medium text-amber-800 mb-2">
        🌤️ November Weather in SF
    </h4>
    <div id="weather-widget">
        <div class="text-amber-700 text-sm mb-2">
            <strong>Expected:</strong> 60°F/15°C highs, 50°F/10°C lows
        </div>
        <div class="text-amber-700 text-sm mb-2">
            <strong>Conditions:</strong> Partly cloudy, possible light rain
        </div>
        <div class="text-amber-700 text-sm">
            <strong>Pack:</strong> Layers (tee + hoodie + rain jacket), comfortable shoes, hiking boots for weekend adventures!
        </div>
    </div>
    
    <!-- Weather will be updated closer to the event -->
    <div class="mt-3 text-xs text-amber-600 italic">
        Live forecast will be available closer to the conference date
    </div>
</div>

<script>
// Weather API integration - will be activated closer to the event
function updateWeatherWidget() {
    const now = new Date();
    const conferenceDate = new Date('2025-11-19');
    const daysUntilConference = Math.ceil((conferenceDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
    
    // Only fetch live weather data when we're within 10 days of the conference
    if (daysUntilConference <= 10 && daysUntilConference > 0) {
        // We can use OpenWeatherMap API (free tier) or WeatherAPI
        // For now, we'll show a placeholder that can be updated later
        const widget = document.getElementById('weather-widget');
        if (widget) {
            widget.innerHTML = `
                <div class="text-amber-700 text-sm mb-2">
                    <strong>Live Forecast:</strong> Loading current conditions...
                </div>
                <div class="text-xs text-amber-600">
                    Weather data will be updated daily as we approach the conference
                </div>
            `;
        }
        
        // TODO: Implement actual weather API call
        // Example: OpenWeatherMap API call would go here
        // fetch(`https://api.openweathermap.org/data/2.5/forecast?q=San Francisco,US&appid=${API_KEY}`)
    }
}

// Check weather on page load
document.addEventListener('DOMContentLoaded', updateWeatherWidget);
</script>