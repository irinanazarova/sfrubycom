---
/**
 * Button Component
 *
 * A flexible button/link component with consistent styling.
 *
 * @example Basic usage:
 * <Button href="/about">Learn More</Button>
 *
 * @example Primary CTA:
 * <Button href="/register" variant="primary" size="lg">Register Now</Button>
 *
 * @example Social link:
 * <Button href="https://slack.com" variant="slack" external>Join Slack</Button>
 *
 * @example Outline button:
 * <Button variant="outline">Cancel</Button>
 */

interface Props {
    href?: string;
    variant?:
        | "primary"
        | "secondary"
        | "outline"
        | "ghost"
        | "white"
        // Social variants
        | "slack"
        | "substack"
        | "twitter"
        | "bluesky"
        | "linkedin"
        | "ruby";
    size?: "sm" | "md" | "lg";
    external?: boolean;
    class?: string;
    /** Remove hover scale effect */
    noScale?: boolean;
    /** Allow any data-* attributes */
    [key: `data-${string}`]: string | undefined;
}

const {
    href,
    variant = "primary",
    size = "md",
    external = false,
    class: className = "",
    noScale = false,
    ...rest
} = Astro.props;

const Tag = href ? "a" : "button";

// Core variants: colors only — the 8-bit chrome (ink border, hard shadow,
// press state, pixel type) comes from .px-btn/.px-font. Ghost stays flat.
const variants: Record<string, string> = {
    // Standard variants
    primary: "bg-ruby-500 text-white hover:bg-ruby-400",
    secondary: "bg-ink text-white hover:bg-gray-800",
    outline: "bg-transparent text-ruby-600 hover:bg-ruby-50",
    ghost: "bg-transparent text-gray-700 hover:bg-gray-100",
    white: "bg-white text-ruby-600 hover:bg-gray-50",

    // Social variants (brand colors from the token palette, same 8-bit chrome)
    slack: "bg-slack-500 text-white hover:bg-slack-600",
    substack: "bg-substack-500 text-white hover:bg-substack-600",
    twitter: "bg-black text-white hover:bg-gray-800",
    bluesky: "bg-bluesky-500 text-white hover:bg-bluesky-600",
    linkedin: "bg-linkedin-500 text-white hover:bg-linkedin-600",
    ruby: "bg-ruby-500 text-white hover:bg-ruby-600",
};

// Pixel type runs wide; sizes are tuned down from the old text-sm/base/lg.
const sizes: Record<string, string> = {
    sm: "px-4 py-2.5 text-px9",
    md: "px-6 py-3.5 text-px10",
    lg: "px-8 py-4 text-xs",
};
---

<Tag
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    class:list={[
        variant === "ghost"
            ? "inline-flex items-center justify-center gap-2 font-semibold transition-colors duration-200"
            : "px-btn px-font",
        variants[variant],
        sizes[size],
        className,
    ]}
    {...rest}
>
    <slot />
</Tag>
