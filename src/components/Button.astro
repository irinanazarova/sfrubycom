---
/**
 * Button Component
 *
 * A flexible button/link component with consistent styling.
 *
 * @example Basic usage:
 * <Button href="/about">Learn More</Button>
 *
 * @example Primary CTA:
 * <Button href="/register" variant="primary" size="lg">Register Now</Button>
 *
 * @example Social link:
 * <Button href="https://slack.com" variant="slack" external>Join Slack</Button>
 *
 * @example Outline button:
 * <Button variant="outline">Cancel</Button>
 */

interface Props {
    href?: string;
    variant?:
        | "primary"
        | "secondary"
        | "outline"
        | "ghost"
        | "white"
        // Social variants
        | "slack"
        | "substack"
        | "twitter"
        | "bluesky"
        | "linkedin"
        | "ruby";
    size?: "sm" | "md" | "lg";
    external?: boolean;
    class?: string;
    /** Remove hover scale effect */
    noScale?: boolean;
}

const {
    href,
    variant = "primary",
    size = "md",
    external = false,
    class: className = "",
    noScale = false,
} = Astro.props;

const Tag = href ? "a" : "button";

// Core variants
const variants: Record<string, string> = {
    // Standard variants
    primary:
        "bg-gradient-to-r from-ruby-500 to-pink-500 text-white shadow-lg hover:shadow-xl hover:from-ruby-400 hover:to-pink-400",
    secondary: "bg-gray-900 text-white hover:bg-gray-800",
    outline:
        "bg-transparent border-2 border-ruby-500 text-ruby-500 hover:bg-ruby-50",
    ghost: "bg-transparent text-gray-700 hover:bg-gray-100",
    white: "bg-white text-ruby-600 shadow-lg hover:shadow-xl hover:bg-gray-50",

    // Social variants (consistent height with standard buttons)
    slack: "bg-[#4A154B] text-white hover:bg-[#3e1240] shadow-sm hover:shadow-md",
    substack:
        "bg-[#FF6719] text-white hover:bg-[#e55a14] shadow-sm hover:shadow-md",
    twitter: "bg-black text-white hover:bg-gray-800 shadow-sm hover:shadow-md",
    bluesky:
        "bg-[#0085FF] text-white hover:bg-[#0070d6] shadow-sm hover:shadow-md",
    linkedin:
        "bg-[#0A66C2] text-white hover:bg-[#084d94] shadow-sm hover:shadow-md",
    ruby: "bg-ruby-500 text-white hover:bg-ruby-600 shadow-sm hover:shadow-md",
};

// Standardized sizes (consistent across all variants)
const sizes: Record<string, string> = {
    sm: "px-4 py-2 text-sm",
    md: "px-6 py-3 text-base",
    lg: "px-8 py-4 text-lg",
};

const scaleClass = noScale ? "" : "hover:scale-105";
---

<Tag
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    class:list={[
        "inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-all duration-300",
        scaleClass,
        variants[variant],
        sizes[size],
        className,
    ]}
>
    <slot />
</Tag>
