---
/**
 * EmailModal Component
 *
 * A reusable modal that displays an email address with a copy button.
 * Use this instead of mailto links for better UX.
 *
 * Usage:
 * <EmailModal id="unique-id" email="email@example.com" subject="Optional Subject" />
 *
 * Trigger with: data-email-modal="unique-id" on any clickable element
 */

interface Props {
    id: string;
    email: string;
    subject?: string;
    title?: string;
}

const { id, email, subject = "", title = "Get in touch" } = Astro.props;
---

<dialog
    id={`email-modal-${id}`}
    class="email-modal fixed inset-0 z-50 m-auto p-0 bg-transparent backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 overflow-hidden">
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-900">{title}</h3>
                <button
                    class="email-modal-close w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 transition-colors"
                    aria-label="Close"
                >
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <p class="text-gray-600 mb-4">Send us an email at:</p>

            <div class="flex items-center gap-2 p-3 bg-gray-50 rounded-xl border border-gray-200">
                <span class="flex-1 font-mono text-gray-900 select-all">{email}</span>
                <button
                    class="email-copy-btn flex items-center gap-2 px-3 py-1.5 bg-ruby-500 hover:bg-ruby-600 text-white text-sm font-medium rounded-lg transition-colors"
                    data-email={email}
                >
                    <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <svg class="w-4 h-4 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="copy-text">Copy</span>
                </button>
            </div>

            {subject && (
                <p class="mt-3 text-sm text-gray-500">
                    Subject: <span class="text-gray-700">{subject}</span>
                </p>
            )}

            <div class="mt-6 flex gap-3">
                <a
                    href={`mailto:${email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`}
                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-white font-medium rounded-lg transition-colors"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Open in email app
                </a>
            </div>
        </div>
    </div>
</dialog>

<script>
    // Initialize all email modals
    function initEmailModals() {
        // Handle triggers
        document.querySelectorAll('[data-email-modal]').forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                const modalId = trigger.getAttribute('data-email-modal');
                const modal = document.getElementById(`email-modal-${modalId}`) as HTMLDialogElement;
                if (modal) {
                    modal.showModal();
                }
            });
        });

        // Handle close buttons
        document.querySelectorAll('.email-modal-close').forEach(btn => {
            btn.addEventListener('click', () => {
                const modal = btn.closest('dialog');
                if (modal) {
                    (modal as HTMLDialogElement).close();
                }
            });
        });

        // Handle backdrop click to close
        document.querySelectorAll('.email-modal').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    (modal as HTMLDialogElement).close();
                }
            });
        });

        // Handle copy buttons
        document.querySelectorAll('.email-copy-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const email = btn.getAttribute('data-email');
                if (email) {
                    try {
                        await navigator.clipboard.writeText(email);
                        const copyIcon = btn.querySelector('.copy-icon');
                        const checkIcon = btn.querySelector('.check-icon');
                        const copyText = btn.querySelector('.copy-text');

                        if (copyIcon && checkIcon && copyText) {
                            copyIcon.classList.add('hidden');
                            checkIcon.classList.remove('hidden');
                            copyText.textContent = 'Copied!';

                            setTimeout(() => {
                                copyIcon.classList.remove('hidden');
                                checkIcon.classList.add('hidden');
                                copyText.textContent = 'Copy';
                            }, 2000);
                        }
                    } catch (err) {
                        console.error('Failed to copy:', err);
                    }
                }
            });
        });
    }

    // Run on load and after navigation
    initEmailModals();
    document.addEventListener('astro:after-swap', initEmailModals);
</script>
