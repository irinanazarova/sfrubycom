---

const testimonials = [
  {
    quote: "Truly the best meetup in SF. Had a great time tonight!",
    author: "Lev Lazinsky",
    role: "Head of Solutions @ Dagger",
    image: "/testimonial_lev.jpg"
  },
  {
    quote: "It's kinda ridonkulous each month there's a Ruby meetup in SF with as many attendees as most really great annual Ruby/Rails conferences I see folks organizing around the world.",
    author: "Brad Gessler",
    role: "Founder @ Terminalwire",
    image: "/testimonial_brad.jpg"
  }
];
---

<section id="monthly-meetup" class="py-20 bg-dark-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block">
        <a href="#monthly-meetup" class="group">
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-dark-900 mb-4 tracking-tight transition-colors duration-300 group-hover:text-ruby-600"
          >
            Monthly Meetup
          </h2>
        </a>
        <div
          class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
        >
        </div>
      </div>
      <p
        class="mt-4 text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light"
      >
        Brought to you by the SF Ruby Meetup
      </p>
    </div>
    <div class="text-center mt-12">
        The Ruby community in the SF Bay area is full of energy today: we gather 70-100 people at the <a href="https://lu.ma/sfruby" target="_blank" class="underline">SF Ruby meetup</a> every month for deep technical talks and conversations. Check out talk recordings at <a href="https://www.rubyevents.org/events/sf-bay-area-ruby-meetup" target="_blank" class="underline">Ruby Events</a>.
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 md:mx-20 gap-8 text-center mt-4">
      {testimonials.map((testimonial) => (
        <div class="bg-white p-6 rounded-lg shadow-md flex flex-col h-full">
          <div class="mb-4 text-ruby-500">
            <!-- Quote icon -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 opacity-50">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          <blockquote class="flex-grow mb-6">
            <p class="text-dark-700 italic">"{testimonial.quote}"</p>
          </blockquote>

          <div class="flex items-center">
            <div class="flex-shrink-0 mr-3">
              <img
                src={testimonial.image}
                alt={testimonial.author}
                class="h-10 w-10 rounded-full object-cover"
                loading="lazy"
              />
            </div>
            <div>
              <div class="font-medium text-dark-900">{testimonial.author}</div>
              <div class="text-sm text-dark-500">{testimonial.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
