---
// The networking format is the thing this conference has that a stream of talks
// does not, and none of it appeared anywhere on the site. Given it is also the
// reason a company sends five people instead of one, it gets its own section
// above the ticket ladder.
import { LUMA_URL } from "../data/conference-2026.js";

// Numbered plates rather than sprite icons: the px-* set has no third icon that
// reads as "founders' session", and the numbers frame this as a sequence anyway.
// The mechanics are the pitch here, so they are stated exactly: two groups, 70
// to 100 people, 60 seconds each. Earlier copy said "small groups", which is
// both vaguer and wrong at this size.
const formats = [
    {
        title: "Everyone gets a mic",
        body: "You are matched into at least two networking groups of 70 to 100 people. In each one you get 60 seconds on the mic to say who you are and what you are building.",
    },
    {
        title: "Teams of 5+ get a longer slot",
        body: "Bring five or more from your company and you get extended time, and slides, to introduce the team to the room.",
    },
    {
        title: "Founders' round with Garry Tan",
        body: "A dedicated group for founders and founding teams with the President and CEO of Y Combinator.",
    },
];
---

<section
    id="networking"
    class="relative overflow-hidden py-20 md:py-24 px-royal-grad text-white border-t-4 border-ink"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-2xl mx-auto text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Day 1–3</span>
            <h2
                class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6"
            >
                More than a room of talks
            </h2>
            <p class="text-base md:text-lg text-white/90 leading-relaxed mt-5">
                Half the value of a conference is who you meet, so it is on the
                schedule rather than left to the coffee queue.
            </p>
        </div>

        <ul class="mt-14 grid gap-5 md:grid-cols-3 list-none p-0">
            {
                formats.map((f, i) => (
                    <li class="px-card bg-white p-6 flex flex-col">
                        <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3 class="px-font text-px9 md:text-px10 text-gray-900 mt-5 leading-relaxed">
                            {f.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed mt-4">
                            {f.body}
                        </p>
                    </li>
                ))
            }
        </ul>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
                href={LUMA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                <img
                    src="/px-ticket.png"
                    alt=""
                    width="64"
                    height="64"
                    class="px-pixelated h-5 w-auto"
                />
                Bring your team
            </a>
            <a
                href="/contact"
                class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                Ask for an invoice
            </a>
        </div>
    </div>
</section>
