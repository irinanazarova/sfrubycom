---
// The networking format is the thing this conference has that a stream of talks
// does not, and none of it appeared anywhere on the site. Given it is also the
// reason a company sends five people instead of one, it gets its own section
// above the ticket ladder.
import { getAllJobs, jobCompanyId } from "../data/jobs.js";

const openRoles = getAllJobs();
const hiringCompanies = new Set(
    openRoles.map(jobCompanyId).filter(Boolean),
).size;

// Counted from the board rather than typed in, so the claim cannot go stale the
// next time a listing is added or archived. Company identity comes from
// jobCompanyId, the same resolution /jobs uses: counting `companyName` alone
// drops half the board (Gusto, Chime, Persona, AngelList and Omada among them).

// Numbered plates rather than sprite icons: the px-* set has no third icon that
// reads as "founders' session", and the numbers frame this as a sequence anyway.
// The mechanics are the pitch here, so they are stated exactly: two groups, 70
// to 100 people, 60 seconds each. Earlier copy said "small groups", which is
// both vaguer and wrong at this size.
// The conversation groups and who hosts them come from the schedule
// (src/data/schedule-2026.js), the same file the homepage schedule section
// reads, so this section can never promise a room the schedule does not have. Only the hosts' affiliations live here. Verified:
// Amanda is Evil Martians, Cameron moved to Cisco Meraki (our own July 2026
// meetup writeup, more recent than the GitHub tenure the web still shows),
// Mike is Staff Engineer at Triumph. Ken hosts unaffiliated, so he carries no
// org line rather than a guessed one.
import { AUDIENCES, allGroups, groupHosts } from "../data/schedule-2026.js";

const hostOrgs = {
    "Amanda Kinney": "Evil Martians",
    "Cameron Dutro": "Cisco Meraki",
    "Mike Dalton": "Triumph",
};
const hosts = groupHosts().map((name) => ({ name, org: hostOrgs[name] ?? "" }));
const groups = allGroups();

// The mechanics are the pitch here, so they are stated exactly: two groups,
// 70 to 100 people, 60 seconds each. Earlier copy said "small groups", which
// is both vaguer and wrong at this size.
const formats = [
    {
        title: "Everyone gets a mic",
        body: "You are matched into at least two groups of 70 to 100 people who work on the same kind of thing you do. In each one you get 60 seconds on the mic to say who you are and what you are building, so the people who need to find you can.",
    },
    {
        title: "Teams of 5+ get a longer slot",
        body: "Bring five or more from your company and you get extended time, and slides, to introduce the team to the room. Hiring managers find that useful.",
    },
    {
        title: "Groups run while the other audience is in the hall",
        body: "Startups meet while the household names are in their talks, then they swap. Nobody chooses between a talk and the room, and the people in your group are the ones the schedule put there for you.",
    },
];
---

<section
    id="networking"
    class="relative overflow-hidden py-20 md:py-24 px-royal-grad text-white border-t-4 border-ink"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-2xl mx-auto text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Day 1–3</span>
            <h2
                class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6"
            >
                More than a room of talks
            </h2>
            <p class="text-base md:text-lg text-white/90 leading-relaxed mt-5">
                The room is full of people shipping the same problem you
                are: the same queue, the same monolith, the same hiring plan.
                Startups and household names get their own talks, and the two
                weave: while one audience is in the main hall, the other is in a
                conversation group built for it, then they swap.
            </p>
        </div>

        <ul class="mt-14 grid gap-5 md:grid-cols-3 list-none p-0">
            {
                formats.map((f, i) => (
                    <li class="px-card bg-white p-6 flex flex-col">
                        <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3 class="px-font text-px9 md:text-px10 text-gray-900 mt-5 leading-relaxed">
                            {f.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed mt-4">
                            {f.body}
                        </p>
                    </li>
                ))
            }
        </ul>

        <!-- The rooms themselves, straight from the schedule. A session with
             100 people in it and a mic going around needs someone driving, so
             each one names its host; that is what makes the format concrete
             rather than a promise. -->
        <div class="mt-6 px-card bg-white p-6 md:p-7 max-w-3xl mx-auto">
            <p class="px-font text-px8 text-ruby-600 text-center">The conversation groups</p>
            <ul class="mt-6 flex flex-col gap-4 list-none p-0">
                {
                    groups.map((g) => (
                        <li class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 border-b-2 border-sky-100 pb-4 last:border-0 last:pb-0">
                            <span class="flex items-center gap-2 shrink-0 sm:w-56">
                                <span class="px-font text-px8 text-gray-500 whitespace-nowrap">Day {g.day}</span>
                                <span class:list={["px-plate px-font text-px8 px-2 py-1 whitespace-nowrap", g.audience === "household" && "px-plate--gold"]}>
                                    {AUDIENCES[g.audience].label}
                                </span>
                            </span>
                            <span class="min-w-0 text-sm md:text-base text-gray-900 leading-relaxed">
                                {g.title}
                                <span class="block text-xs md:text-sm text-gray-500 mt-0.5">
                                    {g.hosts ? `Hosted by ${g.hosts.join(" and ")}` : g.hostTbc ? "Host to be confirmed" : ""}
                                </span>
                            </span>
                        </li>
                    ))
                }
            </ul>
            <p class="text-xs text-gray-500 leading-relaxed mt-6 text-center">
                Each group follows a conversational style. Be prepared to introduce yourself, your team and product on our second stage. No slides.
            </p>
        </div>

        <!-- The hiring is already visible, and it is our own board saying so. -->
        <div class="mt-8 px-card bg-white p-6 md:p-7 max-w-3xl mx-auto text-center">
            <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                <span class="font-display font-semibold text-gray-900">
                    {openRoles.length} open Ruby and Rails roles from {
                        hiringCompanies
                    } companies
                </span>{" "}
                are on our jobs board today, GitHub, Chime, Gusto, Persona and
                AngelList among them. In November those hiring managers are
                sitting in your networking group, and you get the mic.
            </p>
            <a
                href="/jobs"
                class="px-btn px-btn--sky px-font text-px8 md:text-px10 px-5 py-3 tap-press mt-5"
            >
                See who is hiring
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
                href="/team"
                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                <img
                    src="/px-ticket.png"
                    alt=""
                    width="64"
                    height="64"
                    class="px-pixelated h-5 w-auto"
                />
                Bring your team
            </a>
            <a
                href="/manager"
                class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                Convince your manager
            </a>
        </div>
    </div>
</section>
