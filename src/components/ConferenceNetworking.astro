---
// The networking format is the thing this conference has that a stream of talks
// does not, and none of it appeared anywhere on the site. Given it is also the
// reason a company sends five people instead of one, it gets its own section
// above the ticket ladder.
import { LUMA_URL } from "../data/conference-2026.js";
import { getAllJobs, jobCompanyId } from "../data/jobs.js";

const openRoles = getAllJobs();
const hiringCompanies = new Set(
    openRoles.map(jobCompanyId).filter(Boolean),
).size;

// Counted from the board rather than typed in, so the claim cannot go stale the
// next time a listing is added or archived. Company identity comes from
// jobCompanyId, the same resolution /jobs uses: counting `companyName` alone
// drops half the board (Gusto, Chime, Persona, AngelList and Omada among them).

// Numbered plates rather than sprite icons: the px-* set has no third icon that
// reads as "founders' session", and the numbers frame this as a sequence anyway.
// The mechanics are the pitch here, so they are stated exactly: two groups, 70
// to 100 people, 60 seconds each. Earlier copy said "small groups", which is
// both vaguer and wrong at this size.
// The four people running the networking rooms. Affiliations verified: Amanda
// is Evil Martians, Cameron moved to Cisco Meraki (our own July 2026 meetup
// writeup, more recent than the GitHub tenure the web still shows), Mike is
// Staff Engineer at Triumph. Ken hosts unaffiliated, so he carries no org line
// rather than a guessed one.
const hosts = [
    { name: "Amanda Kinney", org: "Evil Martians" },
    { name: "Ken Decanio", org: "" },
    { name: "Cameron Dutro", org: "Cisco Meraki" },
    { name: "Mike Dalton", org: "Triumph" },
];

const formats = [
    {
        title: "Everyone gets a mic",
        body: "You are matched into at least two networking groups of 70 to 100 people. In each one you get 60 seconds on the mic to say who you are and what you are building.",
    },
    {
        title: "Teams of 5+ get a longer slot",
        body: "Bring five or more from your company and you get extended time, and slides, to introduce the team to the room.",
    },
    {
        title: "Founders' round with Garry Tan",
        body: "A dedicated group for founders and founding teams with the President and CEO of Y Combinator.",
    },
];
---

<section
    id="networking"
    class="relative overflow-hidden py-20 md:py-24 px-royal-grad text-white border-t-4 border-ink"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-2xl mx-auto text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Day 1–3</span>
            <h2
                class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6"
            >
                More than a room of talks
            </h2>
            <p class="text-base md:text-lg text-white/90 leading-relaxed mt-5">
                Startups and scaleups get two tracks, and the tracks weave: when
                one is on stage, the other room is in an organized networking
                session, then they swap. Who you meet is on the schedule, so it
                never comes down to the coffee queue.
            </p>
        </div>

        <ul class="mt-14 grid gap-5 md:grid-cols-3 list-none p-0">
            {
                formats.map((f, i) => (
                    <li class="px-card bg-white p-6 flex flex-col">
                        <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 self-start">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <h3 class="px-font text-px9 md:text-px10 text-gray-900 mt-5 leading-relaxed">
                            {f.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed mt-4">
                            {f.body}
                        </p>
                    </li>
                ))
            }
        </ul>

        <!-- Who runs the rooms. A session with 100 people in it and a mic
             going around needs someone driving, and naming them makes the
             format concrete rather than a promise. -->
        <div
            class="mt-6 px-card bg-white p-6 md:p-7 max-w-3xl mx-auto text-center"
        >
            <p class="px-font text-px8 text-ruby-600">Your hosts</p>
            <ul
                class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-5 list-none p-0"
            >
                {
                    hosts.map((h) => (
                        <li>
                            {/* fixed two-line box, same trick as the speaker
                                tiles: names that wrap would otherwise push
                                their org line off the row's baseline */}
                            <p class="font-display font-semibold text-sm md:text-base text-gray-900 leading-snug flex items-center justify-center min-h-[2.75rem]">
                                {h.name}
                            </p>
                            {h.org && (
                                <p class="text-xs text-ruby-600 mt-1.5">
                                    {h.org}
                                </p>
                            )}
                        </li>
                    ))
                }
            </ul>
            <p class="text-xs text-gray-500 leading-relaxed mt-6">
                Each room has a host keeping the mic moving through 70 to 100
                introductions, so every 60 seconds lands.
            </p>
        </div>

        <!-- The hiring is already visible, and it is our own board saying so. -->
        <div class="mt-8 px-card bg-white p-6 md:p-7 max-w-3xl mx-auto text-center">
            <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                <span class="font-display font-semibold text-gray-900">
                    {openRoles.length} open Ruby and Rails roles from {
                        hiringCompanies
                    } companies
                </span>{" "}
                are on our jobs board today, GitHub, Chime, Gusto, Persona and
                AngelList among them. In November those hiring managers are
                sitting in your networking group, and you get the mic.
            </p>
            <a
                href="/jobs"
                class="px-btn px-btn--sky px-font text-px8 md:text-px10 px-5 py-3 tap-press mt-5"
            >
                See who is hiring
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
                href={LUMA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                <img
                    src="/px-ticket.png"
                    alt=""
                    width="64"
                    height="64"
                    class="px-pixelated h-5 w-auto"
                />
                Bring your team
            </a>
            <a
                href="/contact"
                class="px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                Ask for an invoice
            </a>
        </div>
    </div>
</section>
