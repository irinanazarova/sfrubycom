---
// Price and the date it holds until. A deadline states itself; spelling out the
// cap and the coming rise turns a fact into a pitch, so neither is written down.
// The remaining count appears only once it is genuinely small, where it is
// information rather than pressure.
import {
    regularTier,
    regularRemaining,
    LUMA_URL,
} from "../data/conference-2026.js";

interface Props {
    variant?: "light" | "dark";
    withCta?: boolean;
}

const { variant = "dark", withCta = false } = Astro.props;

const remaining = regularRemaining();
const closes = new Date(regularTier.closesOn).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "America/Los_Angeles",
});
const showCount = remaining <= regularTier.showCountBelow;
---

<div
    class:list={[
        "px-card inline-flex flex-col sm:flex-row items-center gap-3 sm:gap-5 px-4 py-3",
        variant === "dark" ? "bg-white/95" : "bg-white",
    ]}
>
    <span class="px-font text-px10 md:text-xs text-gray-900">$450</span>

    <span class="hidden sm:block w-px h-6 bg-gray-200" aria-hidden="true"></span>

    <span class="text-xs md:text-sm text-gray-600 text-center sm:text-left">
        Until {closes}
    </span>

    {
        showCount && (
            <>
                <span
                    class="hidden sm:block w-px h-6 bg-gray-200"
                    aria-hidden="true"
                />
                <span class="text-xs md:text-sm text-gray-600">
                    {remaining} left
                </span>
            </>
        )
    }

    {
        withCta && (
            <a
                href={LUMA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--gold px-font text-px8 px-4 py-3 tap-press"
            >
                Get tickets
            </a>
        )
    }
</div>
