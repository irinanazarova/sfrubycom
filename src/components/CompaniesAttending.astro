---
// Who is in the room: the companies with two or more ticket holders, with the
// Cloud Card characters those people have already published on the Pier.
// Data is the build-time snapshot from scripts/fetch-attending-companies.js
// (src/content/attending-companies.json), refreshed on every `npm run build`.
//
// Characters are hotlinked from clouds.sfruby.com, the same images the game
// serves on each person's card. A character someone has since deleted 404s,
// and the img removes itself so the row never shows a broken image.
import snapshot from "../content/attending-companies.json";

const companies = snapshot.companies ?? [];
const min = snapshot.minAttendees ?? 2;
const totalPeople = companies.reduce((n, c) => n + c.count, 0);
---

{
    companies.length > 0 && (
        <section
            id="companies"
            class="relative overflow-hidden py-20 md:py-24 px-sky-grad-day border-t-4 border-ink"
        >
            {/* the same sky as the hero, so the room reads as the same world */}
            <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-20 left-[4%] w-40 md:w-60 animate-float pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-28 right-[6%] w-28 md:w-44 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-[42%] left-[2%] w-20 md:w-28 animate-float [animation-delay:-1.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute bottom-40 right-[3%] w-36 md:w-56 animate-float [animation-delay:-5s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-24 left-[2%] w-48 h-auto animate-float [animation-delay:-4s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute top-[26%] right-[2%] w-32 h-auto animate-float [animation-delay:-2s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="max-w-2xl mx-auto text-center">
                    <span class="px-plate px-font text-px8 px-3 py-1.5">
                        Who is in the room
                    </span>
                    <h2 class="px-font px-shadow-ink text-lg md:text-2xl text-gold-400 mt-6">
                        Ruby companies you'll meet
                    </h2>
                    <p class="text-base md:text-lg text-white px-shadow-ink-sm leading-relaxed mt-5">
                        {companies.length} companies have sent {min} or more
                        people so far, {totalPeople} engineers and founders
                        between them. The characters are theirs, made on the
                        Pier.
                    </p>
                </div>

                <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
                    {companies.map((c) => (
                        <li class="px-card px-card--gold bg-sky-50 p-5 flex flex-col gap-4">
                            <div class="flex items-baseline justify-between gap-3">
                                <h3 class="font-display font-semibold text-base md:text-lg text-gray-900 leading-snug min-w-0">
                                    {c.name}
                                </h3>
                                <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 shrink-0 whitespace-nowrap">
                                    {c.count} attending
                                </span>
                            </div>
                            <div class="flex flex-wrap items-end gap-2 min-h-[4rem]">
                                {c.characters.map((p) => (
                                    <a
                                        href={p.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="block tap-press"
                                        title={p.name}
                                        aria-label={`${p.name}'s Cloud Card`}
                                    >
                                        <img
                                            src={p.image}
                                            alt={p.name}
                                            width="64"
                                            height="64"
                                            loading="lazy"
                                            decoding="async"
                                            class="px-pixelated h-16 w-auto"
                                            onerror="this.parentElement.remove()"
                                        />
                                    </a>
                                ))}
                                {Array.from({ length: Math.max(0, c.count - c.characters.length) }).map(() => (
                                    <span
                                        class="px-font text-2xl text-gray-300 h-16 flex items-end pb-1"
                                        aria-label="Attendee without a Cloud Card yet"
                                    >
                                        ?
                                    </span>
                                ))}
                            </div>
                        </li>
                    ))}
                </ul>

                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a
                        href="/team"
                        class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
                    >
                        <img
                            src="/px-ticket.png"
                            alt=""
                            width="64"
                            height="64"
                            class="px-pixelated h-5 w-auto"
                        />
                        Put your company here
                    </a>
                    <p class="text-sm text-white px-shadow-ink-sm text-center sm:text-left max-w-xs">
                        Two tickets from one company and you are on this list.
                        A ticket also unlocks your character on the Pier.
                    </p>
                </div>
            </div>
        </section>
    )
}
