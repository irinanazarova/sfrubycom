---
// Who is in the room: the companies with two or more ticket holders, with the
// Cloud Card characters those people have already published on the Pier.
// Data is the build-time snapshot from scripts/fetch-attending-companies.js
// (src/content/attending-companies.json), refreshed on every `npm run build`.
//
// Characters are hotlinked from clouds.sfruby.com, the same images the game
// serves on each person's card. A character someone has since deleted 404s,
// and the img swaps itself for the "?" placeholder so the head count still
// shows and the row never shows a broken image.
import snapshot from "../content/attending-companies.json";

const companies = snapshot.companies ?? [];

// Name and character size by head count. Four steps is enough: the point is
// that a group of ten reads as ten and a pair as a pair.
const sizeOf = (n) =>
    n >= 8
        ? { name: "text-base md:text-2xl", chibi: "h-16 md:h-20" }
        : n >= 4
          ? { name: "text-sm md:text-lg", chibi: "h-14 md:h-16" }
          : n >= 3
            ? { name: "text-px10 md:text-sm", chibi: "h-12 md:h-14" }
            : { name: "text-px8 md:text-px10", chibi: "h-10 md:h-12" };

// Legal suffixes are noise on an island: "Workshop Software Inc" is
// Workshop Software to the people standing on it.
const displayName = (name) => name.replace(/[,\s]+(inc|llc|ltd|corp|co|gmbh|plc)\.?$/i, "");

// The organizers stand aside; the cloud is the companies buying tickets.
const ORGANIZER = "Evil Martians";
const organizers = companies.filter((c) => c.name === ORGANIZER);
const guests = companies.filter((c) => c.name !== ORGANIZER);
// Biggest in the middle: the sorted list is dealt to alternating ends.
const arranged = guests.reduce((acc, c, i) => (i % 2 ? [c, ...acc] : [...acc, c]), []);
---

{
    companies.length > 0 && (
        <section
            id="companies"
            class="relative overflow-hidden py-20 md:py-24 px-sky-grad-day border-t-4 border-ink"
        >
            {/* the same sky as the hero, so the room reads as the same world */}
            <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-20 left-[4%] w-40 md:w-60 animate-float pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-28 right-[6%] w-28 md:w-44 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-[42%] left-[2%] w-20 md:w-28 animate-float [animation-delay:-1.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute bottom-40 right-[3%] w-36 md:w-56 animate-float [animation-delay:-5s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-24 left-[2%] w-48 h-auto animate-float [animation-delay:-4s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute top-[26%] right-[2%] w-32 h-auto animate-float [animation-delay:-2s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="max-w-2xl mx-auto text-center">
                    <span class="px-plate px-font text-px8 px-3 py-1.5">
                        Who is in the room
                    </span>
                    <h2 class="px-font px-shadow-ink text-lg md:text-2xl text-gold-400 mt-6">
                        Ruby companies you'll meet
                    </h2>
                    <p class="text-base md:text-lg text-white px-shadow-ink-sm leading-relaxed mt-5">
                        This list is automated: two tickets from one company
                        put it here, and more tickets make the island bigger.
                    </p>
                </div>

                {/* An archipelago: every company is its characters standing
                    on a floating island, the company name under it. The
                    island is as wide as the group, so its height follows
                    (the sprite keeps its aspect), and name and characters
                    grow with the head count too. A ticket holder without a
                    Cloud Card yet stands in as the human from the CFP poster
                    (px-human.png, cut from 8bit_cfp.png at its native 21x41). The organizers' island
                    sits beside the cloud rather than in it: as organizers we
                    always have the most people, and the cloud is for the
                    companies buying tickets. Sorted by size, then dealt to alternating
                    ends so the biggest island floats mid-sky. */}
                <div class="mt-12 lg:grid lg:grid-cols-[1fr_auto] lg:items-center lg:gap-x-10">
                <ul class="flex flex-wrap justify-center items-end gap-x-6 gap-y-8 md:gap-x-10 md:gap-y-10 list-none p-0 m-0">
                    {arranged.map((c, i) => {
                        const size = sizeOf(c.count);
                        return (
                            <li
                                class="flex flex-col items-center animate-float min-w-[8rem]"
                                style={`animation-delay: ${-((i * 1.3) % 6).toFixed(1)}s`}
                            >
                                <div class="relative z-10 flex flex-wrap items-end justify-center gap-1 max-w-[24rem] px-4 -mb-1.5">
                                    {c.characters.map((p) => (
                                        <a
                                            href={p.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="block tap-press"
                                            title={p.name}
                                            aria-label={`${p.name}'s Cloud Card`}
                                        >
                                            <img
                                                src={p.image}
                                                alt={p.name}
                                                width="73"
                                                height="128"
                                                loading="lazy"
                                                decoding="async"
                                                class={`px-pixelated ${size.chibi} w-auto`}
                                            />
                                        </a>
                                    ))}
                                    {Array.from({ length: Math.max(0, c.count - c.characters.length) }).map(() => (
                                        <img
                                            src="/px-human.png"
                                            alt=""
                                            width="21"
                                            height="41"
                                            title="Has a ticket, no Cloud Card yet"
                                            class={`px-pixelated ${size.chibi} w-auto`}
                                        />
                                    ))}
                                </div>
                                {/* w-0 + min-w-full: the island fills the
                                    cluster's width without its own 598px
                                    counting toward that width. */}
                                <div class="w-0 min-w-full">
                                    <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-full h-auto" />
                                </div>
                                <h3 class={`px-font text-white px-shadow-ink text-center leading-relaxed mt-2 ${size.name}`}>
                                    {displayName(c.name)}
                                </h3>
                            </li>
                        );
                    })}
                </ul>
                {organizers.map((c) => (
                    <div class="mt-12 lg:mt-0 flex flex-col items-center animate-float [animation-delay:-2.5s] min-w-[8rem] lg:pl-10 lg:border-l-4 lg:border-white/30">
                        <span class="px-plate px-font text-px8 px-2.5 py-1 mb-3">Organizers</span>
                        <div class="relative z-10 flex flex-wrap items-end justify-center gap-1 max-w-[15rem] px-4 -mb-1.5">
                            {c.characters.map((p) => (
                                <a href={p.url} target="_blank" rel="noopener noreferrer" class="block tap-press" title={p.name} aria-label={`${p.name}'s Cloud Card`}>
                                    <img src={p.image} alt={p.name} width="73" height="128" loading="lazy" decoding="async" class="px-pixelated h-12 md:h-14 w-auto" />
                                </a>
                            ))}
                            {Array.from({ length: Math.max(0, c.count - c.characters.length) }).map(() => (
                                <img src="/px-human.png" alt="" width="21" height="41" title="Has a ticket, no Cloud Card yet" class="px-pixelated h-12 md:h-14 w-auto" />
                            ))}
                        </div>
                        <div class="w-0 min-w-full">
                            <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-full h-auto" />
                        </div>
                        <h3 class="px-font text-white px-shadow-ink text-center leading-relaxed mt-2 text-px10 md:text-sm">{c.name}</h3>
                    </div>
                ))}
                </div>

                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a
                        href="/team"
                        class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
                    >
                        <img
                            src="/px-ticket.png"
                            alt=""
                            width="64"
                            height="64"
                            class="px-pixelated h-5 w-auto"
                        />
                        Put your company here
                    </a>
                </div>
            </div>
        </section>
    )
}
