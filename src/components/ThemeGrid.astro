---
const themes = [
    {
        title: "New Open Source & AI Tooling",
        description:
            "New open source and tools built for the most ambitious Ruby companies, including Ruby&AI.",
        icon: "oss.png",
        link: "/open-source",
        linktype: "none",
    },
    {
        title: "Ruby at Scale",
        description:
            "Stories from Ruby startups that grew into big organizations on solving scalability and performance challenges.",
        icon: "scaleups.png",
        link: "/scaling",
        linktype: "none",
    },
    {
        title: "CTO Panel",
        description:
            "Let's hear from CTOs of Ruby/Rails scaleups: how Ruby helped, and what we all can do to ensure success for years to come.",
        icon: "cto.png",
        link: "/cto-insights",
        linktype: "none",
    },
    {
        title: "Ruby Startup Demos",
        description:
            "Get inspired by learning about the hottest products built with Ruby and Rails.",
        icon: "startups.png",
        link: "https://cfp.sfruby.com",
        linktype: "none",
        linklabel: "Submit a demo",
    },
];
---

<section id="themes" class="py-20 bg-white">
    <section
        class="py-32 bg-gradient-to-b from-cloud-50 to-white relative overflow-hidden"
    >
        <!-- Subtle background pattern -->
        <div class="absolute inset-0 opacity-5">
            <div
                class="absolute top-10 left-10 w-32 h-32 bg-ruby-400 rounded-full filter blur-xl"
            >
            </div>
            <div
                class="absolute bottom-20 right-20 w-24 h-24 bg-sky-400 rounded-full filter blur-xl"
            >
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-20">
                <p
                    class="mb-12 text-2xl md:text-3xl font-light text-dark-700 max-w-4xl mx-auto leading-relaxed animate-fade-in"
                >
                    SF Ruby is excited to invite you to our premier event: the
                    <span
                        class="bg-gradient-to-r from-ruby-500 to-pink-500 bg-clip-text text-transparent font-semibold"
                    >
                        San Francisco Ruby Conference
                    </span>
                </p>
                <div class="space-y-8 mb-20">
                    <p
                        class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                    >
                        We're gathering <span
                            class="font-semibold text-dark-800"
                            >~600 Rubyists</span
                        > in San Francisco—the birthplace of so many legendary Ruby
                        startups, and the city where new ones are being built today.
                        There's no better place to celebrate how far Ruby has come
                        and how much stronger the ecosystem is today, thanks to years
                        of community-driven progress.
                    </p>
                    <p
                        class="text-lg md:text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light tracking-wide"
                    >
                        Join us to share stories, swap ideas, and meet fellow
                        builders who know that Ruby and Rails have never been
                        more powerful for launching and growing something new.
                        <span
                            class="inline-flex items-center font-medium text-ruby-600"
                        >
                            Let's keep building the future—together
                            <span class="ml-1 text-red-500">❤️</span>
                        </span>
                    </p>
                </div>
                <div class="inline-block">
                    <h2
                        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold bg-gradient-to-r from-dark-900 via-dark-700 to-dark-900 bg-clip-text text-transparent mb-4 tracking-tight"
                    >
                        Key Topics
                    </h2>
                    <div
                        class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
                    >
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    themes.map((theme, index) => (
                        <div
                            class="group bg-white rounded-lg _shadow-md transition-all duration-300 overflow-hidden relative _border border-dark-100 sm:flex sm:flex-col sm:items-end"
                            style={`animation-delay: ${index * 100}ms`}
                        >
                            <div class="absolute inset-0 bg-gradient-to-br from-ruby-500/0 via-ruby-500/0 to-ruby-500/0 group-hover:from-ruby-500/5 group-hover:via-ruby-500/10 group-hover:to-ruby-500/20 transition-all duration-300" />

                            <div class="p-6 h-full flex flex-col group-even:text-right md:!text-left">
                                <div class="w-28 h-28 flex items-center justify-center mb-4 group-even:self-end md:!self-start">
                                    <img
                                        src={theme.icon}
                                        alt="Logo"
                                        class="object-contain w-full h-full"
                                        loading="lazy"
                                    />
                                </div>

                                <h3 class="text-xl font-bold text-dark-900 mb-2">
                                    {theme.title}
                                </h3>
                                <p class="text-dark-600 mb-4 flex-grow">
                                    {theme.description}
                                </p>
                                {theme.linktype == "button" ? (
                                    <div class="text-center">
                                        <a
                                            href="https://cfp.sfruby.com"
                                            class="inline-flex items-center justify-center px-6 py-3 bg-ruby-500 text-cloud-50 rounded-md font-medium shadow-md transition-all duration-300 transform hover:scale-105"
                                        >
                                            {theme.linklabel}
                                        </a>
                                    </div>
                                ) : (
                                    <div />
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <style>
        @keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fade-in 1s ease-out;
        }

        /* Staggered animation for theme cards */
        .grid > div {
            opacity: 0;
            transform: translateY(30px);
            animation: fade-in 0.8s ease-out forwards;
        }
    </style>
</section>
