---
/**
 * StartupCard Component
 *
 * A clean, focused card for displaying startup information.
 * The entire card is clickable and opens a modal with full details.
 *
 * Design principles:
 * - Clean and minimal - avoid visual clutter
 * - Key info at a glance: logo, name, speaker, funding
 * - Subtle indicators (demo available, hiring)
 * - News/details saved for the modal
 */

import { getSpeaker } from "../data/speakers";
import { getTalk } from "../data/talks";

interface Startup {
    id: string;
    name: string;
    logo?: string;
    url?: string;
    description?: string;
    speakerId?: string;
    demoTime?: string;
    isYC?: boolean;
    founded?: number | null;
    funding?: string | null;
    valuation?: string | null;
    news?: string | null;
    newsUrl?: string | null;
    fundingUrl?: string | null;
    valuationUrl?: string | null;
    youtubeId?: string | null;
}

interface Props {
    startup: Startup;
    compact?: boolean;
    hasJobs?: boolean;
}

const { startup, compact = false, hasJobs = false } = Astro.props;

// Get speaker info if available
const speaker = startup.speakerId ? getSpeaker(startup.speakerId) : null;

// Check for demo video - first from startup data, then from talks
let youtubeId = startup.youtubeId;
if (!youtubeId) {
    const demoTalk = getTalk(`${startup.id}-demo`);
    if (demoTalk?.youtubeId) {
        youtubeId = demoTalk.youtubeId;
    }
}
---

<div
    class="startup-card group relative bg-white border-2 border-ink shadow-md overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
    data-startup-id={startup.id}
>
    <!-- Header: Badges row -->
    <div class="flex items-center justify-between px-4 pt-3 pb-2">
        <div class="flex gap-1.5">
            {
                startup.valuation && (
                    <span class="px-2 py-0.5 bg-amber-400 text-amber-900 text-xs font-bold rounded-md">
                        {startup.valuation}
                    </span>
                )
            }
            {
                hasJobs && (
                    <span class="px-2 py-0.5 bg-emerald-700 text-white text-xs font-bold rounded-md">
                        Hiring
                    </span>
                )
            }
            {
                startup.isYC && (
                    <span class="px-2 py-0.5 bg-orange-700 text-white text-xs font-bold rounded-md">
                        YC
                    </span>
                )
            }
        </div>
        {
            youtubeId && (
                <div class="flex items-center gap-1 px-2 py-0.5 bg-gray-100 rounded-full">
                    <svg
                        class="w-3 h-3 text-gray-600"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M8 5v14l11-7z" />
                    </svg>
                    <span class="text-xs text-gray-600">Demo</span>
                </div>
            )
        }
    </div>

    <!-- Logo centered -->
    <div class="px-4 py-3">
        {
            startup.logo && (
                <div class="flex items-center justify-center h-28 group-hover:scale-105 transition-transform">
                    <img
                        src={startup.logo}
                        alt={startup.name}
                        class="max-w-full max-h-full object-contain"
                        width="200"
                        height="112"
                        loading="lazy"
                    />
                </div>
            )
        }
    </div>

    <!-- Content section -->
    <div class="px-4 pb-4 pt-2">

        <!-- Short pitch -->
        {
            startup.description && (
                <p class="text-sm text-gray-600 line-clamp-8 mb-3">
                    {startup.description}
                </p>
            )
        }

        <!-- Key Facts Row -->
        {
            (startup.founded || startup.funding) && (
                <div class="flex items-center gap-3 text-sm">
                    {startup.founded && (
                        <span class="text-gray-500">
                            Est.{" "}
                            <span class="font-medium text-gray-700">
                                {startup.founded}
                            </span>
                        </span>
                    )}
                    {startup.funding && (
                        <span class="text-gray-500">
                            <span class="font-medium text-emerald-700">
                                {startup.funding}
                            </span>{" "}
                            raised
                        </span>
                    )}
                </div>
            )
        }
    </div>
</div>
