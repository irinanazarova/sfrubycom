---
import { getSpeaker } from "../data/speakers";
import { getTalk } from "../data/talks";

interface Startup {
    id: string;
    name: string;
    logo?: string;
    url?: string;
    description?: string;
    speakerId?: string;
    demoTime?: string;
    isYC?: boolean;
    founded?: number | null;
    funding?: string | null;
    valuation?: string | null;
    news?: string | null;
    newsUrl?: string | null;
    fundingUrl?: string | null;
    valuationUrl?: string | null;
    youtubeId?: string | null;
}

interface Props {
    startup: Startup;
    compact?: boolean;
    hasJobs?: boolean;
}

const { startup, compact = false, hasJobs = false } = Astro.props;

// Get speaker info if available
const speaker = startup.speakerId ? getSpeaker(startup.speakerId) : null;

// Check for demo video - first from startup data, then from talks
let youtubeId = startup.youtubeId;
if (!youtubeId) {
    const demoTalk = getTalk(`${startup.id}-demo`);
    if (demoTalk?.youtubeId) {
        youtubeId = demoTalk.youtubeId;
    }
}
---

<div
    class="startup-card group relative bg-white rounded-2xl border border-gray-100 overflow-hidden cursor-pointer transition-all duration-300 hover:shadow-2xl hover:shadow-ruby-500/10 hover:border-ruby-200 hover:-translate-y-1"
    data-startup-id={startup.id}
>
    <!-- Header: Logo (consistent for all cards) -->
    <div
        class="relative bg-gradient-to-br from-slate-50 to-slate-100 p-6 pb-10"
    >
        <!-- Badges - top left -->
        <div class="absolute top-3 left-3 flex gap-1.5 z-10">
            {
                startup.isYC && (
                    <span class="px-2 py-0.5 bg-orange-500 text-white text-xs font-bold rounded-md shadow-sm">
                        YC
                    </span>
                )
            }
            {
                startup.valuation && (
                    <span class="px-2 py-0.5 bg-amber-400 text-amber-900 text-xs font-bold rounded-md shadow-sm">
                        {startup.valuation}
                    </span>
                )
            }
            {
                hasJobs && (
                    <span class="px-2 py-0.5 bg-emerald-500 text-white text-xs font-bold rounded-md shadow-sm">
                        Hiring
                    </span>
                )
            }
        </div>

        <!-- Logo - full width, natural height -->
        {
            startup.logo && (
                <div class="flex items-center justify-center h-12 group-hover:scale-105 transition-transform">
                    <img
                        src={startup.logo}
                        alt={startup.name}
                        class="max-w-full max-h-full object-contain"
                        loading="lazy"
                    />
                </div>
            )
        }

        <!-- Speaker photo - positioned at bottom, overlapping into content -->
        {
            speaker?.image && (
                <div class="absolute -bottom-10 left-5">
                    <img
                        src={speaker.image}
                        alt={speaker.name}
                        class="w-20 h-20 rounded-full object-cover ring-4 ring-white shadow-lg"
                        loading="lazy"
                    />
                </div>
            )
        }
    </div>

    <!-- Content section -->
    <div class={`p-5 ${speaker?.image ? "pt-12" : "pt-5"}`}>
        <!-- Name and speaker info -->
        <div class="mb-4">
            <h3
                class="font-bold text-lg text-gray-900 group-hover:text-ruby-600 transition-colors"
            >
                {startup.name}
            </h3>
            {
                speaker && (
                    <p class="text-sm text-gray-500 mt-0.5">{speaker.name}</p>
                )
            }
        </div>

        <!-- Key Facts Row -->
        <div class="flex items-center gap-6 mb-4">
            {
                startup.founded && (
                    <div>
                        <div class="text-sm font-bold text-gray-900">
                            {startup.founded}
                        </div>
                        <div class="text-xs text-gray-400">Founded</div>
                    </div>
                )
            }
            {
                startup.funding && (
                    <div>
                        <div class="text-sm font-bold text-emerald-600">
                            {startup.funding}
                        </div>
                        <div class="text-xs text-gray-400">Raised</div>
                    </div>
                )
            }
        </div>

        <!-- Watch Demo indicator -->
        {
            youtubeId && (
                <div class="flex items-center gap-2 mb-4 p-3 bg-ruby-50 rounded-xl">
                    <div class="w-8 h-8 bg-ruby-500 rounded-full flex items-center justify-center flex-shrink-0">
                        <svg
                            class="w-4 h-4 text-white ml-0.5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M8 5v14l11-7z" />
                        </svg>
                    </div>
                    <span class="text-sm font-medium text-ruby-700">
                        Watch Demo
                    </span>
                </div>
            )
        }

        <!-- News/highlight -->
        {
            startup.news && (
                <div class="flex items-start gap-2 p-3 bg-sky-50 rounded-xl">
                    <svg
                        class="w-4 h-4 text-sky-500 mt-0.5 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    <p class="text-xs text-sky-800 leading-relaxed">
                        {startup.news}
                    </p>
                </div>
            )
        }

        <!-- View details link -->
        <div class="mt-4 flex items-center justify-end">
            <span
                class="inline-flex items-center text-sm text-ruby-500 font-medium group-hover:text-ruby-600"
            >
                Learn more
                <svg
                    class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
            </span>
        </div>
    </div>
</div>
