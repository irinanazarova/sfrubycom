---
// One speaker's full card: sprite on the dithered sky, name, affiliations,
// role, the talk, the abstract, the bio, socials. Rendered by /speakers (one
// per lineup card) and by the homepage schedule (inside the dialog a talk slot opens), so
// the two can never disagree about a speaker.
//
// `profile` is a buildProfiles() entry (src/utils/speakerProfiles.js). Prose
// fields are split into paragraphs here. The data-* hooks stay on the same
// nodes /speakers' client refresh has always targeted.
//
// `title` overrides the profile's title where a caller has a better one.
//
// Layouts, all of which stack below `md`:
// - "stack": stage above the text (the default).
// - "side": the speaker's animated share card across the top, then the text
//   under it. The dialog a schedule slot opens. The card already carries the
//   talk, the time and the abstract, so it is the poster and the text below it
//   is the readable copy: at phone width the card's own type is far too small
//   to read. A speaker with no generated card falls back to the sprite on sky.
// - "wrap": the stage is a fixed tile floated top-left and the text flows
//   beside it, then under it, so a long abstract widens the card rather than
//   lengthening a sky stripe. The parent must be a plain block (no flex or
//   grid: those establish a formatting context the float cannot reach into).
//   The lineup page.
import SocialLink from "./SocialLink.astro";
import { toParagraphs } from "../utils/abstractText.js";
import { speakerCardHref } from "../utils/speakerCard.js";

interface Props {
    profile: any;
    title?: string;
    layout?: "stack" | "side" | "wrap";
}

const { profile: s, title: titleOverride, layout = "stack" } = Astro.props;
const side = layout === "side";
const wrap = layout === "wrap";
const title = titleOverride || s.title;
const abstract = toParagraphs(s.abstract);
const bio = toParagraphs(s.bio);
// The card a schedule slot opens never said when the talk was: the row you
// tapped had the time and the card replaced it.
const when = s.slot && `${s.slot.weekday}, ${s.slot.date} · ${s.slot.time}`;
const cardHref = speakerCardHref(s.key);
// 20 dialogs sit in the homepage's DOM at once, so 20 cards would be 8MB of
// GIF on first paint. The src is withheld here and Schedule.astro fills it in
// when the dialog opens, which is also the only moment the animation matters.
const poster = side && cardHref;
---

{/* The share card paints its own Keynote plate, so the dialog would show two. */}
{
    s.keynote && !poster && (
        <span class="absolute top-3 right-3 z-10 px-plate px-plate--gold px-font text-px8 px-2 py-1">
            Keynote
        </span>
    )
}
{
    poster && (
        <div class="px-dither-sky border-b-4 border-ink aspect-[16/9] w-full">
            <img
                data-card-gif
                data-src={cardHref}
                width="1280"
                height="720"
                alt={`${s.name}, animated talk card`}
                class="px-pixelated block w-full h-full"
            />
        </div>
    )
}

{/* Portrait stage, for a speaker with no generated card. The sprite is a
    transparent PNG, so it needs the dithered sky behind it to read at this
    size, and a fixed height so every card in a row starts its text on the
    same line. */}
{!poster && (
<div
    class:list={[
        "px-dither-sky h-56 flex items-end justify-center border-b-4 border-ink",
        side && "md:h-auto md:min-h-[20rem] md:row-span-2 md:items-center md:border-b-0 md:border-r-4",
        wrap && "md:float-left md:w-52 md:h-52 md:mr-6 md:mb-2 md:border-r-4",
        !side && !wrap && "md:h-64",
    ]}
>
    {
        s.pixel ? (
            <div class:list={["flex flex-col items-center pb-3", side && "md:pb-0"]}>
                <img
                    src={s.pixel}
                    alt={`${s.name}, pixel character`}
                    width="256"
                    height="256"
                    loading="lazy"
                    class:list={["px-pixelated h-auto", wrap ? "w-36 md:w-32" : "w-36 md:w-40"]}
                />
                <img
                    src="/px-island.png"
                    alt=""
                    width="598"
                    height="104"
                    loading="lazy"
                    class:list={["px-pixelated h-auto -mt-3", wrap ? "w-44 md:w-40" : "w-44 md:w-48"]}
                />
            </div>
        ) : (
            <div class="flex-1 flex items-center justify-center" aria-hidden="true">
                <span class="px-font px-shadow-ink text-4xl text-white">?</span>
            </div>
        )
    }
</div>
)}

<div class:list={["p-6", wrap ? "md:pt-7" : "flex flex-col flex-1"]}>
    {/* Grotesk, not the pixel font: Press Start 2P has no accented capitals
        and mangles names like Gutiérrez. */}
    <h3 class="font-display font-bold text-xl text-gray-900 leading-snug">
        {s.name}
    </h3>
    {/* markup kept tight on purpose: line breaks inside the anchor render as
        spaces and detach the commas */}
    <p class="font-display font-medium text-ruby-600 mt-2">
        {s.orgs.map((org, i) => (
            <>{i > 0 && ", "}{org.url ? <a href={org.url} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-2">{org.name}</a> : org.name}</>
        ))}
    </p>
    {s.role && <p class="text-sm text-gray-500 mt-1">{s.role}</p>}

    {
        when && (
            <p class="px-font text-px8 text-ruby-600 mt-5">{when}</p>
        )
    }

    {/* always in the DOM (hidden when empty) so the client refresh has a node
        to fill when a title or abstract lands */}
    <p
        data-talk-title
        hidden={!title}
        class:list={[
            "font-display font-semibold text-base text-gray-900 leading-snug",
            when ? "mt-2" : "mt-5",
        ]}
    >
        {title && `“${title}”`}
    </p>
    <div
        data-talk-abstract
        hidden={abstract.length === 0}
        class="text-sm text-gray-700 leading-relaxed"
    >
        {abstract.map((parts) => (
            <p class="mt-3">
                {parts.map((part) =>
                    part.type === "link" ? (
                        <a href={part.href} target="_blank" rel="noopener noreferrer" class="font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words">{part.label}</a>
                    ) : (
                        part.value
                    ),
                )}
            </p>
        ))}
    </div>

    <div
        data-speaker-bio
        hidden={bio.length === 0}
        class="text-sm text-gray-600 leading-relaxed mt-5 pt-5 border-t-2 border-sky-100"
    >
        {bio.map((parts) => (
            <p class="[&+&]:mt-3">
                {parts.map((part) =>
                    part.type === "link" ? (
                        <a href={part.href} target="_blank" rel="noopener noreferrer" class="font-medium text-ruby-600 hover:text-ruby-500 underline underline-offset-2 break-words">{part.label}</a>
                    ) : (
                        part.value
                    ),
                )}
            </p>
        ))}
    </div>

    {
        (s.socials.length > 0 || cardHref) && (
            <div class="flex flex-wrap items-center gap-3 pt-6 mt-auto">
                {s.socials.map((link) => (
                    <SocialLink platform={link.platform} href={link.href}>
                        <span class:list={[link.icon && "sr-only"]}>{link.label}</span>
                    </SocialLink>
                ))}
                {/* The animated card, for the speaker to post when they
                    announce the talk. A plain download: the file is built and
                    committed, so there is nothing to generate on click. */}
                {cardHref && (
                    <a
                        href={cardHref}
                        download={`sf-ruby-2026-${s.key}.gif`}
                        class="px-btn px-font text-px10 px-6 py-3.5 bg-sky-500 text-white hover:bg-sky-400"
                    >
                        Download GIF
                    </a>
                )}
            </div>
        )
    }
</div>
