---
import { Image } from "astro:assets";
---

<section
    class="relative bg-gradient-to-br from-sky-400 via-sky-600 to-indigo-700 text-white overflow-hidden h-screen flex items-center"
>
    <!-- Enhanced animated background pattern -->
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -inset-[10px] z-0 opacity-20" aria-hidden="true">
            <div class="ruby-grid"></div>
        </div>
        <!-- Floating particles -->
        <div class="absolute inset-0 z-0">
            <div class="floating-particles opacity-30"></div>
        </div>
        <!-- Subtle gradient overlay -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent z-5"
        >
        </div>
    </div>

    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 h-full flex items-center"
    >
        <div
            class="hero-content flex flex-col items-center text-center w-full py-8"
        >
            <!-- logo -->
            <div class="w-full relative flex items-center justify-center mb-6">
                <img
                    src="/hero.png"
                    alt="San Francisco Ruby Conference 2025"
                    class="hero-logo object-contain w-full max-w-xl md:max-w-2xl lg:max-w-3xl h-auto max-h-[40vh]"
                    loading="lazy"
                />
            </div>

            <!-- <h1 class="font-display font-regular text-4xl md:text-6xl lg:text-7xl max-w-4xl leading-tight mb-6 font-stretch-extra-expanded split-text text-cloud-100">
        San Francisco Ruby Conference 2025
      </h1>-->

            <p
                class="text-xl md:text-2xl font-medium split-text text-cloud-100 mb-4 max-w-2xl"
            >
                Building the Future with Ruby
            </p>

            <p
                class="text-lg md:text-xl split-text text-cloud-100/90 mb-8 font-light tracking-wide"
            >
                November 19-20, 2025 • Fort Mason, San Francisco
            </p>

            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
                <a
                    href="/speakers"
                    class="group inline-flex items-center justify-center px-10 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold shadow-xl transition-all duration-500 transform hover:shadow-2xl hover:shadow-white/20 hover:scale-105 hover:bg-white/20 hover:border-white/50"
                >
                    <span
                        class="mr-2 group-hover:mr-3 transition-all duration-300"
                        >Full program</span
                    >
                    <svg
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>

                <a
                    href="https://lu.ma/sfrubyconf2025"
                    class="group inline-flex items-center justify-center px-10 py-4 bg-gradient-to-r from-ruby-500 to-pink-500 border-2 border-ruby-400 text-white rounded-xl font-semibold shadow-xl transition-all duration-500 transform hover:shadow-2xl hover:shadow-ruby-500/30 hover:scale-105 hover:from-ruby-400 hover:to-pink-400"
                >
                    <span
                        class="mr-2 group-hover:mr-3 transition-all duration-300"
                        >Get a ticket</span
                    >
                    <svg
                        class="w-5 h-5 group-hover:rotate-12 transition-transform duration-300"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- Cloud-shaped transition -->
    <div class="absolute bottom-0 left-0 right-0 h-32 overflow-hidden">
        <svg
            preserveAspectRatio="none"
            viewBox="0 0 1200 200"
            xmlns="http://www.w3.org/2000/svg"
            class="absolute bottom-0 w-full h-full"
        >
            <defs>
                <linearGradient
                    id="cloudGradient"
                    x1="0%"
                    y1="0%"
                    x2="0%"
                    y2="100%"
                >
                    <stop
                        offset="0%"
                        style="stop-color:#1E3A8A;stop-opacity:0.6"></stop>
                    <stop
                        offset="30%"
                        style="stop-color:#3B82F6;stop-opacity:0.4"></stop>
                    <stop
                        offset="70%"
                        style="stop-color:#DBEAFE;stop-opacity:0.6"></stop>
                    <stop
                        offset="100%"
                        style="stop-color:#FFFFFF;stop-opacity:1"></stop>
                </linearGradient>
            </defs>
            <!-- Bottom cloud layer - deepest -->
            <path
                d="M0,200 L0,100 C40,80 90,70 140,75 C180,65 220,68 260,75 C300,65 340,68 380,72 C420,62 460,65 500,70 C540,60 580,63 620,68 C660,58 700,61 740,66 C780,56 820,59 860,64 C900,54 940,57 980,62 C1020,52 1060,55 1100,60 C1140,50 1180,53 1200,58 L1200,200 Z"
                fill="#1E40AF"
                opacity="0.3"></path>
            <!-- Middle cloud layer -->
            <path
                d="M0,200 L0,130 C70,115 110,105 160,110 C210,100 260,103 310,110 C360,100 410,103 460,107 C510,97 560,100 610,105 C660,95 710,98 760,103 C810,93 860,96 910,101 C960,91 1010,94 1060,99 C1110,89 1160,92 1200,97 L1200,200 Z"
                fill="url(#cloudGradient)"
                opacity="0.8"></path>
            <!-- Top fluffy cloud layer -->
            <path
                d="M0,200 L0,150 C50,140 80,135 130,138 C170,128 210,131 250,138 C290,128 330,131 370,135 C410,125 450,128 490,133 C530,123 570,126 610,131 C650,121 690,124 730,129 C770,119 810,122 850,127 C890,117 930,120 970,125 C1010,115 1050,118 1090,123 C1130,113 1170,116 1200,121 L1200,200 Z"
                fill="white"
                opacity="0.9"></path>
            <!-- Final smooth cloud layer -->
            <path
                d="M0,200 L0,170 C100,160 150,155 250,160 C350,150 450,153 550,160 C650,150 750,153 850,160 C950,150 1050,153 1150,160 C1175,157 1187,158 1200,160 L1200,200 Z"
                fill="white"></path>
        </svg>

        <!-- Floating cloud elements -->
        <div
            class="absolute top-8 left-1/4 w-16 h-8 bg-white/20 rounded-full animate-float-slow"
        >
        </div>
        <div
            class="absolute top-12 right-1/3 w-12 h-6 bg-white/15 rounded-full animate-float-slower"
        >
        </div>
        <div
            class="absolute top-6 right-1/4 w-8 h-4 bg-white/10 rounded-full animate-float"
        >
        </div>
    </div>
</section>

<style>
    /* Ensure proper viewport fit */
    section {
        min-height: 100vh;
        min-height: 100dvh; /* Dynamic viewport height for mobile */
    }

    /* Enhanced floating particles */
    .floating-particles {
        position: absolute;
        width: 100%;
        height: 100%;
    }

    .floating-particles::before,
    .floating-particles::after {
        content: "";
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .floating-particles::before {
        top: 20%;
        left: 20%;
        animation-delay: 0s;
    }

    .floating-particles::after {
        top: 60%;
        right: 30%;
        animation-delay: -3s;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0px) translateX(0px);
            opacity: 0.6;
        }
        33% {
            transform: translateY(-20px) translateX(10px);
            opacity: 1;
        }
        66% {
            transform: translateY(5px) translateX(-5px);
            opacity: 0.8;
        }
    }

    /* Enhanced ruby grid */
    .ruby-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        grid-template-rows: repeat(12, 1fr);
        gap: 8px;
        width: 100%;
        height: 100%;
    }

    .ruby-grid::before {
        content: "";
        grid-column: 3 / 5;
        grid-row: 2 / 4;
        background: rgba(255, 182, 193, 0.3);
        border-radius: 4px;
        animation: pulse 4s ease-in-out infinite;
    }

    .ruby-grid::after {
        content: "";
        grid-column: 8 / 10;
        grid-row: 6 / 8;
        background: rgba(255, 105, 180, 0.3);
        border-radius: 4px;
        animation: pulse 4s ease-in-out infinite;
        animation-delay: -2s;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }

    /* Enhanced button glow effects */
    .group:hover {
        filter: brightness(1.1);
    }

    /* Responsive improvements */
    @media (max-height: 800px) {
        .hero-logo {
            max-height: 35vh;
        }
    }

    @media (max-height: 600px) {
        .hero-content {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
        .hero-logo {
            max-height: 30vh;
        }
        p {
            font-size: 1rem;
        }
    }

    /* Cloud animation */
    @keyframes float {
        0%,
        100% {
            transform: translateY(0px) translateX(0px);
        }
        33% {
            transform: translateY(-8px) translateX(4px);
        }
        66% {
            transform: translateY(2px) translateX(-2px);
        }
    }

    @keyframes float-slow {
        0%,
        100% {
            transform: translateY(0px) translateX(0px);
        }
        50% {
            transform: translateY(-6px) translateX(6px);
        }
    }

    @keyframes float-slower {
        0%,
        100% {
            transform: translateY(0px) translateX(0px);
        }
        50% {
            transform: translateY(-4px) translateX(-4px);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    .animate-float-slow {
        animation: float-slow 8s ease-in-out infinite;
    }

    .animate-float-slower {
        animation: float-slower 10s ease-in-out infinite;
    }

    /* Smooth scroll behavior */
    html {
        scroll-behavior: smooth;
    }
</style>

<script>
    import anime from "animejs";

    // Initialize animations
    function initializeAnimations() {
        // Create additional floating particles dynamically
        const particleContainer = document.querySelector(".floating-particles");
        if (particleContainer) {
            for (let i = 0; i < 8; i++) {
                const particle = document.createElement("div");
                particle.style.cssText = `
                    position: absolute;
                    width: ${Math.random() * 3 + 2}px;
                    height: ${Math.random() * 3 + 2}px;
                    background: rgba(255, 255, 255, ${Math.random() * 0.5 + 0.3});
                    border-radius: 50%;
                    top: ${Math.random() * 100}%;
                    left: ${Math.random() * 100}%;
                    animation: float ${Math.random() * 4 + 4}s ease-in-out infinite;
                    animation-delay: ${Math.random() * -6}s;
                `;
                particleContainer.appendChild(particle);
            }
        }

        // Split text animation
        document.querySelectorAll(".split-text").forEach((element) => {
            const text = element.textContent || "";
            element.textContent = "";

            // Split text into words
            const words = text.split(" ");

            words.forEach((word, wordIndex) => {
                // Create a container for the word
                const wordContainer = document.createElement("span");
                wordContainer.className = "word";
                wordContainer.style.display = "inline-block";

                // Split word into characters
                word.split("").forEach((char) => {
                    const charSpan = document.createElement("span");
                    charSpan.className = "char";
                    charSpan.textContent = char;
                    charSpan.style.opacity = "0";
                    charSpan.style.transform = "translateY(30px)";
                    charSpan.style.display = "inline-block";
                    wordContainer.appendChild(charSpan);
                });

                element.appendChild(wordContainer);

                // Add space after word (except last word)
                if (wordIndex < words.length - 1) {
                    const spaceSpan = document.createElement("span");
                    spaceSpan.className = "space";
                    spaceSpan.innerHTML = "&nbsp;";
                    spaceSpan.style.display = "inline-block";
                    element.appendChild(spaceSpan);
                }
            });
        });

        // Enhanced text animation timeline
        anime
            .timeline({
                easing: "easeOutExpo",
            })
            .add({
                targets: "img[alt*='San Francisco Ruby Conference']",
                scale: [0.8, 1],
                opacity: [0, 1],
                duration: 1200,
                easing: "easeOutElastic(1, .8)",
            })
            .add(
                {
                    targets: ".split-text .char",
                    opacity: [0, 1],
                    translateY: [30, 0],
                    duration: 1000,
                    delay: anime.stagger(30, { start: 200 }),
                    easing: "easeOutElastic(1, .6)",
                },
                "-=800",
            )
            .add(
                {
                    targets: "a[href*='speakers'], a[href*='lu.ma']",
                    scale: [0.8, 1],
                    opacity: [0, 1],
                    translateY: [20, 0],
                    duration: 800,
                    delay: anime.stagger(100),
                    easing: "easeOutBack(1.7)",
                },
                "-=400",
            );
    }

    // Initialize when DOM is loaded
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeAnimations);
    } else {
        initializeAnimations();
    }
</script>
