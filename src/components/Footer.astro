---
const currentYear = new Date().getFullYear();

const footerLinks = [
    {
        title: "Event",
        links: [
            { name: "About", href: "/about" },
            { name: "Schedule", href: "/schedule" },
            { name: "Speakers", href: "/speakers" },
            { name: "Jobs", href: "/jobs" },
            { name: "Scholarship", href: "/scholarship" },
            {
                name: "News",
                href: "https://sfruby.substack.com/",
                target: "_blank",
            },

            {
                name: "SF Ruby Slack",
                href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-327ylyio2-N10OGtkl~QSt0jnIxDXmZg",
                target: "_blank",
            },
        ],
    },
    {
        title: "Get Involved",
        links: [
            {
                name: "Get a ticket",
                href: "https://lu.ma/sfrubyconf2025",
                target: "_blank",
            },
            { name: "Sponsor", href: "/sponsors" },
            { name: "Contact", href: "/contact" },
            { name: "Code of conduct", href: "/cc" },
        ],
    },
];

const socialLinks: Array<{ name: string; href: string; icon: string }> = [
    // { name: 'Twitter', href: 'https://twitter.com/sfrubconf', icon: 'twitter' },
    // { name: 'GitHub', href: 'https://github.com/sfrubconf', icon: 'github' },
    // { name: 'LinkedIn', href: 'https://linkedin.com/company/sfrubconf', icon: 'linkedin' }
];
---

<footer class="bg-sky-800 text-cloud-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Logo and description -->
            <div class="col-span-1">
                <div class="flex items-center space-x-2 mb-4">
                    <!-- Ruby logo -->
                    <div class="h-20">
                        <img
                            src="/sfruby_logo_h.png"
                            alt="SF Ruby Conference Logo"
                            class="object-contain w-full h-full"
                            loading="lazy"
                        />
                    </div>
                </div>
                <p class="mt-2 text-sky-300 text-sm">
                    November 19-20, 2025
                    <br />Fort Mason Center
                    <br />2 Marina Blvd
                    <br />San Francisco, CA 94123
                </p>
            </div>

            <!-- Links -->
            {
                footerLinks.map((section) => (
                    <div>
                        <h3 class="font-medium text-cloud-100 mb-4">
                            {section.title}
                        </h3>
                        <ul class="space-y-2">
                            {section.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target={link.target && link.target}
                                        class="text-sky-300 hover:text-ruby-400 transition-colors duration-200 text-sm"
                                    >
                                        {link.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <!-- Social links and copyright -->
        <div
            class="mt-12 pt-8 border-t border-sky-800 flex flex-col md:flex-row justify-between items-center"
        >
            <div class="flex space-x-6 mb-4 md:mb-0">
                {
                    socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sky-300 hover:text-ruby-400 transition-colors duration-200"
                            aria-label={link.name}
                        >
                            <span class="sr-only">{link.name}</span>
                            <div class="h-6 w-6 flex items-center justify-center rounded-full border border-sky-700">
                                {link.icon.charAt(0).toUpperCase()}
                            </div>
                        </a>
                    ))
                }
            </div>

            <div class="text-sky-400 text-sm">
                &copy; {currentYear} San Francisco Ruby Conference. Organized by
                Evil Martians Inc. All rights reserved.
            </div>
        </div>
    </div>
</footer>
