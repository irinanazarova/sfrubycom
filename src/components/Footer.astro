---
const currentYear = new Date().getFullYear();

const footerLinks = [
    {
        title: "Discover",
        links: [
            { name: "Startups", href: "/startups" },
            { name: "Videos", href: "/videos" },
            { name: "Jobs", href: "/jobs" },
            { name: "Photos", href: "/photos" },
        ],
    },
    {
        title: "Community",
        links: [
            {
                name: "Join Slack",
                href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
                external: true,
            },
            { name: "Meetups", href: "https://lu.ma/sfruby", external: true },
            {
                name: "Submit a Talk",
                href: "https://forms.gle/EZLqENWd5VjiLduq8",
                external: true,
            },
            { name: "Host a Meetup", href: "/host" },
            {
                name: "Newsletter",
                href: "https://sfruby.substack.com",
                external: true,
            },
        ],
    },
    {
        title: "About",
        links: [
            { name: "About SF Ruby", href: "/about" },
            { name: "Scholarship Program", href: "/scholarship" },
            { name: "Sponsor 2026", href: "/sponsor-2026" },
            { name: "Code of Conduct", href: "/cc" },
            { name: "Contact", href: "/contact" },
        ],
    },
];

const socialLinks = [
    {
        name: "X (Twitter)",
        href: "https://x.com/sfrubyconf",
        icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
    },
    {
        name: "Bluesky",
        href: "https://bsky.app/profile/sfruby.com",
        icon: `<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>`,
    },
    {
        name: "LinkedIn",
        href: "https://www.linkedin.com/company/sfrubyconf/",
        icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    },
    {
        name: "Substack",
        href: "https://sfruby.substack.com/",
        icon: `<path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>`,
    },
];
---

<footer class="bg-ink text-gray-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
            <div class="lg:col-span-2">
                <a href="/" class="mb-6 flex items-center gap-3">
                    <img
                        src="/logo8bit-mascot.png"
                        alt=""
                        width="392"
                        height="448"
                        class="px-pixelated h-14 w-auto"
                        loading="lazy"
                    />
                    <span class="px-font text-base text-white">SF Ruby</span>
                </a>
                <p class="text-gray-400 mb-6 max-w-sm">
                    Let's build the new generation of Ruby success stories. Join
                    founders and engineers at monthly meetups, talks, and the
                    annual SF Ruby conference.
                </p>
                <div class="flex space-x-4">
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 text-gray-400 hover:bg-ruby-500 hover:text-white transition-all duration-300"
                                aria-label={link.name}
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <Fragment set:html={link.icon} />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>

            {
                footerLinks.map((section) => (
                    <div>
                        <h3 class="px-font text-px10 text-gold-500 mb-4">
                            {section.title}
                        </h3>
                        <ul class="space-y-3">
                            {section.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target={
                                            link.external ? "_blank" : undefined
                                        }
                                        rel={
                                            link.external
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                        class="text-gray-400 hover:text-ruby-400 transition-colors duration-200 inline-flex items-center gap-1"
                                    >
                                        {link.name}
                                        {link.external && (
                                            <svg
                                                class="w-3 h-3"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                />
                                            </svg>
                                        )}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-gray-400 text-sm">
                &copy; {currentYear} SF Ruby. Organized by <a
                    href="https://evilmartians.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-300 hover:text-ruby-400 underline decoration-gray-500">Evil Martians</a
                >.
            </p>
        </div>
    </div>
</footer>
