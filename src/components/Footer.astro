---
const currentYear = new Date().getFullYear();

const footerLinks = [
    {
        title: "Discover",
        links: [
            { name: "Startups", href: "/startups" },
            { name: "Talks", href: "/talks" },
            { name: "Jobs", href: "/jobs" },
            { name: "Photos", href: "/photos" },
        ],
    },
    {
        title: "Community",
        links: [
            {
                name: "Join Slack",
                href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
                external: true,
            },
            { name: "Meetups", href: "https://lu.ma/sfruby", external: true },
            {
                name: "Submit a Talk",
                href: "https://forms.gle/EZLqENWd5VjiLduq8",
                external: true,
            },
            {
                name: "Newsletter",
                href: "https://sfruby.substack.com",
                external: true,
            },
        ],
    },
    {
        title: "About",
        links: [
            { name: "About SF Ruby", href: "/about" },
            { name: "Sponsor 2026", href: "/sponsor-2026" },
            { name: "Code of Conduct", href: "/cc" },
            { name: "Contact", href: "/contact" },
        ],
    },
];

const socialLinks = [
    {
        name: "X (Twitter)",
        href: "https://x.com/sf_ruby",
        icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
    },
    {
        name: "GitHub",
        href: "https://github.com/sfruby",
        icon: `<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>`,
    },
];
---

<footer class="bg-gray-900 text-gray-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
            <div class="lg:col-span-2">
                <a href="/" class="inline-block mb-6">
                    <img
                        src="/sfruby_logo_h.png"
                        alt="SF Ruby"
                        class="h-16 w-auto"
                        loading="lazy"
                    />
                </a>
                <p class="text-gray-400 mb-6 max-w-sm">
                    Let's build the new generation of Ruby success stories. Join
                    founders and engineers at monthly meetups, talks, and the
                    annual SF Ruby conference.
                </p>
                <div class="flex space-x-4">
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 text-gray-400 hover:bg-ruby-500 hover:text-white transition-all duration-300"
                                aria-label={link.name}
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <Fragment set:html={link.icon} />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>

            {
                footerLinks.map((section) => (
                    <div>
                        <h3 class="font-semibold text-white mb-4">
                            {section.title}
                        </h3>
                        <ul class="space-y-3">
                            {section.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target={
                                            link.external ? "_blank" : undefined
                                        }
                                        rel={
                                            link.external
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                        class="text-gray-400 hover:text-ruby-400 transition-colors duration-200 inline-flex items-center gap-1"
                                    >
                                        {link.name}
                                        {link.external && (
                                            <svg
                                                class="w-3 h-3"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                />
                                            </svg>
                                        )}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-gray-500 text-sm">
                &copy; {currentYear} SF Ruby. Organized by <a
                    href="https://evilmartians.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-400 hover:text-ruby-400">Evil Martians</a
                >.
            </p>
        </div>
    </div>
</footer>
