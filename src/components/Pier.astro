---
// The Pier (clouds.sfruby.com): the pre-conference game, and the reason to buy
// a ticket in August rather than in October. It sits directly under the hero
// because it is the one thing here no other Ruby conference has, and because a
// ticket is what unlocks it.
//
// Everything shown is the real game: the map art is the same asset the game
// serves as its own OG image, the quests are the live quest list with its
// point values, and the three Cloud Cards are published cards of people who
// are actually coming. Refresh them by re-exporting from the game rather than
// inventing copy here — a quest list that disagrees with the game is worse
// than no quest list.
import { ticketLink, ticketEventClass, ticketTiers } from "../data/conference-2026.js";

// Sprites scattered over the map frame so it reads as populated. Positioned
// against the frame, not the image, so the mobile crop can move underneath
// them without stranding anyone in the bay.
const citizens = [
    {
        pixel: "/speaker_rosa_gutierrez_pixel_256.png",
        at: "bottom-[14%] left-[8%] w-14 md:w-16",
        delay: "0s",
    },
    {
        pixel: "/community_chris_fung_pixel_256.png",
        at: "bottom-[38%] left-[26%] w-12 md:w-14",
        delay: "-1.5s",
    },
    {
        pixel: "/speaker_peter_zhu_pixel_256.png",
        at: "bottom-[10%] right-[22%] w-14 md:w-16",
        delay: "-3s",
    },
    {
        pixel: "/community_amanda_kinney_pixel_256.png",
        at: "bottom-[44%] right-[9%] w-12 md:w-14",
        delay: "-4.5s",
    },
];

// The live quest list, with the game's own point values.
// Icons are the site's own item sprites, one per quest, so the list reads
// like a quest log rather than a checklist.
const quests = [
    { label: "Generate and publish your pixel card", points: 10, icon: "/px-ticket.png", w: 26, h: 12 },
    { label: "Fill out your profile", points: 10, icon: "/px-envelope.png", w: 24, h: 13 },
    { label: "Find yourself on the Pier", points: 1, icon: "/px-coin.png", w: 12, h: 12 },
    { label: "Talk to 5 people", points: 20, icon: "/px-heart.png", w: 14, h: 13 },
    { label: "Return a gem to its maintainer", points: 10, icon: "/px-ruby.png", w: 14, h: 12 },
];

// Published cards, one community member among the speakers: the Pier is the
// whole room, not the stage.
const cards = [
    {
        name: "Rosa Gutiérrez",
        role: "Speaker · 37signals",
        image: "/cloudcard_2026_rosa_gutierrez.webp",
        href: "https://clouds.sfruby.com/e/2026-bits/rosa-gutierrez",
    },
    {
        name: "Chris Fung",
        role: "Attendee · Gusto",
        image: "/cloudcard_2026_chris_fung.webp",
        href: "https://clouds.sfruby.com/e/2026-bits/chris-fung",
    },
    {
        name: "Peter Zhu",
        role: "Speaker · Shopify",
        image: "/cloudcard_2026_peter_zhu.webp",
        href: "https://clouds.sfruby.com/e/2026-bits/peter-zhu",
    },
];

const PIER_URL = "https://clouds.sfruby.com";
const SLACK_URL =
    "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg";
// Price quoted from the ladder rather than typed in, so it can never drift from
// the tier table further down the page. Pinned to the individual price: the
// company-sponsored tier is invoiced and has no deadline, so taking whichever
// tier happens to be live first would quote $650 on a CTA aimed at one person
// the moment Regular closes. If no individual tier is live, the button drops
// the price rather than the build.
const livePrice = ticketTiers.find(
    (t) => t.state === "live" && t.name !== "Company-sponsored",
)?.price;
---

<section
    id="pier"
    class="relative overflow-hidden py-20 md:py-24 px-sky-grad-day border-t-4 border-ink"
>
    {/* the same world as the hero: clouds at three depths, islands, and a
        few sparkles in the sky */}
    <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-16 left-[3%] w-40 md:w-60 animate-float pointer-events-none" aria-hidden="true" />
    <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-24 right-[5%] w-28 md:w-44 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
    <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute top-[38%] left-[1%] w-20 md:w-28 animate-float [animation-delay:-1.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
    <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-[52%] right-[1%] w-36 md:w-56 animate-float [animation-delay:-5s] pointer-events-none hidden lg:block" aria-hidden="true" />
    <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute top-[30%] right-[4%] w-32 h-auto animate-float [animation-delay:-2s] pointer-events-none hidden lg:block" aria-hidden="true" />
    <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated absolute bottom-16 left-[2%] w-44 h-auto animate-float [animation-delay:-4s] pointer-events-none hidden lg:block" aria-hidden="true" />
    {
        [
            ["top-12 left-[16%]", "0s"], ["top-40 left-[9%]", "-0.6s"], ["top-20 right-[18%]", "-1.1s"],
            ["top-[44%] right-[9%]", "-0.3s"], ["bottom-32 left-[12%]", "-1.4s"], ["bottom-24 right-[14%]", "-0.9s"],
        ].map(([at, delay]) => (
            <img src="/px-sparkle.png" alt="" width="7" height="7" class={`px-sparkle w-3 md:w-4 hidden md:block ${at}`} style={`--px-twinkle-delay: ${delay}`} aria-hidden="true" />
        ))
    }
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center relative">
            {/* balloons and hearts around the heading: the celebration the
                section is about, kept to the edges so the words stay clear */}
            <img src="/px-balloon-blue.png" alt="" width="12" height="18" class="px-pixelated absolute -top-4 -left-6 lg:-left-16 w-7 md:w-9 animate-float pointer-events-none hidden md:block" aria-hidden="true" />
            <img src="/px-balloon-gold.png" alt="" width="12" height="18" class="px-pixelated absolute top-8 -left-2 lg:-left-8 w-6 md:w-8 animate-float [animation-delay:-2s] pointer-events-none hidden md:block" aria-hidden="true" />
            <img src="/px-heart.png" alt="" width="14" height="13" class="px-pixelated absolute top-24 -left-5 lg:-left-14 w-5 md:w-6 animate-float [animation-delay:-1s] pointer-events-none hidden md:block" aria-hidden="true" />
            <img src="/px-balloon-ruby.png" alt="" width="12" height="18" class="px-pixelated absolute -top-5 -right-6 lg:-right-16 w-7 md:w-9 animate-float [animation-delay:-3s] pointer-events-none hidden md:block" aria-hidden="true" />
            <img src="/px-balloon-gold.png" alt="" width="12" height="18" class="px-pixelated absolute top-10 -right-2 lg:-right-8 w-6 md:w-8 animate-float [animation-delay:-4.5s] pointer-events-none hidden md:block" aria-hidden="true" />
            <img src="/px-heart.png" alt="" width="14" height="13" class="px-pixelated absolute top-24 -right-5 lg:-right-14 w-5 md:w-6 animate-float [animation-delay:-2.5s] pointer-events-none hidden md:block" aria-hidden="true" />
            <span class="px-plate px-plate--gold px-font text-px8 px-3 py-1.5"
                >Playable now</span
            >
            <h2
                class="px-font px-shadow-ink text-lg md:text-2xl text-gold-400 mt-6"
            >
                Everyone who comes gets a character
            </h2>
            <p class="text-base md:text-lg text-white px-shadow-ink-sm leading-relaxed mt-5">
                The Pier is an 8-bit San Francisco where attendees, speakers
                and volunteers walk around as pixel versions of themselves.
                Buy a ticket, get a character. The game runs until we meet at
                SFJAZZ in November.
            </p>
        </div>

        <div class="mt-14 grid gap-6 lg:grid-cols-[1.5fr_1fr] items-start">
            <!-- A window into the running game: the map, populated, with the
                 whole frame as the way in. -->
            <div class="relative">
            <img src="/px-hotair.png" alt="" width="22" height="24" class="px-pixelated absolute -top-10 left-[14%] w-12 md:w-16 z-10 animate-float pointer-events-none" aria-hidden="true" />
            <img src="/px-hotair.png" alt="" width="22" height="24" class="px-pixelated absolute -top-8 right-[8%] w-10 md:w-14 z-10 animate-float [animation-delay:-3.5s] pointer-events-none" aria-hidden="true" />
            <a
                href={PIER_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-card block relative overflow-hidden bg-sky-400 tap-press"
                aria-label="Enter the Pier, the SF Ruby conference game"
            >
                {/* Phones get a crop around SFJAZZ rather than the whole
                    city: the full map at 342px wide is a smudge, and the
                    building with our sign on it is the point. <picture> so
                    only one of the two is ever fetched. */}
                <picture>
                    <source
                        media="(min-width: 640px)"
                        srcset="/pier-map-1600.webp"
                        width="1600"
                        height="892"
                    />
                    <img
                        src="/pier-map-detail.webp"
                        alt="The Pier: an 8-bit San Francisco, with the SFJAZZ Center under the conference sign"
                        width="900"
                        height="711"
                        loading="lazy"
                        class="px-pixelated w-full aspect-[5/4] sm:aspect-[16/9] object-cover"
                    />
                </picture>
                {
                    citizens.map((c) => (
                        <img
                            src={c.pixel}
                            alt=""
                            width="256"
                            height="256"
                            loading="lazy"
                            aria-hidden="true"
                            class:list={[
                                "px-pixelated absolute h-auto animate-float pointer-events-none",
                                c.at,
                            ]}
                            style={`animation-delay: ${c.delay}`}
                        />
                    ))
                }
                <span
                    class="px-plate px-plate--gold px-font text-px8 md:text-px10 px-4 py-3 absolute bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap"
                >
                    Enter the Pier &#9654;&#xFE0E;
                </span>
            </a>
            </div>

            <!-- The live quest list. Point values are the game's own. -->
            <div class="px-card bg-white overflow-hidden">
                {/* gold header band, like the game's own quest panel */}
                <div class="flex items-center justify-between gap-3 bg-gold-500 border-b-4 border-ink px-5 py-4">
                    <h3 class="px-font text-px10 md:text-xs text-gray-900">
                        Quests
                    </h3>
                    {/* "0 complete" is what the game's own panel shows. A
                        denominator would have to include the returning-2025
                        bonus quest, which most readers cannot do. */}
                    <span class="px-plate px-font text-px8 px-2.5 py-1"
                        >0 complete</span
                    >
                </div>
                <ul class="list-none p-0 m-0 flex flex-col">
                    {
                        quests.map((q, i) => (
                            <li class:list={[
                                "flex items-center justify-between gap-3 px-5 py-4 border-b-2 border-gray-100 last:border-0",
                                i === 0 && "bg-gold-100",
                            ]}>
                                <span class="text-sm text-gray-800 leading-relaxed min-w-0">
                                    {q.label}
                                </span>
                                <span class="flex items-center gap-3 shrink-0">
                                    <img src={q.icon} alt="" width={q.w} height={q.h} class="px-pixelated h-5 w-auto" aria-hidden="true" />
                                    <span class="px-plate px-plate--gold px-font text-px8 px-2 py-1">
                                        +{q.points}
                                    </span>
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <p class="text-xs text-gray-500 leading-relaxed px-5 pb-5 pt-4">
                    Came last year? There is a quest waiting for you. New
                    quests come out until November, and the last badges are
                    earned in person at SFJAZZ. Talk about it in the{" "}
                    <a
                        href={SLACK_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-ruby-600 underline underline-offset-2"
                        >SF Ruby Slack</a
                    >.
                </p>
            </div>
        </div>

        <!-- The artifact people actually post. Three published cards, linked
             to the real profiles they came from. -->
        <div class="mt-14">
            <p
                class="px-font text-px8 md:text-px10 text-white px-shadow-ink-sm text-center leading-relaxed"
            >
                Every player gets a Cloud Card
            </p>
            <ul class="mt-6 grid gap-5 sm:grid-cols-3 list-none p-0">
                {
                    cards.map((c) => (
                        <li class="px-card bg-white">
                            <a
                                href={c.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block tap-press"
                            >
                                <img
                                    src={c.image}
                                    alt={`${c.name}'s Cloud Card`}
                                    width="900"
                                    height="470"
                                    loading="lazy"
                                    class="px-pixelated w-full h-auto border-b-4 border-ink"
                                />
                                <div class="p-4 text-center">
                                    <p class="font-display font-semibold text-sm text-gray-900 leading-snug">
                                        {c.name}
                                    </p>
                                    <p class="text-xs text-ruby-600 mt-1.5">
                                        {c.role}
                                    </p>
                                </div>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div
            class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4"
        >
            <a
                href={PIER_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="px-btn px-btn--gold px-font text-px10 md:text-xs px-6 py-4 tap-press"
            >
                Enter the Pier
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path stroke-linecap="square" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
            <a
                href={ticketLink("pier")}
                target="_blank"
                rel="noopener noreferrer"
                class={`px-btn px-btn--white px-font text-px10 md:text-xs px-6 py-4 tap-press ${ticketEventClass("pier")}`}
            >
                <img
                    src="/px-ticket.png"
                    alt=""
                    width="26"
                    height="12"
                    class="px-pixelated h-5 w-auto"
                />
                Get your slot{livePrice && ` \u00B7 $${livePrice}`}
            </a>
        </div>
    </div>
</section>
