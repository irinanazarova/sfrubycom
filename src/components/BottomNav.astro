---
import { Icon } from "astro-icon/components";

// Floating bottom nav, mobile only (hidden on lg: and OG-image renders).
// 8-bit HUD take on an iOS tab bar: a solid sprite panel that floats over
// the content (which scrolls underneath), plus a detached gold "item block"
// square for the primary CTA. The panel holds a few primary destinations +
// a "More" tab that opens a full-menu bottom sheet for everything else.
// Icons are Phosphor (light = idle, fill = active) via astro-icon, inlined
// at build.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? path === "/" : path.startsWith(href);
const ph = (name: string, active: boolean) => `ph:${name}-${active ? "fill" : "light"}`;

// Primary tabs that live in the glass pill.
const tabs = [
    { name: "Home", href: "/", icon: "house" },
    { name: "Meetup", href: "/meetup", icon: "users-three" },
    {
        name: "Slack",
        href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
        external: true,
        icon: "slack-logo",
    },
    { name: "Jobs", href: "/jobs", icon: "briefcase" },
];

// Overflow destinations, reached via the "More" tab → bottom sheet.
const moreItems = [
    { name: "Speakers", href: "/speakers", icon: "user-sound" },
    { name: "Videos", href: "/videos", icon: "play-circle" },
    { name: "Startups", href: "/startups", icon: "rocket-launch" },
    { name: "Sponsor", href: "/sponsor-2026", icon: "hand-heart" },
    { name: "News", href: "/news", icon: "newspaper" },
    { name: "About", href: "/about", icon: "info" },
];
const moreActive = moreItems.some((it) => isActive(it.href));
---

<!-- Floating dock: transparent margins pass taps through to content. Display
     comes from the `flex` utility so `lg:hidden`/`ogplus:hidden` win the cascade. -->
<div class="bottom-dock lg:hidden ogplus:hidden fixed inset-x-0 bottom-0 z-40 flex items-center gap-2.5 px-4 pointer-events-none">
    <nav id="bottom-nav" aria-label="Primary" class="nav-glass">
        {
            tabs.map((tab) => {
                const active = !tab.external && isActive(tab.href);
                return (
                    <a
                        href={tab.href}
                        target={tab.external ? "_blank" : undefined}
                        rel={tab.external ? "noopener noreferrer" : undefined}
                        aria-current={active ? "page" : undefined}
                        class="tab-item tap-press"
                    >
                        <span class:list={["tab-inner", { active }]}>
                            <Icon name={ph(tab.icon, active)} class="w-6 h-6" />
                            <span>{tab.name}</span>
                        </span>
                    </a>
                );
            })
        }
        <button id="more-tab" type="button" class="tab-item tap-press" aria-haspopup="dialog" aria-expanded="false" aria-controls="more-sheet">
            <span class:list={["tab-inner", { active: moreActive }]}>
                <Icon name={ph("dots-three", moreActive)} class="w-6 h-6" />
                <span>More</span>
            </span>
        </button>
    </nav>

    <a
        id="join-fab"
        href="https://lu.ma/sfruby"
        target="_blank"
        rel="noopener noreferrer"
        class="join-fab tap-press"
        aria-label="Join the next SF Ruby meetup"
    >
        <Icon name="ph:calendar-plus-light" class="w-6 h-6" />
    </a>
</div>

<!-- More menu: dim backdrop + iOS bottom sheet -->
<div id="more-backdrop" class="more-backdrop lg:hidden" aria-hidden="true" hidden></div>
<div
    id="more-sheet"
    class="more-sheet lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="More"
    hidden
>
    <div class="more-grabber" aria-hidden="true"></div>
    <p class="more-title">More</p>
    <nav class="more-list" aria-label="More destinations">
        {
            moreItems.map((it) => {
                const active = isActive(it.href);
                return (
                    <a
                        href={it.href}
                        aria-current={active ? "page" : undefined}
                        class:list={["more-row tap-press", { active }]}
                    >
                        <Icon name={ph(it.icon, active)} class="w-6 h-6 more-row-icon" />
                        <span class="more-row-label">{it.name}</span>
                        <Icon name="ph:caret-right-light" class="w-4 h-4 more-row-caret" />
                    </a>
                );
            })
        }
    </nav>
</div>

<style>
    /* The dock spans the bottom; its padding lifts the pill above the home
       indicator. pointer-events pass through the transparent margins so the
       page stays tappable to the sides of the pill. */
    /* Layout/display/hide come from utility classes (so the lg:/ogplus: hidden
       variants win the cascade); scoped CSS only adds the safe-area lift. */
    .bottom-dock {
        padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));
    }

    /* 8-bit dock: a solid sprite panel with an ink outline and a hard offset
       shadow, floating over the content like a HUD. */
    .nav-glass {
        position: relative;
        flex: 1 1 auto;
        display: flex;
        height: 4rem;
        border-radius: 0;
        overflow: hidden;
        pointer-events: auto;
        background: var(--white);
        border: 4px solid var(--px-ink);
        box-shadow: 4px 4px 0 0 var(--px-ink);
    }

    .tab-item {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--dark-500);
        background: transparent;
        border: 0;
        cursor: pointer;
        -webkit-touch-callout: none;
        user-select: none;
    }
    .tab-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.3125rem 0.5rem;
        border-radius: 0;
        font-family: "Press Start 2P", "Martian Mono", monospace;
        font-size: 0.5rem;
        line-height: 1;
        text-transform: uppercase;
        transition: background 0.15s, color 0.15s;
    }
    /* Active tab: logo coral + a flat tinted block behind it. */
    .tab-inner.active {
        color: var(--ruby-600);
        background: color-mix(in oklch, var(--ruby-500) 14%, transparent);
    }

    /* Detached accent CTA: a gold "item block" square, same sprite family
       as the dock panel. */
    .join-fab {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: 0;
        pointer-events: auto;
        color: var(--px-ink);
        background: var(--px-gold);
        border: 4px solid var(--px-ink);
        box-shadow: 4px 4px 0 0 var(--px-ink);
    }

    /* ---- More bottom sheet ---- */
    .more-backdrop {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: color-mix(in oklch, var(--dark-900) 45%, transparent);
        opacity: 0;
        transition: opacity 0.28s ease;
        pointer-events: none;
    }
    .more-backdrop.open {
        opacity: 1;
        pointer-events: auto;
    }
    .more-sheet {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 51;
        max-height: 80vh;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--white);
        border-radius: 0;
        border-top: 4px solid var(--px-ink);
        padding: 0 0.75rem calc(0.75rem + env(safe-area-inset-bottom));
        transform: translateY(100%);
        transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .more-sheet.open {
        transform: translateY(0);
    }
    .more-grabber {
        position: sticky;
        top: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.625rem 0 0.25rem;
        background: var(--white);
        cursor: grab;
        touch-action: none;
    }
    .more-grabber::before {
        content: "";
        width: 2.25rem;
        height: 0.375rem;
        border-radius: 0;
        background: var(--px-ink);
    }
    .more-title {
        font-family: "Press Start 2P", "Martian Mono", monospace;
        font-size: 0.625rem;
        text-transform: uppercase;
        color: var(--dark-500);
        padding: 0.25rem 0.75rem 0.5rem;
    }
    .more-row {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 0.75rem;
        border-radius: 0;
        color: var(--dark-800);
        font-size: 1rem;
        font-weight: 500;
    }
    .more-row-icon {
        color: var(--dark-500);
        flex: 0 0 auto;
    }
    .more-row-caret {
        margin-inline-start: auto;
        color: var(--dark-300);
        flex: 0 0 auto;
    }
    .more-row.active {
        background: color-mix(in oklch, var(--ruby-500) 12%, transparent);
        color: var(--ruby-600);
    }
    .more-row.active .more-row-icon {
        color: var(--ruby-600);
    }

    @media (prefers-reduced-motion: reduce) {
        .more-sheet,
        .more-backdrop,
        .tab-inner {
            transition: none;
        }
    }
</style>

<script>
    const moreBtn = document.getElementById("more-tab");
    const sheet = document.getElementById("more-sheet");
    const backdrop = document.getElementById("more-backdrop");
    const grabber = sheet?.querySelector<HTMLElement>(".more-grabber");
    const SPRING = "transform 0.32s cubic-bezier(0.32, 0.72, 0, 1)";
    let lastFocused: HTMLElement | null = null;

    const isOpen = () => sheet?.classList.contains("open") ?? false;

    function openMore() {
        if (!sheet || !backdrop) return;
        lastFocused = document.activeElement as HTMLElement;
        sheet.hidden = false;
        backdrop.hidden = false;
        // Always start from the fully-closed position, then animate up — this
        // clears any leftover inline transform from a previous drag.
        sheet.style.transition = "none";
        sheet.style.transform = "";
        void sheet.offsetHeight; // reflow at translateY(100%)
        sheet.style.transition = "";
        sheet.classList.add("open");
        backdrop.classList.add("open");
        document.body.classList.add("overflow-hidden");
        moreBtn?.setAttribute("aria-expanded", "true");
        sheet.querySelector<HTMLElement>("a")?.focus();
    }

    function closeMore() {
        if (!sheet || !backdrop) return;
        sheet.classList.remove("open");
        backdrop.classList.remove("open");
        // Drive the slide-down explicitly (a drag may have left an inline
        // transform that would otherwise override the class and freeze it).
        sheet.style.transition = SPRING;
        sheet.style.transform = "";
        document.body.classList.remove("overflow-hidden");
        moreBtn?.setAttribute("aria-expanded", "false");
        lastFocused?.focus?.();
        lastFocused = null;
        const done = (e: TransitionEvent) => {
            if (e.propertyName !== "transform") return;
            // Reopened mid-close: leave it open, don't hide.
            if (isOpen()) { sheet.removeEventListener("transitionend", done); return; }
            sheet.hidden = true;
            backdrop.hidden = true;
            sheet.style.transition = "";
            sheet.removeEventListener("transitionend", done);
        };
        sheet.addEventListener("transitionend", done);
    }

    moreBtn?.addEventListener("click", () => (isOpen() ? closeMore() : openMore()));
    backdrop?.addEventListener("click", closeMore);
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen()) closeMore();
    });

    // Keep keyboard focus inside the open sheet.
    sheet?.addEventListener("keydown", (e) => {
        if (e.key !== "Tab" || !isOpen()) return;
        const items = sheet.querySelectorAll<HTMLElement>("a[href]");
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
        }
    });

    // Drag the grab handle down to dismiss, like an iOS sheet.
    if (grabber && sheet) {
        let startY = 0;
        let dy = 0;
        let dragging = false;
        grabber.addEventListener("touchstart", (e) => {
            dragging = true;
            startY = e.touches[0].clientY;
            dy = 0;
            sheet.style.transition = "none";
        }, { passive: true });
        grabber.addEventListener("touchmove", (e) => {
            if (!dragging) return;
            dy = Math.max(0, e.touches[0].clientY - startY);
            sheet.style.transform = `translateY(${dy}px)`;
        }, { passive: true });
        grabber.addEventListener("touchend", () => {
            if (!dragging) return;
            dragging = false;
            if (dy > sheet.offsetHeight * 0.3 || dy > 120) {
                closeMore();
            } else {
                sheet.style.transition = SPRING;
                sheet.style.transform = "translateY(0)";
            }
        });
    }
</script>
