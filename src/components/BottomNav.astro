---
import { Icon } from "astro-icon/components";

// iOS-style bottom tab bar, mobile only. Hidden on desktop (lg:) and when
// generating OG images (ogplus:). It is the sole mobile nav (the hamburger
// menu was removed), so it carries every destination: the first five fill the
// screen, the rest are reached by scrolling the bar horizontally. Icons are
// Phosphor "light" (delicate, iOS-like) via astro-icon, inlined at build.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? path === "/" : path.startsWith(href);

const tabs = [
    { name: "Home", href: "/", icon: "ph:house-light" },
    { name: "Jobs", href: "/jobs", icon: "ph:briefcase-light" },
    {
        name: "Slack",
        href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg",
        external: true,
        icon: "ph:slack-logo-light",
    },
    { name: "Videos", href: "/videos", icon: "ph:play-circle-light" },
    {
        name: "Join",
        href: "https://lu.ma/sfruby",
        external: true,
        accent: true,
        icon: "ph:calendar-plus-light",
    },
    { name: "Sponsor", href: "/sponsor-2026", icon: "ph:hand-heart-light" },
    { name: "Conf", href: "/conference-2026", icon: "ph:microphone-stage-light" },
    { name: "News", href: "/news", icon: "ph:newspaper-light" },
    { name: "Startups", href: "/startups", icon: "ph:rocket-launch-light" },
    { name: "About", href: "/about", icon: "ph:info-light" },
];
---

<nav
    id="bottom-nav"
    aria-label="Primary"
    class="lg:hidden ogplus:hidden fixed bottom-0 inset-x-0 z-40 bg-white/90 backdrop-blur-xl border-t border-gray-200/80 pb-safe"
>
    <div class="tab-scroll flex h-16">
        {
            tabs.map((tab) => {
                const active = !tab.external && isActive(tab.href);
                const color = tab.accent
                    ? "text-ruby-600"
                    : active
                      ? "text-ruby-600"
                      : "text-gray-500";
                return (
                    <a
                        href={tab.href}
                        target={tab.external ? "_blank" : undefined}
                        rel={tab.external ? "noopener noreferrer" : undefined}
                        aria-current={active ? "page" : undefined}
                        class={`tab-item tap-press ${color}`}
                    >
                        <Icon name={tab.icon} class="w-6 h-6" />
                        <span>{tab.name}</span>
                    </a>
                );
            })
        }
    </div>
</nav>

<style>
    .tab-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        /* Commit to horizontal panning immediately (no vertical-scroll
           disambiguation delay on the first swipe). */
        touch-action: pan-x;
        scrollbar-width: none;
        /* Fade the right edge to hint that the bar scrolls to more tabs. */
        -webkit-mask-image: linear-gradient(
            to right,
            #000 calc(100% - 1.5rem),
            transparent
        );
        mask-image: linear-gradient(
            to right,
            #000 calc(100% - 1.5rem),
            transparent
        );
    }
    .tab-scroll::-webkit-scrollbar {
        display: none;
    }
    .tab-item {
        flex: 0 0 20%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.1875rem;
        font-size: 0.625rem;
        line-height: 1;
        font-weight: 500;
        transition: color 0.15s;
        /* Suppress the iOS long-press callout / text selection on chrome. */
        -webkit-touch-callout: none;
        user-select: none;
    }
</style>
