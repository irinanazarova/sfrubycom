---
// iOS-style bottom tab bar, mobile only. Hidden on desktop (lg:) and when
// generating OG images (ogplus:). It is the sole mobile nav (the hamburger
// menu was removed), so it carries every destination: the first five fill the
// screen, the rest are reached by scrolling the bar horizontally.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
    href === "/" ? path === "/" : path.startsWith(href);

const tabs = [
    { name: "Home", href: "/", icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" },
    { name: "Jobs", href: "/jobs", icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" },
    { name: "Slack", href: "https://join.slack.com/t/sf-ruby/shared_invite/zt-3mi22dwb9-MGN_s0j_jNrt7hb4rvqkHg", external: true, icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" },
    { name: "Videos", href: "/videos", icon: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
    { name: "Join", href: "https://lu.ma/sfruby", external: true, accent: true, icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
    { name: "Sponsor", href: "/sponsor-2026", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
    { name: "Conf", href: "/conference-2026", icon: "M19 11a7 7 0 01-14 0m7 7v4m-4 0h8m-4-7a3 3 0 01-3-3V5a3 3 0 016 0v3a3 3 0 01-3 3z" },
    { name: "News", href: "/news", icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m0 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9m4 7H9m4 4H9m-2-8h.01" },
    { name: "Startups", href: "/startups", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
    { name: "About", href: "/about", icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
];
---

<nav
    id="bottom-nav"
    aria-label="Primary"
    class="lg:hidden ogplus:hidden fixed bottom-0 inset-x-0 z-40 bg-white/90 backdrop-blur-xl border-t border-gray-200/80 pb-safe"
>
    <div class="tab-scroll flex h-16">
        {
            tabs.map((tab) => {
                const active = !tab.external && isActive(tab.href);
                const color = tab.accent
                    ? "text-ruby-600 font-semibold"
                    : active
                      ? "text-ruby-600"
                      : "text-gray-500";
                return (
                    <a
                        href={tab.href}
                        target={tab.external ? "_blank" : undefined}
                        rel={tab.external ? "noopener noreferrer" : undefined}
                        aria-current={active ? "page" : undefined}
                        class={`tab-item tap-press ${color}`}
                    >
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tab.icon} />
                        </svg>
                        <span>{tab.name}</span>
                    </a>
                );
            })
        }
    </div>
</nav>

<style>
    .tab-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        /* Commit to horizontal panning immediately (no vertical-scroll
           disambiguation delay on the first swipe). */
        touch-action: pan-x;
        scrollbar-width: none;
        /* Fade the right edge to hint that the bar scrolls to more tabs. */
        -webkit-mask-image: linear-gradient(
            to right,
            #000 calc(100% - 1.5rem),
            transparent
        );
        mask-image: linear-gradient(
            to right,
            #000 calc(100% - 1.5rem),
            transparent
        );
    }
    .tab-scroll::-webkit-scrollbar {
        display: none;
    }
    .tab-item {
        flex: 0 0 20%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.125rem;
        font-size: 0.625rem;
        line-height: 1;
        font-weight: 500;
        transition: color 0.15s;
        /* Suppress the iOS long-press callout / text selection on chrome. */
        -webkit-touch-callout: none;
        user-select: none;
    }
</style>
