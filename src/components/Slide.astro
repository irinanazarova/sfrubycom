---
interface Props {
  layout?: 'centered' | 'two-column' | 'card-grid' | 'fullscreen' | 'stacked';
  background?: 'dark' | 'gradient-pink' | 'gradient-purple' | 'gradient-yellow' | 'gradient-green';
  notes?: string;
}
const { layout = 'centered', background = 'dark', notes } = Astro.props;
---
<section
  class:list={['slide', `slide-${layout}`, `slide-bg-${background}`]}
  data-notes={notes}
>
  <slot />
</section>
