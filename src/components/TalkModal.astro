---
/**
 * TalkModal - Native HTML dialog element for displaying talk details
 * Uses the native <dialog> element for better accessibility and performance
 */
---

<dialog id="talkModal" class="talk-modal">
    <div class="modal-panel">
        <div id="talkModalContent" class="modal-content">
            <!-- Content will be dynamically inserted here -->
        </div>
    </div>
</dialog>

<style>
    /* CSS variables for dynamic viewport height */
    :root {
        --modal-viewport-height: 100vh;
    }

    @supports (height: 100dvh) {
        :root {
            --modal-viewport-height: 100dvh;
        }
    }

    .talk-modal {
        /* Force dialog to appear - Safari fix */
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: var(--modal-viewport-height);
        min-height: 100vh;
        padding: 0;
        margin: 0;
        border: none;
        background: transparent;
        z-index: 9999;
        /* Hide by default */
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    .talk-modal[open] {
        /* Show when open */
        opacity: 1 !important;
        pointer-events: auto !important;
        visibility: visible !important;
        animation: fadeIn 0.2s ease-out;
    }

    .talk-modal::backdrop {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
        animation: fadeIn 0.2s ease-out;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: var(--modal-viewport-height);
        min-height: 100vh;
    }

    .modal-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 56rem;
        max-height: 90vh; /* fallback for iOS < 15.4 */
        max-height: 90dvh;
        width: 95vw;
        background: white;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }

    .modal-content {
        max-height: 90vh; /* fallback for iOS < 15.4 */
        max-height: 90dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    /* Smooth scrolling within modal */
    .modal-content {
        scroll-behavior: smooth;
    }

    /* Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* Mobile responsive */
    @media (max-width: 640px) {
        .modal-panel {
            width: 100vw;
            max-width: 100vw;
            height: var(--modal-viewport-height);
            border-radius: 0;
            top: 0;
            left: 0;
            transform: none;
        }

        .modal-content {
            height: var(--modal-viewport-height);
            padding: 0;
            -webkit-overflow-scrolling: touch;
        }

        .modal-content > div {
            padding-top: max(env(safe-area-inset-top), 1rem);
            padding-bottom: max(env(safe-area-inset-bottom), 2rem);
        }
    }

    /* Improve scrollbar styling */
    .modal-content::-webkit-scrollbar {
        width: 8px;
    }

    .modal-content::-webkit-scrollbar-track {
        background: var(--dark-100);
    }

    .modal-content::-webkit-scrollbar-thumb {
        background: var(--dark-400);
        border-radius: 4px;
    }

    .modal-content::-webkit-scrollbar-thumb:hover {
        background: var(--dark-600);
    }
</style>

<script>
    /**
     * Safari-compatible dialog modal manager for talks
     */

    function initializeTalkModal() {
        const modal = document.getElementById("talkModal") as HTMLDialogElement;
        const modalContent = document.getElementById("talkModalContent");

        if (!modal || !modalContent) {
            console.error("TalkModal elements not found");
            return;
        }

        /**
         * Open modal with Safari-compatible approach
         */
        function openModal() {
            if (!modal) return;

            try {
                modal.style.display = "block";
                modal.style.visibility = "visible";
                modal.style.opacity = "1";
                modal.style.pointerEvents = "auto";
                modal.style.position = "fixed";
                modal.style.zIndex = "9999";

                if (typeof modal.showModal === "function") {
                    modal.showModal();
                } else {
                    modal.setAttribute("open", "");
                    modal.style.display = "block";
                }

                document.body.classList.add("modal-open");

                requestAnimationFrame(() => {
                    if (modalContent) {
                        modalContent.scrollTop = 0;
                    }
                });
            } catch (error) {
                console.error("TalkModal: Error opening modal:", error);
                modal.setAttribute("open", "");
                modal.style.display = "block";
                modal.style.visibility = "visible";
                modal.style.opacity = "1";
                document.body.classList.add("modal-open");
            }
        }

        /**
         * Close modal
         */
        function closeModal() {
            if (!modal) return;

            try {
                // Clear modal content to stop any playing videos
                if (modalContent) {
                    modalContent.innerHTML = "";
                }

                if (modal.open && typeof modal.close === "function") {
                    modal.close();
                } else {
                    modal.removeAttribute("open");
                }

                modal.style.display = "";
                modal.style.visibility = "";
                modal.style.opacity = "";
                modal.style.pointerEvents = "";
                modal.style.position = "";
                modal.style.zIndex = "";

                document.body.classList.remove("modal-open");
            } catch (error) {
                console.error("TalkModal: Error closing modal:", error);
                // Clear content even on error
                if (modalContent) {
                    modalContent.innerHTML = "";
                }
                modal.removeAttribute("open");
                modal.style.display = "";
                modal.style.visibility = "";
                modal.style.opacity = "";
                modal.style.pointerEvents = "";
                document.body.classList.remove("modal-open");
            }
        }

        /**
         * Set modal content
         */
        function setModalContent(html: string) {
            if (!modalContent) return;

            modalContent.innerHTML = html;
            modalContent.scrollTop = 0;

            // Attach close button handler
            const closeBtn = modalContent.querySelector("#talkModalCloseBtn");
            if (closeBtn) {
                closeBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    closeModal();
                });
            }
        }

        // Handle ESC key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal.open) {
                // Use URL-aware close if available, otherwise regular close
                if (
                    typeof (window as any).closeTalkModalAndUpdateUrl ===
                    "function"
                ) {
                    (window as any).closeTalkModalAndUpdateUrl();
                } else {
                    closeModal();
                }
            }
        });

        modal.addEventListener("close", () => {
            document.body.classList.remove("modal-open");
        });

        // Handle backdrop click to close
        modal.addEventListener("click", (e) => {
            const modalPanel = modal.querySelector(
                ".modal-panel",
            ) as HTMLElement;
            if (modalPanel && !modalPanel.contains(e.target as Node)) {
                // Use URL-aware close if available, otherwise regular close
                if (
                    typeof (window as any).closeTalkModalAndUpdateUrl ===
                    "function"
                ) {
                    (window as any).closeTalkModalAndUpdateUrl();
                } else {
                    closeModal();
                }
            }
        });

        // Export functions to window
        (window as any).showTalkModal = openModal;
        (window as any).hideTalkModal = closeModal;
        (window as any).setTalkModalContent = setModalContent;
    }

    // Run immediately if DOM is ready, otherwise wait
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeTalkModal);
    } else {
        initializeTalkModal();
    }
</script>

<style is:global>
    /* Prevent body scroll when modal is open */
    body.modal-open {
        overflow: hidden;
    }
</style>
