---
// Character-select grid for the 2026 lineup. Speakers without pixel art yet render
// as an unrevealed "?" slot, which keeps the name (the thing that sells) on the page.
//
// Talk titles and bios come from the CFP feed: baked in at build time from the
// committed snapshot (src/content/cfp-talks.json, refreshed by
// scripts/fetch-cfp-talks.js), then silently refreshed in place from the live
// API by the script below. Stubs ("TBD", a one-word bio) stay hidden or fall
// back to the roster line, which buildProfiles decides for every surface at
// once so this grid and /speakers can never disagree about a speaker.
//
// A tile is a link into that speaker's full card on /speakers, where the bio
// runs at full length. This one is shortened to fit.
import { conferenceSpeakers, cfpNameAliases } from "../data/conference-2026.js";
import { buildProfiles, shortBio } from "../utils/speakerProfiles.js";
import cfpTalks from "../content/cfp-talks.json";

interface Props {
    heading?: string;
    limit?: number;
    compact?: boolean;
    // Set on the homepage: the roster is the last conference content before the
    // page moves on to news, so it needs a way through to the full page.
    ctaHref?: string;
    ctaLabel?: string;
}

const {
    heading = "The lineup",
    limit,
    compact = false,
    ctaHref,
    ctaLabel = "Everything about the conference",
} = Astro.props;

const { profiles, unmatched } = buildProfiles(
    cfpTalks,
    conferenceSpeakers,
    cfpNameAliases,
);
// An unmatched CFP name means a missing cfpNameAliases entry or a speaker we
// haven't added to the roster — surface it in the build log, don't fail.
if (unmatched.length > 0)
    console.warn(`cfp-talks: no roster match for: ${unmatched.join(", ")}`);

// Pinned speakers hold the ends of the grid; the rest sort artwork-first so the
// roster opens on real faces rather than a wall of unrevealed slots.
const rank = (s) => (s.pin === "first" ? -1 : s.pin === "last" ? 1 : 0);
const ordered = [...profiles].sort(
    (a, b) =>
        rank(a) - rank(b) ||
        Number(Boolean(b.pixel)) - Number(Boolean(a.pixel)),
);
// A limit would silently drop whoever sorts last, so it only ever trims the
// unpinned middle.
const speakers = limit
    ? [
          ...ordered.filter((s) => s.pin === "first"),
          ...ordered
              .filter((s) => !s.pin)
              .slice(0, Math.max(0, limit - ordered.filter((s) => s.pin).length)),
          ...ordered.filter((s) => s.pin === "last"),
      ]
    : ordered;
// Whoever the limit trimmed. Their sprites become the crowd on the CTA, so the
// page shows how much lineup is left rather than just asserting it.
const shown = new Set(speakers.map((s) => s.key));
const rest = ordered.filter((s) => !shown.has(s.key));
// The CTA names the whole lineup rather than the remainder: "see all 19" is the
// number a reader wants, and one number beats two competing on the same panel.
const ctaText =
    rest.length > 0 ? `See all ${ordered.length} speakers` : ctaLabel;
---

<section
    id="speakers"
    class:list={[
        "relative overflow-hidden border-t-4 border-ink px-dither-sky",
        compact ? "py-14" : "py-20 md:py-24",
    ]}
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5"
                >{conferenceSpeakers.length} confirmed</span
            >
            <h2
                class="px-font px-shadow-ink text-lg md:text-2xl text-white mt-6"
            >
                {heading}
            </h2>
        </div>

        <ul
            class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 list-none p-0"
        >
            {
                speakers.map((s) => (
                    <li class="px-card bg-white" data-cfp-key={s.key}>
                        <a
                            href={`/speakers#${s.key}`}
                            class="p-4 flex flex-col items-center text-center h-full tap-press"
                        >
                            {s.pixel ? (
                                <img
                                    src={s.pixel}
                                    alt={`${s.name}, pixel character`}
                                    width="256"
                                    height="256"
                                    loading="lazy"
                                    class="px-pixelated w-24 md:w-28 h-auto"
                                />
                            ) : (
                                <div
                                    class="w-24 md:w-28 aspect-square flex items-center justify-center bg-sky-100 border-4 border-ink"
                                    aria-hidden="true"
                                >
                                    <span class="px-font text-2xl text-sky-500">
                                        ?
                                    </span>
                                </div>
                            )}
                            <img
                                src="/px-island.png"
                                alt=""
                                width="598"
                                height="104"
                                loading="lazy"
                                class="px-pixelated w-28 md:w-32 h-auto -mt-2"
                            />
                            {/* Grotesk, not the pixel font: Press Start 2P has no accented
                                capitals and would mangle names like Gutiérrez. */}
                            {/* fixed two-line box so cards whose names wrap keep the
                                company line on the same baseline across the row */}
                            <p class="font-display font-semibold text-sm md:text-base text-gray-900 mt-3 leading-snug flex items-center justify-center min-h-[2.75rem]">
                                {s.name}
                            </p>
                            {/* plain text, not links: the whole tile is already an
                                anchor, and anchors can't nest. The org links live on
                                the /speakers card this tile opens. */}
                            <p class="text-xs md:text-sm text-ruby-600 mt-2">
                                {s.orgs.map((org) => org.name).join(", ")}
                            </p>
                            {/* always in the DOM (hidden when empty) so the client
                                refresh has a node to fill when a title lands */}
                            <p
                                data-talk-title
                                hidden={!s.title}
                                class="font-display font-semibold text-xs md:text-sm text-gray-900 leading-snug mt-3"
                            >
                                {s.title && `“${s.title}”`}
                            </p>
                            {/* shortBio trims the text; the clamp keeps a long
                                one from stretching the tile. Six lines on a
                                phone, where the two-column tile fits about a
                                dozen characters per line and four would clip a
                                short bio mid-sentence; four from sm up, where
                                the tile is wide enough. The full bio is one tap
                                away on the card this tile opens. */}
                            <p
                                data-speaker-bio
                                hidden={!s.bio}
                                class="text-xs text-gray-600 leading-relaxed mt-3 line-clamp-6 sm:line-clamp-4"
                            >
                                {shortBio(s.bio)}
                            </p>
                            {s.keynote && (
                                <span class="px-plate px-plate--gold px-font text-px8 px-2 py-1 mt-3">
                                    Keynote
                                </span>
                            )}
                        </a>
                    </li>
                ))
            }
        </ul>


        {
            ctaHref && (
                <div class="mt-10 md:mt-12">
                    {/* The whole panel is the target, not a lone button: on a
                        trimmed roster this is the only way through to the other
                        speakers, so it gets the width. */}
                    <a
                        href={ctaHref}
                        class="px-btn px-btn--white flex-col w-full gap-5 px-6 py-8 md:py-10 tap-press"
                    >
                        {rest.length > 0 && (
                            <div class="flex flex-wrap items-end justify-center gap-x-1 gap-y-2">
                                {rest.map(
                                    (s) =>
                                        s.pixel && (
                                            <img
                                                src={s.pixel}
                                                alt=""
                                                width="256"
                                                height="256"
                                                loading="lazy"
                                                aria-hidden="true"
                                                class="px-pixelated w-10 md:w-14 h-auto"
                                            />
                                        ),
                                )}
                            </div>
                        )}
                        <span class="px-plate px-plate--gold px-font text-px8 md:text-px10 px-5 py-4 inline-flex items-center gap-2">
                            {ctaText}
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path stroke-linecap="square" d="M9 5l7 7-7 7" />
                            </svg>
                        </span>
                    </a>
                </div>
            )
        }

    </div>
</section>

<script>
    // Refresh talk titles and bios in place from the live CFP feed. The baked
    // copy is already on screen, so every failure path (dev server without the
    // Netlify proxy, CFP app down, 8s timeout) just means no silent upgrade this
    // visit — nothing to clean up, no spinner to hide.
    import {
        conferenceSpeakers,
        cfpNameAliases,
    } from "../data/conference-2026.js";
    import { buildProfiles, shortBio } from "../utils/speakerProfiles.js";
    import { CFP_API_PATH } from "../utils/cfpTalks.js";

    function setText(card: Element, selector: string, text: string) {
        const node = card.querySelector(selector);
        if (!(node instanceof HTMLElement)) return;
        if (node.textContent !== text) node.textContent = text;
        node.hidden = !text;
    }

    async function refreshRoster() {
        try {
            const res = await fetch(CFP_API_PATH, {
                signal: AbortSignal.timeout(8_000),
            });
            if (!res.ok) return;
            const { profiles } = buildProfiles(
                await res.json(),
                conferenceSpeakers,
                cfpNameAliases,
            );
            const byKey = new Map(profiles.map((p) => [p.key, p]));
            for (const card of document.querySelectorAll("[data-cfp-key]")) {
                if (!(card instanceof HTMLElement)) continue;
                const p = byKey.get(card.dataset.cfpKey ?? "");
                if (!p) continue;
                setText(
                    card,
                    "[data-talk-title]",
                    p.title ? `\u201C${p.title}\u201D` : "",
                );
                setText(card, "[data-speaker-bio]", shortBio(p.bio));
            }
        } catch {
            // keep the baked copy
        }
    }

    refreshRoster();
</script>
