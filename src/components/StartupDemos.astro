---
import { getAllStartups } from "../data/startups.js";
import { getSpeaker } from "../data/speakers.js";

const startups = getAllStartups();
---

<section id="startup-demos" class="py-20 bg-dark-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <div class="inline-block">
                <a href="#startup-demos" class="group">
                    <h2
                        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-dark-900 mb-4 tracking-tight transition-colors duration-300 group-hover:text-ruby-600"
                    >
                        Ruby Startup Demos
                    </h2>
                </a>
                <div
                    class="w-24 h-1 bg-gradient-to-r from-ruby-500 to-pink-500 rounded-full mx-auto"
                >
                </div>
            </div>
            <p
                class="mt-4 text-xl text-dark-600 max-w-4xl mx-auto leading-relaxed font-light"
            >
                See how Ruby powers the next generation of innovative startups
                and products
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
            {
                startups.map((startup) => {
                    const speaker = getSpeaker(startup.speakerId);
                    // Use naming convention: {startup.id}-demo
                    const demoTalkId = `${startup.id}-demo`;
                    const scheduleLink = `/schedule-2025#${demoTalkId}`;
                    const isExternal = false;
                    return (
                        <a
                            href={scheduleLink}
                            target={isExternal ? "_blank" : undefined}
                            rel={isExternal ? "noopener noreferrer" : undefined}
                            class="group bg-white rounded-xl p-8 transition-all duration-300 transform hover:scale-105 hover:shadow-xl shadow-sm border border-gray-100 hover:border-ruby-200 h-full"
                        >
                            <div class="flex flex-col items-center h-full min-h-[280px]">
                                <div class="h-28 w-full mb-6 flex items-center justify-center">
                                    <img
                                        src={startup.logo}
                                        alt={`${startup.name} logo`}
                                        class="max-h-full max-w-full object-contain filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        loading="lazy"
                                    />
                                </div>
                                <p class="text-sm text-dark-600 text-center leading-relaxed flex-grow mb-4">
                                    {startup.description}
                                </p>
                                {startup.isYC && (
                                    <div class="mb-4">
                                        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-orange-50 border border-orange-200 rounded-full">
                                            <img
                                                src="/yc_icon.png"
                                                alt="Y Combinator"
                                                class="w-4 h-4"
                                                title="Y Combinator Company"
                                            />
                                            <span class="text-xs font-medium text-orange-700">
                                                YC Backed
                                            </span>
                                        </div>
                                    </div>
                                )}
                                {speaker && speaker.name && (
                                    <div class="mt-4 pt-3 border-t border-dark-100 w-full">
                                        <div class="flex flex-col items-center text-xs text-dark-500">
                                            <span class="text-dark-400 mb-1">
                                                Demo by
                                            </span>
                                            <span class="font-medium text-dark-700">
                                                {speaker.name}
                                            </span>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
