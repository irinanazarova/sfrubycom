---
import { getAllStartups } from '../data/startups.js';
import { getSpeaker } from '../data/speakers.js';

const startups = getAllStartups();
---

<section id="startup-demos" class="py-20 bg-dark-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-dark-900">
                Ruby Startup <span class="text-ruby-500">Demos</span>
            </h2>
            <p class="mt-4 text-xl text-dark-600 max-w-3xl mx-auto">
                See how Ruby powers the next generation of innovative startups and products
            </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-8 mb-12">
            {startups.map((startup) => {
                const speaker = getSpeaker(startup.speakerId);
                return (
                    <a
                        href={startup.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-white border rounded-lg p-6 transition-all duration-300 transform hover:scale-105 hover:shadow-lg"
                    >
                        <div class="flex flex-col items-center">
                            <div class="h-16 w-16 mb-4 flex items-center justify-center">
                                <img
                                    src={startup.logo}
                                    alt={`${startup.name} logo`}
                                    class="max-h-full max-w-full object-contain"
                                    loading="lazy"
                                />
                            </div>
                            <h3 class="font-bold text-dark-900 mb-2 text-center">
                                {startup.name}
                            </h3>
                            <p class="text-sm text-dark-600 text-center mb-3 line-clamp-2">
                                {startup.description}
                            </p>
                            {speaker && (
                                <div class="flex flex-col items-center text-xs text-dark-500">
                                    <span class="mb-1">Founded by</span>
                                    <span class="font-medium">{speaker.name}</span>
                                </div>
                            )}
                            <div class="mt-3 px-3 py-1 bg-ruby-100 text-ruby-600 text-xs rounded-full">
                                {startup.category}
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>

        <div class="bg-gradient-to-r from-ruby-100 to-cloud-100 rounded-lg p-8">
            <div class="text-center">
                <h3 class="text-xl font-display font-bold text-dark-900 mb-4">
                    Startup Demo Sessions
                </h3>
                <p class="text-dark-600 mb-6 max-w-2xl mx-auto">
                    Join our dedicated startup demo sessions where founders will showcase their Ruby-powered products,
                    share their technical journey, and discuss building companies with Rails.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <div class="bg-white px-4 py-2 rounded-md shadow-sm">
                        <div class="font-bold text-ruby-500">Day 1</div>
                        <div class="text-sm text-dark-600">3:00 - 4:00 PM</div>
                    </div>
                    <div class="bg-white px-4 py-2 rounded-md shadow-sm">
                        <div class="font-bold text-ruby-500">Day 2</div>
                        <div class="text-sm text-dark-600">1:00 - 2:30 PM</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-12">
            <a
                href="/startup-demos"
                class="inline-flex items-center justify-center px-8 py-3 bg-ruby-500 border border-ruby-500 text-white rounded-md font-medium shadow-md transition-all duration-300 transform hover:shadow-glow hover:scale-105"
            >
                View All Demos
            </a>
        </div>
    </div>
</section>
