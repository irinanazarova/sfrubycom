---
import type { NewsItem } from "../utils/types";
import Badge from "./Badge.astro";
import { formatDate } from "../utils/helpers";

interface Props {
    news: NewsItem;
}

const { news } = Astro.props;

const categoryColors: Record<string, string> = {
    Funding: "success",
    Release: "info",
    Press: "default",
    Acquisition: "warning",
    Hiring: "success",
    Event: "ruby",
};

const variant = categoryColors[news.category] || "default";
---

<a
    href={news.link}
    target="_blank"
    rel="noopener noreferrer"
    class="block bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg hover:border-ruby-200 transition-all duration-300 group"
>
    <div class="flex items-start justify-between gap-4 mb-3">
        <Badge variant={variant}>{news.category}</Badge>
        <time class="text-xs text-gray-500 flex-shrink-0">{formatDate(news.date)}</time>
    </div>

    <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-ruby-500 transition-colors line-clamp-2">
        {news.headline}
    </h3>

    <p class="text-gray-600 text-sm line-clamp-2 mb-3">{news.summary}</p>

    <div class="flex items-center justify-between text-xs text-gray-500">
        <div class="flex items-center gap-2">
            {news.startupName && (
                <span class="font-medium text-gray-700">{news.startupName}</span>
            )}
            {news.source && (
                <span class="text-gray-400">via {news.source}</span>
            )}
        </div>
        <svg class="w-4 h-4 text-ruby-400 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
    </div>
</a>
