---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
        "px-btn px-font text-[0.625rem] gap-3 px-6 py-3.5 text-white",
        platformStyles[platform],
        className,
    ]}
>
    {platformIcons[platform] && <Fragment set:html={platformIcons[platform]} />}
    <slot name="icon" />
    <slot />
</a>
