---
/**
 * SocialLink Component
 *
 * A consistent button-style link for social media and external platforms.
 * All social links have the same height and padding for visual consistency.
 *
 * @example Basic usage:
 * <SocialLink platform="slack" href="https://slack.com/invite">Join Slack</SocialLink>
 *
 * @example With custom icon:
 * <SocialLink platform="custom" href="/link" color="#123456">
 *   <svg slot="icon">...</svg>
 *   Custom Link
 * </SocialLink>
 */

interface Props {
    platform:
        | "slack"
        | "substack"
        | "twitter"
        | "bluesky"
        | "linkedin"
        | "youtube"
        | "ruby" // Ruby-branded (ruby-500)
        | "dark" // Dark gray
        | "gradient"; // Ruby gradient (for primary CTA)
    href: string;
    class?: string;
}

const { platform, href, class: className = "" } = Astro.props;

const platformStyles: Record<string, string> = {
    slack: "bg-[#4A154B] hover:bg-[#3e1240]",
    substack: "bg-[#c24e00] hover:bg-[#a84400]",
    twitter: "bg-black hover:bg-gray-800",
    bluesky: "bg-[#0060bf] hover:bg-[#004d99]",
    linkedin: "bg-[#0A66C2] hover:bg-[#084d94]",
    youtube: "bg-[#FF0000] hover:bg-[#cc0000]",
    ruby: "bg-ruby-500 hover:bg-ruby-600",
    dark: "bg-gray-700 hover:bg-gray-600",
    gradient:
        "bg-ruby-500 hover:bg-ruby-400",
};

// Platform icons (inline SVGs for common platforms)
const platformIcons: Record<string, string> = {
