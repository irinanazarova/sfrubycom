---
/**
 * TalkModal - Native HTML dialog element for displaying talk details
 * Uses the native <dialog> element for better accessibility and performance
 */
---

<dialog id="talkModal" class="talk-modal">
    <div class="modal-panel">
        <div id="modalContent" class="modal-content">
            <!-- Content will be dynamically inserted here -->
        </div>
    </div>
</dialog>

<style>
    /* CSS variables for dynamic viewport height */
    :root {
        --modal-viewport-height: 100vh;
    }

    @supports (height: 100dvh) {
        :root {
            --modal-viewport-height: 100dvh;
        }
    }

    .talk-modal {
        /* Force dialog to appear - Safari fix */
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        padding: 0;
        margin: 0;
        border: none;
        background: transparent;
        z-index: 9999;
        /* Hide by default */
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    .talk-modal[open] {
        /* Show when open */
        opacity: 1 !important;
        pointer-events: auto !important;
        visibility: visible !important;
        animation: fadeIn 0.2s ease-out;
    }

    .talk-modal::backdrop {
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        animation: fadeIn 0.2s ease-out;
        z-index: 9998;
    }

    .modal-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 80rem;
        max-height: 90vh;
        width: 90vw;
        background: white;
        border-radius: 0.75rem;
        box-shadow:
            0 20px 25px -5px rgba(0, 0, 0, 0.1),
            0 10px 10px -5px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .modal-content {
        max-height: 90vh;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    /* Smooth scrolling within modal */
    .modal-content {
        scroll-behavior: smooth;
    }

    /* Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* Mobile responsive */
    @media (max-width: 640px) {
        .modal-panel {
            width: 100vw;
            max-width: 100vw;
            height: var(--modal-viewport-height);
            border-radius: 0;
            top: 0;
            left: 0;
            transform: none;
        }

        .modal-content {
            height: var(--modal-viewport-height);
            padding: 0;
            -webkit-overflow-scrolling: touch;
        }

        .modal-content > div {
            padding-top: max(env(safe-area-inset-top), 1rem);
            padding-bottom: max(env(safe-area-inset-bottom), 2rem);
        }
    }

    /* Improve scrollbar styling */
    .modal-content::-webkit-scrollbar {
        width: 8px;
    }

    .modal-content::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .modal-content::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }

    .modal-content::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>

<script>
    /**
     * Safari-compatible dialog modal manager
     * Uses native dialog with fallback for Safari issues
     */

    // Ensure script runs after DOM is fully loaded
    function initializeModal() {
        const modal = document.getElementById("talkModal") as HTMLDialogElement;
        const modalContent = document.getElementById("modalContent");

        if (!modal || !modalContent) {
            console.error("Modal elements not found");
            return;
        }

        console.log("TalkModal: Initializing modal", { modal, modalContent });

        /**
         * Open modal with Safari-compatible approach
         */
        function openModal() {
            console.log("TalkModal: openModal called", {
                modalExists: !!modal,
                modalOpen: modal?.open,
                hasShowModal: typeof modal?.showModal === "function",
            });

            if (!modal) {
                console.error("TalkModal: Modal element not found");
                return;
            }

            try {
                // Force visibility for Safari
                modal.style.display = "block";
                modal.style.visibility = "visible";
                modal.style.opacity = "1";
                modal.style.pointerEvents = "auto";

                // Force positioning
                modal.style.position = "fixed";
                modal.style.zIndex = "9999";

                if (typeof modal.showModal === "function") {
                    modal.showModal();
                    console.log("TalkModal: showModal() called successfully", {
                        modalOpen: modal.open,
                        computedDisplay: window.getComputedStyle(modal).display,
                        computedVisibility:
                            window.getComputedStyle(modal).visibility,
                        computedZIndex: window.getComputedStyle(modal).zIndex,
                    });
                } else {
                    // Fallback for browsers that don't support dialog
                    console.warn(
                        "TalkModal: showModal not supported, using fallback",
                    );
                    modal.setAttribute("open", "");
                    modal.style.display = "block";
                }

                document.body.classList.add("modal-open");

                // Scroll modal content to top when opening - use requestAnimationFrame for reliability
                requestAnimationFrame(() => {
                    if (modalContent) {
                        modalContent.scrollTop = 0;
                    }
                });

                console.log("TalkModal: Modal should now be visible", {
                    hasOpenAttr: modal.hasAttribute("open"),
                    openProp: modal.open,
                });
            } catch (error) {
                console.error("TalkModal: Error opening modal:", error);
                // Fallback
                modal.setAttribute("open", "");
                modal.style.display = "block";
                modal.style.visibility = "visible";
                modal.style.opacity = "1";
                document.body.classList.add("modal-open");
            }
        }

        /**
         * Close modal
         */
        function closeModal() {
            console.log("TalkModal: closeModal called");

            if (!modal) return;

            try {
                if (modal.open && typeof modal.close === "function") {
                    modal.close();
                } else {
                    modal.removeAttribute("open");
                }

                // Clear all inline styles that were set during open
                modal.style.display = "";
                modal.style.visibility = "";
                modal.style.opacity = "";
                modal.style.pointerEvents = "";
                modal.style.position = "";
                modal.style.zIndex = "";

                document.body.classList.remove("modal-open");

                // Clear URL hash
                history.pushState(
                    "",
                    document.title,
                    window.location.pathname + window.location.search,
                );
            } catch (error) {
                console.error("TalkModal: Error closing modal:", error);
                modal.removeAttribute("open");
                modal.style.display = "";
                modal.style.visibility = "";
                modal.style.opacity = "";
                modal.style.pointerEvents = "";
                document.body.classList.remove("modal-open");
            }
        }

        /**
         * Set modal content
         */
        function setModalContent(html: string) {
            console.log("TalkModal: setModalContent called");

            if (!modalContent) {
                console.error("TalkModal: modalContent not found");
                return;
            }

            modalContent.innerHTML = html;

            // Immediate scroll to ensure starting position
            modalContent.scrollTop = 0;

            // Attach close button handler to newly created button
            const closeBtn = modalContent.querySelector("#modalCloseBtn");
            if (closeBtn) {
                closeBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    closeModal();
                });
                console.log("TalkModal: Close button handler attached");
            } else {
                console.warn("TalkModal: Close button not found in content");
            }
        }

        // Handle ESC key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal.open) {
                closeModal();
            }
        });

        modal.addEventListener("close", () => {
            document.body.classList.remove("modal-open");
        });

        // Handle backdrop click to close
        modal.addEventListener("click", (e) => {
            // Check if click is on the modal panel (the white content area)
            const modalPanel = modal.querySelector(
                ".modal-panel",
            ) as HTMLElement;
            if (modalPanel && !modalPanel.contains(e.target as Node)) {
                // Click was on backdrop, not the panel
                closeModal();
            }
        });

        // Export functions to window - with explicit logging
        (window as any).showTalkModal = openModal;
        (window as any).hideTalkModal = closeModal;
        (window as any).setTalkModalContent = setModalContent;

        console.log("TalkModal: Functions exported to window", {
            showTalkModal: typeof (window as any).showTalkModal,
            hideTalkModal: typeof (window as any).hideTalkModal,
            setTalkModalContent: typeof (window as any).setTalkModalContent,
        });
    }

    // Run immediately if DOM is ready, otherwise wait
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeModal);
    } else {
        initializeModal();
    }
</script>

<style is:global>
    /* Prevent body scroll when modal is open */
    body.modal-open {
        overflow: hidden;
    }
</style>
