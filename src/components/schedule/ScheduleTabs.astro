---
/**
 * ScheduleTabs - Day navigation tabs using CSS :target
 * Minimal JS, CSS-driven tab switching, compact design
 */

interface Props {
    days: Array<{
        date: string;
        dayLabel: string;
        dayNumber: number;
    }>;
}

const { days } = Astro.props;
---

<nav id="dayNavigation" class="day-navigation">
    <div class="day-nav-container">
        <!-- Draft Version Ribbon -->
        <div class="draft-ribbon">Submit an event!</div>

        <div class="tabs-wrapper">
            {
                days.map((day, index) => (
                    <a
                        href={`#day${day.dayNumber}`}
                        class="schedule-tab"
                        data-day-index={index}
                    >
                        <div class="tab-label">{day.dayLabel}</div>
                        <div class="tab-date">
                            {day.date
                                .split(",")[0]
                                .replace("November ", "Nov ")}
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</nav>

<style>
    .day-navigation {
        position: sticky;
        top: 80px;
        z-index: 40;
        margin-bottom: 0;
        transition: all 0.3s ease;
    }

    .day-nav-container {
        background: linear-gradient(
            to bottom,
            rgba(243, 244, 246, 1),
            rgba(243, 244, 246, 0.95)
        );
        border-radius: 0.75rem;
        padding: 0.5rem;
        display: flex;
        gap: 0.5rem;
        position: relative;
        backdrop-filter: blur(8px);
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }

    .draft-ribbon {
        position: absolute;
        right: -0.5rem;
        top: -0.5rem;
        background: rgb(59, 130, 246);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transform: rotate(12deg);
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        z-index: 10;
        white-space: nowrap;
    }

    .tabs-wrapper {
        display: flex;
        gap: 0.5rem;
        width: 100%;
    }

    .schedule-tab {
        flex: 1;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: rgb(55, 65, 81);
        background: transparent;
        border: 2px solid transparent;
    }

    .schedule-tab:hover {
        background: white;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    /* Active state - managed by JS */
    .schedule-tab.active {
        background: linear-gradient(
            to right,
            rgb(239, 68, 68),
            rgb(236, 72, 153)
        );
        color: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .tab-label {
        font-weight: 700;
        font-size: 0.875rem;
        margin-bottom: 0.125rem;
        font-family: "Martian Grotesk", sans-serif;
    }

    .tab-date {
        font-size: 0.625rem;
        opacity: 0.9;
    }

    /* Mobile responsive - single row */
    @media (max-width: 640px) {
        .day-navigation {
            top: 60px;
            margin-bottom: 0;
        }

        .day-nav-container {
            padding: 0.375rem;
        }

        .tabs-wrapper {
            gap: 0.375rem;
        }

        .schedule-tab {
            padding: 0.5rem 0.5rem;
        }

        .tab-label {
            font-size: 0.75rem;
            margin-bottom: 0.125rem;
        }

        .tab-date {
            font-size: 0.5rem;
        }

        .draft-ribbon {
            font-size: 0.5rem;
            padding: 0.125rem 0.5rem;
            right: -0.25rem;
            top: -0.375rem;
        }
    }
</style>

<script>
    /**
     * Minimal JS - sticky positioning and active tab highlighting
     */
    document.addEventListener("DOMContentLoaded", () => {
        const dayNav = document.getElementById("dayNavigation");
        const mainNav = document.querySelector("header.fixed") as HTMLElement;
        const tabs = document.querySelectorAll(".schedule-tab");

        // Adjust sticky position based on main nav height
        if (dayNav && mainNav) {
            const updateStickyPosition = () => {
                dayNav.style.top = `${mainNav.offsetHeight}px`;
            };

            updateStickyPosition();
            window.addEventListener("resize", updateStickyPosition);
        }

        // Update active tab based on current hash
        function updateActiveTab() {
            const hash = window.location.hash || "#day3";
            tabs.forEach((tab) => {
                if ((tab as HTMLAnchorElement).getAttribute("href") === hash) {
                    tab.classList.add("active");
                } else {
                    tab.classList.remove("active");
                }
            });
        }

        // Set initial active state
        updateActiveTab();

        // Update on hash change
        window.addEventListener("hashchange", updateActiveTab);
    });
</script>
