---
import { conference2026SponsorTiers } from "../data/sponsors.js";

// Logo cards scale with the tier, so the row a sponsor lands in reads as the
// thing they paid for. Sizes come from `size` on each tier in data/sponsors.js.
// Class strings are spelled out in full so Tailwind's scanner sees them.
// A very wide lockup (mark + two words on one line) comes out twice the width of
// a one-word logo at the same height, and dwarfs its own tier. `wideLockup` on a
// sponsor caps that one logo's width instead; it then sits shorter than its row,
// which is the trade for a row that reads evenly. The class lives here, not in
// the data file, because the scanner only sees what is spelled out in a template.
const WIDE_LOCKUP = "max-w-[16rem]";

// Every tier heading is the same size. The logo and card sizes carry the
// hierarchy; a heading a pixel smaller than the one beside it in a shared
// row just read as sloppy. Colour still marks the tier.
const HEADING = "text-px9 md:text-px10";

// Box height is set per tier, not by the logo size: Pickaxe 128, Ruby 92,
// Emerald 72, every other tier 60. Phones step down so the boxes keep their
// proportion to the smaller logos there.
const BOX = {
    xl: "h-[84px] md:h-[128px]",
    ruby: "h-[72px] md:h-[92px]",
    emerald: "h-[56px] md:h-[72px]",
    rest: "h-[48px] md:h-[60px]",
};
// Padding is what decides where a tier stops wrapping, so it stays lean and the
// logo height carries the hierarchy. At these sizes each tier holds one row from
// 820px on the homepage and 900px on /sponsor-2026, and stacks below that.
const SIZES = {
    xl: {
        card: "px-8",
        logo: "h-9 md:h-14",
    },
    lg: {
        card: "px-6",
        logo: "h-8 md:h-11",
    },
    md: {
        // Two-up on phones. Letting these size to their logos leaves cards of
        // 141-163px against a ~318px row, so they wrap one per screen; a
        // half-width basis (minus half the 1rem gap) fits two whatever the
        // next logo's aspect ratio turns out to be.
        card: "basis-[calc(50%-0.5rem)] grow-0 justify-center sm:basis-auto px-4 sm:px-5",
        logo: "h-6 md:h-8",
    },
    // The two smallest tiers (Travel, Media) sit under Emerald and are priced
    // under it, so each step down is a step down in logo height as well.
    sm: {
        card: "px-4 sm:px-5",
        logo: "h-5 md:h-7",
    },
    xs: {
        card: "px-3 sm:px-4",
        logo: "h-5 md:h-6",
    },
};

const unsized = conference2026SponsorTiers.filter((t) => !SIZES[t.size]);
if (unsized.length) {
    // Falling back to a default would render a new Pickaxe tier at Emerald size:
    // the top of the paid hierarchy drawn as the bottom, with nothing to notice it.
    throw new Error(
        `SponsorTiers: set size (${Object.keys(SIZES).join("/")}) on ${unsized
            .map((t) => t.tier)
            .join(", ")} in data/sponsors.js`,
    );
}

// Consecutive tiers marked `shareRow` (the single-sponsor Coffee, Passport and Speaker Dinner
// tiers) render side by side in one row, each under its own heading, instead
// of one lonely card per band. They stack again on phones.
const groups = conference2026SponsorTiers.reduce((acc, tier) => {
    const last = acc.at(-1);
    if (tier.shareRow && last?.shared) last.tiers.push(tier);
    else acc.push({ shared: !!tier.shareRow, tiers: [tier] });
    return acc;
}, []);
---

<div class="space-y-10">
    {
        groups.map((group) => (
            <div class:list={[group.shared && "flex flex-wrap justify-center gap-x-12 gap-y-10"]}>
        {group.tiers.map((tier) => {
            const size = SIZES[tier.size];
            const box = BOX[tier.box ?? "rest"];
            return (
                <div class:list={[group.shared && "flex flex-col"]}>
                    <h3
                        class={`px-font ${HEADING} ${tier.headingClass} text-center mb-5`}
                    >
                        {tier.tier}
                    </h3>
                    <div
                        class:list={[
                            "flex flex-wrap justify-center gap-4 md:gap-6",
                            // Tiers sharing a row are stretched to a common
                            // height by the group, so the cards fill it and
                            // their boxes line up. The logos keep their own
                            // tier size, which is what carries the hierarchy.
                            "items-center",
                        ]}
                    >
                        {tier.sponsors.map((sponsor) => (
                            <a
                                href={sponsor.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`px-card bg-white ${size.card} ${box} inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform`}
                            >
                                <img
                                    src={sponsor.logo}
                                    alt={sponsor.name}
                                    class={`${size.logo} w-auto object-contain ${sponsor.wideLockup ? WIDE_LOCKUP : "max-w-full"}`}
                                    width={sponsor.logoWidth}
                                    height={sponsor.logoHeight}
                                    loading="lazy"
                                />
                            </a>
                        ))}
                    </div>
                </div>
            );
        })}
            </div>
        ))
    }
</div>
