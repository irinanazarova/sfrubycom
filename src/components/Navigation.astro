---
const navItems = [
    // { name: 'Home', href: '/' },
    // { name: 'Schedule', href: '/schedule' },
    { name: "Speakers", href: "/speakers" },
    { name: "Sponsors", href: "/sponsors" },
    { name: "About", href: "/about" },
];
---

<header class="fixed w-full z-50 transition-all duration-300 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <a
                href="/"
                class="font-display font-bold text-xl md:text-2xl text-ruby-500"
            >
                <img
                    src="/sfruby_letters_black.png"
                    class="object-contain w-24 h-10"
                />
            </a>

            <!-- Desktop navigation -->
            <nav class="hidden md:flex items-center space-x-8">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="font-medium text-cloud-900 hover:text-ruby-400 transition-colors duration-200"
                        >
                            {item.name}
                        </a>
                    ))
                }
                <!-- <a
          href="#newsletter"
          class="px-4 py-2 rounded-md bg-ruby-500 text-cloud-500 font-medium hover:bg-ruby-600 transition-colors duration-200"
        >
          Sign up
        </a>-->
            </nav>

            <!-- Mobile menu button -->
            <button
                id="mobile-menu-button"
                class="md:hidden flex items-center text-sky-800"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile navigation -->
    <div
        id="mobile-menu"
        class="hidden md:hidden bg-cloud-100 shadow-lg absolute w-full"
    >
        <div class="px-2 pt-2 pb-3 space-y-1">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="block px-3 py-2 rounded-md text-base font-medium text-sky-800 hover:text-ruby-500 hover:bg-ruby-50 transition-all duration-200"
                    >
                        {item.name}
                    </a>
                ))
            }
            <!--<a
        href="/#newsletter"
        class="block px-3 py-2 rounded-md text-base font-medium bg-ruby-500 text-cloud-500 hover:bg-ruby-600"
      >
        Sign up
      </a>-->
        </div>
    </div>
</header>

<script>
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuButton?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    // Close mobile menu when clicking outside
    document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (
            mobileMenu &&
            !mobileMenu.classList.contains("hidden") &&
            mobileMenuButton &&
            !mobileMenuButton.contains(target) &&
            !mobileMenu.contains(target)
        ) {
            mobileMenu.classList.add("hidden");
        }
    });

    // Header background on scroll
    const header = document.querySelector("header");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            header?.classList.remove("bg-transparent");
            header?.classList.add(
                "bg-cloud-500/95",
                "backdrop-blur-sm",
                "shadow-md",
            );
        } else {
            header?.classList.add("bg-transparent");
            header?.classList.remove(
                "bg-cloud-500/95",
                "backdrop-blur-sm",
                "shadow-md",
            );
        }
    });
</script>