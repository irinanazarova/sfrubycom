---
import { getJobsBySponsor } from "../data/jobs.js";

interface Host {
    id: string;
    name: string;
    logo: string;
    url: string;
    summary: string;
    rubyConnection: string;
    tag: string;
    sponsorId?: string;
}

interface Props {
    host: Host;
}

const { host } = Astro.props;

const jobs = host.sponsorId ? getJobsBySponsor(host.sponsorId) : [];
---

<a
    href={host.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative bg-white rounded-2xl border border-gray-100 overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-gray-200 hover:-translate-y-0.5 flex flex-col"
>
    <!-- Tag -->
    <div class="px-4 pt-3 pb-1 flex items-center justify-between">
        <span
            class:list={[
                "px-2 py-0.5 text-xs font-bold rounded-md",
                host.tag === "Built with Rails" || host.tag === "Built with Ruby"
                    ? "bg-red-50 text-red-700"
                    : host.tag === "Ruby SDK"
                      ? "bg-purple-50 text-purple-700"
                      : "bg-amber-50 text-amber-700",
            ]}
        >
            {host.tag}
        </span>
        {
            jobs.length > 0 && (
                <span class="px-2 py-0.5 bg-emerald-500 text-white text-xs font-bold rounded-md">
                    Hiring
                </span>
            )
        }
    </div>

    <!-- Logo -->
    <div class="px-4 py-4 flex items-center justify-center h-28">
        <img
            src={host.logo}
            alt={host.name}
            class="w-full h-full object-contain group-hover:scale-105 transition-transform"
            loading="lazy"
        />
    </div>

    <!-- Content -->
    <div class="px-4 pb-4 pt-1 flex flex-col flex-1">


        <p class="text-xs text-gray-500mt-auto">{host.rubyConnection}</p>
    </div>

    <!-- Jobs footer -->
    {
        jobs.length > 0 && (
            <div class="border-t border-gray-100 px-4 py-2.5 bg-gray-50/50">
                <div class="flex items-center gap-1.5 text-xs text-emerald-700 font-medium">
                    <svg
                        class="w-3.5 h-3.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        />
                    </svg>
                    {jobs.length} open {jobs.length === 1 ? "role" : "roles"}
                </div>
            </div>
        )
    }
</a>
