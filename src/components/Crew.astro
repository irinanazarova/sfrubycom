---
// Organizers and volunteers: everyone on an organizer or volunteer ticket on
// Luma, on two floating islands at dusk, the same way the companies stand on
// theirs. The snapshot is src/content/crew-2026.json (see the fetch script);
// a person without a Cloud Card yet stands in as the CFP-poster chibi, so
// the roll is complete on the day the ticket is issued, not the day the
// character is drawn.
import crew from "../content/crew-2026.json";

const groups = [
    { label: "Organizers", people: crew.organizers ?? [] },
    { label: "Volunteers", people: crew.volunteers ?? [] },
].filter((g) => g.people.length);
---

{
    groups.length > 0 && (
        <section id="crew" class="relative overflow-hidden pt-20 pb-28 md:pt-24 md:pb-32 px-sky-grad-dusk border-t-4 border-ink text-white">
            <img src="/px-cloud-lg.png" alt="" width="72" height="28" class="px-pixelated absolute top-16 left-[5%] w-40 md:w-60 animate-float pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud-md.png" alt="" width="48" height="20" class="px-pixelated absolute top-24 right-[7%] w-28 md:w-44 animate-float [animation-delay:-3s] pointer-events-none" aria-hidden="true" />
            <img src="/px-cloud.png" alt="" width="34" height="14" class="px-pixelated absolute bottom-24 left-[3%] w-20 md:w-28 animate-float [animation-delay:-1.5s] pointer-events-none hidden lg:block" aria-hidden="true" />
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="max-w-2xl mx-auto text-center">
                    <span class="px-plate px-font text-px8 px-3 py-1.5">The people running it</span>
                    <h2 class="px-font px-shadow-ink text-lg md:text-2xl text-gold-400 mt-6">
                        Organizers and volunteers
                    </h2>
                    <p class="text-base md:text-lg text-white px-shadow-ink-sm leading-relaxed mt-5">
                        Say hi at SFJAZZ. They know where everything is.
                    </p>
                </div>

                <ul class="mt-12 flex flex-wrap justify-center items-end gap-x-10 gap-y-12 list-none p-0 m-0">
                    {groups.map((g, i) => (
                        <li class="flex flex-col items-center animate-float min-w-[10rem]" style={`animation-delay: ${i ? "-2.5s" : "0s"}`}>
                            <span class="px-plate px-plate--gold px-font text-px8 px-2.5 py-1 mb-3">{g.label}</span>
                            <div class="relative z-10 flex flex-wrap items-end justify-center gap-1 max-w-[30rem] px-4 -mb-1.5">
                                {g.people.map((p) =>
                                    p.image ? (
                                        <a href={p.url} target="_blank" rel="noopener noreferrer" class="block tap-press" title={p.name} aria-label={`${p.name}'s Cloud Card`}>
                                            <img src={p.image} alt={p.name} width="73" height="128" loading="lazy" decoding="async" class="px-pixelated h-14 md:h-16 w-auto" />
                                        </a>
                                    ) : (
                                        <img src="/px-human.png" alt={p.name} width="21" height="41" title={p.name} class="px-pixelated h-14 md:h-16 w-auto" />
                                    ),
                                )}
                            </div>
                            <div class="w-0 min-w-full">
                                <img src="/px-island.png" alt="" width="598" height="104" class="px-pixelated w-full h-auto" />
                            </div>
                            <p class="font-mono text-xs text-white/90 px-shadow-ink-sm text-center leading-relaxed mt-3 max-w-[30rem]">
                                {g.people.map((p) => p.name).join(" · ")}
                            </p>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- crenellated step into the community strip -->
            <div class="px-crenel absolute bottom-0 left-0 w-full [--px-crenel-color:var(--white)]" aria-hidden="true"></div>
        </section>
    )
}
