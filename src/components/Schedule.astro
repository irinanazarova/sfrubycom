---
// The 2026 schedule as a homepage section, rendered from
// src/data/schedule-2026.js. One stage, two audiences: each talks block shows
// who is in the hall and, beside it, the conversation group the other audience
// is in at the same time. It used to be its own page; /schedule now redirects
// to /#schedule, and the 2025 schedule lives on at /schedule-2025.
//
// Every talk slot is a button that opens the speaker's full card (the same
// SpeakerProfile /speakers renders) in a native <dialog>. The open card is in
// the URL as ?speaker=<key>, so a slot can be shared and reopens on load.
import SpeakerProfile from "./SpeakerProfile.astro";
import {
    AUDIENCES,
    days,
    formatTime,
    formatRange,
    formatDay,
} from "../data/schedule-2026.js";
import { conferenceSpeakers, cfpNameAliases } from "../data/conference-2026.js";
import { speakerKey } from "../utils/cfpTalks.js";
import { buildProfiles } from "../utils/speakerProfiles.js";
import cfpTalks from "../content/cfp-talks.json";

const { profiles } = buildProfiles(cfpTalks, conferenceSpeakers, cfpNameAliases);
const profileByKey = new Map(profiles.map((p) => [p.key, p]));
// A slot opens a dialog only for a speaker on the roster; a name the roster
// lacks (a withdrawn talk still on the sheet, say) renders as plain text.
const profileFor = (name) => profileByKey.get(speakerKey(name)) ?? null;

// One dialog per scheduled speaker. Both the row and the card read the title
// off the profile, where the CFP feed has already won over the placeholder,
// so a slot and the card it opens can never print different names.
const dialogs = new Map();
for (const d of days)
    for (const b of d.blocks)
        for (const sess of b.sessions ?? []) {
            if (sess.tba) continue;
            const profile = profileFor(sess.speaker);
            if (profile && !dialogs.has(profile.key))
                dialogs.set(profile.key, profile);
        }
const plateClass = (audience) =>
    audience === "household" ? "px-plate--gold" : audience === "all" ? "px-plate--orange" : "";
const audienceLabel = (audience) => AUDIENCES[audience]?.label ?? "";
const breakLabel = { break: "Break", lunch: "Lunch" };

// Absolute times for the "now on stage" state. The conference is in
// November, after the DST switch, so Pacific is -08:00 on every day.
const PT_OFFSET = "-08:00";
const at = (d, hm) => `${d.date}T${hm.padStart(5, "0")}:00${PT_OFFSET}`;

---

<section id="schedule" class="py-20 md:py-24 lg:pt-12 bg-sky-50 border-t-4 border-ink">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
            <span class="px-plate px-font text-px8 px-3 py-1.5">Nov 10-12 · SFJAZZ</span>
            <h2 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                The schedule
            </h2>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-5">
                While
                <span class="px-plate px-font text-px8 px-2 py-1 mx-1">Small teams</span>
                are in a talk,
                <span class="px-plate px-plate--gold px-font text-px8 px-2 py-1 mx-1">Big teams</span>
                are in a conversation group, then they swap.
            </p>
        </div>
        {/* The day tabs switch the day shown (one day at a time halves the
            section on a phone) and stay pinned under the header while the
            schedule scrolls, so a reader deep in Day 2 still knows it is
            Day 2. Without JS every day renders and the tabs are anchors.
            One row on phones too: "Day 1 · Nov 10" three times is wider than
            390px, so there the date stacks under the day. */}
        <div class="sticky top-[5.25rem] z-20 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 mt-8 py-3 bg-sky-50">
            <nav class="max-w-2xl mx-auto grid grid-cols-3 gap-2 sm:flex sm:justify-center sm:gap-3" aria-label="Days" data-day-tabs>
                {
                    days.map((d) => (
                        <a
                            href={`#day${d.n}`}
                            data-day-tab={d.n}
                            class="day-tab px-btn px-btn--white px-font text-px8 md:text-px9 px-2 sm:px-4 py-2 sm:py-3 !gap-1.5 sm:!gap-2.5 tap-press text-center flex-col sm:flex-row"
                        >
                            <span class="block sm:inline">Day {d.n}</span><span class="hidden sm:inline">·</span><span class="block sm:inline">{formatDay(d)}</span>
                        </a>
                    ))
                }
            </nav>
        </div>

    {
        days.map((d) => (
            <div id={`day${d.n}`} data-day={d.n} data-date={d.date} class="schedule-day mt-10 scroll-mt-[11.5rem]">
                <div>
                    <p class="px-font text-px9 md:text-px10 text-ruby-600">
                        Day {d.n} · {d.weekday}, {formatDay(d)}
                    </p>
                    <h3 class="px-font text-base md:text-xl text-gray-900 mt-4">
                        {d.theme}
                    </h3>
                    <p class="text-gray-600 mt-3 max-w-2xl">{d.tagline}</p>
                    {d.links && (
                        <div class="mt-6 flex flex-col sm:flex-row gap-3">
                            {d.links.map((l) => (
                                <a
                                    href={l.href}
                                    target={l.external ? "_blank" : undefined}
                                    rel={l.external ? "noopener noreferrer" : undefined}
                                    class="px-btn px-btn--sky px-font text-px8 md:text-px9 px-5 py-3 tap-press"
                                >
                                    {l.label}
                                </a>
                            ))}
                        </div>
                    )}

                    {d.blocks.length > 0 && (
                        <ol class="mt-10 flex flex-col gap-4 list-none p-0">
                            {d.blocks.map((b) =>
                                b.kind === "break" || b.kind === "lunch" ? (
                                    <li class="flex items-baseline gap-4 px-1 text-sm text-gray-500" data-start={at(d, b.start)} data-end={at(d, b.end)}>
                                        <span class="font-mono shrink-0 w-32">
                                            {formatTime(b.start)}
                                        </span>
                                        <span class="px-font text-px9">
                                            {breakLabel[b.kind]}
                                        </span>
                                    </li>
                                ) : (
                                    <li
                                        class:list={[
                                            "schedule-block px-card bg-white",
                                            b.group && "grid md:grid-cols-[1fr_16rem]",
                                        ]}
                                        data-start={at(d, b.start)}
                                        data-end={at(d, b.end)}
                                    >
                                        <div class="p-5 md:p-6">
                                            <div class="flex flex-wrap items-center gap-3">
                                                <span class="font-mono text-sm text-gray-500">
                                                    {formatRange(b.start, b.end)}
                                                </span>
                                                <span class={`px-plate ${plateClass(b.audience)} px-font text-px8 px-2 py-1`}>
                                                    {b.kind === "keynote" ? "Keynote · Everyone" : audienceLabel(b.audience)}
                                                </span>
                                                <span class="live-plate px-plate px-plate--ruby px-font text-px8 px-2 py-1" hidden>
                                                    <span class="px-blink" aria-hidden="true">&#9654;&#xFE0E; </span>On stage now
                                                </span>
                                            </div>
                                            <ul class="mt-5 flex flex-col gap-5 list-none p-0">
                                                {b.sessions.map((s, i) => {
                                                    const profile = s.tba ? null : profileFor(s.speaker);
                                                    const title = profile?.title || s.title;
                                                    const start = s.start ?? b.start;
                                                    const end = b.sessions[i + 1]?.start ?? b.end;
                                                    return (
                                                        <li class="session flex gap-3 sm:gap-4" data-start={at(d, start)} data-end={at(d, end)}>
                                                            {/* On phones the time goes above the title: a time
                                                                column beside the sprite starved the title to
                                                                200px and wrapped it five lines deep. */}
                                                            {s.start && (
                                                                <span class="hidden sm:block font-mono text-xs text-gray-500 shrink-0 w-16 pt-1">
                                                                    {formatTime(s.start)}
                                                                </span>
                                                            )}
                                                            {/* The speaker's sprite, the same one they have in the
                                                                hero's fighter grid (already cached by the time the
                                                                schedule scrolls into view). Sized by height, since
                                                                sprites share a height but not a width. */}
                                                            {profile?.pixel && (
                                                                <button
                                                                    type="button"
                                                                    class="shrink-0 w-10 sm:w-12 -mt-1 tap-press"
                                                                    data-speaker-dialog={profile.key}
                                                                    aria-hidden="true"
                                                                    tabindex="-1"
                                                                >
                                                                    <img src={profile.pixel} alt="" width="256" height="256" loading="lazy" decoding="async" class="px-pixelated block h-10 sm:h-12 w-auto mx-auto" />
                                                                </button>
                                                            )}
                                                            <div class="min-w-0">
                                                            {s.start && (
                                                                <span class="sm:hidden block font-mono text-xs text-gray-500 mb-1">
                                                                    {formatTime(s.start)}
                                                                </span>
                                                            )}
                                                            {s.tba ? (
                                                                <p class="font-display font-semibold text-gray-500">
                                                                    To be announced
                                                                </p>
                                                            ) : profile ? (
                                                                <button
                                                                    type="button"
                                                                    class="slot-btn group min-w-0 text-left tap-press"
                                                                    data-speaker-dialog={profile.key}
                                                                    aria-haspopup="dialog"
                                                                    aria-controls={`speaker-${profile.key}`}
                                                                >
                                                                    <span class="block font-display font-semibold text-base md:text-lg text-gray-900 leading-snug group-hover:text-ruby-600 transition-colors">
                                                                        {title}
                                                                    </span>
                                                                    {/* one line on purpose: a line break before the comma renders as a space */}
                                                                    <span class="block text-sm text-gray-600 mt-1.5"><span class="font-medium text-ruby-600 underline-offset-2 group-hover:underline">{s.speaker}</span>, {s.org}</span>
                                                                </button>
                                                            ) : (
                                                                <div class="min-w-0">
                                                                    <p class="font-display font-semibold text-base md:text-lg text-gray-900 leading-snug">
                                                                        {title}
                                                                    </p>
                                                                    <p class="text-sm text-gray-600 mt-1.5"><span class="font-medium text-gray-900">{s.speaker}</span>, {s.org}</p>
                                                                </div>
                                                            )}
                                                            </div>
                                                        </li>
                                                    );
                                                })}
                                            </ul>
                                        </div>
                                        {b.group && (
                                            <aside class="p-5 md:p-6 bg-sky-50 border-t-4 md:border-t-0 md:border-l-4 border-ink">
                                                <p class="px-font text-px9 text-gray-500">Meanwhile</p>
                                                <span class={`px-plate ${plateClass(b.group.audience)} px-font text-px8 px-2 py-1 mt-3 inline-block`}>
                                                    {audienceLabel(b.group.audience)}
                                                </span>
                                                <p class="font-display font-semibold text-gray-900 leading-snug mt-3">
                                                    {b.group.tba ? "Conversation group, to be announced" : b.group.title}
                                                </p>
                                                {(b.group.hosts || b.group.hostTbc) && (
                                                    <p class="text-sm text-gray-600 mt-1.5">
                                                        {b.group.hosts ? `with ${b.group.hosts.join(" and ")}` : "host to be confirmed"}
                                                    </p>
                                                )}
                                                <p class="text-xs text-gray-500 mt-3">
                                                    Conversation group, {formatRange(b.start, b.end)}
                                                </p>
                                            </aside>
                                        )}
                                    </li>
                                ),
                            )}
                        </ol>
                    )}
                    {days[d.n] && (
                        <div class="mt-8 flex justify-center">
                            <a
                                href={`#day${days[d.n].n}`}
                                data-day-next={days[d.n].n}
                                class="px-btn px-btn--white px-font text-px9 px-5 py-3.5 tap-press"
                            >
                                Day {days[d.n].n} · {days[d.n].theme} &rarr;
                            </a>
                        </div>
                    )}
                </div>
            </div>
        ))
    }
    </div>

    {
        [...dialogs.values()].map((profile) => (
            <dialog
                id={`speaker-${profile.key}`}
                class="speaker-dialog"
                aria-label={`${profile.name}, speaker card`}
            >
                {/* tabindex + autofocus: showModal() would otherwise focus the
                    close button and paint its focus ring the moment the card
                    opens. Focus lands on the panel, and Tab reaches the X. */}
                <div class="px-card bg-white relative overflow-hidden flex flex-col outline-none" tabindex="-1" autofocus>
                    {/* Floats over the share card's top-right corner, which
                        the card keeps empty for it: the title runs down the
                        left and the Keynote plate sits in the text column, so
                        this corner is sky on every card. Top-left cannot work,
                        because the poster scales with the dialog and at phone
                        width the title reaches the corner. Small on purpose,
                        with the tap area restored in .close-x below. */}
                    <form method="dialog" class="absolute top-2 right-2 z-20 m-0">
                        <button
                            type="submit"
                            class="px-btn px-btn--white px-font text-px8 close-x w-8 h-8 tap-press"
                            aria-label="Close"
                        >
                            X
                        </button>
                    </form>
                    <SpeakerProfile profile={profile} layout="side" />
                </div>
            </dialog>
        ))
    }
</section>

<style>
    /* Native <dialog>: the top layer sits above the bottom nav and the More
       sheet without joining the z-index ladder. The panel is a px-card; the
       dialog itself is just the frame that positions it and scrolls.
       Phones get a full-width sheet rising from the bottom; from md up it is
       a wide centered card. The speaker's animated share card runs across the
       top of it, with the text underneath. */
    .speaker-dialog {
        padding: 0;
        border: 0;
        background: transparent;
        width: 100%;
        max-width: 100%;
        max-height: 94svh;
        margin: auto 0 0 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .speaker-dialog::backdrop {
        background: rgb(0 0 0 / 0.55);
    }
    .speaker-dialog > .px-card {
        box-shadow: none;
        border-bottom: 0;
        border-left: 0;
        border-right: 0;
        min-height: 100%;
    }
    @media (min-width: 768px) {
        .speaker-dialog {
            width: min(100% - 3rem, 56rem);
            max-height: min(90svh, 100% - 3rem);
            margin: auto;
        }
        /* the card's hard shadow needs room inside the scroll box */
        .speaker-dialog > .px-card {
            box-shadow: 8px 8px 0 0 var(--px-ink);
            border: 4px solid var(--px-ink);
            margin: 0 8px 8px 0;
            min-height: 0;
        }
    }
    /* the panel takes initial focus so the close button does not; it is not
       a control, so the global focus ring stays off it */
    .speaker-dialog > .px-card:focus,
    .speaker-dialog > .px-card:focus-visible {
        outline: none;
        box-shadow: none;
    }
    @media (min-width: 768px) {
        .speaker-dialog > .px-card:focus,
        .speaker-dialog > .px-card:focus-visible {
            box-shadow: 8px 8px 0 0 var(--px-ink);
        }
    }
    /* The close button is drawn at 32px so it clears the share card's title,
       and its chrome is scaled to match: the standard 4px border and 5px
       shadow are built for a button twice this size. The ::after gives back
       the touch target the drawn size gives up, measuring 50px square against
       the 44px minimum. Without it this would be a 32px tap target on a
       phone. Measure it by hit-testing, not by adding up the inset: the two
       do not agree here. */
    .close-x {
        position: relative;
        border-width: 3px;
        box-shadow: 3px 3px 0 0 var(--px-ink);
    }
    .close-x::after {
        content: "";
        position: absolute;
        inset: -14px;
    }
    .close-x:hover {
        box-shadow: 4px 4px 0 0 var(--px-ink);
    }
    .close-x:active {
        transform: translate(3px, 3px);
        box-shadow: 0 0 0 0 var(--px-ink);
    }

    .slot-btn {
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        cursor: pointer;
    }
    body:has(.speaker-dialog[open]) {
        overflow: hidden;
    }

    /* One day at a time once the script runs; without it every day shows. */
    .js-days .schedule-day:not(.is-active) {
        display: none;
    }
    .day-tab.is-active {
        background: var(--px-gold);
    }

    /* On the conference days: the block on stage now, and what is over. */
    .schedule-block.is-live {
        border-color: var(--px-ruby);
        box-shadow: 6px 6px 0 0 var(--px-ruby-dark);
    }
    .session.is-live {
        background: var(--ruby-50);
        outline: 0.5rem solid var(--ruby-50);
    }
    .is-past {
        opacity: 0.55;
    }
</style>

<script>
    // Open a slot's speaker card; keep ?speaker=<key> in the URL so the open
    // card survives a reload and can be shared. Escape and the backdrop close
    // it (the backdrop is the dialog element itself; the card is its child).
    const PARAM = "speaker";

    function dialogFor(key: string | null) {
        if (!key) return null;
        const el = document.getElementById(`speaker-${key}`);
        return el instanceof HTMLDialogElement ? el : null;
    }

    function setParam(key: string | null) {
        const url = new URL(location.href);
        if (key) url.searchParams.set(PARAM, key);
        else url.searchParams.delete(PARAM);
        history.replaceState(history.state, "", url);
    }

    // The speaker's share card is a ~400KB GIF and every scheduled speaker has
    // a dialog in the page, so the src is held back until the card is asked
    // for. Once set it stays set, and the browser caches it from there.
    function loadCard(dialog: HTMLDialogElement) {
        const img = dialog.querySelector<HTMLImageElement>("img[data-card-gif][data-src]");
        if (!img?.dataset.src) return;
        img.src = img.dataset.src;
        img.removeAttribute("data-src");
    }

    function open(key: string) {
        const dialog = dialogFor(key);
        if (!dialog || dialog.open) return;
        loadCard(dialog);
        dialog.showModal();
        dialog.scrollTop = 0;
        setParam(key);
    }

    document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest("[data-speaker-dialog]");
        if (btn instanceof HTMLElement && btn.dataset.speakerDialog) {
            open(btn.dataset.speakerDialog);
            return;
        }
        // a click on the dialog's own box, outside the card, is the backdrop
        if (target instanceof HTMLDialogElement && target.open) target.close();
    });

    for (const dialog of document.querySelectorAll("dialog.speaker-dialog")) {
        dialog.addEventListener("close", () => setParam(null));
    }

    const initial = new URLSearchParams(location.search).get(PARAM);
    if (initial) open(initial);

    // Days: the tabs show one day at a time and stay pinned while the
    // schedule scrolls. #day2 selects a day, and so does ?speaker=<key>
    // (the day of that speaker's slot), and on the conference days the
    // current day opens by itself.
    const section = document.getElementById("schedule");
    const dayEls = [...document.querySelectorAll<HTMLElement>(".schedule-day")];
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>("[data-day-tab]")];

    function showDay(n: number, scroll = false) {
        const day = dayEls.find((el) => el.dataset.day === String(n));
        if (!day) return;
        for (const el of dayEls) el.classList.toggle("is-active", el === day);
        for (const t of tabs) {
            const on = t.dataset.dayTab === String(n);
            t.classList.toggle("is-active", on);
            if (on) t.setAttribute("aria-current", "true");
            else t.removeAttribute("aria-current");
        }
        if (scroll) {
            day.scrollIntoView({ block: "start", behavior: "smooth" });
            history.replaceState(history.state, "", `${location.pathname}${location.search}#day${n}`);
        }
    }

    // "Now" for the live state. ?now=2026-11-10T10:40-08:00 previews it.
    const nowOverride = new URLSearchParams(location.search).get("now");
    const now = () => (nowOverride ? new Date(nowOverride).getTime() : Date.now());
    const ptDate = (t: number) =>
        new Intl.DateTimeFormat("en-CA", { timeZone: "America/Los_Angeles" }).format(t);

    function markLive() {
        const t = now();
        for (const el of section?.querySelectorAll<HTMLElement>("[data-start][data-end]") ?? []) {
            const start = Date.parse(el.dataset.start!);
            const end = Date.parse(el.dataset.end!);
            el.classList.toggle("is-live", t >= start && t < end);
            // a block's sessions dim on their own; the block dims when it is over
            if (!el.classList.contains("session")) el.classList.toggle("is-past", t >= end);
        }
        for (const plate of section?.querySelectorAll<HTMLElement>(".live-plate") ?? [])
            plate.hidden = !plate.closest(".schedule-block")?.classList.contains("is-live");
    }

    if (section && dayEls.length) {
        section.classList.add("js-days");
        const fromHash = location.hash.match(/^#day(\d+)$/)?.[1];
        const fromSpeaker = initial
            ? document.querySelector(`[data-speaker-dialog="${CSS.escape(initial)}"]`)
                  ?.closest<HTMLElement>(".schedule-day")?.dataset.day
            : undefined;
        const today = dayEls.find((el) => el.dataset.date === ptDate(now()))?.dataset.day;
        showDay(Number(fromHash ?? fromSpeaker ?? today ?? 1));

        const pick = (e: Event) => {
            const a = (e.target as Element).closest<HTMLAnchorElement>("[data-day-tab], [data-day-next]");
            if (!a) return;
            e.preventDefault();
            showDay(Number(a.dataset.dayTab ?? a.dataset.dayNext), true);
        };
        section.addEventListener("click", pick);
        addEventListener("hashchange", () => {
            const n = location.hash.match(/^#day(\d+)$/)?.[1];
            if (n) showDay(Number(n), true);
        });

        markLive();
        setInterval(markLive, 60_000);
    }
</script>
