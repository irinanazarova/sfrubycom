---
// Answers "is this for me?", which is the first question a visitor has and the
// one the page never used to answer. Sits directly under the hero.
// width/height must match the real asset: these sprites are far from square
// (px-royal is an 8x192 strip), and a wrong ratio squashes them into bars.
const pillars = [
    {
        icon: "/px-ruby.png",
        w: 14,
        h: 12,
        title: "Startups",
        body: "Founders betting on Ruby, and the new success stories being written on Rails right now.",
    },
    {
        icon: "/px-coin.png",
        w: 135,
        h: 139,
        title: "Scaleups",
        body: "The teams already running Ruby at serious scale, on what it actually takes to stay there.",
    },
    {
        icon: "/px-heart.png",
        w: 14,
        h: 13,
        title: "Open source",
        body: "The authors of the gems and tools the rest of us build on, on what they are shipping next.",
    },
];
---

<section class="py-20 md:py-24 bg-white border-t-4 border-ink">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
            <p class="px-font text-xs md:text-sm text-ruby-600">Who it's for</p>
            <h2 class="px-font text-lg md:text-2xl text-gray-900 mt-6">
                Ruby is where startups grow
            </h2>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed mt-6">
                Three days for the people building the most ambitious products
                on Ruby and Rails: the companies that already scaled on it, the
                startups writing the next stories of success, and the open
                source powering both.
            </p>
        </div>

        <ul
            class="mt-14 grid gap-5 md:grid-cols-3 list-none p-0"
        >
            {
                pillars.map((p) => (
                    <li class="px-card bg-sky-50 p-6 flex flex-col items-center text-center">
                        <img
                            src={p.icon}
                            alt=""
                            width={p.w}
                            height={p.h}
                            loading="lazy"
                            class="px-pixelated h-9 w-auto"
                        />
                        <h3 class="px-font text-px10 md:text-xs text-gray-900 mt-5">
                            {p.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed mt-4">
                            {p.body}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
