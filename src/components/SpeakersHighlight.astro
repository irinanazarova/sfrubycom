---
import { speakers, getSpeakersByGroup } from "../data/speakers.js";
import SocialLink from "../components/SocialLink.astro";
// Get speakers by group
const featuredSpeakers = getSpeakersByGroup("featured");
---

<section id="speakers" class="py-20 bg-dark-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2
                class="text-3xl md:text-4xl font-display font-bold text-dark-900"
            >
                Featured Speakers
            </h2>
            <p class="mt-4 text-xl text-dark-600 max-w-3xl mx-auto">
                Learn from the brightest minds in the Ruby community
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                featuredSpeakers.map((speaker) => (
                    <div class="group">
                        <div class="relative rounded-lg overflow-hidden mb-4">
                            <div class="aspect-w-3 aspect-h-4 bg-dark-200 filter grayscale hover:grayscale-0 transition flex items-center flex-col">
                                <img
                                    src={speaker.image}
                                    alt={speaker.name}
                                    class="object-cover object-top duration-300 rounded-full sm:rounded-none h-48 w-48 sm:h-auto sm:w-auto"
                                    loading="lazy"
                                />
                            </div>
                        </div>

                        <div class="text-center flex flex-col gap-2">
                            <h3 class="font-bold text-lg text-dark-900">
                                {speaker.name}{" "}
                            </h3>
                            <div class="flex space-x-4 justify-center">
                                {speaker.socials.map((url) => (
                                    <SocialLink url={url} />
                                ))}
                            </div>
                            <p class="text-ruby-500">{speaker.title}</p>
                            <p class="text-dark-500 text-sm">
                                {speaker.company}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="flex flex-col items-center text-center">
            <div class="text-center mt-12 text-gray-500">
                <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
                    <a
                        href="/speakers"
                        class="inline-flex items-center justify-center px-5 py-3 bg-transparent border border-cloud-700 text-cloud-900 rounded-md font-medium shadow-md transition-all duration-300 transform hover:shadow-glow hover:scale-105"
                    >
                        All speakers
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
