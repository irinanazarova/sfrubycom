---
const speakers = [
  {
    name: 'Andrew Kane',
    title: 'Creator of ActiveAgent',
    company: 'Independent',
    image: 'https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=800'
  },
  {
    name: 'Sarah Chen',
    title: 'Ruby Core Contributor',
    company: 'Shopify',
    image: 'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=800'
  },
  {
    name: 'Miguel Rodriguez',
    title: 'Author of "Scaling Ruby"',
    company: 'Stripe',
    image: 'https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=800'
  },
  {
    name: 'Aisha Johnson',
    title: 'AI & Ruby Expert',
    company: 'RubyLLM',
    image: 'https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=800'
  }
];
---

<section id="speakers" class="py-20 bg-dark-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-dark-900">Featured Speakers</h2>
      <p class="mt-4 text-xl text-dark-600 max-w-3xl mx-auto">
        Learn from the brightest minds in the Ruby community
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {speakers.map((speaker) => (
        <div class="group">
          <div class="relative rounded-lg overflow-hidden mb-4">
            <div class="aspect-w-3 aspect-h-4 bg-dark-200">
              <img 
                src={speaker.image} 
                alt={speaker.name} 
                class="w-full h-full object-cover" 
                loading="lazy"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-dark-900/70 via-dark-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
              <div class="p-4 w-full text-center">
                <a 
                  href={`/speakers/${speaker.name.toLowerCase().replace(/\s/g, '-')}`}
                  class="inline-block px-4 py-2 bg-white/90 text-dark-800 rounded-md font-medium hover:bg-white transition-colors duration-200"
                >
                  View Profile
                </a>
              </div>
            </div>
          </div>
          
          <div class="text-center">
            <h3 class="font-bold text-lg text-dark-900">{speaker.name}</h3>
            <p class="text-ruby-500">{speaker.title}</p>
            <p class="text-dark-500 text-sm">{speaker.company}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a 
        href="/speakers" 
        class="inline-flex items-center justify-center px-6 py-3 border border-dark-300 rounded-md text-dark-800 bg-white hover:bg-dark-50 transition-colors duration-200 font-medium"
      >
        View All Speakers
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 ml-2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>