---
import "../styles/global.css";

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Startups on Rails 2026",
    description = "RubyConfTH Bangkok - A presentation about Ruby startups",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#111111" />
        <title>{title}</title>

        <!-- Preload fonts -->
        <link
            rel="preload"
            href="/fonts/MartianGrotesk.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/MartianMono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body class="bg-gray-900 text-white font-sans antialiased">
        <slot />
    </body>
</html>
