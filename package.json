{
  "name": "sfruby-community",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "fetch-data": "node scripts/fetch-luma-events.js && node scripts/fetch-cfp-talks.js",
    "fetch-youtube-dates": "node scripts/fetch-youtube-dates.js",
    "lint:colors": "node scripts/check-colors.mjs",
    "build": "npm run lint:colors && npm run fetch-data && astro build",
    "build:dev": "npm run lint:colors && astro build",
    "preview": "astro preview",
    "qa": "npm run build:dev && node scripts/qa-mobile.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^5.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/tailwind": "^6.0.2",
    "@iconify-json/ph": "^1.2.2",
    "@types/node": "^20.0.0",
    "astro-icon": "^1.1.5",
    "playwright": "^1.61.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0"
  }
}
